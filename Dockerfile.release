# syntax=docker/dockerfile:1

FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd -g 10001 ergon && \
    useradd -u 10001 -g 10001 -m -d /home/ergon -s /usr/sbin/nologin ergon && \
    mkdir -p /data && \
    chown -R 10001:10001 /data

ARG TARGETARCH
RUN --mount=type=bind,source=dist,target=/tmp/dist \
    case "$TARGETARCH" in \
      amd64) install -m 0755 /tmp/dist/ergon-x86_64-unknown-linux-gnu /usr/local/bin/ergon ;; \
      arm64) install -m 0755 /tmp/dist/ergon-aarch64-unknown-linux-gnu /usr/local/bin/ergon ;; \
      *) echo "Unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac

ENV ERGON_HOST=0.0.0.0 \
    ERGON_PORT=8787 \
    ERGON_DATA_DIR=/data \
    ERGON_NO_OPEN=1 \
    ERGON_TRUST_PROXY=1 \
    ERGON_DISABLE_HOST_APP_SCAN=1 \
    ERGON_MODEL_BASE_URL=https://opencode.ai/zen/go/v1 \
    ERGON_MODEL_ID=deepseek-v4.1-flash

VOLUME ["/data"]
EXPOSE 8787

USER 10001:10001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["ergon", "healthcheck"]

ENTRYPOINT ["ergon"]
