//! Ergon skill: make_spreadsheet (Rune)
//!
//! Takes a title, column headers and rows of cells; formats them as a
//! CSV spreadsheet with RFC 4180 quoting, and writes `<title>.csv` into
//! the workspace through the host function `host_workspace_write`.
//! Returns the file name (or an "error: ..." string from the host).

fn esc(cell) {
    if !cell.contains(",") && !cell.contains("\"") && !cell.contains("\n") && !cell.contains("\r") {
        return cell;
    }
    let doubled = cell.replace("\"", "\"\"");
    `"${doubled}"`
}

fn join_row(cells) {
    let line = String::new();
    let first = true;
    for cell in cells {
        if !first {
            line.push(',');
        }
        line.push_str(esc(cell));
        first = false;
    }
    line
}

pub fn main(title, columns, rows) {
    let content = String::new();
    if !columns.is_empty() {
        content.push_str(join_row(columns));
        content.push('\n');
    }
    for row in rows {
        content.push_str(join_row(row));
        content.push('\n');
    }
    let filename = `${title}.csv`;
    // Label first: passing `filename` to the host function moves it.
    // "file:" prefix = success (see write_document.rn).
    let label = `file:${filename}`;
    let result = host_workspace_write(filename, content);
    if result != "ok" {
        return result;
    }
    label
}
