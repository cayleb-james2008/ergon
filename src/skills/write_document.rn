//! Ergon skill: write_document (Rune)
//!
//! Takes a title and a list of section strings, formats them into a
//! finished markdown document, and writes it into the workspace through
//! the host function `host_workspace_write`. Returns the file name.

pub fn main(title, sections) {
    let body = "";
    for section in sections {
        body = `${body}${section}\n\n`;
    }
    let content = `# ${title}\n\n${body}`;
    let filename = `${title}.md`;
    // The label is interpolated BEFORE the write: passing `filename` to
    // the host function moves it, and reading it afterwards is an error.
    // Success returns are prefixed "file:" so the Rust side can tell a
    // file name from a host error unambiguously — even when the title
    // itself starts with "error:".
    let label = `file:${filename}`;
    let result = host_workspace_write(filename, content);
    if result != "ok" {
        return result;
    }
    label
}
