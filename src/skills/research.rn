//! Ergon skill: research (Rune)
//!
//! Takes a topic, a target file name and a list of URLs; fetches each
//! page through the host function `host_fetch_url` and compiles one
//! research notes document — a section per source, in the order given.
//! A source that fails to load is recorded as an error line in its
//! section, never silently dropped. Returns the file name.
//!
//! Note: the section heading is built BEFORE the fetch, because passing
//! `url` to the host function moves it — reading it afterwards is an
//! error in Rune.

pub fn main(topic, filename, urls) {
    let total = urls.len();
    let fetched = 0;
    let sections = "";
    let n = 0;
    for url in urls {
        n = n + 1;
        let heading = `## Source ${n}: ${url}\n\n`;
        let text = host_fetch_url(url);
        if !text.starts_with("error:") {
            fetched = fetched + 1;
        }
        sections = sections + heading + text + "\n\n";
    }
    // The header states how many sources actually loaded — never the
    // count that was merely attempted.
    let content = `# Research: ${topic}\n\nFetched ${fetched} of ${total} sources.\n\n` + sections;
    // Label first: passing `filename` to the host function moves it.
    // "file:" prefix = success (see write_document.rn).
    let label = `file:${filename}`;
    let result = host_workspace_write(filename, content);
    if result != "ok" {
        return result;
    }
    label
}
