--- claim 2: Server.luau guarded fog write + honest record ---
 if manifest.fogOff then
  -- The fog-off batch: the world is captured without fog or haze (the top-down tiles are functional views).
  -- Lighting.FogEnabled is a legacy member (absent on Studio 0.745): write it only when the engine still offers it, and
  -- always apply the atmosphere fog-off. The record says exactly which path was taken — never a write it did not make.
  local method={}
  local fogEnabledAvailable=pcall(function() return Lighting.FogEnabled end)
  if fogEnabledAvailable then Lighting.FogEnabled=false;table.insert(method,"fog-enabled") end
  local atmosphere=Lighting:FindFirstChildOfClass("Atmosphere")
  if atmosphere then atmosphere.Density=0;atmosphere.Haze=0;table.insert(method,"atmosphere") end
  inventory.fogOff=true
  inventory.fogOffDetail={applied=#method>0,fogEnabledAvailable=fogEnabledAvailable,atmosphere=atmosphere~=nil,method=table.concat(method,"+")}
  Lighting:SetAttribute("AtlasFogOff",Http:JSONEncode(inventory.fogOffDetail))
 end

