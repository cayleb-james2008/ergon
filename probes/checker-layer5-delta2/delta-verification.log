    def flush_capture_attempts(self, out):
        """Write the capture-attempt audit with the CURRENT COMPLETE list (overwritten by design).

        This is a DERIVED mirror of result.json.captureAttempts: an exclusive-create would let an earlier retry leave a
        stale snapshot that a later failure's flush silently skips (checker layer-5 delta). A real write error is raised,
        never swallowed."""
        if not self.capture_attempts:
            return
        (out / "capture-attempts.json").write_text(json.dumps(self.capture_attempts, indent=2) + "\n")

