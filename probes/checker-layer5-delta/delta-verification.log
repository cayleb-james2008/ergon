    def flush_capture_attempts(self, out):
        """Write the capture-attempt audit once (also on fail-closed paths, so attempts are always on disk)."""
        if not self.capture_attempts:
            return
        try:
            write(out / "capture-attempts.json", self.capture_attempts)
        except FileExistsError:
            pass
