--- claim 1: root check accepts userdata/table, named messages unchanged ---
function WorldSeed.requireApplied(root, expectedSeed, expectedLayout)
	local value = WorldSeed.parse(expectedSeed)
	assert(value ~= nil, "a named seed is required")
	-- The world root is a Folder INSTANCE (type == "userdata"); accept an Instance or a test table, keep the named
	-- fail-fast text, and never index a value that cannot be one (the old type(root)=="table" check was the bug).
	local kind = type(root)
	assert(root ~= nil and (kind == "userdata" or kind == "table") and type(root.GetAttribute) == "function",
		"the world root is required")
	local actualSeed, actualLayout = root:GetAttribute("WorldSeed"), root:GetAttribute("WorldLayoutVersion")
	if actualSeed == value and actualLayout == expectedLayout then
		return { seed = value, worldSeed = actualSeed, layoutVersion = actualLayout, fastPath = true, rebuilt = false }
	end
	error(string.format("named seed not applied before Play: world reports seed %s layout %s, expected %s/%s; "
		.. "refusing in-Play rebuild", tostring(actualSeed), tostring(actualLayout), tostring(value), tostring(expectedLayout)))
end

return WorldSeed
