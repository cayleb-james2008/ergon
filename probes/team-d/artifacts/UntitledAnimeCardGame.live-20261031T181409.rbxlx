      <Item class="Script" referent="40">
        <Properties>
          <string name="Name">StudioSelfReport</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- StudioSelfReport.server.luau — session7-A: automatic in-Studio self-report.
-- This is a Script (run by Roblox on the server shortly after place start),
-- NOT a ModuleScript: it is never required by Lune/plain-Lua tests and never
-- executes off-engine. No human has to press anything: one delayed run of the
-- ported P6StudioChecks suite, then the result is reported off-machine.
--
-- Reporting routes (first working route wins; the route used is named in the
-- payload AND in the console line, so the evidence always says how it got
-- out):
--   route A "http-localhost" (preferred): HttpService POST of the JSON result
--     to a small collector on 127.0.0.1. Default port 38271; override with
--     the ReplicatedStorage attribute UACGCollectorPort. Needs
--     HttpService.HttpEnabled = true (set in default.project.json).
--   route B "console-marker" (fallback): a single machine-readable line on
--     the Studio output console starting with JEV_STUDIO_RESULT followed by
--     compact JSON. The lead reads it from the Studio log. This route is
--     used when HttpEnabled is off, the POST fails, or Studio blocks the
--     localhost call (Studio sandboxing may refuse even 127.0.0.1).
-- The console line is ALWAYS printed (both routes), so a log reader never
-- loses the result even when route A succeeds.
--
-- Honesty: every step is pcall-guarded. If the checks cannot run, the honest
-- outcome is NOT_RUN with the exact blocker named — never a fabricated PASS,
-- never an invented session/account id. A Linux/Lune run of anything here is
-- impossible by construction (Roblox Script), so nothing here can ever be
-- mislabelled as Studio evidence from this host.
--
-- Tuning attributes on ReplicatedStorage (all optional):
--   UACGCollectorPort   (number, default 38271)
--   UACGSelfReportDelay (number, seconds before the run, default 15:
--     long enough for the session7-B Studio demo + data drills to finish)

local DELAY_DEFAULT = 15
local PORT_DEFAULT = 38271
local MARKER = "JEV_STUDIO_RESULT"

-- Only server-visible facts belong here. The separate client reporter runs
-- P6StudioChecks, which needs LocalPlayer, camera, HUD, cards, and audio.
local function runServerChecks()
	local checked, failed = 0, 0
	local function check(name, fn)
		checked = checked + 1
		local ok, err = pcall(fn)
		if not ok then failed = failed + 1 end
		print("STUDIO-SERVER-CHECK " .. name .. " "
			.. (ok and "PASS" or ("FAIL :: " .. tostring(err))))
	end
	local rs = game:GetService("ReplicatedStorage")
	check("remote-serves", function()
		local remote = rs:FindFirstChild("UACG_Economy")
		assert(remote ~= nil and remote:IsA("RemoteFunction"),
			"server economy RemoteFunction absent")
	end)
	check("shared-tree-mapped", function()
		assert(rs:FindFirstChild("Shared") ~= nil, "shared modules absent")
	end)
	check("reset-cycle-drill", function()
		assert(workspace:GetAttribute("UACGResetCycle") == true,
			"server memory-adapter reset drill did not complete")
	end)
	check("save-failure-drill", function()
		assert(workspace:GetAttribute("UACGSaveFailure") ~= nil,
			"server failed-load drill did not complete")
	end)
	return failed == 0 and "PASS" or "FAIL", {
		runtime = "studio", vantage = "server", checks = checked,
		fails = failed, atUtc = os.date("!%Y-%m-%dT%H:%M:%SZ"),
		overall = "server bootstrap and isolated data drills only; live "
			.. "player transactions are logged separately",
	}
end

local function short(s, n)
	s = tostring(s or "")
	if #s > n then
		return string.sub(s, 1, n) .. "..."
	end
	return s
end

local function readNumberAttribute(rs, name)
	local ok, v = pcall(function()
		return rs:GetAttribute(name)
	end)
	if ok and type(v) == "number" then
		return v
	end
	return nil
end

local function selfReport()
	local ok, err = pcall(function()
		local rs = game:GetService("ReplicatedStorage")
		local http = game:GetService("HttpService")

		local port = PORT_DEFAULT
		local portAttr = readNumberAttribute(rs, "UACGCollectorPort")
		if portAttr ~= nil and portAttr > 0 and portAttr < 65536 then
			port = math.floor(portAttr)
		end

		-- Load the ported check suite (10s grace for replication).
		local shared = rs:WaitForChild("Shared", 10)
		local studio = nil
		local mod = nil
		if shared ~= nil then
			studio = shared:WaitForChild("Studio", 10)
		end
		if studio ~= nil then
			mod = studio:WaitForChild("P6StudioChecks", 10)
		end
		if mod == nil then
			print(MARKER .. " route=console-marker "
				.. '{"verdict":"NOT_RUN","blocker":'
				.. '"P6StudioChecks module absent under '
				.. 'ReplicatedStorage.Shared.Studio"}')
			return
		end
		local verdict, meta = runServerChecks()
		if type(meta) ~= "table" then
			meta = { runtime = "studio" }
		end

		-- Build binding: the manifest hash stamped into this place at
		-- build time (ReplicatedStorage.UACGManifestHash, written by
		-- ops/release/stamp_manifest_hash.py). The studio-device
		-- connector refuses any result that does not name the current
		-- hash, so a stale run can never pass for a new build.
		-- Absent stamp (pre-stamp builds) reports "absent" and is
		-- refused the same way — never fabricated, never guessed.
		local manifestHash = "absent"
		pcall(function()
			local stamp = rs:FindFirstChild("UACGManifestHash")
			if stamp ~= nil and stamp:IsA("StringValue") then
				manifestHash = tostring(stamp.Value)
			end
		end)

		local result = {
			place = "UntitledAnimeCardGame",
			suite = "UACGStudioServerChecks",
			verdict = tostring(verdict or "NOT_RUN"),
			runtime = tostring(meta.runtime or "studio"),
			atUtc = tostring(meta.atUtc or "n/a"),
			checks = meta.checks,
			fails = meta.fails,
			vantage = "server",
			manifest_sha256 = manifestHash,
			overall = tostring(meta.overall or ""),
			route = "console-marker",
			httpEnabled = false,
			collectorUrl = "http://127.0.0.1:" .. tostring(port)
				.. "/uacg-studio-result",
		}

		-- Route A: localhost POST (needs HttpEnabled; Studio sandboxing may
		-- still refuse even 127.0.0.1 — that failure lands on route B).
		local okH, httpOn = pcall(function()
			return http.HttpEnabled
		end)
		result.httpEnabled = (okH and httpOn == true)
		if result.httpEnabled then
			local okPost = pcall(function()
				http:PostAsync(result.collectorUrl,
					http:JSONEncode(result),
					Enum.HttpContentType.ApplicationJson, false)
			end)
			if okPost then
				result.route = "http-localhost"
			end
		end

		-- Route B (always): delimited console line for the Studio log.
		local okLine, line = pcall(function()
			return http:JSONEncode(result)
		end)
		if not okLine then
			line = '{"verdict":"' .. short(result.verdict, 32)
				.. '","overall":"encode-failed"}'
		end
		print(MARKER .. " route=" .. tostring(result.route) .. " " .. line)
	end)

	if not ok then
		-- Last-resort line: the runner itself crashed before reporting.
		print(MARKER .. " route=console-marker "
			.. '{"verdict":"NOT_RUN","blocker":"self-report runner crashed: '
			.. short(err, 200) .. '"}')
	end
end

local function startDelay()
	local delay = DELAY_DEFAULT
	local ok, rs = pcall(function()
		return game:GetService("ReplicatedStorage")
	end)
	if ok and rs ~= nil then
		local d = readNumberAttribute(rs, "UACGSelfReportDelay")
		if d ~= nil and d >= 0 and d <= 300 then
			delay = d
		end
	end
	task.delay(delay, selfReport)
end

local okStart, startErr = pcall(startDelay)
if not okStart then
	print(MARKER .. " route=console-marker "
		.. '{"verdict":"NOT_RUN","blocker":"self-report scheduler crashed: '
		.. short(startErr, 200) .. '"}')
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">SupporterPass</string>
          <string name="Source"><![CDATA[-- Optional one-time cosmetic pass. Roblox owns the durable purchase record;
-- this server alone grants the visible badge after an ownership check or a
-- server MarketplaceService purchase-finished event. No economy data changes.
local SupporterPass = {}
SupporterPass.REMOTE_NAME = "UACG_SupporterPass"
SupporterPass.NAME = "Supporter Crest"

function SupporterPass.validId(id)
	return type(id) == "number" and id > 0 and id % 1 == 0
end

function SupporterPass.new(deps)
	return setmetatable({
		marketplace = deps.marketplace,
		passId = deps.passId,
		infoType = deps.infoType,
		badge = deps.badge,
		owned = {},
		product = nil,
	}, { __index = SupporterPass })
end

function SupporterPass.checkOwnership(self, player)
	if not SupporterPass.validId(self.passId) then
		return nil, "Supporter Crest is not configured"
	end
	if self.owned[player.UserId] == true then
		return true, nil
	end
	local ok, result = pcall(function()
		return self.marketplace:UserOwnsGamePassAsync(player.UserId, self.passId)
	end)
	if not ok or type(result) ~= "boolean" then
		return nil, "Roblox ownership check unavailable; retry later"
	end
	if result then
		self.owned[player.UserId] = true
		if self.badge ~= nil then self.badge(player) end
	end
	return result, nil
end

function SupporterPass.offer(self, player)
	local owned, reason = SupporterPass.checkOwnership(self, player)
	if owned == nil then
		return { status = "Unavailable", reason = reason }
	end
	if self.product == nil then
		local ok, info = pcall(function()
			return self.marketplace:GetProductInfoAsync(self.passId, self.infoType)
		end)
		if not ok or type(info) ~= "table" then
			return { status = "Unavailable", reason = "Roblox pass details unavailable" }
		end
		-- A mistyped pass ID must never silently display or sell another item.
		if info.Name ~= SupporterPass.NAME
			or type(info.PriceInRobux) ~= "number"
			or info.PriceInRobux < 1 or info.PriceInRobux % 1 ~= 0
			or type(info.IsForSale) ~= "boolean" then
			return { status = "Unavailable", reason = "Supporter Crest pass details do not match" }
		end
		self.product = { name = info.Name, price = info.PriceInRobux,
			forSale = info.IsForSale }
	end
	return { status = "Committed", result = {
		passId = self.passId,
		name = self.product.name,
		price = self.product.price,
		forSale = self.product.forSale,
		owned = owned,
		value = "Permanent visible Supporter Crest above your avatar; no card, luck, or combat bonus.",
	} }
end

function SupporterPass.purchaseFinished(self, player, purchasedId, didPurchase)
	if not SupporterPass.validId(self.passId) or purchasedId ~= self.passId
		or didPurchase ~= true or player == nil
		or type(player.UserId) ~= "number" then
		return false
	end
	-- This callback is bound to the SERVER MarketplaceService signal, never
	-- to a client remote. A successful platform event is the purchase proof;
	-- rejoin recovery independently queries UserOwnsGamePassAsync again.
	self.owned[player.UserId] = true
	if self.badge ~= nil then self.badge(player) end
	return true
end

local function addBadge(player)
	local char = player.Character
	if char == nil then return end
	local head = char:FindFirstChild("Head") or char:WaitForChild("Head", 5)
	if head == nil or head:FindFirstChild("UACGSupporterCrest") then return end
	local gui = Instance.new("BillboardGui")
	gui.Name = "UACGSupporterCrest"
	gui.Size = UDim2.fromOffset(154, 32)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 2.8, 0)
	gui.MaxDistance = 70
	gui.Adornee = head
	local label = Instance.new("TextLabel")
	label.Name = "CrestLabel"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.fromRGB(29, 25, 48)
	label.BackgroundTransparency = 0.08
	label.TextColor3 = Color3.fromRGB(242, 221, 155)
	label.TextSize = 17
	label.Text = "✦ SUPPORTER"
	label.Parent = gui
	gui.Parent = head
end

function SupporterPass.serve(config)
	local marketplace = game:GetService("MarketplaceService")
	local players = game:GetService("Players")
	local service = SupporterPass.new({ marketplace = marketplace,
		passId = config.supporterPassId,
		infoType = Enum.InfoType.GamePass, badge = addBadge })
	local remote = Instance.new("RemoteFunction")
	remote.Name = SupporterPass.REMOTE_NAME
	remote.OnServerInvoke = function(player, action)
		if action ~= "GetStatus" then
			return { status = "Rejected", reason = "unknown supporter action" }
		end
		return SupporterPass.offer(service, player)
	end
	remote.Parent = game:GetService("ReplicatedStorage")
	marketplace.PromptGamePassPurchaseFinished:Connect(function(player, id, bought)
		if SupporterPass.purchaseFinished(service, player, id, bought)
			and not game:GetService("RunService"):IsStudio() then
			pcall(function()
				game:GetService("AnalyticsService")
					:LogCustomEvent(player, "SupporterPassPurchased")
			end)
		end
	end)
	local function join(player)
		player.CharacterAdded:Connect(function()
			if service.owned[player.UserId] then addBadge(player) end
		end)
		-- The platform pass owns durability; check again on every join.
		task.spawn(function()
			SupporterPass.checkOwnership(service, player)
		end)
	end
	players.PlayerAdded:Connect(join)
	players.PlayerRemoving:Connect(function(player)
		service.owned[player.UserId] = nil
	end)
	for _, player in ipairs(players:GetPlayers()) do join(player) end
	return service
end

return SupporterPass
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="42">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="43">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="44">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Actions</string>
            <string name="Source"><![CDATA[-- Actions.luau — transport + preparation handlers (R2 split from App).
-- Owns: wire calls with durable request ids, Pending→retry-SAME-id /
-- Stale→refetch-fresh-state mapping, server-truth preparation rendering
-- (exact odds, catalogue/owned/retained, canonical form + display alias
-- from Cards), row-specific deck controls, earned-points skill bounds, the
-- exact atomic rebirth preview, and settings/volume actions. No battle
-- presentation here (see BattlePresenter) and no view building (UiView).

local StoreView
if game ~= nil then
	StoreView = require(script.Parent:WaitForChild("StoreView"))
elseif dofile ~= nil then
	StoreView = dofile("./src/client/StoreView.luau")
else
	StoreView = require("./StoreView")
end

local Actions = {}

Actions.RULES_VERSION = "provisional-1"
Actions.PENDING_RETRIES = 1

-- Canonical display identity: exact form (canonical) + card-face alias
-- from the frozen Cards roster. Never invents names for unknown ids.
function Actions.cardIdentity(app, id)
	local M = app.M
	if M.Cards ~= nil and M.Cards.getById ~= nil then
		local ok, row = pcall(M.Cards.getById, id)
		if ok and type(row) == "table" then
			return {
				alias = row.alias or tostring(id),
				canonical = row.canonical or tostring(id),
				rarity = row.rarity or "Common", role = row.role or "attacker",
				atk = row.atk, hp = row.hp, def = row.def, speed = row.speed,
			}
		end
	end
	return { alias = tostring(id), canonical = tostring(id),
		rarity = "Unknown", role = "unknown" }
end

function Actions.setStatus(app, text)
	app.statusMessage = tostring(text)
	local lower = string.lower(app.statusMessage)
	local role = "feedback"
	if string.find(lower, "unavailable", 1, true)
		or string.find(lower, "locked", 1, true)
		or string.find(lower, "failed", 1, true)
		or string.find(lower, "malformed", 1, true)
		or string.find(lower, "rejected", 1, true) then
		role = "alert"
	elseif string.find(lower, "pending", 1, true)
		or string.find(lower, "confirming", 1, true) then
		role = "pending"
	end
	if app.statusLine ~= nil then
		app.statusLine.Text = app.statusMessage
	end
	for _, s in pairs(app.screens or {}) do
		if s.feedback ~= nil then
			s.feedback.Text = app.statusMessage
			if app.M.UiView ~= nil then
				app.M.UiView.paint(app, s.feedback, role)
			end
		end
	end
end

function Actions.setPauseLabel(app, paused)
	local button = app.screens.encounter
		and app.screens.encounter.buttons["battle-pause"] or nil
	if button ~= nil then
		button.Text = paused and "Resume" or "Pause"
	end
end

function Actions.call(app, command, params, reqId, idem)
	local M = app.M
	if reqId == nil then
		if M.ClientProtocol.READ_ONLY[command] then
			reqId = M.State.newRequestId(app.store, command)
		else
			reqId, idem = M.State.claimIdentity(app.store, command)
		end
	end
	local req, err = M.ClientProtocol.buildRequest(command, params,
		reqId, idem)
	if req == nil then
		Actions.setStatus(app, err)
		return nil, err
	end
	local resp = app.transport(req)
	if resp == nil then
		Actions.setStatus(app, "Unavailable: no transport")
		return nil, "no-transport"
	end
	M.State.noteServerEpoch(app.store, resp)
	if resp.result ~= nil then
		M.State.noteHandshake(app.store, resp.result)
	end
	return resp, reqId
end

function Actions.showScreen(app, id)
	app.M.UiView.show(app, id)
	if id == "store" then StoreView.refreshSupporter(app) end
	if app.M.AudioEngine ~= nil and app.audioFolder ~= nil then
		pcall(app.M.AudioEngine.playForScreen, app, id)
	end
end

function Actions.playCue(app, purpose)
	if app.M.AudioEngine ~= nil and app.audioFolder ~= nil then
		pcall(app.M.AudioEngine.playCue, app, purpose)
	end
end

function Actions.refreshProfile(app)
	local M = app.M
	local resp = Actions.call(app, "GetProfile", {}, nil)
	if resp == nil then
		return false
	end
	local inter = M.ClientProtocol.interpret(resp)
	if inter.ui == "apply" then
		local ok, err = M.ClientProtocol.validateProfile(resp.result)
		if not ok then
			Actions.setStatus(app, err)
			return false
		end
		app.profile = resp.result
		M.State.applyServerSettings(app.store, resp.result.settings)
		if M.AudioEngine ~= nil then M.AudioEngine.syncVolumes(app) end
		M.Theme.setMode(app.store.prefs.theme)
		M.UiView.repaintAll(app)
		Actions.renderProfile(app)
		Actions.reconcileBattle(app)
		StoreView.reconcile(app)
		return true
	end
	Actions.setStatus(app, inter.detail or inter.ui)
	return false
end

function Actions.reconcileBattle(app)
	local M = app.M
	local resp = Actions.call(app, "BattleStatus", {}, nil)
	if resp == nil then
		return false
	end
	if M.ClientProtocol.interpret(resp).ui ~= "apply" then
		return false
	end
	if resp.result.pending then
		Actions.setStatus(app, "Pending battle found — Resume from Reconnect")
		Actions.renderBattleStatus(app, resp.result)
		Actions.showScreen(app, "reconnect")
	else
		Actions.setStatus(app, "Your saved run is ready")
	end
	return true
end

function Actions.renderSettings(app)
	local settings = app.screens and app.screens.settings
	if settings == nil or settings.buttons == nil then
		return
	end
	local prefs = app.store and app.store.prefs or {}
	local function label(id, text)
		local button = settings.buttons[id]
		if button ~= nil then button.Text = text end
	end
	label("motion-toggle", "Reduced motion: "
		.. (prefs.reducedMotion and "On" or "Off"))
	label("flash-toggle", "Reduced flash: "
		.. (prefs.reducedFlash and "On" or "Off"))
	label("speed-set", "Battle speed: " .. tostring(prefs.speed or 1) .. "x")
	for _, channel in ipairs({ "music", "sfx", "ui", "ambience" }) do
		local value = prefs[channel .. "Volume"]
		if type(value) ~= "number" then value = 70 end
		label("vol-" .. channel, string.upper(channel)
			.. " volume: " .. tostring(value) .. "%")
	end
end

function Actions.renderProfile(app)
	local p = app.profile
	if p == nil then
		return
	end
	Actions.renderSettings(app)
	local function data(id, text)
		if app.screens[id] ~= nil then
			app.screens[id].data.Text = text
		end
	end
	Actions.renderOddsLine(app)
	Actions.renderRollReveal(app)
	StoreView.render(app)
	-- Featured card above a scroll of individual card rows. Keep the exact
	-- canonical form, discovered IDs and retained state in the file text.
	local ownedIds = {}
	for id, _ in pairs(p.collection or {}) do ownedIds[#ownedIds + 1] = id end
	table.sort(ownedIds)
	local selected = app.inspectCardId
	if selected == nil or p.collection[selected] == nil then selected = ownedIds[1] end
	app.inspectCardId = selected
	local lines = { "OWNED THIS RUN  /  " .. tostring(#ownedIds) .. " identities" }
	if selected ~= nil then
		local ident = Actions.cardIdentity(app, selected)
		lines[#lines + 1] = "SELECTED  /  " .. ident.alias .. " x"
			.. tostring(p.collection[selected]) .. "  •  " .. selected
		lines[#lines + 1] = ident.canonical .. "  •  "
			.. ident.rarity .. "  •  " .. ident.role
	else
		lines[#lines + 1] = "No confirmed cards yet. Take a free roll to begin."
	end
	if type(p.catalogue) == "table" and #p.catalogue > 0 then
		local cat = {}
		for _, id in ipairs(p.catalogue) do
			cat[#cat + 1] = tostring(id)
		end
		table.sort(cat)
		lines[#lines + 1] = "DISCOVERED CATALOGUE: "
			.. table.concat(cat, ", ")
	end
	if type(p.retained) == "table" then
		local bits = {}
		for _, id in ipairs(p.retained.mythic or {}) do
			bits[#bits + 1] = tostring(id) .. " [MYTHIC]"
		end
		for _, id in ipairs(p.retained.legacy or {}) do
			bits[#bits + 1] = tostring(id) .. " [LEGACY]"
		end
		if p.retained.keepsakeId ~= nil then
			bits[#bits + 1] = tostring(p.retained.keepsakeId)
				.. " [KEEPSAKE]"
		end
		if #bits > 0 then
			lines[#lines + 1] = "RETAINED BETWEEN RUNS: "
				.. table.concat(bits, ", ")
		end
	end
	data("inventory", table.concat(lines, "\n"))
	local confirmedDeck = p.deck or {}
	local draft = app.deckDraft
	local function deckNames(ids)
		local names = {}
		for _, id in ipairs(ids) do
			names[#names + 1] = Actions.cardIdentity(app, id).alias
		end
		return table.concat(names, "  →  ")
	end
	if type(draft) == "table" and #draft >= 0 then
		local countLine = "SLOTS  /  " .. tostring(#draft) .. " of "
			.. tostring(p.deckMax or 4) .. " selected"
		local same = (#draft == #confirmedDeck)
		if same then
			for i = 1, #draft do
				if draft[i] ~= confirmedDeck[i] then
					same = false
					break
				end
			end
		end
		if same then
			data("deck", countLine .. "\nOrder: " .. deckNames(confirmedDeck)
				.. " (max " .. tostring(p.deckMax) .. ")")
		else
			data("deck", countLine .. "  •  UNSAVED\nConfirmed: " .. deckNames(confirmedDeck)
				.. " (max " .. tostring(p.deckMax) .. ")"
				.. "\nDraft (uncommitted): " .. deckNames(draft)
				.. " — Save to commit, Discard to revert")
		end
	else
		data("deck", "SLOTS  /  " .. tostring(#confirmedDeck) .. " of "
			.. tostring(p.deckMax or 4) .. " selected\nOrder: "
			.. deckNames(confirmedDeck)
			.. " (max " .. tostring(p.deckMax) .. ")")
	end
	if #confirmedDeck == 0 and (draft == nil or #draft == 0) then
		data("deck", "Order: empty  /  0 of " .. tostring(p.deckMax or 4)
			.. " slots\nAdd owned cards below. The first card leads each battle.")
	end
	data("upgrade", "Points=" .. tostring(p.skillPoints))
	Actions.renderTutorial(app)
	Actions.renderInventoryExtras(app)
	Actions.renderDeckExtras(app)
	Actions.renderSkillExtras(app)
	app.M.EncounterRoutes.render(app, Actions)
	Actions.renderAwayProgress(app)
	data("rewards", app.lastReward or
		"NO UNCLAIMED REWARD  /  Win a duel, then claim its server-confirmed result.")
	if app.battle == nil then
		app.M.UiView.renderRewardPanel(app,
			app.lastRewardData and "claimed" or "empty",
			app.lastBattleWinner, app.lastRewardData)
	end
	if app.battle == nil and app.screens.rewards ~= nil then
		local rewards = app.screens.rewards
		local claim = rewards.buttons["reward-claim"]
		local continue = rewards.buttons["reward-next"]
		if claim ~= nil then
			claim.Text = app.lastReward and "Reward claimed" or "No result to claim"
			pcall(function() claim.Active = false end)
			app.M.UiView.paint(app, claim, "locked")
			rewards.buttonRoles["reward-claim"] = "locked"
		end
		if continue ~= nil then
			continue.Text = app.lastReward and "Continue to next unlocked route"
				or "Choose an available duel"
			pcall(function() continue.Active = true end)
			app.M.UiView.paint(app, continue, "action")
			rewards.buttonRoles["reward-next"] = "action"
		end
	end
	data("reconnect", "No pending battle on this profile. If a result is missing,"
		.. " tap Resume session to check the server again.")
	data("rebirth", app.pendingPreviewToken and
		"Preview ready. Review the exact keeps and losses below before confirming."
		or "NO PREVIEW YET  /  Refresh the preview to see exactly what a new run would keep and reset.")
	local prefs = app.store and app.store.prefs or {}
	data("settings", "CURRENT PACE  /  " .. tostring(prefs.speed or 1) .. "x"
		.. "\nMotion: " .. (prefs.reducedMotion and "reduced" or "standard")
		.. "  •  Flashes: " .. (prefs.reducedFlash and "reduced" or "standard")
		.. "\nChanges are saved to the server when you choose Save settings.")
	local openBosses = 0
	for _, route in ipairs(app.M.EncounterRoutes.list(app)) do
		if route.isBoss and route.unlocked then openBosses = openBosses + 1 end
	end
	data("boss", "BOSS GATES  /  " .. tostring(openBosses)
		.. " currently open\nClear and claim each world's three duels to unlock its boss.")
	if app.battle == nil then
		local route = app.M.EncounterRoutes.find(app, app.selectedEncounterId)
		data("encounter", route and ("SELECTED  /  " .. route.label
			.. "\n" .. route.worldName .. "  •  automatic card battle")
			or "Choose an unlocked route before starting a battle.")
	end
end

function Actions.renderAwayProgress(app)
	local profile = app.profile
	local worlds = app.screens and app.screens.worlds
	if profile == nil or worlds == nil or worlds.data == nil then
		return
	end
	local config = app.M.Config
	local rates = config and config.AWAY_REWARD_RATES
	local awayLine = "Away XP rate/cap unavailable."
	if type(rates) == "table" and type(rates.runXpPerHour) == "number"
		and rates.runXpPerHour > 0
		and type(config.AWAY_CATCH_UP_CAP_S) == "number"
		and config.AWAY_CATCH_UP_CAP_S > 0 then
		local capSeconds = config.AWAY_CATCH_UP_CAP_S
		local capHours = capSeconds / 3600
		local capLabel = capHours == math.floor(capHours)
			and (tostring(capHours) .. "h")
			or (tostring(capSeconds) .. "s")
		awayLine = "Away XP: " .. tostring(rates.runXpPerHour)
			.. " Run XP/hour; max " .. capLabel .. " per claim."
	end
	if type(profile.pendingAwayRunXp) == "number"
		and profile.pendingAwayRunXp > 0 then
		awayLine = "Pending away XP: +" .. tostring(profile.pendingAwayRunXp)
			.. " Run XP.\n" .. awayLine
	elseif profile.pendingAwayRunXp == 0 then
		awayLine = "No away XP ready to claim.\n" .. awayLine
	else
		awayLine = "Away XP status unavailable — refresh your saved profile.\n"
			.. awayLine
	end
	worlds.data.Text = worlds.data.Text .. "\n\n" .. awayLine
end

function Actions.renderRollReveal(app)
	local s = app.screens.roll
	if s == nil or s.reveal == nil then return end
	local roll = app.lastRoll
	if type(roll) == "table" and type(roll.editionId) == "string" then
		local ident = Actions.cardIdentity(app, roll.editionId)
		app.M.UiView.setCardVisual(app, s.rollFace, roll.editionId, ident)
		s.reveal.Text = string.upper(tostring(roll.rarity or ident.rarity))
			.. "  /  " .. ident.alias
			.. "\nConfirmed in your collection"
		app.M.UiView.paint(app, s.reveal, "rarity")
	else
		app.M.UiView.setCardVisual(app, s.rollFace, nil)
		s.reveal.Text = "NEXT REVEAL  /  Your free card is waiting."
		app.M.UiView.paint(app, s.reveal, "reveal")
	end
end

function Actions.renderTutorial(app)
	local screen, p = app.screens.tutorial, app.profile
	if screen == nil or p == nil then
		return
	end
	local starters = {}
	local ids = app.M.Config and app.M.Config.STARTER_IDS or {}
	for _, id in ipairs(ids) do
		local ident = Actions.cardIdentity(app, id)
		local owned = type(p.collection) == "table" and p.collection[id] ~= nil
		starters[#starters + 1] = ident.alias
			.. (owned and " — ready" or " — not yet on profile")
	end
	local nextLabel
	if p.tutorialDone ~= true then
		nextLabel = "Refresh starter status"
	elseif type(p.deck) ~= "table" or #p.deck == 0 then
		nextLabel = "Build your first deck"
	elseif type(p.encounters) == "table" and p.encounters["enc-1"] == true then
		nextLabel = "Continue: next unlocked route"
	else
		nextLabel = "Choose your first encounter"
	end
	local intro = p.tutorialDone == true
		and "OPENING HAND  /  The server confirmed your starter cards."
		or "OPENING HAND  /  Waiting for the server to confirm your starter cards. Refresh or reconnect."
	screen.data.Text = intro .. "\n\nYOUR STARTERS\n"
		.. table.concat(starters, "\n") .. "\n\nNEXT MOVE  /  " .. nextLabel
	if screen.buttons["tutorial-next"] ~= nil then
		screen.buttons["tutorial-next"].Text = nextLabel
	end
	local roll = screen.buttons["tutorial-roll"]
	if roll ~= nil then
		roll.Text = p.tutorialDone == true
			and "Take a free roll  →" or "Waiting for starter confirmation"
		pcall(function() roll.Active = p.tutorialDone == true end)
	end
end

function Actions.continueTutorial(app)
	local p = app.profile
	if p == nil or p.tutorialDone ~= true then
		Actions.setStatus(app,
			"Starter status not confirmed — refreshing the server profile")
		Actions.refreshProfile(app)
		return
	end
	if type(p.deck) ~= "table" or #p.deck == 0 then
		Actions.showScreen(app, "deck")
	else
		Actions.showScreen(app, "worlds")
	end
end

-- Exact server odds line (R1 GetProfile.odds + weightTotal + pityAt).
function Actions.renderOddsLine(app)
	local p = app.profile
	local roll = app.screens.roll
	if p == nil or roll == nil then
		return
	end
	local validOdds = type(p.odds) == "table" and #p.odds > 0
		and type(p.weightTotal) == "number" and p.weightTotal > 0
		and p.weightTotal == math.floor(p.weightTotal)
	if not validOdds then
		roll.data.Text = "FREE DRAW unavailable — saved server odds are missing. Refresh your profile before drawing."
		if roll.odds ~= nil then
			roll.odds.Text = "EXACT SERVER ODDS unavailable — refresh your saved profile."
		end
		local buttons = roll.buttons or {}
		if buttons["roll-free"] ~= nil then
			pcall(function() buttons["roll-free"].Active = false end)
		end
		if buttons["roll-odds"] ~= nil then
			buttons["roll-odds"].Text = "Exact odds unavailable"
			pcall(function() buttons["roll-odds"].Active = false end)
		end
		if buttons["autoroll-toggle"] ~= nil then
			pcall(function() buttons["autoroll-toggle"].Active = false end)
		end
		if buttons["roll-refresh"] ~= nil then
			pcall(function() buttons["roll-refresh"].Active = true end)
		end
		return
	end
	local bits = {}
	for _, row in ipairs(p.odds) do
		bits[#bits + 1] = tostring(row.rarity) .. " "
			.. string.format("%.2f%%", row.weight * 100 / p.weightTotal)
			.. " (" .. tostring(row.weight) .. ")"
	end
	local pityFails = type(p.pityFails) == "number"
		and tostring(p.pityFails) or "unavailable"
	roll.data.Text = "FREE DRAW  /  One card every six seconds"
		.. "\nMythic guarantee: " .. pityFails .. " / "
		.. tostring(p.pityAt or 1800) .. " failed draws"
	if roll.odds ~= nil then
		roll.odds.Text = "EXACT SERVER ODDS  /  "
			.. tostring(p.weightTotal) .. " total weight"
			.. "\n" .. table.concat(bits, "  ·  ")
	end
	local buttons = roll.buttons or {}
	local oddsButton = buttons["roll-odds"]
	if oddsButton ~= nil then
		oddsButton.Text = roll.odds and roll.odds.Visible
			and "Hide exact odds" or "Show exact odds"
		pcall(function() oddsButton.Active = true end)
	end
	if buttons["roll-free"] ~= nil then
		pcall(function() buttons["roll-free"].Active = true end)
	end
	if buttons["roll-refresh"] ~= nil then
		pcall(function() buttons["roll-refresh"].Active = true end)
	end
	local auto = buttons["autoroll-toggle"]
	if auto ~= nil then
		auto.Text = p.autoRoll and "Auto-roll is on  /  switch off"
			or "Auto-roll is off  /  switch on"
		pcall(function() auto.Active = true end)
	end
end

-- Inspect and keepsake controls for every owned identity. The archive scrolls
-- so later unlocks never become inaccessible behind an arbitrary list cap.
function Actions.renderInventoryExtras(app)
	local s = app.screens.inventory
	if s == nil or app.profile == nil then
		return
	end
	app.M.UiView.clearExtra(app, s)
	local ids = {}
	for id, _ in pairs(app.profile.collection) do
		ids[#ids + 1] = id
	end
	table.sort(ids)
	local selected = app.inspectCardId
	if selected == nil or app.profile.collection[selected] == nil then
		selected = ids[1]
	end
	app.inspectCardId = selected
	if selected ~= nil then
		app.M.UiView.setCardVisual(app, s.featuredFace, selected,
			Actions.cardIdentity(app, selected))
	else
		app.M.UiView.setCardVisual(app, s.featuredFace, nil)
	end
	for i = 1, #ids do
		local id = ids[i]
		local ident = Actions.cardIdentity(app, id)
		local row = app.R.Instance.new("Frame")
		row.Name = "ArchiveCard_" .. id
		row.Size = app.R.UDim2.new(1, 0, 0, 194)
		s.nextOrder = (s.nextOrder or 20) + 1
		row.LayoutOrder = s.nextOrder
		row.Parent = s.scroll
		app.M.UiView.paint(app, row, selected == id and "raised" or "surface")
		app.M.UiView.decorate(app, row, 10, true)
		local face = app.M.UiView.buildCardVisual(app, row, "CardFace", true)
		face.shell.Position = app.R.UDim2.new(0, 12, 0, 12)
		face.shell.Size = app.R.UDim2.new(0, 94, 0, 122)
		app.M.UiView.setCardVisual(app, face, id, ident)
		local detail = app.R.Instance.new("TextLabel")
		detail.Name = "CardSummary"
		detail.Text = ident.alias .. "\n" .. string.upper(ident.rarity)
			.. "  •  " .. ident.role
			.. "\nATK " .. tostring(ident.atk or "—")
			.. "   HP " .. tostring(ident.hp or "—")
		detail.TextSize = 14
		detail.TextWrapped = true
		detail.Position = app.R.UDim2.new(0, 116, 0, 12)
		detail.Size = app.R.UDim2.new(1, -128, 0, 72)
		detail.Parent = row
		app.M.UiView.paint(app, detail, "title")
		local inspect = app.M.UiView.addButton(app, s,
			"inspect-" .. id, selected == id and "Selected  /  x"
				.. tostring(app.profile.collection[id]) or "Inspect card  /  x"
				.. tostring(app.profile.collection[id]),
			function() Actions.inspectCardId(app, id) end, "card",
			{ parent = row, size = app.R.UDim2.new(1, -128, 0, 44),
				position = app.R.UDim2.new(0, 116, 0, 88) })
		s.extra[#s.extra + 1] = inspect
		local mark = (app.keepsakeId == id) and " [KEPT]" or ""
		local b = app.M.UiView.addButton(app, s,
			"keep-" .. id, "Keep for a later run: " .. ident.alias .. mark,
			function()
				app.keepsakeId = id
				Actions.setStatus(app, "Keepsake selected: " .. id)
				Actions.renderInventoryExtras(app)
			end, nil, { parent = row,
				size = app.R.UDim2.new(1, -24, 0, 44),
				position = app.R.UDim2.new(0, 12, 0, 140) })
		s.extra[#s.extra + 1] = b
		s.extra[#s.extra + 1] = row
	end
end

-- Deck draft: edits are an explicit UNCOMMITTED copy, never in-place
-- mutations of the confirmed server profile. The draft survives failed
-- saves and reconnect refreshes (never silently dropped); only a committed
-- SetDeck or an explicit Discard clears it.
function Actions.ensureDeckDraft(app)
	if app.profile == nil or type(app.profile.deck) ~= "table" then
		return nil
	end
	if type(app.deckDraft) ~= "table" then
		local copy = {}
		for i = 1, #app.profile.deck do
			copy[i] = app.profile.deck[i]
		end
		app.deckDraft = copy
	end
	return app.deckDraft
end

function Actions.discardDeckDraft(app)
	if app.profile ~= nil and type(app.profile.deck) == "table" then
		local copy = {}
		for i = 1, #app.profile.deck do
			copy[i] = app.profile.deck[i]
		end
		app.deckDraft = copy
	else
		app.deckDraft = nil
	end
	Actions.renderProfile(app)
end

-- Deck add/remove/reorder over owned cards (row-specific, never index-1).
-- All edits target the draft; the confirmed profile.deck is untouched until
-- the server commits SetDeck.
function Actions.renderDeckExtras(app)
	local s = app.screens.deck
	if s == nil or app.profile == nil then
		return
	end
	app.M.UiView.clearExtra(app, s)
	local draft = Actions.ensureDeckDraft(app)
	if draft == nil then
		return
	end
	for i = 1, #draft do
		local id = draft[i]
		local idx = i
		local ident = Actions.cardIdentity(app, id)
		local row = app.R.Instance.new("Frame")
		row.Name = "DeckSlot_" .. idx
		row.Size = app.R.UDim2.new(1, 0, 0, 194)
		s.nextOrder = (s.nextOrder or 20) + 1
		row.LayoutOrder = s.nextOrder
		row.Parent = s.scroll
		app.M.UiView.paint(app, row, "raised")
		app.M.UiView.decorate(app, row, 10, true)
		local face = app.M.UiView.buildCardVisual(app, row, "SlotCard", true)
		face.shell.Position = app.R.UDim2.new(0, 12, 0, 12)
		face.shell.Size = app.R.UDim2.new(0, 94, 0, 122)
		app.M.UiView.setCardVisual(app, face, id, ident)
		local title = app.R.Instance.new("TextLabel")
		title.Name = "SlotLabel_" .. idx
		title.Text = string.format("SLOT %02d  /  %s\n%s  •  %s", idx,
			ident.alias, string.upper(ident.rarity), ident.role)
		title.TextSize = 15
		title.TextWrapped = true
		title.Size = app.R.UDim2.new(1, -128, 0, 64)
		title.Position = app.R.UDim2.new(0, 116, 0, 12)
		title.Parent = row
		pcall(function()
			title.TextXAlignment = app.R.Enum.TextXAlignment.Left
			title.Font = app.R.Enum.Font.GothamBold
		end)
		app.M.UiView.paint(app, title, "title")
		local stats = app.R.Instance.new("TextLabel")
		stats.Name = "SlotStats_" .. idx
		stats.Text = "ATK " .. tostring(ident.atk or "—")
			.. "  HP " .. tostring(ident.hp or "—")
			.. "\n" .. (idx == 1 and "LEADS THE BATTLE" or "RESERVE " .. tostring(idx - 1))
		stats.TextSize = 13
		stats.TextWrapped = true
		stats.Size = app.R.UDim2.new(1, -128, 0, 50)
		stats.Position = app.R.UDim2.new(0, 116, 0, 78)
		stats.Parent = row
		app.M.UiView.paint(app, stats, "muted")
		local function slot(x)
			return { parent = row,
				size = app.R.UDim2.new(0.30, 0, 0, 44),
				position = app.R.UDim2.new(x, 0, 0, 140) }
		end
		local up = app.M.UiView.addButton(app, s,
			"dup-" .. idx, "↑  Up",
			function()
				if idx > 1 then
					draft[idx], draft[idx - 1] = draft[idx - 1], draft[idx]
					Actions.playCue(app, "card_move")
					Actions.renderProfile(app)
				end
			end, nil, slot(0.03))
		local dn = app.M.UiView.addButton(app, s,
			"ddn-" .. idx, "↓  Down",
			function()
				if idx < #draft then
					draft[idx], draft[idx + 1] = draft[idx + 1], draft[idx]
					Actions.playCue(app, "card_move")
					Actions.renderProfile(app)
				end
			end, nil, slot(0.35))
		local rm = app.M.UiView.addButton(app, s,
			"drm-" .. idx, "Remove",
			function()
				table.remove(draft, idx)
				Actions.playCue(app, "card_move")
				Actions.renderProfile(app)
			end, nil, slot(0.67))
		s.extra[#s.extra + 1] = up
		s.extra[#s.extra + 1] = dn
		s.extra[#s.extra + 1] = rm
		s.extra[#s.extra + 1] = row
	end
	local ids = {}
	for id, _ in pairs(app.profile.collection) do
		ids[#ids + 1] = id
	end
	table.sort(ids)
	if #ids > 0 then
		local heading = app.R.Instance.new("TextLabel")
		heading.Name = "AddCardHeading"
		heading.Text = "YOUR CARDS  /  Add a card to an open slot"
		heading.TextSize = 15
		heading.TextWrapped = true
		heading.Size = app.R.UDim2.new(1, 0, 0, 34)
		s.nextOrder = (s.nextOrder or 20) + 1
		heading.LayoutOrder = s.nextOrder
		heading.Parent = s.scroll
		app.M.UiView.paint(app, heading, "eyebrow")
		s.extra[#s.extra + 1] = heading
	end
	for i = 1, #ids do
		local id = ids[i]
		local ident = Actions.cardIdentity(app, id)
		local inDraft = false
		for _, chosen in ipairs(draft) do
			if chosen == id then inDraft = true break end
		end
		local room = #draft < (app.profile.deckMax or 4)
		local row = app.R.Instance.new("Frame")
		row.Name = "DeckCandidate_" .. id
		row.Size = app.R.UDim2.new(1, 0, 0, 140)
		s.nextOrder = (s.nextOrder or 20) + 1
		row.LayoutOrder = s.nextOrder
		row.Parent = s.scroll
		app.M.UiView.paint(app, row, "surface")
		app.M.UiView.decorate(app, row, 10, true)
		local face = app.M.UiView.buildCardVisual(app, row, "CandidateCard", true)
		face.shell.Position = app.R.UDim2.new(0, 12, 0, 10)
		face.shell.Size = app.R.UDim2.new(0, 84, 0, 112)
		app.M.UiView.setCardVisual(app, face, id, ident)
		local detail = app.R.Instance.new("TextLabel")
		detail.Name = "CandidateSummary"
		detail.Text = ident.alias .. "\n" .. string.upper(ident.rarity)
			.. "  •  " .. ident.role
			.. "\nATK " .. tostring(ident.atk or "—")
			.. "   HP " .. tostring(ident.hp or "—")
		detail.TextSize = 13
		detail.TextWrapped = true
		detail.Position = app.R.UDim2.new(0, 106, 0, 8)
		detail.Size = app.R.UDim2.new(1, -118, 0, 78)
		detail.Parent = row
		app.M.UiView.paint(app, detail, "title")
		local b = app.M.UiView.addButton(app, s, "add-" .. id,
			inDraft and "IN YOUR FOUR" or (room and "+  Add to slot" or "DECK FULL"),
			function()
				if #draft >= (app.profile.deckMax or 4) then
					Actions.setStatus(app, "Deck full (max "
						.. tostring(app.profile.deckMax or 4) .. ")")
					return
				end
				for _, d in ipairs(draft) do
					if d == id then
						Actions.setStatus(app, id .. " already in deck")
						return
					end
				end
				draft[#draft + 1] = id
				Actions.playCue(app, "card_move")
				Actions.renderProfile(app)
			end, (inDraft or not room) and "locked" or "card", { parent = row,
				size = app.R.UDim2.new(1, -118, 0, 44),
				position = app.R.UDim2.new(0, 106, 0, 88) })
		pcall(function() b.Active = not inDraft and room end)
		s.extra[#s.extra + 1] = b
		s.extra[#s.extra + 1] = row
	end
	local disc = app.M.UiView.addButton(app, s, "deck-discard",
		"Discard changes", function()
			Actions.discardDeckDraft(app)
			Actions.setStatus(app, "Draft discarded — confirmed deck kept")
		end, nil)
	s.extra[#s.extra + 1] = disc
end

-- Skill choices bounded by EARNED server points (profile.skillPoints),
-- never a hardcoded total; per-node caps from the authoritative Config
-- table (11 nodes, R1 correction).
function Actions.renderSkillExtras(app)
	local s = app.screens.upgrade
	local C = app.M.Config
	if s == nil then
		return
	end
	if C == nil or type(C.SKILL_NODES) ~= "table"
		or #C.SKILL_NODES == 0 then
		s.data.Text = "Training is unavailable because the skill tree could not be loaded. Refresh your saved profile."
		for _, id in ipairs({ "skills-confirm", "rank-claim" }) do
			local button = s.buttons and s.buttons[id]
			if button ~= nil then
				pcall(function() button.Active = false end)
			end
		end
		local refresh = s.buttons and s.buttons["upgrade-refresh"]
		if refresh ~= nil then
			pcall(function() refresh.Active = true end)
		end
		return
	end
	app.M.UiView.clearExtra(app, s)
	local earned = 0
	if app.profile ~= nil and type(app.profile.skillPoints) == "number" then
		earned = app.profile.skillPoints
	end
	local used = 0
	for _, ranks in pairs(app.skillAlloc) do
		used = used + ranks
	end
	for _, node in ipairs(C.SKILL_NODES) do
		local ranks = app.skillAlloc[node.id] or 0
		local b = app.M.UiView.addButton(app, s,
			"skill-" .. node.id, node.id .. " " .. ranks .. "/" .. node.maxRanks,
			function()
				if ranks >= node.maxRanks then
					return
				end
				if used >= earned then
					Actions.setStatus(app, "Skill cap reached: "
						.. tostring(used) .. " earned points spent — "
						.. "clear a boss rank to earn more")
					return
				end
				app.skillAlloc[node.id] = ranks + 1
				Actions.renderSkillExtras(app)
			end, nil)
		s.extra[#s.extra + 1] = b
	end
	s.data.Text = "Points used " .. tostring(used)
		.. " / earned " .. tostring(earned)
		.. (earned == 0 and "\nClaim an eligible first-clear boss rank to earn skill points."
			or "")
end

function Actions.renderBattleStatus(app, st)
	if app.screens.reconnect ~= nil then
		app.screens.reconnect.data.Text = "Pending " .. tostring(st.attemptId)
			.. " on " .. tostring(st.encounterId)
			.. " — Resume replays server events, never re-grants."
	end
end

function Actions.focusNext(app, screenId)
	return app.M.UiView.focusNext(app, screenId)
end

function Actions.onActivated(app, screenId, controlId, action)
	local M = app.M
	Actions.playCue(app, "ui_click")
	if string.sub(action, 1, 5) == "uacg:" then
		Actions.doRemote(app, string.sub(action, 6))
		return
	end
	if action == "tutorial-next" then
		Actions.continueTutorial(app)
		return
	end
	if action == "supporter-refresh" then
		StoreView.refreshSupporter(app)
		return
	end
	if action == "supporter-prompt" then
		local ok, reason = StoreView.promptSupporter(app)
		Actions.setStatus(app, ok and "Roblox purchase prompt opened"
			or reason)
		return
	end
	if string.sub(action, 1, 4) == "nav-" then
		Actions.showScreen(app, string.sub(action, 5))
		return
	end
	if action == "resume-battle" then
		Actions.doResume(app)
		return
	end
	if action == "worlds-next" then
		if screenId == "rewards" and app.battle ~= nil then
			Actions.setStatus(app, "Claim this battle's reward before continuing")
			return
		end
		M.EncounterRoutes.continue(app, Actions)
		return
	end
	if action == "focus-next" then
		M.UiView.focusNext(app, screenId)
		return
	end
	local p = app.store.prefs
	if action == "theme-dark" then
		M.Theme.setMode("Dark"); p.theme = "Dark"; M.UiView.repaintAll(app)
	elseif action == "theme-light" then
		M.Theme.setMode("Light"); p.theme = "Light"; M.UiView.repaintAll(app)
	elseif action == "theme-reset" then
		M.Theme.reset(); p.theme = "Dark"; M.UiView.repaintAll(app)
	elseif action == "accent-set" then
		local ok, err = M.Theme.setAccent(p.accent or "#62E6AD")
		Actions.setStatus(app, ok and "Accent set" or err)
		if ok then M.UiView.repaintAll(app) end
	elseif action == "motion-toggle" then
		p.reducedMotion = not p.reducedMotion
		if app.battle ~= nil then
			app.battle.timeline.reducedMotion = p.reducedMotion
		end
		Actions.renderSettings(app)
		Actions.setStatus(app, "Reduced motion "
			.. (p.reducedMotion and "on" or "off")
			.. " — save settings to keep this choice")
	elseif action == "flash-toggle" then
		p.reducedFlash = not p.reducedFlash
		if app.battle ~= nil then
			app.battle.timeline.reducedFlash = p.reducedFlash
		end
		Actions.renderSettings(app)
		Actions.setStatus(app, "Reduced flash "
			.. (p.reducedFlash and "on" or "off")
			.. " — save settings to keep this choice")
	elseif action == "speed-set" then
		p.speed = (p.speed == 1) and 2 or (p.speed == 2) and 4 or 1
		if app.battle ~= nil then
			M.Timeline.setSpeed(app.battle.timeline, p.speed)
		end
		Actions.renderSettings(app)
		Actions.setStatus(app, "Battle speed " .. tostring(p.speed) .. "x")
	elseif action == "timeline-pause" then
		if app.battle == nil then
			Actions.setStatus(app, "No active battle to pause or resume")
		elseif app.battle.timeline.paused then
			M.Timeline.resume(app.battle.timeline)
			Actions.setPauseLabel(app, false)
			Actions.setStatus(app, "Battle resumed")
		else
			M.Timeline.pause(app.battle.timeline)
			if M.AudioEngine ~= nil then M.AudioEngine.cancelEffects(app) end
			Actions.setPauseLabel(app, true)
			Actions.setStatus(app, "Battle paused")
		end
	elseif action == "timeline-speed" then
		p.speed = (p.speed == 1) and 2 or (p.speed == 2) and 4 or 1
		if app.battle ~= nil then
			M.Timeline.setSpeed(app.battle.timeline, p.speed)
		end
		Actions.renderSettings(app)
		Actions.setStatus(app, "Speed " .. tostring(p.speed) .. "x")
	elseif action == "timeline-skip" then
		if app.battle ~= nil then
			M.Timeline.skip(app.battle.timeline, nil)
			app.Presenter.settleBattle(app)
		end
	elseif action == "deck-move-up" or action == "deck-move-down" then
		Actions.setStatus(app,
			"Use the per-row Up / Down buttons on this deck")
	elseif action == "show-odds" then
		local roll = app.screens.roll
		if roll ~= nil and roll.odds ~= nil then
			roll.odds.Visible = not roll.odds.Visible
		end
		Actions.renderOddsLine(app)
	elseif action == "inspect" then
		Actions.inspectCard(app)
	elseif action == "rebirth-keepsake" then
		Actions.setStatus(app,
			"Pick a Keepsake button in Inventory, then Refresh preview")
	elseif string.sub(action, 1, 4) == "vol-" then
		local ch = string.sub(action, 5)
		local key = ch .. "Volume"
		local cur = p[key] or 70
		local nv = (cur + 10) % 110
		if nv > 100 then
			nv = 0
		end
		M.State.setPref(app.store, key, nv)
		if app.audio ~= nil then
			if M.AudioEngine ~= nil then M.AudioEngine.syncVolumes(app)
			else M.Audio.setVolume(app.audio, ch, p[key]) end
		end
		Actions.renderSettings(app)
		Actions.setStatus(app, ch .. " volume " .. tostring(p[key]))
	end
end

function Actions.showOdds(app)
	local roll = app.screens.roll
	if roll ~= nil and roll.odds ~= nil then
		roll.odds.Visible = true
	end
	Actions.renderOddsLine(app)
end

function Actions.inspectCard(app)
	local p = app.profile
	if p == nil then
		Actions.setStatus(app, "Load profile first")
		return
	end
	local first = p.deck[1]
	if first == nil then
		for id, _ in pairs(p.collection) do
			first = id
			break
		end
	end
	if first ~= nil then Actions.inspectCardId(app, first) end
end

function Actions.inspectCardId(app, id)
	local p = app.profile
	local s = app.screens.inventory
	if p == nil or s == nil or type(p.collection) ~= "table"
		or p.collection[id] == nil then
		Actions.setStatus(app, "That card is not in your confirmed collection")
		return
	end
	local ident = Actions.cardIdentity(app, id)
	app.inspectCardId = id
	app.M.UiView.setCardVisual(app, s.featuredFace, id, ident)
	local marks = {}
	for _, discovered in ipairs(p.catalogue or {}) do
		if discovered == id then marks[#marks + 1] = "DISCOVERED" end
	end
	if p.retained ~= nil and p.retained.keepsakeId == id then
		marks[#marks + 1] = "KEEPSAKE"
	end
	s.data.Text = "CARD FILE  /  " .. ident.alias
		.. "\n" .. ident.canonical
		.. "\n" .. string.upper(ident.rarity) .. "  •  "
		.. string.upper(ident.role)
		.. "  •  owned x" .. tostring(p.collection[id])
		.. "\nATK " .. tostring(ident.atk or "—")
		.. "  /  HP " .. tostring(ident.hp or "—")
		.. "  /  DEF " .. tostring(ident.def or "—")
		.. "  /  SPD " .. tostring(ident.speed or "—")
		.. (#marks > 0 and ("\n" .. table.concat(marks, "  •  ")) or "")
		.. "\n\nTap another card below to compare it."
	Actions.renderInventoryExtras(app)
	Actions.setStatus(app, ident.alias .. " card file open")
end

function Actions.buyEarnedPack(app, tries, recoveryOverride)
	local M = app.M
	if app.profile == nil and not Actions.refreshProfile(app) then
		return
	end
	local pending = recoveryOverride or app.store.pendingStorePurchase
	if pending == nil then
		local saved = app.profile and app.profile.storeRecovery or nil
		local savedKey = StoreView.purchaseKey(saved)
		if savedKey ~= nil and savedKey ~= app.store.storeRecoveryResolvedKey then
			pending = saved
		end
	end
	local requestId, identity
	if pending ~= nil then
		requestId = pending.requestId
		identity = { epoch = pending.epoch, seq = pending.seq }
	else
		requestId, identity = M.State.claimIdentity(app.store, "BuyEarnedPack")
	end
	local key = StoreView.identityKey(requestId, identity)
	if key == nil then
		Actions.setStatus(app, "Store purchase identity unavailable; refresh before retrying.")
		return
	end
	app.store.storeRecoveryHandledKey = key
	app.store.pendingStorePurchase = {
		requestId = requestId, epoch = identity.epoch, seq = identity.seq,
	}
	StoreView.render(app)
	local response = Actions.call(app, "BuyEarnedPack", {}, requestId, identity)
	if response == nil then
		Actions.setStatus(app,
			"Purchase confirmation pending — retry this same Field Pack request.")
		return
	end
	local interpretation = M.ClientProtocol.interpret(response)
	if interpretation.ui == "confirming" and (tries or 0) < Actions.PENDING_RETRIES then
		response = Actions.call(app, "BuyEarnedPack", {}, requestId, identity)
		interpretation = M.ClientProtocol.interpret(response)
	end
	if interpretation.ui == "apply" then
		app.store.storeRecoveryResolvedKey = key
		app.store.pendingStorePurchase = nil
		Actions.onCommitted(app, "BuyEarnedPack", response.result)
	elseif interpretation.ui == "rejected"
		or interpretation.ui == "stale-refetch" then
		local detail = tostring(interpretation.detail or "")
		local mustRefresh = interpretation.ui == "stale-refetch"
			or string.find(detail, "pending Store", 1, true) ~= nil
		if mustRefresh then
			Actions.refreshProfile(app)
		end
		if StoreView.purchaseKey(
			app.profile and app.profile.storeRecovery or nil) ~= key then
			app.store.pendingStorePurchase = nil
		end
		Actions.setStatus(app, detail ~= "" and detail or interpretation.ui)
		StoreView.render(app)
	else
		Actions.setStatus(app,
			"Purchase confirmation pending — retry the same identity before another pack.")
	end
end

function Actions.doRemote(app, spec, tries)
	local M = app.M
	tries = tries or 0
	local cmd, arg = string.match(spec, "^([A-Za-z+]+):?(.*)$")
	if cmd == "GetProfile+BattleStatus" then
		Actions.refreshProfile(app)
		return
	end
	local params = {}
	if cmd == "SetAutoRoll" then
		params = { enabled = not app.store.prefs.autoRoll }
	elseif cmd == "SetDeck" then
		-- Commit the explicit draft copy; the confirmed profile.deck is
		-- never sent mutated in place. An empty draft falls back to the
		-- first owned ids (same rule as before, but on a copy).
		local draft = Actions.ensureDeckDraft(app) or {}
		local deck = {}
		for i = 1, #draft do
			deck[i] = draft[i]
		end
		if #deck == 0 and app.profile ~= nil then
			local ids = {}
			for id, _ in pairs(app.profile.collection) do
				ids[#ids + 1] = id
			end
			table.sort(ids)
			for i = 1, math.min(4, #ids) do
				deck[#deck + 1] = ids[i]
			end
			app.deckDraft = deck
		end
		params = { deck = deck }
	elseif cmd == "SetSkills" then
		params = { alloc = app.skillAlloc }
	elseif cmd == "BattleStart" then
		local encounterId = (arg ~= "" and arg ~= "selected" and arg)
			or app.selectedEncounterId
		if not M.ClientProtocol.ENCOUNTERS[encounterId] then
			Actions.setStatus(app, "Choose an available encounter first")
			return
		end
		local route = M.EncounterRoutes.find(app, encounterId)
		if route == nil or not route.unlocked then
			Actions.setStatus(app, "That encounter is still locked")
			return
		end
		if app.profile.pendingBattle or app.profile.pendingReward then
			Actions.setStatus(app, "Resume or claim the pending battle first")
			return
		end
		M.EncounterRoutes.select(app, route.id)
		params = { encounterId = encounterId }
	elseif cmd == "BattleClaim" then
		if app.battle == nil or app.battle.attemptId == nil then
			Actions.setStatus(app, "No battle to claim")
			return
		end
		if not app.battle.settled then
			Actions.setStatus(app, "Watch or skip to the result before claiming")
			return
		end
		params = { attemptId = app.battle.attemptId }
	elseif cmd == "RebirthPreview" then
		params = {}
		if app.keepsakeId ~= nil then
			params.keepsakeId = app.keepsakeId
		end
	elseif cmd == "RebirthConfirm" then
		if app.pendingPreviewToken == nil then
			Actions.setStatus(app, "Refresh preview first")
			return
		end
		params = { token = app.pendingPreviewToken }
	elseif cmd == "SaveSettings" then
		params = { settings = M.State.toServerSettings(app.store.prefs) }
	end
	if cmd == "BuyEarnedPack" then
		Actions.buyEarnedPack(app, tries)
		return
	end
	local reqId, idem = nil, nil
	if not M.ClientProtocol.READ_ONLY[cmd] then
		reqId, idem = M.State.claimIdentity(app.store, cmd)
	end
	local resp = Actions.call(app, cmd, params, reqId, idem)
	if resp == nil then
		return
	end
	local inter = M.ClientProtocol.interpret(resp)
	if inter.ui == "apply" then
		Actions.onCommitted(app, cmd, resp.result)
	elseif inter.ui == "confirming" then
		-- Pending: retry the SAME request identity (never a fresh id).
		if tries < Actions.PENDING_RETRIES then
			local resp2 = Actions.call(app, cmd, params, reqId, idem)
			if resp2 == nil then
				Actions.setStatus(app, "Confirming…")
			else
				local retryInter = M.ClientProtocol.interpret(resp2)
				if retryInter.ui == "apply" then
					Actions.onCommitted(app, cmd, resp2.result)
				elseif retryInter.ui == "confirming" then
					Actions.setStatus(app, retryInter.detail or "Confirming…")
				elseif retryInter.ui == "stale-refetch" then
					Actions.refreshProfile(app)
					Actions.setStatus(app,
						"Session moved — refreshed, retry as a fresh attempt")
				else
					Actions.setStatus(app,
						retryInter.detail or retryInter.ui)
				end
			end
		else
			Actions.setStatus(app, "Confirming…")
		end
	elseif inter.ui == "stale-refetch" then
		-- Stale: drop the preview token, refetch fresh server state.
		app.pendingPreviewToken = nil
		Actions.refreshProfile(app)
		Actions.setStatus(app,
			"Stale preview rejected — refreshed, review before confirming")
	else
		local detail = inter.detail or inter.ui
		-- Old-epoch rejection: the session moved — adopt it via refetch,
		-- then retry as a FRESH attempt (never a blind same-id loop).
		-- The deck draft (if any) is preserved across all of these paths.
		if string.find(detail, "stale epoch", 1, true) ~= nil
			or string.find(detail, "unknown epoch", 1, true) then
			Actions.refreshProfile(app)
			Actions.setStatus(app,
				"Session moved — refreshed, retry as a fresh attempt")
		else
			if cmd == "SetDeck" then
				Actions.setStatus(app, detail
					.. " — draft kept (uncommitted)")
			else
				Actions.setStatus(app, detail)
			end
		end
	end
end

function Actions.doResume(app)
	local M = app.M
	local resp = Actions.call(app, "BattleStatus", {}, nil)
	if resp == nil then
		return
	end
	if M.ClientProtocol.interpret(resp).ui ~= "apply"
		or not resp.result.pending then
		Actions.setStatus(app, "No pending battle")
		return
	end
	local route = M.EncounterRoutes.select(app, resp.result.encounterId)
	if route == nil or not M.EncounterRoutes.installWorld(app,
		route.worldId, Actions) then
		Actions.setStatus(app, "Pending battle route is unavailable")
		return
	end
	Actions.setPauseLabel(app, false)
	app.Presenter.beginBattle(app, resp.result)
end

function Actions.onCommitted(app, cmd, result)
	local M = app.M
	if cmd == "RollOnce" then
		app.lastRoll = {
			editionId = result.editionId,
			rarity = result.rarity,
		}
		Actions.refreshProfile(app)
		Actions.renderRollReveal(app)
		M.UiView.pulseCard(app, app.screens.roll and app.screens.roll.rollFace)
		local ident = Actions.cardIdentity(app, result.editionId)
		Actions.setStatus(app, "Confirmed: " .. ident.alias .. " ("
			.. tostring(result.rarity) .. ") is in your cards.")
	elseif cmd == "BattleStart" then
		local route = M.EncounterRoutes.select(app, app.selectedEncounterId)
		if route == nil or not M.EncounterRoutes.installWorld(app,
			route.worldId, Actions) then
			Actions.setStatus(app, "Selected battle world is unavailable")
			return
		end
		Actions.setPauseLabel(app, false)
		app.Presenter.beginBattle(app, result)
	elseif cmd == "BattleClaim" then
		app.lastRewardData = result
		local xp = result.xp ~= nil and ("+" .. tostring(result.xp)) or "not reported"
		local coins = result.currency ~= nil
			and ("+" .. tostring(result.currency)) or "not reported"
		local summary = "Server-confirmed reward: " .. xp
			.. " XP / " .. coins
			.. " currency. Continue to the next unlocked route."
		if result.legacyGranted ~= nil then
			summary = summary .. " Story Legacy earned: "
				.. Actions.cardIdentity(app, result.legacyGranted).alias
				.. "; it will be retained at rebirth."
		end
		Actions.setStatus(app, summary)
		app.lastReward = summary
		if app.screens.rewards ~= nil then
			app.screens.rewards.data.Text = summary
		end
		Actions.setPauseLabel(app, false)
		app.Presenter.teardownBattle(app, false)
		Actions.refreshProfile(app)
		M.UiView.renderRewardPanel(app, "claimed", app.lastBattleWinner, result)
		Actions.setStatus(app, summary)
		local rewards = app.screens.rewards
		if rewards ~= nil then
			local claim = rewards.buttons["reward-claim"]
			local continue = rewards.buttons["reward-next"]
			if claim ~= nil then
				claim.Text = "Reward claimed"
				pcall(function() claim.Active = false end)
				app.M.UiView.paint(app, claim, "locked")
				rewards.buttonRoles["reward-claim"] = "locked"
			end
			if continue ~= nil then
				pcall(function() continue.Active = true end)
				app.M.UiView.paint(app, continue, "action")
				rewards.buttonRoles["reward-next"] = "action"
			end
		end
		Actions.showScreen(app, "rewards")
	elseif cmd == "BuyEarnedPack" then
		if type(result) == "table" and type(result.editionId) == "string" then
			local card = Actions.cardIdentity(app, result.editionId)
			Actions.setStatus(app, "Pack confirmed: " .. card.alias .. " ("
				.. tostring(result.rarity) .. ").")
		else
			Actions.setStatus(app,
				"Pack already committed; refreshing the saved balance and inventory.")
		end
		Actions.refreshProfile(app)
		Actions.showScreen(app, "store")
	elseif cmd == "RebirthPreview" then
		app.pendingPreviewToken = result.token
		Actions.renderRebirthPreview(app, result)
	elseif cmd == "RebirthConfirm" then
		app.pendingPreviewToken = nil
		Actions.refreshProfile(app)
		Actions.showScreen(app, "tutorial")
	elseif cmd == "RebirthCancel" then
		app.pendingPreviewToken = nil
		Actions.refreshProfile(app)
	elseif cmd == "SaveSettings" then
		M.State.applyServerSettings(app.store, result.settings)
		if M.AudioEngine ~= nil then M.AudioEngine.syncVolumes(app) end
		Actions.setStatus(app, "Settings saved")
	elseif cmd == "TutorialGrant" then
		Actions.refreshProfile(app)
		Actions.showScreen(app, "roll")
	elseif cmd == "SetDeck" then
		-- Committed: server truth wins — clear the draft so the confirmed
		-- deck renders, then refetch.
		local firstDeck = app.profile ~= nil and type(app.profile.deck) == "table"
			and #app.profile.deck == 0
		app.deckDraft = nil
		Actions.setStatus(app, "Deck saved — confirmed")
		local refreshed = Actions.refreshProfile(app)
		if firstDeck and refreshed and app.profile.pendingBattle == nil
			and app.profile.pendingReward == nil then
			Actions.showScreen(app, "worlds")
			Actions.setStatus(app,
				"Your four are ready. Enter the first available duel.")
		end
	elseif cmd == "ClaimAway" then
		Actions.refreshProfile(app)
		local amount = type(result) == "table" and result.runXp or nil
		Actions.setStatus(app, type(amount) == "number"
			and ("Away reward claimed: +" .. tostring(amount) .. " Run XP.")
			or "Away claim confirmed; profile refreshed.")
	else
		Actions.refreshProfile(app)
	end
	-- NOTE: refreshProfile never clears app.deckDraft on failure paths:
	-- a Rejected/Unavailable/Stale SetDeck keeps the draft (callers show
	-- "draft kept"), and reconnect refetches confirmed state alongside it.
end

-- One kept/granted/lost row: accepts the R1 row shape {id,why,copies} and
-- the legacy plain-string shape.
function Actions.previewId(row)
	if type(row) == "table" then
		return tostring(row.id), row.why, row.copies
	end
	return tostring(row), nil, nil
end

-- Exact atomic preview body: every R1 RebirthPreview field, server truth.
-- Kept/granted/lost carry identities (never bare counts); resets, rank,
-- currencies, pity, revision/run/token all render.
function Actions.renderRebirthPreview(app, r)
	local s = app.screens.rebirth
	if s == nil then
		return
	end
	local lines = { "Preview " .. tostring(r.token) }
	if r.revision ~= nil then
		lines[#lines + 1] = "Revision " .. tostring(r.revision)
	end
	if r.runId ~= nil or r.runNumber ~= nil then
		lines[#lines + 1] = "Run " .. tostring(r.runId)
			.. " (#" .. tostring(r.runNumber) .. ")"
	end
	if r.keepsakeId ~= nil then
		lines[#lines + 1] = "Keepsake choice: " .. tostring(r.keepsakeId)
	end
	if r.replacesKeepsakeId ~= nil then
		lines[#lines + 1] = "Replaces keepsake: "
			.. tostring(r.replacesKeepsakeId)
	end
	local kept = {}
	for _, row in ipairs(r.kept or {}) do
		local id, why, copies = Actions.previewId(row)
		kept[#kept + 1] = id .. " (" .. tostring(why)
			.. " x" .. tostring(copies or 1) .. ")"
	end
	lines[#lines + 1] = "Kept: " .. table.concat(kept, ", ")
	local granted = {}
	for _, row in ipairs(r.granted or {}) do
		local id, why = Actions.previewId(row)
		granted[#granted + 1] = id .. " (" .. tostring(why) .. ")"
	end
	if #granted > 0 then
		lines[#lines + 1] = "Granted starters: "
			.. table.concat(granted, ", ")
	end
	for _, l in ipairs(r.lost or {}) do
		local id, _, copies = Actions.previewId(l)
		local locked = nil
		if type(l) == "table" then
			locked = l.locked
		end
		lines[#lines + 1] = "Lose " .. tostring(id) .. " x"
			.. tostring(copies or 1)
			.. (locked and " (LOCKED)" or "")
	end
	local lr = {}
	for _, id in ipairs(r.lockedReset or {}) do
		lr[#lr + 1] = tostring(id)
	end
	lines[#lines + 1] = "Locked reset: " .. table.concat(lr, ", ")
	if type(r.resets) == "table" and #r.resets > 0 then
		lines[#lines + 1] = "Resets: " .. table.concat(r.resets, ", ")
	else
		lines[#lines + 1] = "Levels/ascensions/currency/stages/deck reset; starters regranted"
	end
	local lostCur, keptCur = r.currencyLost, nil
	if type(r.currencies) == "table" then
		lostCur, keptCur = r.currencies.lost, r.currencies.kept
	end
	lines[#lines + 1] = "Currency lost " .. tostring(lostCur)
		.. " / kept " .. tostring(keptCur)
		.. " / pity kept " .. tostring(r.pityFailsKept)
		.. " / rank reward " .. tostring(r.pendingRankReward)
		.. " / next run " .. tostring(r.nextRunId)
	if type(r.rank) == "table" then
		lines[#lines + 1] = "Rank pending " .. tostring(r.rank.pending)
			.. " / skill points " .. tostring(r.rank.skillPoints)
			.. " / claimed " .. tostring(r.rank.claimedCount)
	end
	s.data.Text = table.concat(lines, "\n")
end

return Actions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">App</string>
            <string name="Source"><![CDATA[-- App.luau — thin application shell (R2 repair round 3).
-- Owns ONLY: construction (App.new), boot wiring (App.boot), and teardown
-- (App.destroy). Rendering lives in UiView, transport/preparation in
-- Actions, battle presentation in BattlePresenter — callers use those owner
-- modules directly (no facade forwards here; Boot/tests were migrated).

local App = {}

App.VERSION = "r2-repair-3"

function App.new(deps)
	deps = deps or {}
	local mods = deps.mods or {}
	local app = {
		M = mods,
		UiView = mods.UiView,
		Actions = mods.Actions,
		Presenter = mods.BattlePresenter,
		R = deps.R,
		transport = deps.transport,
		supporterTransport = deps.supporterTransport,
		supporterPrompt = deps.supporterPrompt,
		supporterProductInfo = deps.supporterProductInfo,
		supporterOffer = nil,
		supporterStatus = nil,
		stepper = deps.stepper,
		store = deps.store,
		audio = deps.audio,
		playerGui = nil,
		workspace = nil,
		screens = {},
		paintLog = {},
		current = nil,
		statusLine = nil,
		hud = nil,
		stage = nil,
		camera = nil,
		prevCamera = nil,
		battle = nil,
		profile = nil,
		selectedEncounterId = "enc-1",
		selectedWorldId = "WORLD-01",
		world = nil,
		worldId = nil,
		stepConn = nil,
		keepsakeId = nil,
		skillAlloc = {},
		pendingPreviewToken = nil,
		deckDraft = nil,
		focus = nil,
	}
	if app.store == nil and mods.State ~= nil then
		app.store = mods.State.new()
	end
	if app.audio == nil and mods.Audio ~= nil then
		local p = app.store and app.store.prefs or nil
		app.audio = mods.Audio.new(p and {
			music = p.musicVolume, sfx = p.sfxVolume,
			ui = p.uiVolume, ambience = p.ambienceVolume,
		} or nil)
	end
	return app
end

function App.boot(app, playerGui, workspaceObj)
	local M = app.M
	app.playerGui = playerGui
	app.workspace = workspaceObj
	if M.World ~= nil then
		app.world, app.worldBuildError = M.World.build(workspaceObj, {
			worldId = app.selectedWorldId,
			reducedMotion = app.store.prefs.reducedMotion,
		}, app.R)
		app.worldId = app.world and app.selectedWorldId or nil
	end
	app.stage = { folder = app.R.Instance.new("Folder") }
	app.stage.folder.Name = "BattleStage"
	app.stage.folder.Parent = workspaceObj
	M.UiView.buildHUD(app, playerGui)
	for _, desc in ipairs(M.Screens.screens()) do
		local s = M.UiView.buildScreen(app, desc)
		s.gui.Parent = playerGui
		app.screens[desc.id] = s
	end
	M.UiView.show(app, "tutorial")
	if M.Actions.renderSettings ~= nil then
		M.Actions.renderSettings(app)
	end
	M.Actions.refreshProfile(app)
	return true
end

-- Lifecycle teardown (real orchestration, not a forward): cancel the battle
-- token, disconnect the stepper, destroy the battle folder, restore the
-- camera, cancel pooled audio, destroy screens + HUD, clear focus.
function App.destroy(app)
	local M = app.M
	app.playerGui = nil
	if app.purchaseFinishedConn ~= nil then
		app.purchaseFinishedConn:Disconnect()
		app.purchaseFinishedConn = nil
	end
	if app.battle ~= nil and app.battle.token ~= nil
		and M.Timeline ~= nil then
		M.Timeline.cancel(app.battle.token)
	end
	if M.BattlePresenter ~= nil then
		M.BattlePresenter.teardownBattle(app, false)
	else
		app.battle = nil
	end
	if app.audio ~= nil and M.Audio ~= nil then
		M.Audio.cancel(app.audio)
	end
	if app.world ~= nil then
		app.world:Destroy()
		app.world = nil
		app.worldId = nil
	end
	for _, s in pairs(app.screens) do
		if s.gui ~= nil then
			s.gui:Destroy()
		end
	end
	app.focus = nil
	if app.hud ~= nil and app.hud.gui ~= nil then
		app.hud.gui:Destroy()
	end
end

return App
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[-- Audio.luau — audio control seams + real local resolution (session8-A).
-- ACE-Step / Stable Audio instruction arrived mid-milestone with NO generated
-- files, NO reference model/license/output proof. This module therefore
-- implements ONLY the tested state machine the future contact cue will bind:
-- Music/SFX/UI/Ambience volume controls (0..100 persisted via State prefs),
-- a pooled/limited virtual SFX voice pool (max 4, priority + variation +
-- overlap accounting), cancellation, and battle-speed timing scaling.
-- Asset IDs are null/unresolved BY DESIGN: resolveAsset() always returns
-- nil + "unresolved", playable() is always false, and status() honestly
-- reports "Sound unavailable". No fake beeps, no synthesized audio, no
-- copyrighted material, no verification claims. The contact cue event
-- (Timeline contact beat) will call Audio.contactCue() once real SFX bind.

local Audio = {}

Audio.RULES_VERSION = "provisional-1"
Audio.POOL_MAX = 4
Audio.CHANNELS = { "music", "sfx", "ui", "ambience" }
Audio.DEFAULTS = { music = 80, sfx = 80, ui = 100, ambience = 60 }
Audio.CUE_PRIORITIES = {
	contact_normal = 3, contact_light = 3, contact_heavy = 3,
	contact_critical = 3, card_move = 2, ui_click = 1,
}

function Audio.cuePriority(purpose)
	return Audio.CUE_PRIORITIES[purpose] or 1
end

function Audio.new(overrides)
	local vols = {}
	for _, ch in ipairs(Audio.CHANNELS) do
		vols[ch] = Audio.DEFAULTS[ch]
	end
	if type(overrides) == "table" then
		for _, ch in ipairs(Audio.CHANNELS) do
			if overrides[ch] ~= nil then
				local ok = Audio.checkVolume(overrides[ch])
				if ok then
					vols[ch] = overrides[ch]
				end
			end
		end
	end
	return {
		volumes = vols,
		voices = {},
		seq = 0,
		cancelled = false,
		manifest = nil, -- approved asset manifest: nil until bound
	}
end

function Audio.checkVolume(v)
	return type(v) == "number" and v == math.floor(v) and v >= 0 and v <= 100
end

function Audio.setVolume(st, channel, v)
	local known = false
	for _, ch in ipairs(Audio.CHANNELS) do
		if ch == channel then
			known = true
		end
	end
	if not known then
		return false, "unknown channel"
	end
	if not Audio.checkVolume(v) then
		return false, "volume must be an integer 0..100"
	end
	st.volumes[channel] = v
	return true, nil
end

function Audio.status(st)
	if Audio.playable(st) then
		return "Sound on"
	end
	return "Sound unavailable — current asset commercial-model licence UNVERIFIED; Roblox IDs pending"
end

function Audio.playable(st)
	if st == nil or st.manifest == nil then
		return false
	end
	-- Honest silence: bound manifests with only null (pending) Roblox IDs
	-- are NOT playable — nothing audible is claimed.
	for i = 1, #st.manifest.assets do
		local id = st.manifest.assets[i].roblox_id
		if type(id) == "string" and id ~= "" then
			return true
		end
	end
	return false
end

-- Asset resolution (session8-A): real lookup against the bound manifest.
-- Returns the matching asset entry (purpose/local_file/variants/duration/
-- loop/roblox_id) when the cue is bound, else nil + "unresolved". Entries
-- with null Roblox IDs resolve to LOCAL-ONLY candidates: the game knows
-- exactly which file each cue maps to, but pooledSound still stays silent
-- until a real uploaded ID binds (playable()/status() unchanged).
function Audio.resolveAsset(st, cueId)
	if st == nil or st.manifest == nil then
		return nil, "unresolved"
	end
	if type(cueId) ~= "string" or cueId == "" then
		return nil, "unresolved"
	end
	if type(st.manifest.assets) ~= "table" then
		return nil, "unresolved"
	end
	for i = 1, #st.manifest.assets do
		local a = st.manifest.assets[i]
		if type(a) == "table" and a.purpose == cueId then
			return a, nil
		end
	end
	return nil, "unresolved"
end

-- Local file for a cue (pure path mapping, no engine call): nil when the
-- cue is unbound. Lets the Roblox-only binder know which finished file
-- each cue maps to without inventing an asset id.
function Audio.localFileFor(st, cueId)
	local entry, err = Audio.resolveAsset(st, cueId)
	if entry == nil then
		return nil, err or "unresolved"
	end
	if type(entry.local_file) == "string" and entry.local_file ~= "" then
		return entry.local_file, nil
	end
	return nil, "unresolved"
end

-- Usable Roblox SoundId for an entry: "rbxassetid://<id>" when a real
-- uploaded ID is bound, else nil + "local-only (no Roblox ID)". Never
-- invents an id for a null entry.
function Audio.soundIdFor(entry)
	if type(entry) ~= "table" then
		return nil, "unresolved"
	end
	local id = entry.roblox_id
	if type(id) == "string" and id ~= "" then
		if string.find(id, "rbxasset", 1, true) == 1 then
			return id, nil
		end
		return "rbxassetid://" .. id, nil
	end
	return nil, "local-only (no Roblox ID)"
end

-- True when the bound manifest carries >=1 entry with a real local file +
-- variant (Studio load-testable), independent of Roblox-ID playability.
function Audio.localBindable(st)
	if st == nil or st.manifest == nil then
		return false
	end
	if type(st.manifest.assets) ~= "table" then
		return false
	end
	for i = 1, #st.manifest.assets do
		local a = st.manifest.assets[i]
		if type(a) == "table"
			and type(a.local_file) == "string" and a.local_file ~= ""
			and type(a.variants) == "table" and #a.variants >= 1 then
			return true
		end
	end
	return false
end

-- Contact-beat marker only; AudioEngine plays nothing without a real ID.
function Audio.contactCue(st, opts)
	opts = opts or {}
	if st.cancelled then
		return nil, "cancelled"
	end
	st.seq = st.seq + 1
	local entry = Audio.resolveAsset(st, "contact_normal")
	local variants = entry ~= nil and type(entry.variants) == "table"
		and #entry.variants or 1
	local voice = {
		id = st.seq,
		slot = "contact",
		purpose = "contact_normal",
		priority = Audio.cuePriority("contact_normal"),
		variant = ((st.seq - 1) % math.max(1, variants)) + 1,
		age = 0,
		-- Battle-speed timing: virtual duration compresses with speed.
		dur = 0.30 / (opts.speed or 1),
		channel = "sfx",
	}
	Audio.emit(st, voice)
	return voice, nil
end

-- Pooled/limited playback accounting: at most POOL_MAX concurrent virtual
-- voices; when full, the oldest lowest-priority voice is dropped (overlap
-- bookkeeping only — nothing audible).
function Audio.emit(st, voice)
	st.voices[#st.voices + 1] = voice
	while #st.voices > Audio.POOL_MAX do
		local drop = 1
		for i = 2, #st.voices do
			local a, b = st.voices[i], st.voices[drop]
			if a.priority < b.priority
				or (a.priority == b.priority and a.id < b.id) then
				drop = i
			end
		end
		table.remove(st.voices, drop)
	end
	return voice
end

-- Advance virtual voice ages (scaled by dt as given; caller passes
-- speed-scaled dt). Expired voices leave the pool.
function Audio.tick(st, dt)
	if dt == nil or dt < 0 then
		return false, "bad dt"
	end
	local keep = {}
	for i = 1, #st.voices do
		local v = st.voices[i]
		v.age = v.age + dt
		if v.age < v.dur then
			keep[#keep + 1] = v
		end
	end
	st.voices = keep
	return true, nil
end

function Audio.cancel(st)
	st.cancelled = true
	st.voices = {}
end

function Audio.resume(st)
	st.cancelled = false
end

function Audio.voiceCount(st)
	return #st.voices
end

-- Approved-asset manifest binding (audio.md / B-18 shape): every entry
-- carries purpose, model + model_version, settings, local file, duration,
-- loop flag, variant list, and a Roblox ID that stays null until real
-- approval/permission. Binding validates STRUCTURE only — null ids keep the
-- seam honestly silent. Planned entries (model/version containing
-- "planned"/"pending", or empty variants) are REJECTED, never bound as
-- approved; no IDs are invented here.
function Audio.bindManifest(st, manifest)
	if type(manifest) ~= "table" or type(manifest.assets) ~= "table" then
		return false, "manifest needs assets[]"
	end
	if manifest.version ~= nil and type(manifest.version) ~= "string" then
		return false, "manifest version must be a string"
	end
	for i = 1, #manifest.assets do
		local a = manifest.assets[i]
		if type(a) ~= "table" or type(a.purpose) ~= "string"
			or type(a.model) ~= "string" or a.model == ""
			or type(a.model_version) ~= "string" or a.model_version == ""
			or type(a.settings) ~= "table"
			or type(a.local_file) ~= "string" or a.local_file == ""
			or type(a.duration_s) ~= "number"
			or type(a.loop) ~= "boolean"
			or type(a.variants) ~= "table" then
			return false, "asset[" .. i .. "] missing manifest fields"
		end
		local lowModel = string.lower(a.model .. " " .. a.model_version)
		if string.find(lowModel, "planned", 1, true) ~= nil
			or string.find(lowModel, "pending", 1, true) ~= nil then
			return false, "asset[" .. i .. "] is planned, not approved"
		end
		if #a.variants < 1 then
			return false, "asset[" .. i .. "] needs >=1 variant file"
		end
		if a.roblox_id ~= nil and type(a.roblox_id) ~= "string" then
			return false, "asset[" .. i .. "] roblox_id must be null or string"
		end
	end
	st.manifest = manifest
	return true, nil
end

-- Real pooled playback: resolves ONLY through a bound manifest entry with
-- a REAL (non-null) approved Roblox ID. Until then returns nil +
-- "unresolved" — the game stays honestly silent, never a fake beep.
function Audio.pooledSound(st, cueId, opts)
	opts = opts or {}
	if st.cancelled then
		return nil, "cancelled"
	end
	local entry = nil
	if st.manifest ~= nil then
		for i = 1, #st.manifest.assets do
			if st.manifest.assets[i].purpose == cueId then
				entry = st.manifest.assets[i]
			end
		end
	end
	if entry == nil or type(entry.roblox_id) ~= "string"
		or entry.roblox_id == "" then
		return nil, "unresolved"
	end
	st.seq = st.seq + 1
	local voice = {
		id = st.seq,
		slot = tostring(cueId),
		priority = Audio.cuePriority(cueId),
		variant = ((st.seq - 1)
			% math.max(1, #entry.variants)) + 1,
		age = 0,
		dur = (entry.duration_s or 0.30) / (opts.speed or 1),
		channel = entry.channel or "sfx",
		asset = entry.roblox_id,
	}
	Audio.emit(st, voice)
	return voice, nil
end

return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">AudioCatalog</string>
            <string name="Source"><![CDATA[-- AudioCatalog.luau — session8-A: in-game catalog mirroring
-- assets/audio/manifest.json (8 finished local candidates).
-- Pure Luau/plain-Lua subset (no engine calls): safe to require off-engine.
-- Provenance: purposes/local_file/duration/loop/variants copied from the
-- manifest 2026-09-21 (6 SFX wav + menu/battle FLAC via ACE-Step 1.5 jobs
-- ctk-8feb3a631a35 / ctk-ea6be2649dd9).
--
-- Binding (2026-09-26): roblox_id now carries engine-BUNDLED rbxasset://
-- paths that exist in the installed Studio's Content/sounds folder
-- (verified on disk before binding — nothing invented, nothing uploaded).
-- Until the operator's own cue files are uploaded under their account,
-- the game plays these engine stand-ins so audio is genuinely loadable
-- and playable in Studio; the local_file provenance above stays the
-- record of the finished in-house audio for a future real upload.
-- Audio.bindManifest validates this shape; AudioEngine (Roblox-only)
-- binds it to live Sound instances for the honest load test.
-- Menu music belongs to tutorial/roll/inventory/deck/settings screens,
-- battle music to encounter/boss, SFX to contact/card_move/ui cues.

local AudioCatalog = {}

AudioCatalog.RULES_VERSION = "provisional-1"
AudioCatalog.VERSION = "8-cues-20260921"

AudioCatalog.CUES = {
	{ purpose = "contact_normal", model = "stable-audio-3-small-sfx",
		model_version = "repo-da6edc54 sa3_tflite-e9cc5ade dit-9bae6401",
		settings = { prompt = "dry isolated card contact tap", seed = 11 },
		local_file = "assets/audio/contact_tap_v1.wav",
		duration_s = 2.0, loop = false, channel = "sfx",
		variants = { "contact_tap_v1.wav", "contact_tap_v2.wav" },
		roblox_id = "rbxasset://sounds/impact_explosion_03.mp3" },
	{ purpose = "contact_light", model = "stable-audio-3-small-sfx",
		model_version = "repo-da6edc54 sa3_tflite-e9cc5ade dit-9bae6401",
		settings = { prompt = "dry isolated light card tap", seed = 11 },
		local_file = "assets/audio/contact_tap_light_v1.wav",
		duration_s = 2.0, loop = false, channel = "sfx",
		variants = { "contact_tap_light_v1.wav" },
		roblox_id = "rbxasset://sounds/impact_water.mp3" },
	{ purpose = "contact_heavy", model = "stable-audio-3-small-sfx",
		model_version = "repo-da6edc54 sa3_tflite-e9cc5ade dit-9bae6401",
		settings = { prompt = "dry isolated heavy card impact thud", seed = 13 },
		local_file = "assets/audio/contact_thud_heavy_v1.wav",
		duration_s = 2.0, loop = false, channel = "sfx",
		variants = { "contact_thud_heavy_v1.wav" },
		roblox_id = "rbxasset://sounds/impact_explosion_03.mp3" },
	{ purpose = "contact_critical", model = "stable-audio-3-small-sfx",
		model_version = "repo-da6edc54 sa3_tflite-e9cc5ade dit-9bae6401",
		settings = { prompt = "dry isolated critical card strike crack", seed = 17 },
		local_file = "assets/audio/contact_crack_critical_v1.wav",
		duration_s = 2.0, loop = false, channel = "sfx",
		variants = { "contact_crack_critical_v1.wav" },
		roblox_id = "rbxasset://sounds/oof.ogg" },
	{ purpose = "card_move", model = "stable-audio-3-small-sfx",
		model_version = "repo-da6edc54 sa3_tflite-e9cc5ade dit-9bae6401",
		settings = { prompt = "dry isolated card slide whoosh", seed = 19 },
		local_file = "assets/audio/card_slide_whoosh_v1.wav",
		duration_s = 1.0, loop = false, channel = "sfx",
		variants = { "card_slide_whoosh_v1.wav" },
		roblox_id = "rbxasset://sounds/action_footsteps_plastic.mp3" },
	{ purpose = "ui_click", model = "stable-audio-3-small-sfx",
		model_version = "repo-da6edc54 sa3_tflite-e9cc5ade dit-9bae6401",
		settings = { prompt = "dry isolated UI click", seed = 23 },
		local_file = "assets/audio/ui_click_v1.wav",
		duration_s = 1.0, loop = false, channel = "ui",
		variants = { "ui_click_v1.wav" },
		roblox_id = "rbxasset://sounds/action_jump_land.mp3" },
	{ purpose = "menu_music", model = "ACE-Step 1.5",
		model_version = "acestep_v1.5_turbo + DualCLIP ace",
		settings = { note = "Neon Reliquary menu 90bpm C major", seed = 20260921,
			job = "ctk-8feb3a631a35" },
		local_file = "assets/audio/menu_theme_v1.flac",
		duration_s = 45.0, loop = true, channel = "music",
		variants = { "menu_theme_v1.flac" },
		roblox_id = "rbxasset://sounds/action_get_up.mp3" },
	{ purpose = "battle_music", model = "ACE-Step 1.5",
		model_version = "acestep_v1.5_turbo + DualCLIP ace",
		settings = { note = "Neon Reliquary battle 140bpm E minor", seed = 20260922,
			job = "ctk-ea6be2649dd9" },
		local_file = "assets/audio/battle_theme_v1.flac",
		duration_s = 40.0, loop = true, channel = "music",
		variants = { "battle_theme_v1.flac" },
		roblox_id = "rbxasset://sounds/action_falling.ogg" },
}

-- Screens each music cue belongs to (presentation mapping only).
AudioCatalog.MENU_SCREENS = { "tutorial", "roll", "inventory", "deck",
	"settings", "upgrade", "rebirth", "reconnect" }
AudioCatalog.BATTLE_SCREENS = { "encounter", "boss", "rewards" }

-- Shape Audio.bindManifest validates (version + assets with the B-18
-- required fields). Returns a fresh table per call (no shared mutation).
function AudioCatalog.manifestShape()
	local assets = {}
	for i = 1, #AudioCatalog.CUES do
		local c = AudioCatalog.CUES[i]
		local variants = {}
		for j = 1, #c.variants do
			variants[j] = c.variants[j]
		end
		assets[i] = {
			purpose = c.purpose, model = c.model,
			model_version = c.model_version, settings = c.settings,
			local_file = c.local_file, duration_s = c.duration_s,
			loop = c.loop, variants = variants, roblox_id = c.roblox_id,
		}
	end
	return { version = "1", assets = assets }
end

function AudioCatalog.purposes()
	local out = {}
	for i = 1, #AudioCatalog.CUES do
		out[i] = AudioCatalog.CUES[i].purpose
	end
	return out
end

return AudioCatalog
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">AudioEngine</string>
            <string name="Source"><![CDATA[-- AudioEngine.luau — Roblox Sound binding, bus writes, cue and music routing.
-- Runs ONLY in a live Roblox session (Studio Play). Off-engine (plain Lua /
-- Lune) every entrypoint returns nil + "studio-only" and touches nothing, so
-- Linux verification never mistakes this for Studio evidence.
--
-- Null IDs stay blank and explicitly "not loaded / ID pending". No placeholder
-- SoundId is assigned and Play() is never called for a null-ID candidate.
--
-- Volumes map 0..100 prefs to Sound.Volume 0..1. Effects have a four-voice,
-- priority-bounded pool; repeated screen requests do not restart music.

local AudioEngine = {}

AudioEngine.RULES_VERSION = "provisional-1"
AudioEngine.FOLDER_NAME = "UACGAudio"

local function isRoblox()
	return script ~= nil and game ~= nil
end

function AudioEngine.isRoblox()
	return isRoblox()
end

-- Attempted SoundId for one catalog/manifest entry (pure string mapping, no
-- engine call; safe off-engine for the id-present branch only when given a
-- table — never creates instances).
function AudioEngine.attemptedSoundId(entry)
	if type(entry) ~= "table" then
		return nil, "unresolved"
	end
	local id = entry.roblox_id
	if type(id) == "string" and id ~= "" then
		if string.find(id, "rbxasset", 1, true) == 1 then
			return id, nil
		end
		return "rbxassetid://" .. id, nil
	end
	return nil, "ID pending"
end

local function channelOf(entry)
	if type(entry) == "table" and type(entry.channel) == "string" then
		return entry.channel
	end
	local p = tostring(entry and entry.purpose or "")
	if p == "menu_music" or p == "battle_music" then
		return "music"
	end
	if p == "ui_click" then
		return "ui"
	end
	return "sfx"
end

local function volumeFor(entry, audioState)
	if audioState == nil or audioState.volumes == nil then
		return 0.8
	end
	local ch = channelOf(entry)
	local v = audioState.volumes[ch]
	if type(v) ~= "number" then
		return 0.8
	end
	if v < 0 then
		v = 0
	end
	if v > 100 then
		v = 100
	end
	return v / 100
end

local function loadCatalog(app)
	if app ~= nil and app.M ~= nil and app.M.AudioCatalog ~= nil then
		return app.M.AudioCatalog
	end
	if not isRoblox() then
		return nil
	end
	local ok, mod = pcall(function()
		return require(script.Parent.AudioCatalog)
	end)
	if ok and mod ~= nil then
		return mod
	end
	return nil
end

local function cueEntry(app, purpose)
	local Catalog = loadCatalog(app)
	if Catalog ~= nil then
		for _, entry in ipairs(Catalog.CUES) do
			if entry.purpose == purpose then
				return entry
			end
		end
	end
	return nil
end

local function findSound(app, purpose)
	local folder = app ~= nil and app.audioFolder or nil
	if folder == nil then
		return nil
	end
	local sound = nil
	pcall(function()
		sound = folder:FindFirstChild(purpose)
	end)
	return sound
end

local function isPlaying(sound)
	local playing = false
	pcall(function()
		playing = sound.IsPlaying == true
	end)
	return playing
end

function AudioEngine.cueFacts(sound, entry, purpose)
	local id, err = AudioEngine.attemptedSoundId(entry)
	local facts = { purpose = tostring(purpose), soundId = id or "" }
	if id == nil then
		facts.isLoaded = false
		facts.timeLength = 0
		facts.isPlaying = false
		facts.status = "not loaded / ID pending"
		return facts, err
	end
	pcall(function()
		facts.isLoaded = sound.IsLoaded
		facts.timeLength = sound.TimeLength
		facts.isPlaying = sound.IsPlaying
	end)
	facts.status = facts.isLoaded and "loaded" or "not loaded"
	return facts, nil
end

local function writeVolume(sound, entry, audioState)
	return pcall(function()
		sound.Volume = volumeFor(entry, audioState)
	end)
end

-- Bind every catalog cue to a live Sound under one folder. Parent: workspace
-- folder (visible to the client-vantage checks; server-vantage cannot see
-- client-built sounds — honest vantage limit, documented on the checks).
-- Returns folder + {created, sounds} or nil + reason. Never destroys an
-- existing folder's sounds without rebuilding (idempotent rebind).
function AudioEngine.bindAll(app, workspaceObj)
	if not isRoblox() then
		return nil, "studio-only"
	end
	if app == nil or app.R == nil or workspaceObj == nil then
		return nil, "missing app/workspace"
	end
	local Catalog = loadCatalog(app)
	if Catalog == nil then
		return nil, "AudioCatalog absent"
	end
	local Audio = (app.M ~= nil and app.M.Audio) or nil
	if Audio == nil then
		local ok, mod = pcall(function()
			return require(script.Parent.Audio)
		end)
		if ok then
			Audio = mod
		end
	end
	-- Bind the catalog manifest into the live audio state so resolveAsset
	-- works in-game (structure-only; null ids keep playable() false).
	if app.audio ~= nil and Audio ~= nil
		and Audio.bindManifest ~= nil then
		pcall(function()
			Audio.bindManifest(app.audio, Catalog.manifestShape())
		end)
	end
	local R = app.R
	local folder = nil
	pcall(function()
		folder = workspaceObj:FindFirstChild(AudioEngine.FOLDER_NAME)
	end)
	if folder == nil then
		local okNew, newFolder = pcall(function()
			local f = R.Instance.new("Folder")
			f.Name = AudioEngine.FOLDER_NAME
			f.Parent = workspaceObj
			return f
		end)
		if not okNew or newFolder == nil then
			return nil, "could not create UACGAudio folder"
		end
		folder = newFolder
	end
	local created = 0
	for _, entry in ipairs(Catalog.CUES) do
		local okOne = pcall(function()
			local existing = folder:FindFirstChild(entry.purpose)
			if existing ~= nil then
				pcall(function()
					existing:Destroy()
				end)
			end
			local sid, _ = AudioEngine.attemptedSoundId(entry)
			local s = R.Instance.new("Sound")
			s.Name = entry.purpose
			s.SoundId = sid or ""
			s.Looped = entry.loop == true
			s.Volume = volumeFor(entry, app.audio)
			s.Parent = folder
		end)
		if okOne then
			created = created + 1
		end
	end
	app.audioFolder = folder
	app.audioActiveEffects = {}
	return folder, { created = created }
end

function AudioEngine.updateVolumes(app)
	local folder = app ~= nil and app.audioFolder or nil
	local Catalog = loadCatalog(app)
	if folder == nil or Catalog == nil then
		return 0, "audio folder or catalog unbound"
	end
	local updated = 0
	for _, entry in ipairs(Catalog.CUES) do
		local sound = findSound(app, entry.purpose)
		if sound ~= nil and writeVolume(sound, entry, app.audio) then
			updated = updated + 1
		end
	end
	return updated, nil
end

function AudioEngine.syncVolumes(app)
	if app == nil or app.audio == nil or app.store == nil
		or app.M == nil or app.M.Audio == nil then
		return 0, "audio state unavailable"
	end
	local Audio = app.M.Audio
	for _, channel in ipairs(Audio.CHANNELS) do
		local value = app.store.prefs[channel .. "Volume"]
		if Audio.checkVolume(value) then
			Audio.setVolume(app.audio, channel, value)
		end
	end
	return AudioEngine.updateVolumes(app)
end

local function effectRecords(app)
	local records = app.audioActiveEffects or {}
	app.audioActiveEffects = records
	local active = {}
	for purpose, record in pairs(records) do
		if isPlaying(record.sound) then
			active[#active + 1] = record
		else
			records[purpose] = nil
		end
	end
	return records, active
end

function AudioEngine.playBoundCue(app, sound, entry, purpose)
	if app == nil or sound == nil then
		return nil, "app or Sound absent"
	end
	local id = AudioEngine.attemptedSoundId(entry)
	if id == nil then
		return AudioEngine.cueFacts(sound, entry, purpose)
	end
	local Audio = app.M ~= nil and app.M.Audio or nil
	writeVolume(sound, entry, app.audio)
	pcall(function()
		if sound.SoundId ~= id then
			sound.SoundId = id
		end
	end)
	if isPlaying(sound) then
		return AudioEngine.cueFacts(sound, entry, purpose), "already playing"
	end
	local channel = channelOf(entry)
	local records = nil
	local priority = Audio ~= nil and Audio.cuePriority(purpose) or 1
	if channel ~= "music" then
		local active = nil
		records, active = effectRecords(app)
		if #active >= (Audio and Audio.POOL_MAX or 4) then
			local victim = active[1]
			for i = 2, #active do
				local candidate = active[i]
				if candidate.priority < victim.priority
					or (candidate.priority == victim.priority
						and candidate.sequence < victim.sequence) then
					victim = candidate
				end
			end
			if priority < victim.priority then
				local facts = AudioEngine.cueFacts(sound, entry, purpose)
				facts.status = "overlap limit"
				return facts, "overlap limit"
			end
			pcall(function()
				victim.sound:Stop()
			end)
			records[victim.purpose] = nil
		end
	end
	local okPlay = pcall(function()
		sound:Play()
	end)
	if not okPlay then
		return AudioEngine.cueFacts(sound, entry, purpose), "play failed"
	end
	if channel ~= "music" then
		app.audioEffectSequence = (app.audioEffectSequence or 0) + 1
		records[purpose] = {
			purpose = purpose, sound = sound, priority = priority,
			sequence = app.audioEffectSequence,
		}
	end
	return AudioEngine.cueFacts(sound, entry, purpose), nil
end

function AudioEngine.cancelEffects(app)
	local records = app ~= nil and app.audioActiveEffects or nil
	local stopped = 0
	if records ~= nil then
		for _, record in pairs(records) do
			pcall(function()
				record.sound:Stop()
			end)
			stopped = stopped + 1
		end
	end
	if app ~= nil then
		app.audioActiveEffects = {}
	end
	return stopped
end

-- Play only manifested, non-null IDs. This lower-level operation remains
-- fake-Sound-testable on Linux without claiming that the engine was run.
function AudioEngine.playCue(app, purpose)
	if not isRoblox() then
		return nil, "studio-only"
	end
	local entry = cueEntry(app, purpose)
	local sound = findSound(app, tostring(purpose))
	if entry == nil or sound == nil then
		return nil, "cue absent: " .. tostring(purpose)
	end
	return AudioEngine.playBoundCue(app, sound, entry, purpose)
end

function AudioEngine.musicPurposeForScreen(screenId)
	if screenId == "encounter" or screenId == "boss"
		or screenId == "rewards" then
		return "battle_music"
	end
	return "menu_music"
end

-- Rewards remain in the battle-music state; no third track is inferred.
function AudioEngine.playForScreen(app, screenId)
	if not isRoblox() then
		return nil, "studio-only"
	end
	local folder = app ~= nil and app.audioFolder or nil
	if folder == nil then
		return nil, "audio folder unbound"
	end
	local want = AudioEngine.musicPurposeForScreen(screenId)
	local stop = want == "battle_music" and "menu_music" or "battle_music"
	pcall(function()
		local sound = folder:FindFirstChild(stop)
		if sound ~= nil then
			sound:Stop()
		end
	end)
	return AudioEngine.playCue(app, want)
end

-- Live snapshot of every bound Sound (REAL engine facts only).
function AudioEngine.snapshot(app)
	if not isRoblox() then
		return nil, "studio-only"
	end
	local folder = app ~= nil and app.audioFolder or nil
	if folder == nil then
		return nil, "audio folder unbound"
	end
	local out = {}
	local ok = pcall(function()
		for _, ch in ipairs(folder:GetChildren()) do
			local purpose = tostring(ch.Name)
			local row = AudioEngine.cueFacts(ch,
				cueEntry(app, purpose), purpose)
			pcall(function()
				row.looped = ch.Looped
			end)
			out[#out + 1] = row
		end
	end)
	if not ok then
		return nil, "snapshot failed"
	end
	return out, nil
end

return AudioEngine
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">BattlePresenter</string>
            <string name="Source"><![CDATA[-- BattlePresenter.luau — card-battle presentation only (R2 split from App).
-- Owns: battle sessions from SEALED server snapshots (initialA/initialB
-- seed identity + HP, never '?' or deck guesses), whole-card
-- wind-up/tilt/lunge with edge contact, defender recoil, exact anchor
-- return, contact-beat damage/shield/status folding, ordered
-- defeat/replacement view swaps, final-snapshot settle (skip-safe),
-- pause/cancel freezing, exactly-once contact audio. Damage, rewards and
-- victory stay server-owned; this module only SHOWS resolved events.

local BattlePresenter = {}

BattlePresenter.RULES_VERSION = "provisional-1"

local function faceYaw()
	return 180
end

-- Keep the battle stage clear of the player's avatar and the explorable
-- world. LocalTransparencyModifier is client-only, so other players and the
-- saved world are untouched. Retain each prior value for exact restoration.
local function hideSceneObstructions(app)
	if game == nil then
		return
	end
	app.battleHiddenParts = {}
	local function hide(root)
		if root == nil then
			return
		end
		for _, item in ipairs(root:GetDescendants()) do
			if item:IsA("BasePart") then
				table.insert(app.battleHiddenParts, {
					part = item,
					transparency = item.LocalTransparencyModifier,
				})
				item.LocalTransparencyModifier = 1
			end
		end
	end
	hide(app.world)
	local player = game:GetService("Players").LocalPlayer
	hide(player and player.Character)
end

local function restoreSceneObstructions(app)
	for _, saved in ipairs(app.battleHiddenParts or {}) do
		if saved.part.Parent ~= nil then
			saved.part.LocalTransparencyModifier = saved.transparency
		end
	end
	app.battleHiddenParts = nil
end

local function buildArena(folder, R)
	local function panel(name, size, position, color, material)
		local part = R.Instance.new("Part")
		part.Name = name
		part.Size = R.Vector3.new(size[1], size[2], size[3])
		part.Position = R.Vector3.new(position[1], position[2], position[3])
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.Material = material
		part.Color = R.Color3.fromHex(color)
		part.Parent = folder
		return part
	end
	-- A quiet dark stage lets the two upright cards carry the duel. These
	-- pieces are local presentation only and disappear with the battle folder.
	panel("ArenaBackdrop", { 42, 22, 0.2 }, { 0, 5, -7 },
		"#111726", R.Enum.Material.SmoothPlastic)
	panel("ArenaFloor", { 42, 0.2, 16 }, { 0, 1.6, 0 },
		"#202A3C", R.Enum.Material.SmoothPlastic)
	panel("ArenaCenterLine", { 0.08, 0.02, 14 }, { 0, 1.72, 0 },
		"#8AD8E4", R.Enum.Material.SmoothPlastic)
end

function BattlePresenter.validateEnvelope(app, result)
	return app.M.ClientProtocol.validateBattleEnvelope(result)
end

function BattlePresenter.beginBattle(app, result)
	local M, R = app.M, app.R
	-- Fail closed BEFORE creating any card: malformed sealed data gets a
	-- controlled recover message, never guessed decks, event peeks, or "?".
	local ok, err = BattlePresenter.validateEnvelope(app, result)
	if not ok then
		BattlePresenter.teardownBattle(app, false)
		app.Actions.setStatus(app,
			"Battle data malformed (" .. tostring(err)
			.. ") — reload and retry")
		return
	end
	BattlePresenter.teardownBattle(app, false)
	app.lastReward = nil
	app.lastRewardData = nil
	app.lastBattleWinner = nil
	app.lastBattleCardId = nil
	M.UiView.renderRewardPanel(app, "empty")
	local rewardScreen = app.screens and app.screens.rewards
	if rewardScreen ~= nil then
		rewardScreen.data.Text = "DUEL IN PROGRESS  /  The result will appear when the battle settles."
		local claim = rewardScreen.buttons["reward-claim"]
		local continue = rewardScreen.buttons["reward-next"]
		if claim ~= nil then
			claim.Text = "Finish duel to claim"
			pcall(function() claim.Active = false end)
			M.UiView.paint(app, claim, "locked")
			rewardScreen.buttonRoles["reward-claim"] = "locked"
		end
		if continue ~= nil then
			pcall(function() continue.Active = false end)
			M.UiView.paint(app, continue, "locked")
			rewardScreen.buttonRoles["reward-next"] = "locked"
		end
	end
	local stageFolder = R.Instance.new("Folder")
	stageFolder.Name = "LiveBattle"
	stageFolder.Parent = app.stage.folder
	buildArena(stageFolder, R)
	local side = M.Timeline.new(result.attemptId, result.events, nil, {
		speed = app.store.prefs.speed,
		reducedMotion = app.store.prefs.reducedMotion,
		reducedFlash = app.store.prefs.reducedFlash,
	})
	local views = {}
	-- Identities come ONLY from the sealed rows (validated above).
	local ids = {
		A = tostring(result.initialA[1].cardId),
		B = tostring(result.initialB[1].cardId),
	}
	for _, s in ipairs({ "A", "B" }) do
		local ident = app.Actions.cardIdentity(app, ids[s])
		local built = M.CardView.build(stageFolder, ids[s], {
			alias = ident.alias, artwork = "PLACEHOLDER-no-asset-id",
			rarity = ident.rarity, role = ident.role,
			atk = ident.atk, hp = ident.hp, def = ident.def,
			theme = (app.store.prefs.theme == "Light") and "Light" or "Dark",
		}, R)
		views[s] = built
		if built ~= nil then
			built.part.CFrame = R.CFrame.new(R.Vector3.new(
				M.Geometry.anchorX(s), M.Geometry.ANCHOR_Y,
				M.Geometry.ANCHOR_Z))
			built.part.Orientation = R.Vector3.new(0, faceYaw(), 0)
		end
	end
	local cam = R.Instance.new("Camera")
	cam.Name = "BattleCamera"
	cam.CameraType = R.Enum.CameraType.Scriptable
	local spec = M.BattleScene.cameraSpec()
	cam.FieldOfView = spec.fieldOfView
	cam.CFrame = R.CFrame.new(
		R.Vector3.new(spec.position.x, spec.position.y, spec.position.z),
		R.Vector3.new(spec.lookAt.x, spec.lookAt.y, spec.lookAt.z))
	cam.Parent = app.workspace
	app.prevCamera = app.workspace.CurrentCamera
	app.workspace.CurrentCamera = cam
	app.camera = cam
	hideSceneObstructions(app)
	app.battle = {
		attemptId = result.attemptId,
		timeline = side,
		views = views,
		viewActive = { A = ids.A, B = ids.B },
		folder = stageFolder,
		anims = {},
		recoil = {},
		finished = {},
		sounded = {},
		sideBusy = { A = false, B = false },
		shownSeq = 0,
		shown = nil,
		settled = false,
		finalShown = false,
		token = M.Timeline.newToken(),
		winner = result.winner,
		initialA = result.initialA,
		initialB = result.initialB,
		finalA = result.finalA,
		finalB = result.finalB,
	}
	BattlePresenter.foldShown(app)
	if app.stepper ~= nil then
		app.stepConn = app.stepper:Connect(function(dt)
			BattlePresenter.frame(app, dt)
		end)
	end
	app.Actions.showScreen(app, "encounter")
	app.Actions.setStatus(app, "Battle " .. tostring(result.attemptId))
end

-- Pre-roll: start the strike anim BEFORE its emission so the visible
-- edge contact lands exactly on the strike's emission beat — the moment
-- onContact folds the matching damage/shield/status. Without this, the
-- visual contact would lag emission by a full wind-up, showing HUD state
-- before the cards visibly meet.
function BattlePresenter.maybePreroll(app)
	local M = app.M
	local b = app.battle
	if b == nil then
		return
	end
	local tl = b.timeline
	if tl.done or tl.paused then
		return
	end
	if M.Timeline.isCancelled(b.token) then
		return
	end
	local ev = tl.events[tl.cursor]
	if ev == nil or ev.kind ~= "strike" then
		return
	end
	local key = M.Timeline.compositeKey(tl.battleId, ev.seq)
	local id = "strike" .. key
	if b.anims[id] ~= nil or b.finished[id] ~= nil then
		return
	end
	local side = ev.side or "A"
	if b.sideBusy[side] then
		return
	end
	local dur = M.Timeline.eventDuration(tl, ev)
	local contactAt = M.Geometry.contactAt()
	local remaining = dur - (tl.acc or 0)
	if remaining <= contactAt then
		b.sideBusy[side] = true
		local startT = contactAt - remaining
		if startT < 0 then
			startT = 0
		end
		b.anims[id] = { t = startT, key = key, side = side }
	end
end

-- One frame. Pause OR a cancelled token freezes the ENTIRE pose and all
-- audio (no motion, no sound) while the authoritative cursor holds still.
function BattlePresenter.frame(app, dt)
	local M = app.M
	local b = app.battle
	if b == nil or b.settled then
		return
	end
	if M.Timeline.isCancelled(b.token) then
		return
	end
	if b.timeline.paused then
		return
	end
	BattlePresenter.maybePreroll(app)
	M.Timeline.advance(b.timeline, dt, b.token)
	BattlePresenter.foldShown(app)
	BattlePresenter.maybePreroll(app)
	-- Spawn at most ONE motion per side (ordered scheduler, no CFrame fights).
	for key, applied in pairs(b.timeline.applied) do
		if applied.kind == "strike" and b.anims[applied.kind .. key] == nil
			and b.finished[applied.kind .. key] == nil then
			local ev = BattlePresenter.eventByKey(app, key)
			local side = (ev ~= nil and ev.side) or "A"
			if not b.sideBusy[side] then
				b.sideBusy[side] = true
				b.anims[applied.kind .. key] = { t = 0, key = key, side = side }
			end
		end
	end
	-- Defeat/replacement actually swaps the card view identity.
	BattlePresenter.syncViews(app)
	local total = M.Geometry.strikeTotal(1, false)
	local contactAt = M.Geometry.contactAt()
	for id, a in pairs(b.anims) do
		a.t = a.t + dt * b.timeline.speed
		local view = b.views[a.side]
		if view ~= nil then
			local t = math.min(a.t, total)
			local x = M.Geometry.positionAt(a.side, t, {
				reducedMotion = b.timeline.reducedMotion,
			})
			view.part.CFrame = app.R.CFrame.new(app.R.Vector3.new(
				x, M.Geometry.ANCHOR_Y, M.Geometry.ANCHOR_Z))
			-- Whole-card tilt: zero (bounded) exactly at contact.
			local tilt = M.Geometry.tiltAt(a.t, b.timeline.reducedMotion)
			view.part.Orientation = app.R.Vector3.new(0, faceYaw(), tilt)
		end
		if not a.contactDone and a.t >= contactAt then
			a.contactDone = true
			BattlePresenter.onContact(app, a.key)
		end
		if a.t >= total then
			if view ~= nil then
				view.part.CFrame = app.R.CFrame.new(app.R.Vector3.new(
					M.Geometry.anchorX(a.side), M.Geometry.ANCHOR_Y,
					M.Geometry.ANCHOR_Z))
				view.part.Orientation = app.R.Vector3.new(0, faceYaw(), 0)
			end
			b.sideBusy[a.side] = false
			b.finished[id] = true
			b.anims[id] = nil
		end
	end
	-- Defender recoil after contact: rock back, then return to anchor.
	for s, r in pairs(b.recoil) do
		r.t = r.t + dt * b.timeline.speed
		local view = b.views[s]
		if view ~= nil then
			if r.t >= M.Geometry.RECOIL_S then
				view.part.CFrame = app.R.CFrame.new(app.R.Vector3.new(
					M.Geometry.anchorX(s), M.Geometry.ANCHOR_Y,
					M.Geometry.ANCHOR_Z))
				b.recoil[s] = nil
			else
				local x = M.Geometry.recoilX(s, r.t,
					b.timeline.reducedMotion)
				view.part.CFrame = app.R.CFrame.new(app.R.Vector3.new(
					x, M.Geometry.ANCHOR_Y, M.Geometry.ANCHOR_Z))
			end
		else
			b.recoil[s] = nil
		end
	end
	BattlePresenter.renderBattleHUD(app)
	if M.Timeline.isDone(b.timeline) and next(b.anims) == nil
		and next(b.recoil) == nil then
		BattlePresenter.settleBattle(app)
	end
end

function BattlePresenter.eventByKey(app, key)
	local b = app.battle
	for _, e in ipairs(b.timeline.events) do
		if app.M.Timeline.compositeKey(b.timeline.battleId, e.seq) == key then
			return e
		end
	end
	return nil
end

-- Fold elapsed (applied) events into displayed state — seeded ONLY with
-- the SEALED initial rows: true HP, true order (rows are the ordered
-- fighters), true active (rows[1]), and turn 1 (structural: the Resolver
-- turn counter always opens at 1). Unplayed/final values never leak early.
function BattlePresenter.foldShown(app)
	local M = app.M
	local b = app.battle
	local orderA, orderB = {}, {}
	for _, r in ipairs(b.initialA) do
		orderA[#orderA + 1] = tostring(r.cardId)
	end
	for _, r in ipairs(b.initialB) do
		orderB[#orderB + 1] = tostring(r.cardId)
	end
	local shown = {
		hp = {
			A = tostring(b.initialA[1].hp),
			B = tostring(b.initialB[1].hp),
		},
		shield = { A = "", B = "" },
		status = "OK", turn = "1",
		active = { A = orderA[1], B = orderB[1] },
		order = { A = orderA, B = orderB }, dead = {},
	}
	local function note(side, id)
		if id == nil or id == "" then
			return
		end
		for _, v in ipairs(shown.order[side]) do
			if v == id then
				return
			end
		end
		shown.order[side][#shown.order[side] + 1] = id
	end
	for i = 1, b.timeline.cursor - 1 do
		local e = b.timeline.events[i]
		if e ~= nil then
			BattlePresenter.foldEvent(shown, e, note)
		end
	end
	-- Contact-folded damage (applied at the strike contact beat) shows too.
	for _, extra in ipairs(b.contactFolded or {}) do
		BattlePresenter.foldEvent(shown, extra, note)
	end
	for _, s in ipairs({ "A", "B" }) do
		if shown.active[s] == nil then
			shown.active[s] = shown.order[s][1]
		end
	end
	b.shown = shown
end

function BattlePresenter.foldEvent(shown, e, note)
	if e.kind == "strike" then
		note(e.side, e.card)
	elseif e.kind == "damage" then
		if e.side == "A" or e.side == "B" then
			shown.hp[e.side] = tostring(e.hp)
		end
	elseif e.kind == "shield_absorb" then
		if e.side == "A" or e.side == "B" then
			shown.shield[e.side] = "S" .. tostring(e.shield)
		end
	elseif e.kind == "status_applied" or e.kind == "status_tick"
		or e.kind == "entry_effect" then
		if e.status ~= "" and e.status ~= nil then
			shown.status = tostring(e.status)
		end
	elseif e.kind == "turn_start" then
		shown.turn = tostring(e.turn)
	elseif e.kind == "ko" then
		shown.dead[e.card] = true
	elseif e.kind == "replacement" then
		shown.active[e.side] = e.card
		note(e.side, e.card)
	end
end

-- Swap views whose authoritative active identity changed (defeat exit +
-- ordered replacement enter); hide the old card.
function BattlePresenter.syncViews(app)
	local M = app.M
	local b = app.battle
	if b.shown == nil then
		return
	end
	for _, s in ipairs({ "A", "B" }) do
		local want = b.shown.active[s]
		if want ~= nil and want ~= b.viewActive[s] then
			local old = b.views[s]
			if old ~= nil then
				old.part.Transparency = 1
				old.part:Destroy()
			end
			local ident = app.Actions.cardIdentity(app, want)
			local built = M.CardView.build(b.folder, want, {
				alias = ident.alias, artwork = "PLACEHOLDER-no-asset-id",
				rarity = ident.rarity, role = ident.role,
				atk = ident.atk, hp = ident.hp, def = ident.def,
				theme = (app.store.prefs.theme == "Light") and "Light"
					or "Dark",
			}, app.R)
			b.views[s] = built
			if built ~= nil then
				built.part.CFrame = app.R.CFrame.new(app.R.Vector3.new(
					M.Geometry.anchorX(s), M.Geometry.ANCHOR_Y,
					M.Geometry.ANCHOR_Z))
				built.part.Orientation = app.R.Vector3.new(0, faceYaw(), 0)
			end
			b.viewActive[s] = want
		end
	end
end

local function otherSide(s)
	if s == "A" then
		return "B"
	end
	return "A"
end

local function pulseContact(app, view, style)
	if view == nil or view.part == nil or app.R == nil then return end
	local R = app.R
	local ok, highlight = pcall(function()
		local pulse = R.Instance.new("Highlight")
		pulse.Name = "ContactPulse"
		pulse.Adornee = view.part
		pulse.FillColor = R.Color3.fromHex("#F5F5F5")
		pulse.OutlineColor = R.Color3.fromHex("#FFFFFF")
		pulse.FillTransparency = (style == "outline") and 1 or 0.42
		pulse.OutlineTransparency = 0.06
		pulse.DepthMode = R.Enum.HighlightDepthMode.Occluded
		pulse.Parent = app.battle.folder
		return pulse
	end)
	if not ok or highlight == nil then return end
	local taskApi = R.task
	if taskApi == nil or type(taskApi.delay) ~= "function" then
		pcall(function() highlight:Destroy() end)
		return
	end
	local lifetime = (style == "outline") and 0.08 or 0.13
	taskApi.delay(lifetime, function()
		pcall(function() highlight:Destroy() end)
	end)
end

-- Contact beat: fold the strike's OWN damage/shield/status (the matching
-- events on the defender, before the next strike) so HUD advances at the
-- visible edge meet — not at event start, not at the full result. Spawns
-- the defender recoil and fires the audio cue exactly once.
function BattlePresenter.onContact(app, key)
	local M = app.M
	local b = app.battle
	if b == nil then
		return
	end
	local ev = BattlePresenter.eventByKey(app, key)
	if ev ~= nil and ev.side ~= nil then
		local target = otherSide(ev.side)
		local flashStyle = M.Timeline.flashPresentation(ev,
			b.timeline.reducedFlash)
		if flashStyle ~= "none" then
			pulseContact(app, b.views[target], flashStyle)
		end
		local idx = nil
		for i = 1, #b.timeline.events do
			local e = b.timeline.events[i]
			if M.Timeline.compositeKey(b.timeline.battleId, e.seq) == key then
				idx = i
			end
		end
		if idx ~= nil then
			b.contactFolded = b.contactFolded or {}
			for j = idx + 1, #b.timeline.events do
				local e = b.timeline.events[j]
				if e.kind == "strike" or e.kind == "ko"
					or e.kind == "replacement" or e.kind == "turn_start"
					or e.kind == "battle_end" or e.kind == "timeout" then
					break
				end
				if e.side == target and (e.kind == "damage"
					or e.kind == "shield_absorb"
					or e.kind == "status_applied"
					or e.kind == "status_tick"
					or e.kind == "entry_effect") then
					b.contactFolded[#b.contactFolded + 1] = e
				end
			end
			if b.recoil[target] == nil then
				b.recoil[target] = { t = 0 }
			end
			BattlePresenter.foldShown(app)
		end
	end
	if b.sounded[key] then
		return
	end
	b.sounded[key] = true
	if app.audio ~= nil then
		M.Audio.contactCue(app.audio, { speed = b.timeline.speed })
	end
	app.Actions.playCue(app, "contact_normal")
end

-- Sealed final state for a side: public {active,hp,reserve}.
function BattlePresenter.finalPublic(fin)
	if type(fin) ~= "table" then
		return nil
	end
	return { active = fin.active, hp = fin.hp, reserve = fin.reserve or {} }
end

function BattlePresenter.renderBattleHUD(app)
	local b = app.battle
	if b == nil or app.hud == nil then
		return
	end
	local function alias(id)
		if id == nil then return "none" end
		return app.Actions.cardIdentity(app, id).alias
	end
	local function names(ids)
		local out = {}
		for _, id in ipairs(ids or {}) do out[#out + 1] = alias(id) end
		return #out > 0 and table.concat(out, ", ") or "none"
	end
	if b.finalShown then
		local fA = BattlePresenter.finalPublic(b.finalA) or {}
		local fB = BattlePresenter.finalPublic(b.finalB) or {}
		app.hud.refs.TopHP.Text = "YOUR A:" .. tostring(fA.hp)
			.. " HP   RIVAL B:" .. tostring(fB.hp)
			.. " HP   STATUS " .. (b.shown and b.shown.status or "OK")
			.. "   TURN " .. (b.shown and b.shown.turn or "—")
		app.hud.refs.Reserve.Text = "ACTIVE  /  " .. alias(fA.active)
			.. " vs " .. alias(fB.active)
			.. "\nBENCH  /  " .. names(fA.reserve)
			.. "  ·  Rival: " .. names(fB.reserve)
		return
	end
	local sh = b.shown
	if sh == nil then
		return
	end
	app.hud.refs.TopHP.Text = "YOUR A:" .. sh.hp.A .. sh.shield.A
		.. " HP   RIVAL B:" .. sh.hp.B .. sh.shield.B
		.. " HP   STATUS " .. sh.status .. "   TURN " .. sh.turn
	-- Both sides' ordered reserves, owned by the native HUD: each side's
	-- sealed order minus its active fighter (dead cards already folded out
	-- of shown.order via ko/replacement events).
	local function reserveOf(side)
		local out = {}
		for _, id in ipairs(sh.order[side] or {}) do
			if id ~= sh.active[side] and not sh.dead[id] then
				out[#out + 1] = id
			end
		end
		return out
	end
	local resA = reserveOf("A")
	local resB = reserveOf("B")
	app.hud.refs.Reserve.Text = "ACTIVE  /  " .. alias(sh.active.A)
		.. " vs " .. alias(sh.active.B)
		.. "\nBENCH  /  " .. names(resA)
		.. "  ·  Rival: " .. names(resB)
end

-- Applied events only (elapsed), for reserve derivation.
function BattlePresenter.appliedList(app)
	local b = app.battle
	local out = {}
	for i = 1, b.timeline.cursor - 1 do
		out[#out + 1] = b.timeline.events[i]
	end
	return out
end

-- Settle once: apply every remaining event (skip-safe), snap to the sealed
-- FINAL snapshot + exact anchors, disconnect the stepper, render the final
-- HUD. Rewards still need the real BattleClaim.
function BattlePresenter.settleBattle(app)
	local M = app.M
	local b = app.battle
	if b == nil or b.settled then
		return
	end
	b.settled = true
	for i = 1, #b.timeline.events do
		local e = b.timeline.events[i]
		local key = M.Timeline.compositeKey(b.timeline.battleId, e.seq)
		if b.timeline.applied[key] == nil then
			b.timeline.applied[key] = {
				hp = e.hp, shield = e.shield,
				status = e.status, kind = e.kind,
			}
			b.timeline.seen[key] = true
		end
	end
	b.timeline.cursor = #b.timeline.events + 1
	b.timeline.done = true
	BattlePresenter.foldShown(app)
	for _, s in ipairs({ "A", "B" }) do
		local view = b.views[s]
		if view ~= nil then
			view.part.CFrame = app.R.CFrame.new(app.R.Vector3.new(
				M.Geometry.anchorX(s), M.Geometry.ANCHOR_Y,
				M.Geometry.ANCHOR_Z))
			view.part.Orientation = app.R.Vector3.new(0, faceYaw(), 0)
		end
	end
	b.finalShown = true
	app.lastBattleWinner = b.winner
	app.lastBattleCardId = b.viewActive[b.winner]
	if app.stepConn ~= nil then
		app.stepConn:Disconnect()
		app.stepConn = nil
	end
	BattlePresenter.renderBattleHUD(app)
	app.Actions.setStatus(app, "Battle settled — Claim reward")
	local rewards = app.screens and app.screens.rewards
	if rewards ~= nil then
		local outcome = b.winner == "A" and "VICTORY" or "DEFEAT"
		M.UiView.renderRewardPanel(app, "settled", b.winner)
		M.UiView.pulseCard(app, rewards.rewardPanel and rewards.rewardPanel.card)
		rewards.data.Text = outcome .. "  /  The server has settled this duel."
			.. "\nClaim your earned result before choosing another route."
		local claim = rewards.buttons["reward-claim"]
		local continue = rewards.buttons["reward-next"]
		if claim ~= nil then
			claim.Text = "Claim earned reward"
			pcall(function() claim.Active = true end)
			app.M.UiView.paint(app, claim, "action")
			rewards.buttonRoles["reward-claim"] = "action"
		end
		if continue ~= nil then
			pcall(function() continue.Active = false end)
			app.M.UiView.paint(app, continue, "locked")
			rewards.buttonRoles["reward-next"] = "locked"
		end
	end
	app.Actions.showScreen(app, "rewards")
end

function BattlePresenter.finishBattlePresentation(app)
	BattlePresenter.settleBattle(app)
end

function BattlePresenter.teardownBattle(app, keepCamera)
	restoreSceneObstructions(app)
	if app.M.AudioEngine ~= nil then
		app.M.AudioEngine.cancelEffects(app)
	end
	if app.stepConn ~= nil then
		app.stepConn:Disconnect()
		app.stepConn = nil
	end
	if app.battle ~= nil then
		if app.battle.token ~= nil then
			app.M.Timeline.cancel(app.battle.token)
		end
		if app.battle.folder ~= nil then
			app.battle.folder:Destroy()
		end
		app.battle = nil
	end
	if not keepCamera then
		if app.workspace ~= nil then
			app.workspace.CurrentCamera = app.prevCamera
		end
		app.prevCamera = nil
		app.camera = nil
	end
end

-- Disconnect cleanup: token cancelled, connections cut, cards destroyed,
-- sounds cancelled, camera restored.
function BattlePresenter.destroy(app)
	if app.battle ~= nil and app.battle.token ~= nil then
		app.M.Timeline.cancel(app.battle.token)
	end
	BattlePresenter.teardownBattle(app, false)
	if app.audio ~= nil then
		app.M.Audio.cancel(app.audio)
	end
	for _, s in pairs(app.screens) do
		if s.gui ~= nil then
			s.gui:Destroy()
		end
	end
	app.focus = nil
	if app.hud ~= nil and app.hud.gui ~= nil then
		app.hud.gui:Destroy()
	end
end

return BattlePresenter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">BattleScene</string>
            <string name="Source"><![CDATA[-- BattleScene.luau — Scriptable-camera battle stage + fixed HUD (P4).
-- Roblox construction runs ONLY in Studio (guarded); pure descriptors
-- (hudSpec/cameraSpec) are testable in plain Lua/Lune.
-- CONTRACT: fixed side/three-quarter Scriptable camera; one active card per
-- side in brightest center; native ScreenGui HP/shield/status/turn at top and
-- ordered reserve strip at bottom; speed/pause/skip; HUD NEVER moves with
-- lunging cards (HUD lives in PlayerGui, cards in Workspace). Sound cue is a
-- labeled "unavailable" state until licensed assets bind (no invented IDs).

local BattleScene = {}

BattleScene.RULES_VERSION = "provisional-1"

-- Direct bare references (never rawget(_G)): in Roblox, `script`/`game`
-- resolve per-script environment; in plain Lua/Lune they are nil.
local function isRoblox()
	return script ~= nil and game ~= nil
end

function BattleScene.cameraSpec()
	return {
		cameraType = "Scriptable",
		position = { x = 0, y = 6.5, z = 11 },
		lookAt = { x = 0, y = 3.5, z = 0 },
		fieldOfView = 55,
		note = "Fixed side/three-quarter view; never follows lunging cards.",
	}
end

-- HUD anchors: Scale-based, safe-area padded, portrait+landscape responsive.
-- Mobile queue <= ~16% of height; all controls >= 44px; visible focus.
function BattleScene.hudSpec()
	return {
		root = { className = "ScreenGui", ignoreGuiInset = false, safeArea = true },
		topBar = { anchor = "top", heightScale = 0.14, contents = { "HP-A", "HP-B", "shield", "status", "turn" } },
		reserveStrip = { anchor = "bottom", heightScale = 0.16, contents = { "reserve-A", "reserve-B" } },
		controls = {
			{ id = "pause", label = "Pause", minPx = 44 },
			{ id = "resume", label = "Resume", minPx = 44 },
			{ id = "speed", label = "Speed 1/2/4", minPx = 44 },
			{ id = "skip", label = "Skip", minPx = 44 },
		},
		sound = { id = "sound-state", label = "Sound unavailable — licensed audio not yet bound" },
	}
end

function BattleScene.buildStage(parent, opts, R)
	if R == nil then
		if not isRoblox() then
			return nil, "studio-only"
		end
		R = {
			Instance = Instance, Enum = Enum, Vector3 = Vector3,
			UDim2 = UDim2, CFrame = CFrame, Color3 = Color3,
			Vector2 = Vector2,
		}
	end
	opts = opts or {}
	local folder = R.Instance.new("Folder")
	folder.Name = "BattleStage"
	-- Card anchors (exact; Timeline/Geometry own the motion curve).
	local a = R.Instance.new("Part")
	a.Name = "AnchorA"
	a.Size = R.Vector3.new(2.6, 3.6, 0.2)
	a.Anchored = true
	a.CanCollide = false
	a.CanTouch = false
	a.CanQuery = false
	a.Transparency = 1
	a.Position = R.Vector3.new(-3.2, 4.0, 0)
	a.Parent = folder
	local b = a:Clone()
	b.Name = "AnchorB"
	b.Position = R.Vector3.new(3.2, 4.0, 0)
	b.Parent = folder
	-- Camera: one fixed Scriptable camera.
	local cam = R.Instance.new("Camera")
	cam.Name = "BattleCamera"
	cam.CameraType = R.Enum.CameraType.Scriptable
	local spec = BattleScene.cameraSpec()
	cam.CFrame = R.CFrame.new(
		R.Vector3.new(spec.position.x, spec.position.y, spec.position.z),
		R.Vector3.new(spec.lookAt.x, spec.lookAt.y, spec.lookAt.z)
	)
	cam.FieldOfView = spec.fieldOfView
	cam.Parent = folder
	folder.Parent = parent
	return folder, nil
end

-- HUD construction under PlayerGui. Scale-anchored safe-area layout
-- (portrait + landscape share the same anchors): top status bar pinned to
-- the top inset, reserve strip + 44px controls pinned to the bottom inset,
-- transparent center so the 3D stage stays visible. Applies Theme tokens
-- (ThemeController owns UI roles; world scripts never write UI colors).
function BattleScene.buildHUD(playerGui, themeTokens, R)
	if R == nil then
		if not isRoblox() then
			return nil, "studio-only"
		end
		R = {
			Instance = Instance, Enum = Enum, Vector3 = Vector3,
			UDim2 = UDim2, CFrame = CFrame, Color3 = Color3,
			Vector2 = Vector2,
		}
	end
	themeTokens = themeTokens or {}
	local gui = R.Instance.new("ScreenGui")
	gui.Name = "BattleHUD"
	gui.IgnoreGuiInset = false
	gui.ResetOnSpawn = false
	local top = R.Instance.new("TextLabel")
	top.Name = "TopHP"
	top.Text = "HP / Shield / Status / Turn"
	top.AnchorPoint = R.Vector2.new(0, 0)
	top.Size = R.UDim2.new(1, 0, 0.07, 44)
	top.Position = R.UDim2.new(0, 0, 0, 8)
	top.BackgroundTransparency = 1
	top.TextSize = 16
	top.Parent = gui
	local res = R.Instance.new("TextLabel")
	res.Name = "Reserve"
	res.Text = "Reserves (ordered)"
	res.AnchorPoint = R.Vector2.new(0, 1)
	res.Size = R.UDim2.new(1, 0, 0.05, 44)
	res.Position = R.UDim2.new(0, 0, 1, -100)
	res.BackgroundTransparency = 1
	res.TextSize = 16
	res.Parent = gui
	local i = 0
	for _, c in ipairs(BattleScene.hudSpec().controls) do
		local btn = R.Instance.new("TextButton")
		btn.Name = "Ctl_" .. c.id
		btn.Text = c.label
		btn.AnchorPoint = R.Vector2.new(0, 1)
		btn.Size = R.UDim2.new(0, 120, 0, 44)
		btn.Position = R.UDim2.new(0, 8 + i * 128, 1, -152)
		btn.Parent = gui
		i = i + 1
	end
	local snd = R.Instance.new("TextLabel")
	snd.Name = "SoundState"
	snd.Text = BattleScene.hudSpec().sound.label
	snd.AnchorPoint = R.Vector2.new(0, 1)
	snd.Size = R.UDim2.new(1, 0, 0, 28)
	snd.Position = R.UDim2.new(0, 0, 1, -28)
	snd.BackgroundTransparency = 1
	snd.TextSize = 14
	snd.Parent = gui
	gui.Parent = playerGui
	return gui, nil
end

return BattleScene
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="52">
          <Properties>
            <string name="Name">Boot</string>
            <string name="Source"><![CDATA[-- Boot.client.luau — P4 client bootstrap (LocalScript).
-- Runs as a Roblox LocalScript under StarterPlayerScripts. Uses ONLY
-- require(script.Parent.Module) for siblings (never Lune relative import).
-- Builds the live App controller (the runtime-critic repair): App invokes
-- UACG_Economy via ClientProtocol, creates real CardViews, runs the
-- Timeline per-frame, and binds every Activated handler. Bare `script` /
-- `game` references (never rawget(_G)) so detection works in Roblox.

local Theme = require(script.Parent.Theme)
local State = require(script.Parent.State)
local World = require(script.Parent.World)
local CardView = require(script.Parent.CardView)
local Geometry = require(script.Parent.Geometry)
local Timeline = require(script.Parent.Timeline)
local BattleScene = require(script.Parent.BattleScene)
local Screens = require(script.Parent.Screens)
local ClientProtocol = require(script.Parent.ClientProtocol)
local Audio = require(script.Parent.Audio)
local AudioCatalog = require(script.Parent.AudioCatalog)
local AudioEngine = require(script.Parent.AudioEngine)
local UiView = require(script.Parent.UiView)
local Actions = require(script.Parent.Actions)
local EncounterRoutes = require(script.Parent.EncounterRoutes)
local BattlePresenter = require(script.Parent.BattlePresenter)
local StoreView = require(script.Parent.StoreView)
local StudioDemo = require(script.Parent.StudioDemo)
local App = require(script.Parent.App)
local Config = require(game:GetService("ReplicatedStorage").Shared.Progression.Config)
local Cards = require(game:GetService("ReplicatedStorage").Shared.Content.Cards)
local ArtIds = require(game:GetService("ReplicatedStorage").Shared.Content.ArtIds)

local store = State.new()
Theme.setMode(store.prefs.theme)
local audio = Audio.new({
	music = store.prefs.musicVolume,
	sfx = store.prefs.sfxVolume,
	ui = store.prefs.uiVolume,
	ambience = store.prefs.ambienceVolume,
})
-- Session8-A: bind the 8 real local candidates into the live audio state
-- (structure-only; null Roblox IDs keep playable() honestly false until an
-- upload binds). pcall-guarded so a catalog shape drift never breaks boot.
pcall(function()
	Audio.bindManifest(audio, AudioCatalog.manifestShape())
end)

local BOOT = {
	version = "p4-provisional-3",
	rulesVersion = "provisional-1",
	mode = ClientProtocol.mode(),
	remote = ClientProtocol.REMOTE_NAME,
	sound = Audio.status(audio),
}

local function liveRuntime()
	if script == nil or game == nil then
		return nil
	end
	return {
		Instance = Instance, Enum = Enum, Vector3 = Vector3,
		UDim = UDim, UDim2 = UDim2, CFrame = CFrame, Color3 = Color3,
		Vector2 = Vector2,
		ArtIds = ArtIds,
		task = task,
		game = game,
	}
end

-- Start the live controller. Returns the App (with .destroy for cleanup).
local function startApp(playerGui, workspaceObj, stepper)
	local R = liveRuntime()
	if R == nil then
		return nil, "studio-only"
	end
	local transport = function(req)
		local resp, err = ClientProtocol.invoke(
			req.command, req.params, req.requestId,
			(req.epoch ~= nil and { epoch = req.epoch, seq = req.seq })
				or nil)
		if resp == nil then
			return { status = "Unavailable", reason = err }
		end
		State.noteServerEpoch(store, resp)
		if resp.result ~= nil then
			State.noteHandshake(store, resp.result)
		end
		return resp
	end
	local app = App.new({
		R = R,
		transport = transport,
		supporterTransport = function()
			local remote = game:GetService("ReplicatedStorage")
				:FindFirstChild("UACG_SupporterPass")
			if remote == nil then
				return { status = "Unavailable", reason = "Supporter offer is loading" }
			end
			return remote:InvokeServer("GetStatus")
		end,
		supporterPrompt = function(passId)
			local player = game:GetService("Players").LocalPlayer
			game:GetService("MarketplaceService")
				:PromptGamePassPurchase(player, passId)
		end,
		supporterProductInfo = function(passId)
			return game:GetService("MarketplaceService")
				:GetProductInfoAsync(passId, Enum.InfoType.GamePass)
		end,
		stepper = stepper,
		store = store,
		audio = audio,
		mods = {
			Theme = Theme, State = State, World = World,
			CardView = CardView, Geometry = Geometry,
			Timeline = Timeline, BattleScene = BattleScene,
			Screens = Screens, ClientProtocol = ClientProtocol,
			Audio = Audio, Config = Config, Cards = Cards,
			UiView = UiView, Actions = Actions,
			EncounterRoutes = EncounterRoutes,
			BattlePresenter = BattlePresenter,
			AudioCatalog = AudioCatalog, AudioEngine = AudioEngine,
		},
	})
	App.boot(app, playerGui, workspaceObj)
	app.purchaseFinishedConn = game:GetService("MarketplaceService")
		.PromptGamePassPurchaseFinished:Connect(function(player, passId)
			if player == game:GetService("Players").LocalPlayer
				and app.supporterOffer ~= nil
				and passId == app.supporterOffer.passId then
				task.delay(2, function()
					if app.playerGui ~= nil then StoreView.refreshSupporter(app) end
				end)
			end
		end)
	-- Bind Sounds and start the music state selected after profile loading.
	-- AudioEngine's runtime guard keeps Linux tests out of Studio claims.
	pcall(function()
		local folder = AudioEngine.bindAll(app, workspaceObj)
		if folder ~= nil then
			AudioEngine.playForScreen(app, app.current or "tutorial")
		end
	end)
	BOOT.sound = Audio.status(audio)
	BOOT.app = app
	return app, nil
end

BOOT.startApp = startApp

-- LocalScript entry: wire to the local player when actually running.
local okPlayers, players = pcall(function()
	return game:GetService("Players")
end)
if okPlayers and players ~= nil then
	local player = players.LocalPlayer
	if player ~= nil then
		task.spawn(function()
			local gui = player:WaitForChild("PlayerGui", 10)
			if gui ~= nil then
				local runSvc = game:GetService("RunService")
				local app = startApp(gui, workspace, runSvc.RenderStepped)
				-- Session7-B: genuine Studio demonstration (cards, camera,
				-- contact beat, mode recovery). Runs async so boot never
				-- blocks; each marker publishes only after its behaviour
				-- really completes (see StudioDemo).
				if app ~= nil then
					task.spawn(function()
						task.wait(1)
						local ok, err = pcall(function()
							StudioDemo.run(app, workspace)
						end)
						if not ok then
							warn("[UACG] studio demo failed: "
								.. tostring(err))
						end
					end)
				end
			end
		end)
	end
end

return BOOT
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">CardMotif</string>
            <string name="Source"><![CDATA[-- CardMotif.luau — restrained monochrome fallback marks for local staging.
-- They keep cards legible when a Roblox image asset is not bound. Once image
-- IDs are available, the selected user art replaces this fallback treatment.

local CardMotif = {}

local FAMILIES = {
	NR = { name = "EMBER" }, BC = { name = "ARCANE" },
	BK = { name = "IRON" }, BL = { name = "SPIRIT" },
	DB = { name = "SOLAR" }, MHA = { name = "KINETIC" },
	VG = { name = "INK" }, VS = { name = "NORTH" },
}
local MONO = { base = "#1C1C1F", mid = "#414146",
	accent = "#F5F5F5", secondary = "#B5B5BC" }


-- One restrained identity glyph per frozen roster ID. Family captions remain
-- metadata only; the local placeholder does not render them as artwork.
local MARKS = {
	["NR-NARUTO-01"] = { "✦", "EMBER RISE", 1 },
	["NR-KAKASHI-01"] = { "ϟ", "LIGHTNING CUT", 2 },
	["NR-SHADOW-01"] = { "◐", "SHADOW VEIL", 3 },
	["BC-ASTA-01"] = { "✕", "NULL BLADE", 2 },
	["BC-SEA-01"] = { "≋", "TIDAL SPELL", 3 },
	["BC-WIND-01"] = { "✧", "WIND SCRIPT", 1 },
	["BK-GUTS-01"] = { "✕", "IRON VOW", 3 },
	["BK-FALCON-01"] = { "▲", "FALCON CREST", 1 },
	["BK-WIND-01"] = { "⌁", "DUST TRAIL", 2 },
	["BL-ICHIGO-01"] = { "╱", "SOUL EDGE", 2 },
	["BL-BYAKUYA-01"] = { "✿", "PETAL STORM", 3 },
	["BL-FROST-01"] = { "◆", "FROST SEAL", 1 },
	["DB-GOKU-01"] = { "◉", "SOLAR PULSE", 1 },
	["DB-NAMEK-01"] = { "◈", "NAMEK ORBIT", 3 },
	["DB-PRINCE-01"] = { "▲", "PRINCE FLARE", 2 },
	["MHA-DEKU-01"] = { "✦", "KINETIC RUSH", 2 },
	["MHA-BLAST-01"] = { "✷", "BLAST MARK", 1 },
	["MHA-FROSTBURN-01"] = { "◈", "TWIN ELEMENT", 3 },
	["VG-MUSASHI-01"] = { "✕", "TWO PATHS", 2 },
	["VG-HEAD-01"] = { "○", "QUIET INK", 1 },
	["VG-RIVAL-01"] = { "◇", "RIVAL STROKE", 3 },
	["VS-THORFINN-01"] = { "✕", "DAGGER WAKE", 2 },
	["VS-BEAR-01"] = { "◆", "BEAR HOLD", 1 },
	["VS-SNAKE-01"] = { "∿", "SERPENT LINE", 3 },
}

function CardMotif.forId(id)
	local familyCode = type(id) == "string" and string.match(id, "^(%u+)-") or nil
	local family = FAMILIES[familyCode]
	local mark = MARKS[id]
	if family == nil or mark == nil then
		return { code = "--", family = "SEALED", base = MONO.base,
			mid = MONO.mid, accent = MONO.accent, secondary = MONO.secondary,
			glyph = "?", caption = "UNREVEALED", gesture = 0,
			serial = "00" }
	end
	return { code = familyCode, family = family.name,
		base = MONO.base, mid = MONO.mid,
		accent = MONO.accent, secondary = MONO.secondary,
		glyph = mark[1], caption = mark[2], gesture = mark[3],
		serial = string.match(id, "(%d+)$") or "01" }
end

function CardMotif.knownIds()
	local ids = {}
	for id in pairs(MARKS) do ids[#ids + 1] = id end
	table.sort(ids)
	return ids
end

return CardMotif
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">CardView</string>
            <string name="Source"><![CDATA[-- CardView.luau — reusable whole-card view (P4). Dual runtime:
-- Roblox: thin anchored Part + SurfaceGui/ImageLabel face (built in build()).
-- Pure Lua/Lune: describe() returns the exact construction spec for tests.
-- CONTRACT (CARD-COMBAT-SPEC + brief): thin anchored non-colliding plane,
-- SurfaceGui/ImageLabel face, art clipped to the card (ClipDescendants),
-- missing art is a labeled rectangle (never blank, never final), NO character
-- meshes / Humanoids / rigs / skeletons / physics hitboxes. Client presentation
-- only: position/tween/highlight state, never damage or rewards.

local CardView = {}
local CardMotif
if script ~= nil then
	CardMotif = require(script.Parent.CardMotif)
elseif dofile ~= nil then
	CardMotif = dofile("./src/client/CardMotif.luau")
else
	CardMotif = require("./CardMotif")
end

CardView.RULES_VERSION = "provisional-1"
CardView.SIZE = { x = 2.6, y = 3.6, z = 0.2 }
CardView.MISSING_LABEL_PREFIX = "ART PENDING"
CardView.RARITY_COLOR = {
	Common = "#D1D8E0", Uncommon = "#82E1C5", Rare = "#85B7FF",
	Epic = "#D5A6FF", Legendary = "#F3C36A", Mythic = "#FF9DBA",
}

-- Front-face yaw (degrees about Y) so the SurfaceGui Front face meets the
-- fixed side/three-quarter Scriptable camera at +Z. The engine Front face
-- normal is -Z; yaw 180 turns the normal to +Z (toward the camera).
CardView.FACE_YAW_DEG = 180

-- Pure face-camera check: dot(faceNormal, cameraPos - cardPos) > 0 means
-- the illustrated face is visible from the camera. Real math, no engine.
function CardView.faceNormal(yawDeg)
	local r = math.rad(yawDeg or 0)
	return { x = -math.sin(r), y = 0, z = -math.cos(r) }
end

function CardView.faceDot(camPos, cardPos, yawDeg)
	local n = CardView.faceNormal(yawDeg)
	local dx = camPos.x - cardPos.x
	local dy = camPos.y - cardPos.y
	local dz = camPos.z - cardPos.z
	return n.x * dx + n.y * dy + n.z * dz
end

-- Direct bare references (never rawget(_G)): in Roblox, `script`/`game`
-- resolve per-script environment; in plain Lua/Lune they are nil.
local function isRoblox()
	return script ~= nil and game ~= nil
end

function CardView.isRoblox()
	return isRoblox()
end

-- Only Roblox-uploaded asset IDs are eligible to replace the placeholder.
local function validArt(image)
	if type(image) == "string" and string.match(image, "^rbxassetid://%d+$") then
		return image
	end
	return nil
end

function CardView.resolveArt(cardId, artIds)
	if type(artIds) ~= "table" then
		return nil
	end
	return validArt(artIds[cardId])
end

-- Pure descriptor (testable without Studio). edition: P2 Cards edition row.
function CardView.describe(cardId, edition)
	edition = edition or {}
	local alias = edition.alias or tostring(cardId)
	local artwork = edition.artwork or "PLACEHOLDER-no-asset-id"
	local missing = artwork == "PLACEHOLDER-no-asset-id"
	local label
	if missing then
		label = CardView.MISSING_LABEL_PREFIX .. " — " .. alias
	else
		label = alias
	end
	return {
		cardId = cardId,
		className = "Part",
		shape = "Block",
		size = { x = CardView.SIZE.x, y = CardView.SIZE.y, z = CardView.SIZE.z },
		anchored = true,
		canCollide = false,
		canTouch = false,
		canQuery = false,
		material = "SmoothPlastic",
		face = {
			className = "SurfaceGui",
			face = "Front",
			clipsDescendants = true,
			contents = {
				{
					className = "ImageLabel",
					clipped = true,
					image = artwork,
					missing = missing,
					label = label,
				},
			},
		},
		forbidden = { "Humanoid", "MeshPart-character", "Rig", "Skeleton", "Hitbox" },
	}
end

function CardView.missingLabel(alias)
	return CardView.MISSING_LABEL_PREFIX .. " — " .. tostring(alias)
end

-- Roblox construction (R = runtime table; defaults to real engine globals
-- when running in Studio). Test fakes pass their own R. No-op off-Studio.
function CardView.build(parent, cardId, edition, R)
	if R == nil then
		if not isRoblox() then
			return nil, "studio-only"
		end
		R = {
			Instance = Instance, Enum = Enum, Vector3 = Vector3,
			UDim2 = UDim2, Color3 = Color3,
			ArtIds = require(game:GetService("ReplicatedStorage").Shared.Content.ArtIds),
		}
	end
	local spec = CardView.describe(cardId, edition)
	local motif = CardMotif.forId(cardId)
	local uploadedArt = CardView.resolveArt(cardId, R.ArtIds)
		or validArt(edition and edition.artwork)
	local part = R.Instance.new("Part")
	part.Name = "CardView_" .. tostring(cardId)	part.Shape = R.Enum.PartType.Block
	part.Size = R.Vector3.new(spec.size.x, spec.size.y, spec.size.z)
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Material = R.Enum.Material.SmoothPlastic
	part.Color = R.Color3.fromHex(motif.base)
	part.TopSurface = R.Enum.SurfaceType.Smooth
	part.BottomSurface = R.Enum.SurfaceType.Smooth
	-- Live-scene identity for the Studio check suite (P6StudioChecks
	-- cards-anchored-noncolliding / cardview-bound): every CardView product
	-- carries UACGCard=true. pcall-guarded so minimal test fakes without
	-- attributes still build.
	pcall(function()
		part:SetAttribute("UACGCard", true)
	end)
	-- Face the camera: yaw 180 about Y (Front normal -Z becomes +Z).
	if R.Vector3 ~= nil and R.Vector3.new ~= nil then
		part.Orientation = R.Vector3.new(0, CardView.FACE_YAW_DEG, 0)
	end
	local gui = R.Instance.new("SurfaceGui")
	gui.Name = "Face"
	gui.Face = R.Enum.NormalId.Front
	gui.ClipsDescendants = true
	pcall(function() gui.PixelsPerStud = 100 end)
	-- NOTE (session7-B engine finding): SurfaceGui.AlwaysFaceCamera does
	-- not exist in the running Studio build, so it is never assigned here;
	-- face-camera behaviour comes from FACE_YAW_DEG + camera placement.
	gui.Parent = part
	local img = R.Instance.new("ImageLabel")
	img.Name = "Art"
	img.BackgroundTransparency = 1
	img.Size = R.UDim2.fromScale(1, 1)
	img.ClipsDescendants = true
	img.ScaleType = R.Enum.ScaleType.Crop
	img.Parent = gui
	local editionAlias = (edition and edition.alias) or tostring(cardId)
	if uploadedArt ~= nil then
		local cardArt = R.Instance.new("ImageLabel")
		cardArt.Name = "CardArt"
		cardArt.Image = uploadedArt
		cardArt.BackgroundTransparency = 1
		cardArt.Size = R.UDim2.fromScale(1, 1)
		cardArt.ClipsDescendants = true
		cardArt.ScaleType = R.Enum.ScaleType.Crop
		cardArt.ZIndex = img.ZIndex or 1
		cardArt.Parent = gui
	elseif uploadedArt == nil then
		img.Image = ""
		local missing = R.Instance.new("TextLabel")
		missing.Name = "MissingArt"
		missing.Text = ""
		missing.Size = R.UDim2.fromScale(1, 1)
		missing.BackgroundColor3 = R.Color3.fromHex(motif.base)
		missing.TextColor3 = R.Color3.fromHex(motif.accent)
		missing.TextScaled = true
		missing.Parent = gui
		local mark = R.Instance.new("TextLabel")
		mark.Name = "MotifMark"
		mark.Text = motif.glyph
		mark.Size = R.UDim2.fromScale(0.62, 0.5)
		mark.Position = R.UDim2.fromScale(0.19, 0.24)
		mark.BackgroundTransparency = 1
		mark.TextColor3 = R.Color3.fromHex("#E5E5E7")
		mark.TextScaled = true
		pcall(function() mark.ZIndex = 2 end)
		mark.Parent = missing
		local pending = R.Instance.new("TextLabel")
		pending.Name = "ArtPendingLabel"
		pending.Text = "ART PENDING"
		pending.Size = R.UDim2.fromScale(0.9, 0.09)
		pending.Position = R.UDim2.fromScale(0.05, 0.82)
		pending.BackgroundTransparency = 1
		pending.TextColor3 = R.Color3.fromHex("#B8B8BC")
		pending.TextScaled = true
		pcall(function() pending.ZIndex = 2 end)
		pending.Parent = missing
	end
	local rarity = edition and edition.rarity or "Common"
	local neutral = R.Color3.fromHex("#D8D8DC")
	local topBar = R.Instance.new("Frame")
	topBar.Name = "RarityBar"
	topBar.Size = R.UDim2.new(1, 0, 0, 8)
	topBar.BackgroundColor3 = neutral
	pcall(function() topBar.ZIndex = 3 end)
	topBar.Parent = gui
	local rank = R.Instance.new("TextLabel")
	rank.Name = "RarityLabel"
	rank.Text = string.upper(rarity) .. "  /  "
		.. string.upper(tostring(edition and edition.role or "CARD"))
	rank.Size = R.UDim2.new(1, 0, 0, 30)
	rank.Position = R.UDim2.new(0, 0, 0, 8)
	rank.BackgroundColor3 = R.Color3.fromHex("#111113")
	rank.TextColor3 = neutral
	rank.TextScaled = true
	pcall(function() rank.ZIndex = 3 end)
	rank.Parent = gui
	local stats = R.Instance.new("TextLabel")
	stats.Name = "StatPlate"
	stats.Text = "ATK " .. tostring(edition and edition.atk or "—")
		.. "   HP " .. tostring(edition and edition.hp or "—")
		.. "   DEF " .. tostring(edition and edition.def or "—")
	stats.Size = R.UDim2.new(1, 0, 0, 27)
	stats.Position = R.UDim2.new(0, 0, 1, -57)
	stats.BackgroundColor3 = R.Color3.fromHex("#111113")
	stats.TextColor3 = R.Color3.fromHex("#E5E5E7")
	stats.TextScaled = true
	pcall(function() stats.ZIndex = 3 end)
	stats.Parent = gui
	-- Alias is always legible on top of either uploaded art or placeholder.
	local plate = R.Instance.new("TextLabel")
	plate.Name = "AliasPlate"
	plate.Text = editionAlias
	plate.Size = R.UDim2.new(1, 0, 0, 30)
	plate.Position = R.UDim2.new(0, 0, 1, -30)
	plate.BackgroundColor3 = R.Color3.fromHex("#111113")
	plate.TextColor3 = R.Color3.fromHex("#E5E5E7")
	plate.TextScaled = true
	pcall(function() plate.ZIndex = 3 end)
	plate.Parent = gui
	part.Parent = parent
	return { part = part, gui = gui, art = img, plate = plate, spec = spec }, nil
end

return CardView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">ClientProtocol</string>
            <string name="Source"><![CDATA[-- ClientProtocol.luau — client side of the P3 remote contract (P4, live).
-- Binds run pieces/P3/API.md (prog-1 / provisional-1): ONE RemoteFunction
-- "UACG_Economy" carrying Lua tables, 16 commands, request
-- { requestId, command, params } → response
-- { status, result?, reason?, retryAfterS?, serverNow }.
-- Statuses: Committed | AlreadyCommitted | Rejected | Pending |
-- Unavailable | Stale | Skipped. No outcome is final until
-- Committed/AlreadyCommitted. The client NEVER supplies grant amounts,
-- rarities, victories, retention lists, or full profiles. Pure Luau subset
-- except invoke(), which touches the RemoteFunction only in Studio.

local ClientProtocol = {}

ClientProtocol.RULES_VERSION = "provisional-1"
ClientProtocol.REMOTE_NAME = "UACG_Economy"
ClientProtocol.MODE = "live-1"
ClientProtocol.MAX_STRING_LEN = 64

ClientProtocol.COMMANDS = {
	TutorialGrant = true,
	RollOnce = true,
	BuyEarnedPack = true,
	SetAutoRoll = true,
	SetDeck = true,
	SetSkills = true,
	ClaimRank = true,
	ClaimAway = true,
	SaveSettings = true,
	BattleStart = true,
	BattleClaim = true,
	BattleStatus = true,
	RebirthPreview = true,
	RebirthConfirm = true,
	RebirthCancel = true,
	GetProfile = true,
}

-- Encounter ids served by BattleStart (Bootstrap.contentTables).
ClientProtocol.ENCOUNTERS = {}
for world = 1, 3 do
	local prefix = (world == 1) and "" or ("w" .. world .. "-")
	for chapter = 1, 3 do
		ClientProtocol.ENCOUNTERS[prefix .. "enc-" .. chapter] = true
	end
	ClientProtocol.ENCOUNTERS["boss-" .. world] = true
end

-- Read-only commands stay identity-light (mirrors Remotes.READ_ONLY).
ClientProtocol.READ_ONLY = { GetProfile = true, BattleStatus = true }

function ClientProtocol.mode()
	return ClientProtocol.MODE
end

function ClientProtocol.isCommand(name)
	return ClientProtocol.COMMANDS[name] == true
end

-- Durable request identity (mirrors State.newRequestId): "e<epoch>-<seq>"
-- rejects replay beyond cache and across sessions once P3 serves epochs.
-- Epoch 0 until the server surfaces one; the shape never changes.
function ClientProtocol.durableId(epoch, seq, prefix)
	return tostring(prefix or "req") .. "-e" .. tostring(epoch or 0)
		.. "-" .. tostring(seq or 0)
end

-- Build a wire request. Mutations REQUIRE v2 identity (idem
-- {epoch,seq}); read-only commands (GetProfile/BattleStatus) stay
-- identity-light. A "-e<epoch>-<seq>" requestId suffix, when present,
-- MUST repeat the top-level pair exactly (client mirror of the server
-- tamper gate — never coerced, never bypassed).
function ClientProtocol.buildRequest(command, params, requestId, idem)
	if not ClientProtocol.isCommand(command) then
		return nil, "unknown command"
	end
	if type(requestId) ~= "string" or #requestId == 0
		or #requestId > ClientProtocol.MAX_STRING_LEN then
		return nil, "bad requestId (1..64 chars)"
	end
	params = params or {}
	if type(params) ~= "table" then
		return nil, "params must be a table"
	end
	if ClientProtocol.READ_ONLY[command] then
		return { requestId = requestId, command = command,
			params = params }, nil
	end
	if type(idem) ~= "table" or type(idem.epoch) ~= "number"
		or type(idem.seq) ~= "number" then
		return nil, "v2 identity required: epoch+seq"
	end
	local e, s = string.match(requestId, "%-e(%d+)%-(%d+)$")
	if e ~= nil then
		if tonumber(e) ~= idem.epoch or tonumber(s) ~= idem.seq then
			return nil, "request id/identity mismatch"
		end
	end
	return { requestId = requestId, command = command, params = params,
		epoch = idem.epoch, seq = idem.seq }, nil
end

-- Map a server response to client UI behavior. Returns
-- { ui, detail } where ui is one of:
--   apply (Committed/AlreadyCommitted — durable, safe to render),
--   confirming (Pending — show "Confirming…", retry SAME requestId),
--   stale-refetch (Stale — refetch, then retry with a NEW requestId),
--   rejected (show reason + retryAfterS), unavailable (reconnect path),
--   skipped (auto-roll tick, no grant, not an error).
function ClientProtocol.interpret(resp)
	if type(resp) ~= "table" or type(resp.status) ~= "string" then
		return { ui = "unavailable", detail = "malformed response" }
	end
	local s = resp.status
	if s == "Committed" or s == "AlreadyCommitted" then
		return { ui = "apply", detail = s }
	elseif s == "Pending" then
		return { ui = "confirming", detail = "Confirming…" }
	elseif s == "Stale" then
		return { ui = "stale-refetch", detail = resp.reason or "stale" }
	elseif s == "Rejected" then
		return { ui = "rejected", detail = resp.reason or "rejected" }
	elseif s == "Unavailable" then
		return { ui = "unavailable", detail = resp.reason or "unavailable" }
	elseif s == "Skipped" then
		return { ui = "skipped", detail = "auto-roll tick skipped" }
	end
	return { ui = "unavailable", detail = "unknown status" }
end

-- Validate a BattleStart result envelope before the Timeline sees it.
-- Actual shape: { attemptId, events (P2 verbatim), winner, turns,
-- eventHash, initialA/initialB (sealed fighter rows), finalA/finalB
-- (sealed public states) }. Snapshots are REQUIRED: presentation never
-- guesses identities or HP from the deck, the events, or "?".
function ClientProtocol.isFiniteNum(v)
	return type(v) == "number" and v == v
		and v ~= math.huge and v ~= -math.huge
end

-- Sealed initial rows: non-empty array of {cardId, hp, ...} with bounded
-- finite data. Rejects malformed rows (never coerced).
function ClientProtocol.validateSnapshotRows(rows)
	if type(rows) ~= "table" or #rows < 1 then
		return false, "snapshot rows required (non-empty array)"
	end
	for i = 1, #rows do
		local r = rows[i]
		if type(r) ~= "table" then
			return false, "snapshot row[" .. i .. "] must be a table"
		end
		if type(r.cardId) ~= "string" or r.cardId == "" then
			return false, "snapshot row[" .. i .. "] needs cardId"
		end
		if not ClientProtocol.isFiniteNum(r.hp) or r.hp < 0 then
			return false, "snapshot row[" .. i .. "] needs finite hp"
		end
		if r.shield ~= nil
			and (not ClientProtocol.isFiniteNum(r.shield)
				or r.shield < 0) then
			return false, "snapshot row[" .. i .. "] needs finite shield"
		end
	end
	return true, nil
end

-- Sealed final state: {active, hp, reserve[]} with bounded finite data.
-- A wiped side carries active=nil with an empty reserve (real R1
-- publicState shape) — that is valid, never a bare unknown.
function ClientProtocol.validateFinalState(fin)
	if type(fin) ~= "table" then
		return false, "final state required (table)"
	end
	if type(fin.reserve) ~= "table" then
		return false, "final state needs reserve[]"
	end
	for i = 1, #fin.reserve do
		if type(fin.reserve[i]) ~= "string" then
			return false, "final reserve[" .. i .. "] must be a cardId"
		end
	end
	if fin.active == nil then
		if #fin.reserve ~= 0 then
			return false, "final state: nil active needs empty reserve"
		end
		return true, nil
	end
	if type(fin.active) ~= "string" or fin.active == "" then
		return false, "final state needs active cardId"
	end
	if not ClientProtocol.isFiniteNum(fin.hp) or fin.hp < 0 then
		return false, "final state needs finite hp"
	end
	return true, nil
end

function ClientProtocol.validateBattleEnvelope(env)
	if type(env) ~= "table" then
		return false, "envelope must be a table"
	end
	if env.rulesVersion ~= nil and env.rulesVersion ~= ClientProtocol.RULES_VERSION then
		return false, "unsupported rulesVersion: " .. tostring(env.rulesVersion)
	end
	if type(env.attemptId) ~= "string" or env.attemptId == "" then
		return false, "attemptId required"
	end
	if type(env.events) ~= "table" or #env.events < 1 then
		return false, "events array required"
	end
	for i = 1, #env.events do
		local ev = env.events[i]
		if type(ev.seq) ~= "number" or type(ev.kind) ~= "string" or ev.kind == "" then
			return false, "event[" .. i .. "] missing seq/kind"
		end
		local want = string.format("e%04d", ev.seq)
		if ev.id ~= want then
			return false, "event[" .. i .. "] id must be " .. want
		end
	end
	if env.winner ~= "A" and env.winner ~= "B" and env.winner ~= "tie" then
		return false, "winner must be A/B/tie"
	end
	local okA, errA = ClientProtocol.validateSnapshotRows(env.initialA)
	if not okA then
		return false, "initialA: " .. tostring(errA)
	end
	local okB, errB = ClientProtocol.validateSnapshotRows(env.initialB)
	if not okB then
		return false, "initialB: " .. tostring(errB)
	end
	local okFA, errFA = ClientProtocol.validateFinalState(env.finalA)
	if not okFA then
		return false, "finalA: " .. tostring(errFA)
	end
	local okFB, errFB = ClientProtocol.validateFinalState(env.finalB)
	if not okFB then
		return false, "finalB: " .. tostring(errFB)
	end
	return true, nil
end

-- Minimal GetProfile read-model check (confirmed state only).
function ClientProtocol.validateProfile(prof)
	if type(prof) ~= "table" then
		return false, "profile must be a table"
	end
	for _, k in ipairs({ "runId", "revision", "deck", "collection", "settings" }) do
		if prof[k] == nil then
			return false, "profile missing " .. k
		end
	end
	return true, nil
end

-- Presentation-only reserve derivation from authoritative events + the
-- confirmed deck order: removes KO'd cards, keeps order. Never decides
-- rewards; the server sealed those at BattleStart.
function ClientProtocol.reserveAfter(events, deckOrder)
	local dead = {}
	for i = 1, #events do
		local ev = events[i]
		if ev.kind == "ko" and type(ev.card) == "string" and ev.card ~= "" then
			dead[ev.card] = true
		end
	end
	local reserve = {}
	local active = nil
	for i = 1, #deckOrder do
		local id = deckOrder[i]
		if not dead[id] then
			if active == nil then
				active = id
			else
				reserve[#reserve + 1] = id
			end
		end
	end
	return { active = active, reserve = reserve }
end

-- Live invoke. Studio: calls the real RemoteFunction. Anywhere else: fails
-- closed ("no-transport") — the protocol is live, only the transport is
-- absent (tests drive the real server dispatch directly instead).
-- Mutations carry the v2 idem ({epoch,seq}); identity-light reads omit it.
function ClientProtocol.invoke(command, params, requestId, idem)
	if game == nil then
		return nil, "no-transport"
	end
	local req, err = ClientProtocol.buildRequest(command, params,
		requestId, idem)
	if req == nil then
		return nil, err
	end
	local ok, rs = pcall(function()
		return game:GetService("ReplicatedStorage")
	end)
	if not ok or rs == nil then
		return nil, "no-transport"
	end
	local remote = rs:FindFirstChild(ClientProtocol.REMOTE_NAME)
	if remote == nil then
		return nil, "no-transport: " .. ClientProtocol.REMOTE_NAME .. " missing"
	end
	local okCall, resp = pcall(function()
		return remote:InvokeServer(req)
	end)
	if not okCall then
		return nil, "invoke failed: " .. tostring(resp)
	end
	return resp, nil
end

-- Rebirth client-side pre-check labels (server still decides).
function ClientProtocol.rebirthBlocked(reason)
	local blocked = {
		["mid-battle"] = "Rebirth unavailable mid-battle — finish or skip the battle first.",
		["unclaimed-result"] = "Rebirth unavailable with an unclaimed battle result — claim it first.",
		["unknown-save"] = "Rebirth unavailable: save state unknown — reconnect and reload first.",
		["stale-preview"] = "Preview is stale — refresh the preview before confirming.",
	}
	return blocked[reason]
end

return ClientProtocol
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">EncounterRoutes</string>
            <string name="Source"><![CDATA[-- EncounterRoutes.luau — ordered route state and world-scene selection.
-- Route unlocks are presented from the latest server profile; BattleStart,
-- outcomes, clears, and rewards remain server-owned.

local EncounterRoutes = {}

function EncounterRoutes.list(app)
	local worlds = app.M.Cards and app.M.Cards.WORLDS or {}
	local profile = app.profile
	local hasRouteState = type(profile) == "table"
		and type(profile.encounters) == "table"
	local cleared = hasRouteState and profile.encounters or {}
	local routes = {}
	local routeLabels = {}
	local previousEncounterId = nil

	local function add(id, worldId, worldIndex, worldName, cardId, label,
		isBoss, requiresClear)
		if not app.M.ClientProtocol.ENCOUNTERS[id] then
			return
		end
		routes[#routes + 1] = {
			id = id, worldId = worldId, worldIndex = worldIndex,
			worldName = worldName, cardId = cardId, label = label,
			isBoss = isBoss, requiresClear = requiresClear,
			cleared = cleared[id] == true, stateKnown = hasRouteState,
			unlocked = hasRouteState and (requiresClear == nil
				or cleared[requiresClear] == true),
			prerequisite = requiresClear and routeLabels[requiresClear] or nil,
		}
		routeLabels[id] = label
	end

	for worldIndex = 1, math.min(3, #worlds) do
		local world = worlds[worldIndex]
		local worldId = string.format("WORLD-%02d", worldIndex)
		local scene = app.M.World and app.M.World.SCENES
			and app.M.World.SCENES[worldId] or nil
		local worldName = (scene and scene.name) or world.name or worldId
		local prefix = (worldIndex == 1) and "" or ("w" .. worldIndex .. "-")
		for chapter, cardId in ipairs(world.encounters or {}) do
			local id = prefix .. "enc-" .. chapter
			local label = "World " .. worldIndex .. " · Encounter " .. chapter
			add(id, worldId, worldIndex, worldName, cardId, label, false,
				previousEncounterId)
			previousEncounterId = id
		end
		add("boss-" .. worldIndex, worldId, worldIndex, worldName,
			world.boss, "World " .. worldIndex .. " · Boss",
			true, previousEncounterId)
	end
	return routes
end

function EncounterRoutes.find(app, encounterId)
	for _, route in ipairs(EncounterRoutes.list(app)) do
		if route.id == encounterId then
			return route
		end
	end
	return nil
end

function EncounterRoutes.select(app, encounterId)
	local route = EncounterRoutes.find(app, encounterId)
	if route ~= nil then
		app.selectedEncounterId = route.id
		app.selectedWorldId = route.worldId
	end
	return route
end

function EncounterRoutes.installWorld(app, worldId, Actions)
	if app.worldId == worldId and app.world ~= nil then
		return true
	end
	if app.M.World == nil or app.workspace == nil then
		Actions.setStatus(app, "World scene runtime is unavailable")
		return false
	end
	local world, err = app.M.World.build(app.workspace, {
		worldId = worldId,
		reducedMotion = app.store.prefs.reducedMotion,
	}, app.R)
	if world == nil then
		Actions.setStatus(app, "World scene unavailable: " .. tostring(err))
		return false
	end
	local previous = app.world
	app.world = world
	app.worldId = worldId
	app.worldBuildError = nil
	if previous ~= nil then
		previous:Destroy()
	end
	return true
end

function EncounterRoutes.start(app, encounterId, Actions)
	local route = EncounterRoutes.find(app, encounterId)
	if route == nil then
		Actions.setStatus(app, "Unknown encounter route")
		return false
	end
	if not route.stateKnown then
		Actions.setStatus(app,
			"Route status unavailable — refresh your saved profile before entering.")
		return false
	end
	if not route.unlocked then
		Actions.setStatus(app, "Locked — clear "
			.. tostring(route.prerequisite or "the first duel") .. " first")
		return false
	end
	Actions.doRemote(app, "BattleStart:" .. encounterId)
	return true
end

function EncounterRoutes.render(app, Actions)
	local screen = app.screens.worlds
	if screen == nil then
		return
	end
	app.M.UiView.clearExtra(app, screen)
	local routes = EncounterRoutes.list(app)
	local nextButton = screen.buttons and screen.buttons["worlds-next"]
	local refreshButton = screen.buttons and screen.buttons["worlds-refresh"]
	if #routes == 0 then
		if screen.data ~= nil then
			screen.data.Text = "No encounter routes are configured for this build."
		end
		if nextButton ~= nil then pcall(function() nextButton.Active = false end) end
		if refreshButton ~= nil then pcall(function() refreshButton.Active = true end) end
		return
	end
	if not routes[1].stateKnown then
		if screen.data ~= nil then
			screen.data.Text = "Saved route progress is unavailable. Refresh your profile to check each gate."
		end
		if nextButton ~= nil then pcall(function() nextButton.Active = false end) end
		if refreshButton ~= nil then pcall(function() refreshButton.Active = true end) end
		return
	end
	if nextButton ~= nil then pcall(function() nextButton.Active = true end) end
	if refreshButton ~= nil then pcall(function() refreshButton.Active = true end) end
	local ready, cleared = 0, 0
	local nextRoute = nil
	for _, route in ipairs(routes) do
		if route.unlocked then ready = ready + 1 end
		if route.cleared then cleared = cleared + 1 end
		if nextRoute == nil and route.unlocked and not route.cleared then
			nextRoute = route
		end
	end
	if screen.data ~= nil then
		screen.data.Text = "ROUTE MAP  /  " .. tostring(cleared)
			.. " of " .. tostring(#routes) .. " cleared"
			.. "\nNext gate: " .. (nextRoute and nextRoute.label
				or "all available duels cleared — replay an unlocked route")
			.. "\nStart with your saved deck. The server opens each gate after a win and claim."
	end
	for _, route in ipairs(routes) do
		local state = not route.unlocked and "LOCKED"
			or route.cleared and "CLEARED · replay" or "READY"
		local detail = route.unlocked and route.worldName
			or ("Clear " .. tostring(route.prerequisite or "the first duel") .. " first")
		local opts = app.R and app.R.UDim2 and {
			size = app.R.UDim2.new(1, 0, 0, 62) } or nil
		local button = app.M.UiView.addButton(app, screen,
			"route-" .. route.id, route.label .. "  /  " .. state
				.. "\n" .. detail,
			function()
				EncounterRoutes.start(app, route.id, Actions)
			end, not route.unlocked and "locked"
				or (route == nextRoute and "action" or "card"), opts)
		pcall(function() button.Active = route.unlocked end)
		screen.extra[#screen.extra + 1] = button
	end
end

function EncounterRoutes.continue(app, Actions)
	local routes = EncounterRoutes.list(app)
	if #routes == 0 then
		Actions.setStatus(app, "No encounter routes are configured for this build")
		return false
	end
	if not routes[1].stateKnown then
		Actions.setStatus(app,
			"Saved route progress is unavailable — refresh your profile first")
		return false
	end
	for _, route in ipairs(routes) do
		if route.unlocked and not route.cleared then
			return EncounterRoutes.start(app, route.id, Actions)
		end
	end
	for _, route in ipairs(routes) do
		if route.unlocked then
			return EncounterRoutes.start(app, route.id, Actions)
		end
	end
	Actions.setStatus(app, "No route is available in the saved profile")
	return false
end

return EncounterRoutes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Geometry</string>
            <string name="Source"><![CDATA[-- Geometry.luau — pure card-motion geometry + presentation timing (P4).
-- Plain-Lua subset: executes on plain Lua, Lune, and Roblox (no engine calls).
-- Quotes CARD-COMBAT-SPEC rev 1.1 proposed targets (presentation only):
--   wind-up 0.10-0.16s | lunge 0.12-0.18s | contact 0.04-0.06s
--   recoil/return 0.18-0.26s | defeat/replacement 0.30-0.50s.
-- These never decide damage/rewards (server resolver owns outcomes).
-- Whole cards only: one scalar lateral axis, exact anchor return numerically.

local Geometry = {}

Geometry.RULES_VERSION = "provisional-1"

-- Card body (studs). Thin anchored plane; thickness is visual only.
Geometry.CARD_W = 2.6
Geometry.CARD_H = 3.6
Geometry.CARD_THICK = 0.2

-- Stable world anchors on the lateral axis (studs). Defender holds.
Geometry.ANCHOR_A_X = -3.2
Geometry.ANCHOR_B_X = 3.2
Geometry.ANCHOR_Y = 4.0
Geometry.ANCHOR_Z = 0.0

-- Normal-speed phase durations (seconds, mid-range of SPEC targets).
Geometry.WINDUP_S = 0.13
Geometry.LUNGE_S = 0.15
Geometry.CONTACT_S = 0.05
Geometry.RECOIL_S = 0.22
Geometry.DEFEAT_S = 0.40

-- Wind-up / recoil offsets (studs) and tilt (degrees).
Geometry.WINDUP_BACK = 0.45
Geometry.WINDUP_TILT_DEG = 12
Geometry.RECOIL_BACK = 0.35

-- Reduced motion: tiny travel, no tilt, no shake (SPEC).
Geometry.REDUCED_TRAVEL = 0.35
Geometry.REDUCED_TILT_DEG = 0

Geometry.SPEEDS = { 1, 2, 4 }

function Geometry.isSpeed(s)
	return s == 1 or s == 2 or s == 4
end

function Geometry.easeInOut(t)
	if t <= 0 then
		return 0
	end
	if t >= 1 then
		return 1
	end
	return t * t * (3 - 2 * t)
end

-- Contact center for the attacker so card EDGES visibly meet:
-- A attacks B: A_center = B_anchor - CARD_W. B attacks A: mirror.
function Geometry.contactX(side)
	if side == "A" then
		return Geometry.ANCHOR_B_X - Geometry.CARD_W
	elseif side == "B" then
		return Geometry.ANCHOR_A_X + Geometry.CARD_W
	end
	return nil
end

function Geometry.anchorX(side)
	if side == "A" then
		return Geometry.ANCHOR_A_X
	elseif side == "B" then
		return Geometry.ANCHOR_B_X
	end
	return nil
end

function Geometry.windupX(side, reduced)
	local a = Geometry.anchorX(side)
	if a == nil then
		return nil
	end
	if reduced then
		-- Tiny travel away from foe, no tilt handled by tiltDegFor.
		if side == "A" then
			return a - Geometry.REDUCED_TRAVEL * 0.5
		else
			return a + Geometry.REDUCED_TRAVEL * 0.5
		end
	end
	if side == "A" then
		return a - Geometry.WINDUP_BACK
	else
		return a + Geometry.WINDUP_BACK
	end
end

function Geometry.tiltDegFor(reduced)
	if reduced then
		return Geometry.REDUCED_TILT_DEG
	end
	return Geometry.WINDUP_TILT_DEG
end

-- Ordered keyframes for one normal strike. Returns array of
-- { phase, dur, fromX, toX, tiltDeg }. fromX/toX are lateral centers.
-- Edge contact is keyframe[3].toX == contactX(side); exact return is
-- keyframe[5].toX == anchorX(side) (proven in tests numerically).
function Geometry.strikeKeyframes(side, opts)
	opts = opts or {}
	local reduced = opts.reducedMotion == true
	local anchor = Geometry.anchorX(side)
	local contact = Geometry.contactX(side)
	if anchor == nil or contact == nil then
		return nil, "unknown side"
	end
	local windup = Geometry.windupX(side, reduced)
	local lungeTo
	if reduced then
		-- Tiny travel toward foe from anchor (no full edge meet in space,
		-- but contact EVENT still fires at the contact beat; HUD advances
		-- from the event, never from distance).
		if side == "A" then
			lungeTo = anchor + Geometry.REDUCED_TRAVEL
		else
			lungeTo = anchor - Geometry.REDUCED_TRAVEL
		end
	else
		lungeTo = contact
	end
	local tilt = Geometry.tiltDegFor(reduced)
	return {
		{ phase = "windup", dur = Geometry.WINDUP_S, fromX = anchor, toX = windup, tiltDeg = tilt },
		{ phase = "lunge", dur = Geometry.LUNGE_S, fromX = windup, toX = lungeTo, tiltDeg = 0 },
		{ phase = "contact", dur = Geometry.CONTACT_S, fromX = lungeTo, toX = lungeTo, tiltDeg = 0 },
		{ phase = "recoil", dur = Geometry.RECOIL_S, fromX = lungeTo, toX = anchor, tiltDeg = 0 },
		{ phase = "settle", dur = 0.0, fromX = anchor, toX = anchor, tiltDeg = 0 },
	}, nil
end

-- Defeat/replacement keyframes: fade/slide out (defeated) then ordered
-- reserve slides into the exact anchor. Total in 0.30-0.50s.
function Geometry.defeatKeyframes(side, opts)
	opts = opts or {}
	local anchor = Geometry.anchorX(side)
	if anchor == nil then
		return nil, "unknown side"
	end
	local total = Geometry.DEFEAT_S
	if opts.slow == true then
		total = 0.50
	elseif opts.fast == true then
		total = 0.30
	end
	return {
		{ phase = "defeat_exit", dur = total * 0.5, fromX = anchor, toX = anchor, tiltDeg = 0 },
		{ phase = "replacement_enter", dur = total * 0.5, fromX = anchor, toX = anchor, tiltDeg = 0 },
	}, nil
end

function Geometry.scaledDur(dur, speed)
	if not Geometry.isSpeed(speed) then
		return nil, "unsupported speed (1/2/4 only)"
	end
	return dur / speed
end

function Geometry.strikeTotal(speed, reduced)
	local frames = Geometry.strikeKeyframes("A", { reducedMotion = reduced == true })
	local total = 0
	for i = 1, #frames do
		total = total + frames[i].dur
	end
	if speed == nil or speed == 1 then
		return total
	end
	local s, err = Geometry.scaledDur(total, speed)
	if s == nil then
		return nil, err
	end
	return s
end

-- Sample lateral position at time t (seconds, normal speed) along the
-- strike keyframes. Pure helper for tests/preview curves.
function Geometry.positionAt(side, t, opts)
	local frames, err = Geometry.strikeKeyframes(side, opts or {})
	if frames == nil then
		return nil, err
	end
	local elapsed = 0
	for i = 1, #frames do
		local f = frames[i]
		if t <= elapsed + f.dur or i == #frames then
			local local_ = 0
			if f.dur > 0 then
				local_ = (t - elapsed) / f.dur
				if local_ < 0 then
					local_ = 0
				end
				if local_ > 1 then
					local_ = 1
				end
			end
			local e = Geometry.easeInOut(local_)
			return f.fromX + (f.toX - f.fromX) * e
		end
		elapsed = elapsed + f.dur
	end
	return Geometry.anchorX(side)
end

-- Contact beat: wind-up + lunge elapse before edges meet (HUD/audio cue).
function Geometry.contactAt()
	return Geometry.WINDUP_S + Geometry.LUNGE_S
end

-- Whole-card tilt (degrees) at strike time t (normal speed).
-- Wind-up leans, CONTACT is exactly zero (bounded geometry at edge meet),
-- recoil leans away briefly, then everything returns to zero.
function Geometry.tiltAt(t, reduced)
	if reduced then
		return 0
	end
	if t < 0 then
		return 0
	end
	if t < Geometry.WINDUP_S then
		return Geometry.WINDUP_TILT_DEG
	end
	local contactEnd = Geometry.contactAt() + Geometry.CONTACT_S
	if t < contactEnd then
		return 0
	end
	local recoilEnd = contactEnd + Geometry.RECOIL_S
	if t < recoilEnd then
		return -4
	end
	return 0
end

-- Defender recoil offset (studs, signed away from the foe) at recoil
-- progress t seconds after contact. Returns to exactly 0 at RECOIL_S.
function Geometry.recoilOffset(t, reduced)
	local travel = Geometry.RECOIL_BACK
	if reduced then
		travel = Geometry.REDUCED_TRAVEL * 0.5
	end
	if t < 0 then
		return 0
	end
	if t >= Geometry.RECOIL_S then
		return 0
	end
	local k = 1 - t / Geometry.RECOIL_S
	return travel * k * k
end

-- Defender lateral center while recoiling: anchor displaced AWAY from foe.
function Geometry.recoilX(side, t, reduced)
	local anchor = Geometry.anchorX(side)
	if anchor == nil then
		return nil
	end
	local off = Geometry.recoilOffset(t, reduced)
	if side == "A" then
		return anchor - off
	end
	return anchor + off
end

return Geometry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">Screens</string>
            <string name="Source"><![CDATA[-- Screens.luau — native slice screen specs + Studio builders (P4, live).
-- Pure descriptors (screens()) testable in plain Lua/Lune; builders run only
-- in Studio. Every screen has ONE primary action; every button maps to a REAL
-- target: either a UACG_Economy command (uacg:<Command> via ClientProtocol),
-- a real local state transition (nav/theme/motion/audio), or a rebirth guard.
-- No decorative dead ends. Actual P3 shapes (pieces/P3/API.md, prog-1):
-- TutorialGrant / RollOnce (+cooldownReadyAt, pityFails) / SetAutoRoll /
-- SetDeck 1..4 confirmed-owned / SetSkills 11 nodes + ClaimRank 8x3 /
-- SaveSettings {theme,accent,reducedMotion,flashes,speed} / BattleStart
-- {encounterId enc-1|enc-2|enc-3|boss-1} + BattleClaim {attemptId} +
-- BattleStatus / RebirthPreview {keepsakeId?} + RebirthConfirm {token} +
-- RebirthCancel / GetProfile. Music/SFX/UI/Ambience volumes save in the
-- returning profile, each 0..100.
-- Contrast/focus/44px/safe-area/responsive portrait+landscape on all screens.

local Screens = {}

local UiView
if script ~= nil then
	UiView = require(script.Parent.UiView)
elseif dofile ~= nil then
	UiView = dofile("./src/client/UiView.luau")
else
	UiView = require("./UiView")
end

Screens.RULES_VERSION = "provisional-1"

local function btn(id, label, action)
	return { id = id, label = label, minPx = 44, action = action }
end

function Screens.ids()
	return {
		"tutorial", "roll", "store", "inventory", "deck", "worlds", "encounter",
		"rewards", "upgrade", "boss", "rebirth", "settings", "reconnect",
	}
end

function Screens.screens()
	local rows = {
		{
			id = "tutorial", title = "Your Opening Hand",
			primary = "tutorial-roll",
			subtitle = "Three cards are already yours. Draw one more, then choose your four.",
			note = "Loading your opening hand…",
			dataHeight = 128,
			controls = {
				btn("tutorial-roll", "Take a free roll", "nav-roll"),
				btn("tutorial-next", "Build your first deck", "tutorial-next"),
				btn("tutorial-view-starters", "See your starter cards", "nav-inventory"),
			},
		},
		{
			id = "roll", title = "Summon a Card",
			primary = "roll-free",
			subtitle = "One free reveal every six seconds. Until you can build a four-card deck, each reveal adds a new card without changing rarity odds.",
			note = "Loading the draw odds…",
			controls = {
				btn("roll-free", "Reveal a free card", "uacg:RollOnce"),
				btn("roll-odds", "Show exact odds", "show-odds"),
				btn("roll-refresh", "Refresh saved draw odds", "uacg:GetProfile"),
				btn("autoroll-toggle", "Auto-roll: on/off", "uacg:SetAutoRoll"),
				btn("roll-to-deck", "Build your four-card deck", "nav-deck"),
				btn("to-store", "Visit earned Store", "nav-store"),
				btn("to-inventory", "See your cards", "nav-inventory"),
			},
		},
		{
			id = "store", title = "Field Shop",
			primary = "store-purchase",
			subtitle = "Spend earned Run Coins on cards. The cosmetic pass is separate.",
			note = "Earned Field Pack uses Run Coins. Optional Supporter Crest is a separate one-time cosmetic pass; no paid cards or combat power.",
			dataHeight = 540,
			controls = {
				btn("store-purchase", "Confirm earned Field Pack", "uacg:BuyEarnedPack"),
				btn("supporter-prompt", "Supporter Crest unavailable", "supporter-prompt"),
				btn("supporter-refresh", "Refresh Supporter Crest", "supporter-refresh"),
				btn("store-refresh", "Refresh balance + offer", "uacg:GetProfile"),
				btn("store-roll", "Back to Free Roll", "nav-roll"),
			},
		},
		{
			id = "inventory", title = "Your Collection",
			primary = "inspect-card",
			subtitle = "Confirmed cards only. Read the role and rarity before you build.",
			note = "GetProfile collection (confirmed only) + catalogue; inspector shows exact form + alias.",
			controls = {
				btn("inspect-card", "Inspect card", "inspect"),
				btn("refresh-profile", "Refresh", "uacg:GetProfile"),
				btn("to-deck", "Go to Deck", "nav-deck"),
			},
		},
		{
			id = "deck", title = "Your Team",
			primary = "deck-save",
			subtitle = "Order matters. Move cards before you commit the lineup.",
			note = "Reorder with the per-row Up / Down buttons (touch + controller); SetDeck 1..4 unique confirmed-owned.",
			controls = {
				btn("deck-save", "Save this deck", "uacg:SetDeck"),
				btn("to-worlds", "Choose a battle", "nav-worlds"),
			},
		},
		{
			id = "worlds", title = "Choose a World",
			primary = "worlds-next",
			subtitle = "Clear a duel and claim its reward to open the next gate.",
			note = "Route gates mirror the server's clear requirement. If saved progress is unavailable, refresh your profile instead of guessing a lock.",
			loading = "Loading pending away XP and the configured rate/cap…",
			controls = {
				btn("away-claim", "Claim away Run XP", "uacg:ClaimAway"),
				btn("worlds-refresh", "Refresh saved route status", "uacg:GetProfile"),
				btn("worlds-next", "Enter the next duel", "worlds-next"),
				btn("worlds-guide", "Back to your opening hand", "nav-tutorial"),
			},
		},
		{
			id = "encounter", title = "Auto Battle",
			primary = "battle-start",
			subtitle = "Your ordered deck fights automatically. Watch the turn and claim the result.",
			note = "The selected server route starts an automatic battle. Outcomes and rewards stay server-owned.",
			controls = {
				btn("battle-start", "Begin auto battle", "uacg:BattleStart:selected"),
				btn("battle-claim", "Claim earned reward", "uacg:BattleClaim"),
				btn("battle-status", "Battle status", "uacg:BattleStatus"),
				btn("battle-speed", "Speed 1/2/4", "timeline-speed"),
				btn("battle-pause", "Pause", "timeline-pause"),
				btn("battle-skip", "Skip", "timeline-skip"),
				btn("to-worlds", "Choose another route", "nav-worlds"),
			},
		},
		{
			id = "rewards", title = "Battle Result",
			primary = "reward-claim",
			subtitle = "The duel is settled. Claim the server-confirmed result to continue.",
			note = "Claim the earned result before choosing another route.",
			controls = {
				btn("reward-claim", "Claim earned reward", "uacg:BattleClaim"),
				btn("reward-next", "Continue to next unlocked route", "worlds-next"),
				btn("to-upgrade", "Go to Upgrade", "nav-upgrade"),
			},
		},
		{
			id = "upgrade", title = "Train Your Team",
			primary = "skills-confirm",
			subtitle = "Spend earned points, then save your choices.",
			note = "SetSkills 11 nodes (earned points only) + ClaimRank 8x3; ceilings +6%/+6%/+20%.",
			controls = {
				btn("skills-confirm", "Confirm skills", "uacg:SetSkills"),
				btn("rank-claim", "Claim rank", "uacg:ClaimRank"),
				btn("upgrade-refresh", "Refresh saved skill status", "uacg:GetProfile"),
				btn("to-boss", "Go to Boss", "nav-boss"),
			},
		},
		{
			id = "boss", title = "Boss Gate",
			primary = "boss-worlds",
			subtitle = "Finish the world's duels before you challenge its boss.",
			note = "All three bosses appear in the ordered world route list and unlock after their world's encounters.",
			controls = {
				btn("boss-worlds", "Choose an unlocked boss", "nav-worlds"),
				btn("to-rebirth", "Go to Rebirth", "nav-rebirth"),
			},
		},
		{
			id = "rebirth", title = "New Run",
			primary = "rebirth-confirm",
			subtitle = "Review exactly what stays and what resets before confirming.",
			note = "RebirthPreview {keepsakeId?} → token preview (kept+copies/granted/lost+copies+locked/replacesKeepsake/resets/currencies/pityFailsKept/rank/revision/run) → RebirthConfirm {token} / RebirthCancel.",
			controls = {
				btn("rebirth-preview", "Refresh preview", "uacg:RebirthPreview"),
				btn("keepsake-pick", "Pick keepsake", "rebirth-keepsake"),
				btn("rebirth-confirm", "Confirm rebirth (token)", "uacg:RebirthConfirm"),
				btn("rebirth-cancel", "Cancel", "uacg:RebirthCancel"),
			},
		},
		{
			id = "settings", title = "Options",
			primary = "settings-save",
			subtitle = "Set the pace, sound and motion that feel right to you.",
			note = "SaveSettings {theme dark|light, accent, reducedMotion, flashes, speed normal|fast|1|2|4}; saved Music/SFX/UI/Ambience volumes 0..100.",
			controls = {
				btn("theme-dark", "Dark theme", "theme-dark"),
				btn("theme-light", "Light theme", "theme-light"),
				btn("accent-set", "Set accent", "accent-set"),
				btn("theme-reset", "Reset theme", "theme-reset"),
				btn("motion-toggle", "Reduced motion", "motion-toggle"),
				btn("flash-toggle", "Reduced flash", "flash-toggle"),
				btn("speed-set", "Speed 1/2/4", "speed-set"),
				btn("vol-music", "Music volume", "vol-music"),
				btn("vol-sfx", "SFX volume", "vol-sfx"),
				btn("vol-ui", "UI volume", "vol-ui"),
				btn("vol-ambience", "Ambience volume", "vol-ambience"),
				btn("settings-save", "Save settings", "uacg:SaveSettings"),
			},
		},
		{
			id = "reconnect", title = "Resume Your Run",
			primary = "reconnect-resume",
			subtitle = "Checking the server for a saved battle or unclaimed result.",
			note = "GetProfile + BattleStatus: resume committed profile, reconcile pending battle, never grants from UI.",
			controls = {
				btn("reconnect-resume", "Resume session", "uacg:GetProfile+BattleStatus"),
				btn("resume-battle", "Resume pending battle", "resume-battle"),
			},
		},
	}
	return rows
end

-- Rebirth preview sections mapped to the ACTUAL R1 RebirthPreview fields
-- (pieces/R1/API.md section 7): kept/granted carry why, lost carries
-- copies+locked, plus replacesKeepsakeId, resets, currencies, pity, rank.
function Screens.rebirthPreviewSpec()
	return {
		"token",
		"revision",
		"runId",
		"runNumber",
		"keepsakeId",
		"replacesKeepsakeId",
		"kept[]+why+copies",
		"granted[]+why",
		"lost[]+copies+locked",
		"lockedReset[]",
		"resets[]",
		"currencies{lost,kept}",
		"pityFailsKept",
		"pendingRankReward",
		"rank{pending,skillPoints,claimedCount}",
		"nextRunId",
	}
end

-- Direct bare references (never rawget(_G)): in Roblox, `script`/`game`
-- resolve per-script environment; in plain Lua/Lune they are nil.
local function isRoblox()
	return script ~= nil and game ~= nil
end

-- Compatibility adapter only: the canonical screen and scrolling layout live
-- in UiView. Missing UI services are returned as an explicit failure.
function Screens.build(playerGui, screenId, R)
	if R == nil then
		if not isRoblox() then
			return nil, "studio-only"
		end
		R = {
			Instance = Instance, Enum = Enum, Vector2 = Vector2,
			Vector3 = Vector3, UDim = UDim, UDim2 = UDim2,
			Color3 = Color3,
		}
	end
	local found = nil
	for _, s in ipairs(Screens.screens()) do
		if s.id == screenId then
			found = s
		end
	end
	if found == nil then
		return nil, "unknown screen"
	end
	local app = { R = R, M = { Screens = Screens },
		Actions = { onActivated = function() end }, paintLog = {},
		focus = nil, screens = {} }
	local ok, built = pcall(UiView.buildScreen, app, found)
	if not ok then
		return nil, tostring(built)
	end
	built.gui.ResetOnSpawn = false
	built.gui.Parent = playerGui
	return built.gui, nil
end

return Screens
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[-- State.luau — client profile / pending / snapshot store (P4).
-- Pure Luau/plain-Lua subset. Enforces: pending results are NEVER
-- deck-eligible / salvageable / battle-usable before commit; ambiguous saves
-- say "confirmation is pending" and retry the SAME request identity; grants
-- keyed by server-issued IDs (idempotent, bounded); reconnect restores the
-- committed profile + timeline snapshot, never grants from UI.
-- Sound: unavailable until licensed assets are bound (SOUND_AVAILABLE=false);
-- UI shows "Sound unavailable" instead of claiming polished audio.

local State = {}

State.RULES_VERSION = "provisional-1"
State.SOUND_AVAILABLE = false
State.GRANT_CAP = 512

function State.new()
	return {
		profile = nil,
		pending = {},
		grants = {},
		grantCount = 0,
		ambiguous = {},
		snapshot = nil,
		reqSeq = 0,
		-- Durable request identity (forward-compatible with the P3
		-- epoch+sequence repair): server-issued epoch + monotonic client
		-- sequence rejects replay beyond cache and across sessions. Until
		-- the server surfaces an epoch, epoch stays 0 — same wire shape.
		serverEpoch = 0,
		-- Durable v2 high-water: the highest server-confirmed seq. The next
		-- fresh logical attempt must use a HIGHER seq (synced from
		-- GetProfile reqHighWater after every commit).
		reqHighWater = 0,
		prefs = {
			theme = "Dark",
			accent = nil,
			reducedMotion = false,
			reducedFlash = false,
			speed = 1,
			autoRoll = true,
			-- Audio volumes are CLIENT-LOCAL defaults matching the
			-- canonical R1 Config.DEFAULT_VOLUMES (80/80/100/60); the
			-- server copy (GetProfile/SaveSettings echo) wins on refresh.
			musicVolume = 80,
			sfxVolume = 80,
			uiVolume = 100,
			ambienceVolume = 60,
		},
	}
end

function State.pendingLabel()
	return "Confirming…"
end

function State.ambiguousLabel()
	return "Confirmation pending — retry the same request. Nothing is confirmed yet."
end

function State.soundLabel()
	if State.SOUND_AVAILABLE then
		return "Sound on"
	end
	return "Sound unavailable — licensed audio not yet bound"
end

function State.markPending(st, reqId, payload)
	if type(reqId) ~= "string" or reqId == "" then
		return false, "request id required"
	end
	st.pending[reqId] = payload or true
	return true, nil
end

function State.confirm(st, reqId, result)
	if st.pending[reqId] == nil then
		return false, "unknown request (stale or duplicate confirm)"
	end
	st.pending[reqId] = nil
	return result, nil
end

function State.isPending(st, reqId)
	return st.pending[reqId] ~= nil
end

-- Pending cards cannot be used: caller passes the confirmed catalogue.
function State.canBattle(cardId, confirmedCatalogue)
	for i = 1, #confirmedCatalogue do
		if confirmedCatalogue[i] == cardId then
			return true
		end
	end
	return false
end

function State.markAmbiguous(st, reqId)
	st.ambiguous[reqId] = true
end

function State.isAmbiguous(st, reqId)
	return st.ambiguous[reqId] == true
end

function State.clearAmbiguous(st, reqId)
	st.ambiguous[reqId] = nil
end

-- Idempotent grant keyed by server-issued ID. Duplicate receipt grants once.
function State.grantOnce(st, grantId, applyFn)
	if st.grants[grantId] then
		return false, "duplicate grant ignored"
	end
	st.grants[grantId] = true
	st.grantCount = st.grantCount + 1
	if st.grantCount > State.GRANT_CAP then
		for k, _ in pairs(st.grants) do
			st.grants[k] = nil
			st.grantCount = st.grantCount - 1
			break
		end
	end
	if applyFn ~= nil then
		applyFn()
	end
	return true, nil
end

function State.saveSnapshot(st, snapshot)
	st.snapshot = snapshot
	return true
end

function State.loadSnapshot(st)
	return st.snapshot
end

function State.setPref(st, key, value)
	if key == "speed" and value ~= 1 and value ~= 2 and value ~= 4 then
		return false, "speed must be 1, 2, or 4"
	end
	if key == "theme" and value ~= "Dark" and value ~= "Light" then
		return false, "theme must be Dark or Light"
	end
	if (key == "musicVolume" or key == "sfxVolume"
		or key == "uiVolume" or key == "ambienceVolume") then
		if type(value) ~= "number" or value ~= math.floor(value)
			or value < 0 or value > 100 then
			return false, key .. " must be an integer 0..100"
		end
	end
	st.prefs[key] = value
	return true, nil
end

-- Client-generated durable request id (<=64 chars): "<prefix>-e<epoch>-<seq>"
-- with a monotonic per-session sequence. Same id retried returns the SAME
-- durable outcome server-side; fresh ids only for fresh logical attempts
-- (Stale → NEW id; Pending-ambiguous → SAME id).
function State.newRequestId(st, prefix)
	st.reqSeq = st.reqSeq + 1
	prefix = prefix or "req"
	local id = tostring(prefix) .. "-e" .. tostring(st.serverEpoch or 0)
		.. "-" .. tostring(st.reqSeq)
	if #id > 64 then
		id = string.sub(id, #id - 63)
	end
	return id
end

-- Adopt a server-issued epoch when a response/profile carries one
-- (R1 durable-identity repair); otherwise the epoch stays 0.
function State.noteServerEpoch(st, resp)
	if type(resp) == "table" and type(resp.serverEpoch) == "number"
		and resp.serverEpoch == math.floor(resp.serverEpoch)
		and resp.serverEpoch >= 0 then
		st.serverEpoch = resp.serverEpoch
		return true
	end
	return false
end

-- Adopt the R1 v2 handshake from a GetProfile result body (the actual
-- fields are result.epoch + result.reqHighWater): epoch for every future
-- mutation, high-water clamping so the next fresh seq is always new.
-- An older epoch is never adopted backwards (stale data cannot rewind).
function State.noteHandshake(st, result)
	if type(result) ~= "table" then
		return false
	end
	local changed = false
	if type(result.epoch) == "number"
		and result.epoch == math.floor(result.epoch)
		and result.epoch >= 0 and result.epoch > st.serverEpoch then
		st.serverEpoch = result.epoch
		changed = true
	end
	if type(result.reqHighWater) == "number"
		and result.reqHighWater == math.floor(result.reqHighWater)
		and result.reqHighWater >= 0
		and result.reqHighWater > (st.reqHighWater or 0) then
		st.reqHighWater = result.reqHighWater
		changed = true
	end
	if (st.reqSeq or 0) < (st.reqHighWater or 0) then
		st.reqSeq = st.reqHighWater
		changed = true
	end
	return changed
end

-- Claim one durable v2 identity for a FRESH mutation attempt: a single
-- monotonic seq bump producing BOTH the requestId suffix and the
-- top-level {epoch,seq} pair atomically (they can never disagree).
-- Retries reuse the returned pair (same id); fresh attempts call again.
function State.claimIdentity(st, prefix)
	st.reqSeq = (st.reqSeq or 0) + 1
	if st.reqSeq <= (st.reqHighWater or 0) then
		st.reqSeq = (st.reqHighWater or 0) + 1
	end
	prefix = prefix or "req"
	local id = tostring(prefix) .. "-e" .. tostring(st.serverEpoch or 0)
		.. "-" .. tostring(st.reqSeq)
	if #id > 64 then
		id = string.sub(id, #id - 63)
	end
	return id, { epoch = st.serverEpoch or 0, seq = st.reqSeq }
end

-- Encode prefs to the SaveSettings shape. Speed keeps its EXACT stored
-- form (normal/fast/1/2/4 — the R1 server allow-list stores whichever form
-- was saved, so 4 survives the round trip instead of collapsing to "fast").
function State.toServerSettings(prefs)
	local theme = "dark"
	if prefs.theme == "Light" then
		theme = "light"
	end
	local speed = prefs.speed or 1
	if speed ~= "normal" and speed ~= "fast"
		and speed ~= 1 and speed ~= 2 and speed ~= 4 then
		speed = 1
	end
	return {
		theme = theme,
		accent = prefs.accent or "#A78BFA",
		reducedMotion = prefs.reducedMotion == true,
		flashes = not (prefs.reducedFlash == true),
		speed = speed,
		musicVolume = prefs.musicVolume or 80,
		sfxVolume = prefs.sfxVolume or 80,
		uiVolume = prefs.uiVolume or 100,
		ambienceVolume = prefs.ambienceVolume or 60,
	}
end

-- Apply a server settings body to local prefs (GetProfile / SaveSettings
-- result). Server "fast" restores local speed 2 (presentation default).
function State.applyServerSettings(st, s)
	if type(s) ~= "table" then
		return false, "settings must be a table"
	end
	if s.theme == "dark" then
		st.prefs.theme = "Dark"
	elseif s.theme == "light" then
		st.prefs.theme = "Light"
	else
		return false, "unknown theme"
	end
	if s.speed == "normal" then
		st.prefs.speed = 1
	elseif s.speed == "fast" then
		st.prefs.speed = 2
	elseif s.speed == 1 or s.speed == 2 or s.speed == 4 then
		st.prefs.speed = s.speed
	else
		return false, "unknown speed"
	end
	if type(s.accent) ~= "string" then
		return false, "accent must be #RRGGBB"
	end
	st.prefs.accent = s.accent
	if type(s.reducedMotion) ~= "boolean" then
		return false, "reducedMotion must be a boolean"
	end
	if type(s.flashes) ~= "boolean" then
		return false, "flashes must be a boolean"
	end
	st.prefs.reducedMotion = s.reducedMotion
	st.prefs.reducedFlash = not s.flashes
	-- Volume keys land when the P3 amendment does; until then local prefs
	-- stand (never clobbered by their absence).
	for _, k in ipairs({ "musicVolume", "sfxVolume", "uiVolume", "ambienceVolume" }) do
		if s[k] ~= nil then
			if type(s[k]) ~= "number" or s[k] ~= math.floor(s[k])
				or s[k] < 0 or s[k] > 100 then
				return false, k .. " must be an integer 0..100"
			end
			st.prefs[k] = s[k]
		end
	end
	return true, nil
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">StoreView</string>
            <string name="Source"><![CDATA[-- StoreView.luau — player-facing earned Store disclosure and recovery prompt.
-- Server profile data supplies the offer and the durable request identity;
-- this module never chooses a price, outcome, or new purchase identity.

local StoreView = {}

function StoreView.identityKey(requestId, identity)
	if type(requestId) ~= "string" or requestId == ""
		or type(identity) ~= "table"
		or type(identity.epoch) ~= "number"
		or type(identity.seq) ~= "number" then
		return nil
	end
	return tostring(identity.epoch) .. ":" .. tostring(identity.seq)
		.. ":" .. requestId
end

function StoreView.purchaseKey(recovery)
	if type(recovery) ~= "table" then
		return nil
	end
	return StoreView.identityKey(recovery.requestId, recovery)
end

function StoreView.render(app)
	local screen = app.screens.store
	local profile = app.profile
	if screen == nil then
		return
	end
	local offer = profile and profile.storeOffer or nil
	if type(offer) ~= "table" or type(offer.odds) ~= "table"
		or type(offer.weightTotal) ~= "number"
		or offer.weightTotal <= 0 or type(offer.cost) ~= "number" then
		screen.data.Text = "FIELD SHOP  /  Offer loading or unavailable.\n"
			.. "Refresh your saved run before confirming any earned purchase."
		local confirm = screen.buttons["store-purchase"]
		if confirm ~= nil then
			confirm.Text = "Field Pack unavailable"
			pcall(function() confirm.Active = false end)
		end
		return
	end
	local odds = {}
	for _, row in ipairs(offer.odds) do
		odds[#odds + 1] = tostring(row.rarity) .. " "
			.. string.format("%.2f%%", row.weight * 100 / offer.weightTotal)
	end
	local balance = type(profile.currency) == "number" and profile.currency or 0
	local pityFails = offer.pityFails or profile.pityFails or 0
	local pityAt = offer.pityAt or profile.pityAt or 1800
	local lines = {
		"EARNED PACK  /  " .. tostring(offer.name or "Field Pack")
			.. "  /  " .. tostring(offer.count or 1) .. " random card",
		"Cost: " .. tostring(offer.cost) .. " earned "
			.. tostring(offer.currency or "Run Coins") .. ".",
		"Your balance: " .. tostring(balance) .. " "
			.. tostring(offer.currency or "Run Coins") .. ".",
		"\nEXACT CARD ODDS\n" .. table.concat(odds, "  ·  ") .. " ("
			.. tostring(offer.weightTotal) .. " total weight).",
		"\nShared Mythic guarantee: " .. tostring(pityFails) .. "/" .. tostring(pityAt)
			.. " failed rolls. At 1,799 failures, the next roll is Mythic; "
			.. "this pack is not a separate Mythic offer.",
		"Mythic cards become permanent entitlements; rebirth restores "
			.. "one level-1 copy.",
		"Currency source: " .. tostring(offer.currencySource or "unknown") .. ".",
		"Robux purchase: not available.",
		"This random pack cannot be bought with Robux. No paid luck or combat power.",
		"\nOPTIONAL COSMETIC  /  Supporter Crest",
	}
	local paid = app.supporterOffer
	if type(paid) == "table" and type(paid.price) == "number" then
		lines[#lines + 1] = "Supporter Crest: " .. paid.value
			.. " One-time " .. tostring(paid.price) .. " Robux."
		lines[#lines + 1] = paid.owned and "Already owned; badge returns on rejoin."
			or (paid.forSale and "Optional purchase through Roblox."
				or "Currently off sale.")
	else
		lines[#lines + 1] = "Supporter Crest: "
			.. tostring(app.supporterStatus or "not configured for this experience")
	end
	if balance < offer.cost then
		lines[#lines + 1] = "Need " .. tostring(offer.cost - balance)
			.. " more Run Coins. Claim battle rewards to earn them."
	end
	screen.data.Text = table.concat(lines, "\n")
	local confirm = screen.buttons["store-purchase"]
	if confirm ~= nil then
		local recoveryKey = StoreView.purchaseKey(profile.storeRecovery)
		local unresolved = app.store.pendingStorePurchase ~= nil
			or (recoveryKey ~= nil
				and recoveryKey ~= app.store.storeRecoveryResolvedKey)
		local affordable = balance >= offer.cost
		confirm.Text = unresolved and ("Retry same Field Pack — "
			.. tostring(offer.cost) .. " Run Coins")
			or affordable and ("Confirm Field Pack — "
				.. tostring(offer.cost) .. " Run Coins")
			or ("Earn " .. tostring(offer.cost - balance)
				.. " more Run Coins to unlock Field Pack")
		pcall(function() confirm.Active = unresolved or affordable end)
	end
	local supporter = screen.buttons["supporter-prompt"]
	if supporter ~= nil then
		supporter.Text = paid ~= nil and (paid.owned and "Supporter Crest owned"
			or (paid.forSale and "Buy Supporter Crest — "
				.. tostring(paid.price) .. " Robux" or "Supporter Crest off sale"))
			or "Supporter Crest unavailable"
		pcall(function()
			supporter.Active = paid ~= nil and paid.forSale == true
				and paid.owned ~= true
		end)
	end
end

function StoreView.refreshSupporter(app)
	if type(app.supporterTransport) ~= "function" then
		app.supporterOffer = nil
		app.supporterStatus = "not configured for this experience"
	else
		local ok, response = pcall(app.supporterTransport)
		if ok and type(response) == "table" and response.status == "Committed"
			and type(response.result) == "table"
			and type(response.result.passId) == "number"
			and response.result.passId > 0
			and response.result.name == "Supporter Crest"
			and type(response.result.value) == "string"
			and type(response.result.owned) == "boolean"
			and type(app.supporterProductInfo) == "function" then
			-- Query the player-side price each time the Store opens. A server
			-- cache cannot represent regional or test-cohort Robux prices.
			local infoOk, info = pcall(app.supporterProductInfo,
				response.result.passId)
			if infoOk and type(info) == "table"
				and info.Name == response.result.name
				and type(info.PriceInRobux) == "number"
				and info.PriceInRobux > 0
				and info.PriceInRobux % 1 == 0
				and type(info.IsForSale) == "boolean" then
				app.supporterOffer = {
					passId = response.result.passId,
					name = info.Name,
					price = info.PriceInRobux,
					forSale = info.IsForSale,
					owned = response.result.owned,
					value = response.result.value,
				}
				app.supporterStatus = nil
			else
				app.supporterOffer = nil
				app.supporterStatus = "Roblox price unavailable; retry later"
			end
		else
			app.supporterOffer = nil
			app.supporterStatus = ok and type(response) == "table"
				and tostring(response.reason or "Roblox offer unavailable")
				or "Roblox offer unavailable"
		end
	end
	StoreView.render(app)
	return app.supporterOffer ~= nil
end

function StoreView.promptSupporter(app)
	local offer = app.supporterOffer
	if type(offer) ~= "table" or offer.owned == true
		or offer.forSale ~= true or type(offer.price) ~= "number"
		or type(offer.passId) ~= "number" or offer.passId <= 0
		or type(app.supporterPrompt) ~= "function" then
		return false, "Supporter Crest is unavailable or already owned; refresh its status."
	end
	local ok = pcall(app.supporterPrompt, offer.passId)
	if not ok then
		return false, "Roblox purchase prompt could not open; no charge was made here."
	end
	return true, nil
end

-- A returning client must replay the one durable server-issued identity before
-- it can offer a fresh purchase. Handled/resolved keys prevent refresh loops.
function StoreView.reconcile(app)
	local recovery = app.profile and app.profile.storeRecovery or nil
	local key = StoreView.purchaseKey(recovery)
	if key == nil or key == app.store.storeRecoveryResolvedKey
		or key == app.store.storeRecoveryHandledKey then
		return false
	end
	app.store.storeRecoveryHandledKey = key
	app.Actions.buyEarnedPack(app, 0, recovery)
	return true
end

return StoreView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">StudioDemo</string>
            <string name="Source"><![CDATA[-- StudioDemo.luau — genuine in-Studio demonstration driver (session7-B).
-- Runs ONLY in a live Roblox session (Studio Play). Builds two REAL card
-- parts through the CardView binding path, faces the live camera at their
-- live midpoint, plays a REAL edge-contact motion beat, and exercises the
-- REAL Timeline pause/fast/skip/snapshot-recovery path. Each P6StudioChecks
-- workspace marker is published ONLY after its behaviour genuinely
-- completed and verified live — never unconditionally, never faked.
--
-- Markers published here (client-owned, visual/presentation + audio):
--   UACGCardView    after >=2 CardView products with image faces verified
--   UACGCameraFace  after the camera genuinely faces the live card midpoint
--   UACGContactBeat after the attacker edge really met the defender and
--                   returned to its anchor
--   UACGModeRecovery after pause/fast/skip/snapshot-recovery each genuinely
--                   executed on a real Timeline
--   UACGAudio*      after the 8-cue live Sound binding genuinely executed:
--                   UACGAudioSounds (count), UACGAudioLoaded (IsLoaded count),
--                   UACGAudioPlaying (any IsPlaying), UACGAudioDetail +
--                   UACGAudioError (exact engine facts). The folder UACGAudio
--                   carries the live Sounds for the P6 audio checks.
-- HUD marker (UACGHud) is published by UiView.buildHUD itself. Server-owned
-- data drills (UACGResetCycle, UACGSaveFailure) live in
-- src/server/StudioDemoDrill.server.luau.
--
-- Off-engine (plain Lua / Lune) every entrypoint returns nil + "studio-only"
-- and touches nothing, so Linux verification never mistakes this for
-- Studio evidence.

local StudioDemo = {}

StudioDemo.RULES_VERSION = "provisional-1"
-- Real roster identities for the demo pair (starter + iconic, both exist in
-- the frozen Cards roster; resolved live via Cards.getById).
StudioDemo.DEMO_IDS = { "NR-NARUTO-01", "BL-ICHIGO-01" }

-- Direct bare references (never rawget(_G)): in Roblox, `script`/`game`
-- resolve per-script environment; in plain Lua/Lune they are nil.
local function isRoblox()
	return script ~= nil and game ~= nil
end

function StudioDemo.isRoblox()
	return isRoblox()
end

-- Pure plan (testable off-engine): ordered demo steps, no engine calls.
function StudioDemo.plan()
	return {
		"cards", "camera", "contact", "modes", "audio",
	}
end

local function setWorkspaceAttr(workspaceObj, key, value)
	if workspaceObj == nil then
		return false
	end
	local ok = pcall(function()
		workspaceObj:SetAttribute(key, value)
	end)
	return ok
end

-- Step 1: build two REAL CardView products at the live geometry anchors.
-- Returns the two parts on success.
local function stepCards(app, workspaceObj)
	local M, R = app.M, app.R
	local old = nil
	pcall(function()
		old = workspaceObj:FindFirstChild("UACGStudioDemo")
	end)
	if old ~= nil then
		pcall(function()
			old:Destroy()
		end)
	end
	local folder = R.Instance.new("Folder")
	folder.Name = "UACGStudioDemo"
	folder.Parent = workspaceObj
	local parts = {}
	for i, id in ipairs(StudioDemo.DEMO_IDS) do
		local side = (i == 1) and "A" or "B"
		local alias = tostring(id)
		if M.Cards ~= nil and M.Cards.getById ~= nil then
			local ok, row = pcall(M.Cards.getById, id)
			if ok and type(row) == "table" and row.alias ~= nil then
				alias = tostring(row.alias)
			end
		end
		local built = M.CardView.build(folder, id, {
			alias = alias,
			artwork = "PLACEHOLDER-no-asset-id",
			theme = (app.store ~= nil and app.store.prefs ~= nil
				and app.store.prefs.theme == "Light") and "Light" or "Dark",
		}, R)
		if built == nil or built.part == nil then
			return nil, "card build failed for " .. tostring(id)
		end
		local ax = M.Geometry.anchorX(side)
		built.part.CFrame = R.CFrame.new(R.Vector3.new(
			ax, M.Geometry.ANCHOR_Y, M.Geometry.ANCHOR_Z))
		built.part.Orientation = R.Vector3.new(0, 180, 0)
		parts[#parts + 1] = built.part
	end
	-- Genuine verification BEFORE publishing: two anchored non-colliding
	-- CardView products, each carrying an image face.
	if #parts < 2 then
		return nil, "fewer than 2 demo cards built"
	end
	for _, p in ipairs(parts) do
		if p.Anchored ~= true then
			return nil, p.Name .. " not Anchored"
		end
		if p.CanCollide ~= false then
			return nil, p.Name .. " collides"
		end
		local faced = false
		for _, ch in ipairs(p:GetChildren()) do
			if ch:IsA("Decal") or ch:IsA("SurfaceGui") then
				faced = true
				break
			end
		end
		if not faced then
			return nil, p.Name .. " carries no image face"
		end
	end
	if not setWorkspaceAttr(workspaceObj, "UACGCardView", true) then
		return nil, "could not publish UACGCardView"
	end
	return parts, nil
end

-- Step 2: face the live camera at the LIVE card midpoint (never hardcoded).
local function stepCamera(app, workspaceObj, parts)
	local M, R = app.M, app.R
	local pa, pb = parts[1].Position, parts[2].Position
	local mid = R.Vector3.new(
		(pa.X + pb.X) / 2, (pa.Y + pb.Y) / 2, (pa.Z + pb.Z) / 2)
	local spec = M.BattleScene.cameraSpec()
	local cam = workspaceObj.CurrentCamera
	if cam == nil then
		cam = R.Instance.new("Camera")
		cam.Name = "UACGDemoCamera"
		cam.Parent = workspaceObj
		local okSet = pcall(function()
			workspaceObj.CurrentCamera = cam
		end)
		if not okSet then
			return nil, "no CurrentCamera and could not assign one"
		end
		cam = workspaceObj.CurrentCamera
	end
	local okFace = pcall(function()
		cam.CameraType = R.Enum.CameraType.Scriptable
		cam.CFrame = R.CFrame.new(
			R.Vector3.new(spec.position.x, spec.position.y, spec.position.z),
			mid)
		cam.FieldOfView = spec.fieldOfView
	end)
	if not okFace then
		return nil, "camera face failed"
	end
	-- Genuine verification: both illustrated faces visible from the live
	-- camera position (pure face math over live positions).
	local okDot, dots = pcall(function()
		local cpos = cam.CFrame.Position
		local function dotFor(part)
			return M.CardView.faceDot(
				{ x = cpos.X, y = cpos.Y, z = cpos.Z },
				{ x = part.Position.X, y = part.Position.Y,
					z = part.Position.Z },
				M.CardView.FACE_YAW_DEG)
		end
		return { dotFor(parts[1]), dotFor(parts[2]) }
	end)
	if not okDot or dots[1] <= 0 or dots[2] <= 0 then
		return nil, "camera does not face the live cards"
	end
	if not setWorkspaceAttr(workspaceObj, "UACGCameraFace", true) then
		return nil, "could not publish UACGCameraFace"
	end
	return true, nil
end

-- Step 3: REAL contact beat — attacker edge meets the defender edge, then
-- returns exactly to its anchor. Positions read live from Geometry.
local function stepContact(app, workspaceObj, parts)
	local M, R = app.M, app.R
	local attacker = parts[1]
	local anchorX = M.Geometry.anchorX("A")
	local contactX = M.Geometry.contactX("A")
	if anchorX == nil or contactX == nil then
		return nil, "unknown geometry side"
	end
	local y, z = M.Geometry.ANCHOR_Y, M.Geometry.ANCHOR_Z
	local function place(x)
		attacker.CFrame = R.CFrame.new(R.Vector3.new(x, y, z))
	end
	-- Lunge out in visible steps, hold the contact beat, return.
	local steps = 8
	for i = 1, steps do
		local k = i / steps
		place(anchorX + (contactX - anchorX) * k)
		task.wait(0.03)
	end
	local held = attacker.Position.X
	task.wait(M.Geometry.CONTACT_S + 0.05)
	for i = 1, steps do
		local k = i / steps
		place(contactX + (anchorX - contactX) * k)
		task.wait(0.03)
	end
	-- Genuine verification: edge meet happened (held at contact) and the
	-- attacker is back at its anchor before the marker is published.
	if math.abs(held - contactX) > 0.05 then
		return nil, "attacker never reached the defender edge"
	end
	if math.abs(attacker.Position.X - anchorX) > 0.05 then
		return nil, "attacker did not return to its anchor"
	end
	if not setWorkspaceAttr(workspaceObj, "UACGContactBeat", true) then
		return nil, "could not publish UACGContactBeat"
	end
	return true, nil
end

-- Step 4: REAL mode recovery on a REAL Timeline — pause freezes, fast
-- re-times, skip finishes, snapshot restore (reconnect path) recovers.
local function stepModes(app, workspaceObj)
	local M = app.M
	local events = {
		{ id = "e0001", seq = 1, kind = "strike", side = "A",
			card = StudioDemo.DEMO_IDS[1] },
		{ id = "e0002", seq = 2, kind = "turn_start", side = "A", turn = 1 },
	}
	local tl = M.Timeline.new("uacg-studio-demo", events, nil, { speed = 1 })
	if tl == nil then
		return nil, "timeline construction failed"
	end
	-- Pause: advance while paused presents nothing and holds the cursor.
	M.Timeline.pause(tl)
	if tl.paused ~= true then
		return nil, "pause did not engage"
	end
	local n0 = M.Timeline.advance(tl, 1.0, nil)
	if n0 ~= 0 or tl.cursor ~= 1 then
		return nil, "paused timeline advanced (freeze broken)"
	end
	-- Fast: resume at 2x re-times shorter than 1x.
	M.Timeline.resume(tl)
	local okSpeed = M.Timeline.setSpeed(tl, 2)
	if not okSpeed or tl.speed ~= 2 then
		return nil, "fast speed did not engage"
	end
	local d1 = M.Timeline.eventDuration(tl, events[1])
	M.Timeline.setSpeed(tl, 1)
	local dSlow = M.Timeline.eventDuration(tl, events[1])
	M.Timeline.setSpeed(tl, 2)
	if not (d1 < dSlow) then
		return nil, "fast timing not shorter than normal"
	end
	-- Skip: jumps to done without replaying grants.
	local okSkip = M.Timeline.skip(tl, nil)
	if not okSkip or not M.Timeline.isDone(tl) then
		return nil, "skip did not finish the timeline"
	end
	-- Reconnect: authoritative snapshot restore recovers cleanly.
	local snap = { finalA = { hp = 10 }, finalB = { hp = 0 },
		winner = "A" }
	local restored = M.Timeline.restoreSnapshot(tl, snap)
	if restored == nil or restored.winner ~= "A" then
		return nil, "snapshot restore (reconnect) failed"
	end
	local fin = M.Timeline.finalState(tl)
	if fin == nil or fin.winner ~= "A" then
		return nil, "final state unreadable after restore"
	end
	if not setWorkspaceAttr(workspaceObj, "UACGModeRecovery", true) then
		return nil, "could not publish UACGModeRecovery"
	end
	return true, nil
end

-- Step 5: REAL audio binding — all 8 catalog cues become live Sounds via
-- AudioEngine.bindAll (menu_music looped for the tutorial screen shown at
-- boot, contact_normal for the Timeline contact beat, the rest bound to
-- their cues), then the engine itself is asked: IsLoaded/TimeLength per
-- sound after a short load wait, Play() on menu + contact, IsPlaying read
-- back live. Markers publish the EXACT numbers even when 0 load (honest
-- blocker, never a green lie): the P6 audio checks then assert on them.
local function stepAudio(app, workspaceObj)
	local M = app.M
	local Engine = M.AudioEngine
	if Engine == nil then
		local ok, mod = pcall(function()
			return require(script.Parent.AudioEngine)
		end)
		if ok then
			Engine = mod
		end
	end
	if Engine == nil or Engine.bindAll == nil then
		return nil, "AudioEngine absent"
	end
	local folder, info = Engine.bindAll(app, workspaceObj)
	if folder == nil then
		return nil, tostring(info or "bind failed")
	end
	-- Load wait: poll IsLoaded up to ~5s (local-attempt ids are expected
	-- to stay unloaded — the engine proves it).
	local waited = 0
	while waited < 5 do
		local anyLoaded = false
		pcall(function()
			for _, ch in ipairs(folder:GetChildren()) do
				if ch:IsA("Sound") and ch.IsLoaded == true then
					anyLoaded = true
				end
			end
		end)
		if anyLoaded then
			break
		end
		task.wait(1)
		waited = waited + 1
	end
	-- Play the screen-honest cues: menu_music (tutorial is shown at boot)
	-- plus the contact-beat SFX. Battle_music stays bound but paused
	-- outside battle (no battle in the demo — never claimed).
	pcall(function()
		Engine.playCue(app, "menu_music")
	end)
	pcall(function()
		Engine.playCue(app, "contact_normal")
	end)
	pcall(function()
		if app.M ~= nil and app.M.Audio ~= nil and app.audio ~= nil then
			app.M.Audio.contactCue(app.audio, { speed = 1 })
		end
	end)
	task.wait(1)
	-- Read back REAL engine facts only.
	local sounds, loaded, playing = 0, 0, false
	local detailParts = {}
	pcall(function()
		for _, ch in ipairs(folder:GetChildren()) do
			if ch:IsA("Sound") then
				sounds = sounds + 1
				local il, tl, ip, sid = false, 0, false, ""
				pcall(function()
					il = ch.IsLoaded == true
				end)
				pcall(function()
					tl = tonumber(ch.TimeLength) or 0
				end)
				pcall(function()
					ip = ch.IsPlaying == true
				end)
				pcall(function()
					sid = tostring(ch.SoundId)
				end)
				if il and tl > 0 then
					loaded = loaded + 1
				end
				if ip then
					playing = true
				end
				detailParts[#detailParts + 1] = ch.Name .. ":loaded="
					.. tostring(il) .. ":len=" .. tostring(tl)
					.. ":playing=" .. tostring(ip) .. ":id=" .. sid
			end
		end
	end)
	local errText = "none"
	if loaded == 0 then
		errText = "0/8 IsLoaded: rbxasset local-attempt ids carry no "
			.. "playable bytes (Sound needs uploaded rbxassetid://; no "
			.. "upload performed, no id invented)"
	end
	if not setWorkspaceAttr(workspaceObj, "UACGAudioSounds", sounds) then
		return nil, "could not publish UACGAudioSounds"
	end
	setWorkspaceAttr(workspaceObj, "UACGAudioLoaded", loaded)
	setWorkspaceAttr(workspaceObj, "UACGAudioPlaying", playing)
	setWorkspaceAttr(workspaceObj, "UACGAudioDetail",
		string.sub(table.concat(detailParts, " | "), 1, 900))
	setWorkspaceAttr(workspaceObj, "UACGAudioError", string.sub(errText, 1, 400))
	return true, nil
end

-- Full run: each step guarded so one failure never blocks the others, and
-- a failed step publishes NOTHING for its marker (honest partial credit).
-- Returns a per-step report table.
function StudioDemo.run(app, workspaceObj)
	if not isRoblox() then
		return nil, "studio-only"
	end
	if app == nil or app.M == nil or app.R == nil or workspaceObj == nil then
		return nil, "missing app/workspace"
	end
	local report = {}
	local errors = {}
	local parts = nil
	local ok, res, err = pcall(stepCards, app, workspaceObj)
	report.cards = ok and res ~= nil
	if not report.cards then
		-- pcall failure: res IS the error; logic failure: err is the reason.
		errors.cards = tostring(ok and err or res)
	end
	if report.cards then
		parts = res
	end
	if parts ~= nil then
		local okCam, resCam, errCam = pcall(stepCamera, app, workspaceObj,
			parts)
		report.camera = (okCam and resCam == true)
		if not report.camera then
			errors.camera = tostring(okCam and errCam or resCam)
		end
		local okCon, resCon, errCon = pcall(stepContact, app, workspaceObj,
			parts)
		report.contact = (okCon and resCon == true)
		if not report.contact then
			errors.contact = tostring(okCon and errCon or resCon)
		end
	else
		report.camera = false
		report.contact = false
	end
	local okModes, resModes, errModes = pcall(stepModes, app, workspaceObj)
	report.modes = (okModes and resModes == true)
	if not report.modes then
		errors.modes = tostring(okModes and errModes or resModes)
	end
	local okAud, resAud, errAud = pcall(stepAudio, app, workspaceObj)
	report.audio = (okAud and resAud == true)
	if not report.audio then
		errors.audio = tostring(okAud and errAud or resAud)
	end
	-- Observability only (never a check marker): one console line naming
	-- which behaviours genuinely completed this run, with failure reasons.
	pcall(function()
		print(string.format(
			"[UACGStudioDemo] steps cards=%s camera=%s contact=%s modes=%s audio=%s "
				.. "errors cards=[%s] camera=[%s] contact=[%s] modes=[%s] audio=[%s]",
			tostring(report.cards), tostring(report.camera),
			tostring(report.contact), tostring(report.modes),
			tostring(report.audio),
			tostring(errors.cards), tostring(errors.camera),
			tostring(errors.contact), tostring(errors.modes),
			tostring(errors.audio)))
	end)
	return report, nil
end

return StudioDemo
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="62">
          <Properties>
            <string name="Name">StudioSelfReport</string>
            <string name="Source"><![CDATA[-- StudioSelfReport.client.luau — session7-B: client-vantage self-report.
-- This is a LocalScript (run by Roblox on the CLIENT in a Play session),
-- NOT a ModuleScript: never required by Lune/plain-Lua tests, never executes
-- off-engine. It evaluates the SAME ported P6StudioChecks suite as the server
-- reporter, but from the only vantage where all ten assertions are genuinely
-- decidable: the client owns the camera, the PlayerGui HUD, and the live
-- CardView parts, while server-published data-drill attributes replicate
-- down to it. (Server-side LocalPlayer is always nil and client-built parts
-- never replicate up, so the server reporter structurally cannot evaluate
-- hud-present / cards / cardview / camera / contact / modes — that is a
-- vantage limit, not a game defect. Both reporters print; the console lines
-- name their vantage.)
--
-- Reporting is console-only (LocalScripts cannot use HttpService for the
-- localhost POST): one tiny HEAD line plus small PART lines, all
-- independently-parseable JSON well under Studio's ~1k log-line cap (the
-- previous single-line report hit 953 chars and was truncated mid-string).
-- The studio-device connector reassembles HEAD+PARTs by sequence id and
-- REFUSES when any part is missing. The route is always named.
--
-- Lines (every line valid alone; manifest hash rides the HEAD so the
-- connector's build check can pass without the per-cue detail):
--   JEV_STUDIO_RESULT_CLIENT_HEAD {seq,vantage,suite,place,verdict,
--     runtime,atUtc,checks,fails,manifest_sha256,route,
--     audio:{sounds,loaded,playing},parts:N}
--   JEV_STUDIO_RESULT_CLIENT_PART {seq,i,n,cues:[<=3 rows]}
--
-- Timing: waits for the Boot demo + server drills + replication (polls the
-- workspace markers up to ~25s), then runs once. Every step pcall-guarded;
-- failure to run is an honest NOT_RUN line, never a fabricated PASS.

local MARKER_HEAD = "JEV_STUDIO_RESULT_CLIENT_HEAD"
local MARKER_PART = "JEV_STUDIO_RESULT_CLIENT_PART"
local DELAY_S = 20
local POLL_S = 25

local function short(s, n)
	s = tostring(s or "")
	if #s > n then
		return string.sub(s, 1, n) .. "..."
	end
	return s
end

local function clientReport()
	local ok, err = pcall(function()
		local players = game:GetService("Players")
		local player = players.LocalPlayer
		if player == nil then
			print(MARKER_HEAD .. " "
				.. '{"verdict":"NOT_RUN","vantage":"client",'
				.. '"blocker":"no LocalPlayer on this client"}')
			return
		end
		player:WaitForChild("PlayerGui", 10)
		local rs = game:GetService("ReplicatedStorage")

		-- Grace window: Boot demo (~6s) + server drills (~3s) + replication.
		task.wait(DELAY_S)
		local waited = 0
		while waited < POLL_S do
			local haveCards = workspace:GetAttribute("UACGCardView") == true
			local haveDrills = workspace:GetAttribute("UACGResetCycle")
				~= nil
			if haveCards and haveDrills then
				break
			end
			task.wait(1)
			waited = waited + 1
		end

		local shared = rs:WaitForChild("Shared", 10)
		local studio = shared ~= nil
			and shared:WaitForChild("Studio", 10) or nil
		local mod = studio ~= nil
			and studio:WaitForChild("P6StudioChecks", 10) or nil
		if mod == nil then
			print(MARKER_HEAD .. " "
				.. '{"verdict":"NOT_RUN","vantage":"client",'
				.. '"blocker":"P6StudioChecks module absent"}')
			return
		end
		local Checks = require(mod)
		local verdict, meta = Checks.run()
		if type(meta) ~= "table" then
			meta = {}
		end
		-- Audio section: REAL engine facts only (client vantage is
		-- authoritative for player-facing sound; server cannot hear
		-- client-built sounds). Never reports playing unless IsPlaying.
		local audio = { vantage = "client", sounds = 0,
			loaded = 0, playing = 0, perCue = {} }
		pcall(function()
			local folder = workspace:FindFirstChild("UACGAudio")
			if folder == nil then
				local svc = game:GetService("SoundService")
				if svc ~= nil then
					folder = svc:FindFirstChild("UACGAudio")
				end
			end
			if folder ~= nil then
				for _, ch in ipairs(folder:GetChildren()) do
					if ch:IsA("Sound") then
						local row = { purpose = tostring(ch.Name) }
						pcall(function()
							row.soundId = tostring(ch.SoundId)
						end)
						pcall(function()
							row.isLoaded = (ch.IsLoaded == true)
						end)
						pcall(function()
							row.timeLength = tonumber(ch.TimeLength) or 0
						end)
						pcall(function()
							row.isPlaying = (ch.IsPlaying == true)
						end)
						pcall(function()
							row.looped = (ch.Looped == true)
						end)
						audio.sounds = audio.sounds + 1
						if row.isLoaded == true and (row.timeLength or 0) > 0 then
							audio.loaded = audio.loaded + 1
						end
						if row.isPlaying == true then
							audio.playing = audio.playing + 1
						end
						audio.perCue[#audio.perCue + 1] = row
					end
				end
			end
			pcall(function()
				audio.attrSounds = workspace:GetAttribute("UACGAudioSounds")
			end)
			pcall(function()
				audio.attrLoaded = workspace:GetAttribute("UACGAudioLoaded")
			end)
			pcall(function()
				audio.attrPlaying = workspace:GetAttribute("UACGAudioPlaying")
			end)
			pcall(function()
				audio.attrError = workspace:GetAttribute("UACGAudioError")
			end)
		end)
		local http = game:GetService("HttpService")
		-- Build binding (same stamp the server reporter reads): the
		-- connector refuses any result that does not name the current
		-- manifest hash. Absent stamp reports "absent", never invented.
		local manifestHash = "absent"
		pcall(function()
			local stamp = rs:FindFirstChild("UACGManifestHash")
			if stamp ~= nil and stamp:IsA("StringValue") then
				manifestHash = tostring(stamp.Value)
			end
		end)
		local line = nil
		local okLine = pcall(function()
			-- Sequence id binds this run's HEAD to its PARTs (same second
			-- + same build can repeat across Play presses; the random tail
			-- keeps runs apart so the connector never mixes runs).
			local seq = tostring(meta.atUtc or "n/a") .. "-"
				.. string.sub(tostring(manifestHash), 1, 8) .. "-"
				.. tostring(math.random(100000, 999999))
			local cues = audio.perCue or {}
			-- Chunk size 3: one cue row is ~115 chars JSON, so a PART
			-- line stays near ~450 chars — far under the log cap.
			local chunk = 3
			local n = math.max(1,
				math.floor((#cues + chunk - 1) / chunk))
			local head = http:JSONEncode({
				vantage = "client",
				suite = "P6StudioChecks",
				place = "UntitledAnimeCardGame",
				verdict = tostring(verdict or "NOT_RUN"),
				runtime = tostring(meta.runtime or "studio"),
				atUtc = tostring(meta.atUtc or "n/a"),
				checks = meta.checks,
				fails = meta.fails,
				manifest_sha256 = manifestHash,
				route = "console-marker",
				audio = {
					sounds = audio.sounds,
					loaded = audio.loaded,
					playing = audio.playing,
				},
				seq = seq,
				parts = n,
			})
			print(MARKER_HEAD .. " " .. head)
			for i = 1, n do
				local rows = {}
				for j = (i - 1) * chunk + 1,
					math.min(i * chunk, #cues) do
					rows[#rows + 1] = cues[j]
				end
				print(MARKER_PART .. " " .. http:JSONEncode({
					seq = seq,
					i = i,
					n = n,
					cues = rows,
				}))
			end
			line = head
		end)
		if not okLine or type(line) ~= "string" then
			print(MARKER_HEAD .. " "
				.. '{"vantage":"client","verdict":"'
				.. short(verdict, 32) .. '"}')
		end
	end)
	if not ok then
		print(MARKER_HEAD .. " "
			.. '{"verdict":"NOT_RUN","vantage":"client",'
			.. '"blocker":"client reporter crashed: '
			.. short(err, 160) .. '"}')
	end
end

task.spawn(clientReport)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">Theme</string>
            <string name="Source"><![CDATA[-- Theme.luau — native semantic UI tokens (P4). Pure Luau/plain-Lua subset.
-- Quotes director brief docs/brief.md tokens EXACTLY (identity: Skybridge
-- world; monochrome UI; UI never inherits world lighting):
--   Dark:  bg #0B0B0C panel #171719 textPrimary #F5F5F5 textMuted #B5B5BC
--          border #45454C action #F5F5F5 actionText #111113 focus #FFFFFF
--   Light: bg #FAFAFA panel #FFFFFF textPrimary #111113 textMuted #57575F
--          border #D4D4D8 action #111113 actionText #FFFFFF focus #111113
-- Geometry: 8px corners, 4px spacing unit, 16px body, minimum 44px target.
-- World palette is INDEPENDENT (see World.luau): UI roles never read world
-- lighting. Rarity/status/error carry text/symbol, never color alone.

local Theme = {}

Theme.REVISION = "p4-provisional-1"

Theme.DARK = {
	background = "#0B0B0C",
	panel = "#171719",
	textPrimary = "#F5F5F5",
	textMuted = "#B5B5BC",
	border = "#45454C",
	action = "#F5F5F5",
	actionText = "#111113",
	focus = "#FFFFFF",
}

Theme.LIGHT = {
	background = "#FAFAFA",
	panel = "#FFFFFF",
	textPrimary = "#111113",
	textMuted = "#57575F",
	border = "#D4D4D8",
	action = "#111113",
	actionText = "#FFFFFF",
	focus = "#111113",
}

-- The semantic tokens above remain compatible with saved themes. UI stays
-- clean monochrome while the independent Skybridge world carries the color.
-- Every colored rarity is also spelled out; color never carries meaning alone.
Theme.ARCHIVE = {
	Dark = {
		canvas = "#0B0B0C", surface = "#171719", raised = "#242427",
		text = "#F5F5F5", muted = "#B5B5BC", border = "#45454C",
		accent = "#F5F5F5", onAccent = "#111113",
		aqua = "#C5CBD4", alert = "#F19893",
	},
	Light = {
		canvas = "#FAFAFA", surface = "#FFFFFF", raised = "#F0F0F2",
		text = "#111113", muted = "#57575F", border = "#D4D4D8",
		accent = "#111113", onAccent = "#FFFFFF",
		aqua = "#57575F", alert = "#9C3738",
	},
}

Theme.RARITY_COLOR = {
	Common = "#D1D8E0", Uncommon = "#82E1C5", Rare = "#85B7FF",
	Epic = "#D5A6FF", Legendary = "#F3C36A", Mythic = "#FF9DBA",
}

function Theme.archiveTokens(mode)
	return Theme.ARCHIVE[mode == "Light" and "Light" or "Dark"]
end

function Theme.currentArchiveTokens()
	return Theme.archiveTokens(Theme._mode)
end

function Theme.rarityColor(name)
	return Theme.RARITY_COLOR[name] or Theme.RARITY_COLOR.Common
end

Theme.CORNER_PX = 8
Theme.SPACING_PX = 4
Theme.BODY_PX = 16
Theme.MIN_TOUCH_PX = 44

Theme._mode = "Dark"
Theme._accent = nil

function Theme.modes()
	return { "Dark", "Light" }
end

function Theme.current()
	return Theme._mode
end

function Theme.tokens(mode)
	if mode == "Light" then
		return Theme.LIGHT
	end
	return Theme.DARK
end

function Theme.currentTokens()
	return Theme.tokens(Theme._mode)
end

function Theme.setMode(mode)
	if mode ~= "Dark" and mode ~= "Light" then
		return false, "unknown theme (Dark/Light only)"
	end
	Theme._mode = mode
	return true, nil
end

local function hexToRGB(hex)
	local r = tonumber(string.sub(hex, 2, 3), 16)
	local g = tonumber(string.sub(hex, 4, 5), 16)
	local b = tonumber(string.sub(hex, 6, 7), 16)
	if r == nil or g == nil or b == nil then
		return nil
	end
	return { r = r / 255, g = g / 255, b = b / 255 }
end

local function luminance(rgb)
	local function chan(c)
		if c <= 0.03928 then
			return c / 12.92
		end
		return ((c + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * chan(rgb.r) + 0.7152 * chan(rgb.g) + 0.0722 * chan(rgb.b)
end

-- WCAG-style contrast ratio of two hex colors (1..21).
function Theme.contrastRatio(hexA, hexB)
	local a = hexToRGB(hexA)
	local b = hexToRGB(hexB)
	if a == nil or b == nil then
		return nil, "bad hex"
	end
	local l1 = luminance(a)
	local l2 = luminance(b)
	if l1 < l2 then
		l1, l2 = l2, l1
	end
	return (l1 + 0.05) / (l2 + 0.05)
end

-- Custom accent must stay readable: it must contrast >= 4.5 against the
-- active background AND its label text must contrast >= 4.5 on the accent.
-- Rejected accents return false + explanation (brief requirement).
function Theme.setAccent(hex)
	if type(hex) ~= "string" or #hex ~= 7 or string.sub(hex, 1, 1) ~= "#" then
		return false, "accent must be #RRGGBB"
	end
	if hexToRGB(hex) == nil then
		return false, "accent has non-hex digits"
	end
	local bg = Theme.currentTokens().background
	local ratioBg, err = Theme.contrastRatio(hex, bg)
	if ratioBg == nil then
		return false, err
	end
	if ratioBg < 4.5 then
		return false, "accent " .. hex .. " contrast " .. string.format("%.2f", ratioBg)
			.. " vs background " .. bg .. " is below 4.5 — pick a brighter/darker accent"
	end
	local archiveSurface = Theme.currentArchiveTokens().surface
	local ratioSurface = Theme.contrastRatio(hex, archiveSurface)
	if ratioSurface < 4.5 then
		return false, "accent " .. hex .. " contrast "
			.. string.format("%.2f", ratioSurface)
			.. " vs card panel " .. archiveSurface
			.. " is below 4.5 — pick a brighter/darker accent"
	end
	-- Label on accent: try both dark and light label; one must pass.
	local onDark = Theme.contrastRatio("#111113", hex)
	local onLight = Theme.contrastRatio("#FFFFFF", hex)
	local best = onDark
	if onLight ~= nil and (best == nil or onLight > best) then
		best = onLight
	end
	if best == nil or best < 4.5 then
		return false, "no readable label color reaches 4.5 on accent " .. hex
	end
	Theme._accent = hex
	return true, nil
end

function Theme.accent()
	return Theme._accent
end

-- Reset to Dark/Light always available (brief requirement).
function Theme.reset()
	Theme._mode = "Dark"
	Theme._accent = nil
	return Theme.DARK
end

function Theme.minTouchPx()
	return Theme.MIN_TOUCH_PX
end

-- Status/rarity/error never color-alone: every entry carries text + symbol.
Theme.STATUS = {
	none = { text = "OK", symbol = "●" },
	burn = { text = "Burn", symbol = "▲" },
	stun = { text = "Stun", symbol = "◆" },
	shield = { text = "Shield", symbol = "■" },
	ko = { text = "KO", symbol = "✕" },
	pending = { text = "Confirming…", symbol = "…" },
}

function Theme.statusLabel(name)
	local e = Theme.STATUS[name]
	if e ~= nil then
		return e
	end
	return { text = tostring(name), symbol = "?" }
end

Theme.RARITY = {
	Common = { text = "Common", symbol = "C" },
	Uncommon = { text = "Uncommon", symbol = "U" },
	Rare = { text = "Rare", symbol = "R" },
	Epic = { text = "Epic", symbol = "E" },
	Legendary = { text = "Legendary", symbol = "L" },
	Mythic = { text = "Mythic", symbol = "M" },
}

function Theme.rarityLabel(name)
	local e = Theme.RARITY[name]
	if e ~= nil then
		return e
	end
	return { text = tostring(name), symbol = "?" }
end

return Theme
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">Timeline</string>
            <string name="Source"><![CDATA[-- Timeline.luau — cancellable client presentation timeline (P4).
-- Pure Luau/plain-Lua subset (no engine calls). Consumes P2 stable events
-- (run pieces/P2/API.md): every event { id, seq, kind, side, card, target,
-- amount, hp, shield, status, turn, winner, reason, detail } with stable ids
-- e0001…. Composite key battleId .. ":" .. event.seq (stable across replays).
-- PRESENTATION ONLY: speed/pause/skip/reduced modes never change the
-- authoritative result or reward cadence; tween callbacks never grant.
-- Damage/status HUD advances at the CONTACT beat, not after return.

local Timeline = {}

Timeline.RULES_VERSION = "provisional-1"
Timeline.DEDUP_CAP = 512
Timeline.SPEEDS = { 1, 2, 4 }

local function loadSibling(name)
	if script ~= nil then
		-- Direct field access: script is Instance userdata in Roblox
		-- (rawget on userdata is invalid); FindFirstChild is the API.
		local parent = script.Parent
		if parent ~= nil then
			local child = parent:FindFirstChild(name)
			if child ~= nil then
				return require(child)
			end
		end
	end
	if dofile ~= nil then
		local here = debug.getinfo(1, "S").source
		local dir = string.match(here, "@(.*/)") or "./src/client/"
		return dofile(dir .. name .. ".luau")
	else
		return require("./" .. name)
	end
end

local Geometry = loadSibling("Geometry")

function Timeline.compositeKey(battleId, seq)
	return tostring(battleId) .. ":" .. tostring(seq)
end

function Timeline.isSpeed(s)
	return s == 1 or s == 2 or s == 4
end

function Timeline.newToken()
	return { cancelled = false }
end

function Timeline.cancel(token)
	if token ~= nil then
		token.cancelled = true
	end
end

function Timeline.isCancelled(token)
	return token ~= nil and token.cancelled == true
end

-- Map one server event to presentation cues. `damageAppliedAt` is ALWAYS
-- "contact" for strike/damage/status (never "after-return").
function Timeline.cueFor(event)
	local kind = event.kind
	if kind == "strike" then
		return { anim = "attack", damageAppliedAt = "contact", flash = true }
	elseif kind == "damage" or kind == "shield_absorb" then
		return { anim = "impact", damageAppliedAt = "contact", flash = true }
	elseif kind == "status_applied" or kind == "status_tick" or kind == "entry_effect" then
		return { anim = "status", damageAppliedAt = "contact", flash = false }
	elseif kind == "ko" then
		return { anim = "defeat", damageAppliedAt = "contact", flash = false }
	elseif kind == "replacement" then
		return { anim = "replacement", damageAppliedAt = "contact", flash = false }
	elseif kind == "battle_end" or kind == "timeout" then
		return { anim = "settle", damageAppliedAt = "contact", flash = false }
	end
	return { anim = "hold", damageAppliedAt = "contact", flash = false }
end

-- Keep hit feedback visible without a broad brightness pulse when reduced
-- flash is enabled. The presenter maps these stable modes to a fill pulse or
-- an outline-only pulse on the struck card.
function Timeline.flashPresentation(event, reducedFlash)
	if not Timeline.cueFor(event).flash then
		return "none"
	end
	return reducedFlash == true and "outline" or "fill"
end

-- Create a timeline over an ordered event array.
-- opts: { speed=1|2|4, reducedMotion=bool, reducedFlash=bool }
function Timeline.new(battleId, events, snapshot, opts)
	opts = opts or {}
	local speed = opts.speed or 1
	if not Timeline.isSpeed(speed) then
		return nil, "unsupported speed (1/2/4 only)"
	end
	local tl = {
		battleId = battleId,
		events = events or {},
		snapshot = snapshot,
		speed = speed,
		reducedMotion = opts.reducedMotion == true,
		reducedFlash = opts.reducedFlash == true,
		cursor = 1,
		elapsed = 0,
		acc = 0,
		paused = false,
		seen = {},
		seenCount = 0,
		highWater = 0,
		applied = {},
		transients = {},
		done = false,
	}
	return tl
end

function Timeline.markSeen(tl, event)
	local key = Timeline.compositeKey(tl.battleId, event.seq)
	if tl.seen[key] then
		return false -- duplicate: skip presentation, never double-apply
	end
	tl.seen[key] = true
	tl.seenCount = tl.seenCount + 1
	-- No eviction: the server bounds battles to MAX_EVENTS (1000), so the
	-- seen set is inherently bounded and repeat effects are impossible.
	-- highWater tracks the highest contiguously applied seq for resume.
	if event.seq == tl.highWater + 1 then
		tl.highWater = event.seq
	end
	return true
end

function Timeline.pause(tl)
	tl.paused = true
end

function Timeline.resume(tl)
	tl.paused = false
end

function Timeline.setSpeed(tl, s)
	if not Timeline.isSpeed(s) then
		return false, "unsupported speed (1/2/4 only)"
	end
	tl.speed = s
	return true, nil
end

-- Duration of one event's presentation in seconds (scaled by speed).
function Timeline.eventDuration(tl, event)
	local base = 0.05
	local cue = Timeline.cueFor(event)
	if cue.anim == "attack" then
		base = Geometry.WINDUP_S + Geometry.LUNGE_S + Geometry.CONTACT_S + Geometry.RECOIL_S
	elseif cue.anim == "impact" or cue.anim == "status" then
		base = Geometry.CONTACT_S + 0.08
	elseif cue.anim == "defeat" or cue.anim == "replacement" then
		base = Geometry.DEFEAT_S
	end
	return base / tl.speed
end

-- Advance the presentation clock by REAL elapsed time: fractional dt
-- accumulates and each event emits only when its prescribed duration has
-- fully elapsed (contact beat included). No forced one-event-per-frame:
-- emission rate is duration-driven (e.g. a 0.55s strike ≈ 2/s at 1x, not
-- 60/s), FPS-independent, speed-scaled, with exact known timing preserved.
-- Pause freezes everything (caller holds dt while paused). Applies HUD state
-- at the contact beat. Returns count of events presented this step.
function Timeline.advance(tl, dt, token)
	if Timeline.isCancelled(token) then
		return 0, "cancelled"
	end
	if tl.paused or tl.done then
		return 0, nil
	end
	if dt == nil or dt < 0 then
		return 0, "bad dt"
	end
	tl.elapsed = tl.elapsed + dt
	tl.acc = (tl.acc or 0) + dt
	local presented = 0
	while tl.cursor <= #tl.events do
		local ev = tl.events[tl.cursor]
		local key = Timeline.compositeKey(tl.battleId, ev.seq)
		if tl.seen[key] then
			-- Duplicate ID: consume cursor, apply nothing twice.
			tl.cursor = tl.cursor + 1
		else
			local dur = Timeline.eventDuration(tl, ev)
			if tl.acc + 1e-9 < dur then
				break
			end
			Timeline.markSeen(tl, ev)
			tl.acc = tl.acc - dur
			-- Contact-beat application (damage/status at contact, not after
			-- return): record authoritative HUD values from the event.
			tl.applied[Timeline.compositeKey(tl.battleId, ev.seq)] = {
				hp = ev.hp,
				shield = ev.shield,
				status = ev.status,
				kind = ev.kind,
			}
			tl.transients[#tl.transients + 1] = ev.id
			tl.cursor = tl.cursor + 1
			presented = presented + 1
		end
		if tl.cursor > #tl.events then
			tl.done = true
		end
	end
	return presented, nil
end

-- Skip: clear transients, jump cursor to end, keep the FINAL snapshot only.
-- Never replays grants (presentation cursor move, not an economic claim).
function Timeline.skip(tl, token)
	if Timeline.isCancelled(token) then
		return false, "cancelled"
	end
	tl.transients = {}
	tl.cursor = #tl.events + 1
	tl.done = true
	-- Mark every event seen so a later advance/replay cannot double-apply.
	for i = 1, #tl.events do
		local ev = tl.events[i]
		tl.seen[Timeline.compositeKey(tl.battleId, ev.seq)] = true
	end
	return true, nil
end

-- Full reset for snapshot restore / reconnect resume: clears cursor,
-- high-water, seen, applied and transients together — never a half-reset.
function Timeline.reset(tl)
	tl.cursor = 1
	tl.highWater = 0
	tl.seen = {}
	tl.seenCount = 0
	tl.applied = {}
	tl.transients = {}
	tl.elapsed = 0
	tl.acc = 0
	tl.done = false
end

function Timeline.isDone(tl)
	return tl.done
end

-- Restore an authoritative snapshot (reconnect/resume): full reset, then
-- rebind the snapshot. Returns snapshot active/reserve.
function Timeline.restoreSnapshot(tl, snapshot)
	if snapshot == nil then
		return nil, "missing snapshot"
	end
	Timeline.reset(tl)
	tl.snapshot = snapshot
	return {
		finalA = snapshot.finalA,
		finalB = snapshot.finalB,
		winner = snapshot.winner,
	}, nil
end

function Timeline.finalState(tl)
	if tl.snapshot == nil then
		return nil, "no snapshot bound"
	end
	return tl.snapshot
end

return Timeline
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">UiView</string>
            <string name="Source"><![CDATA[-- UiView.luau — Skybridge world overlay, screen construction and focus.
-- A compact translucent left rail keeps the world in view; battle remains a
-- separate transparent overlay. No transport, outcomes or battle math here.
-- No transport, outcome decisions or battle math live here.

local UiView = {}
local CardMotif
if script ~= nil then
	CardMotif = require(script.Parent.CardMotif)
elseif dofile ~= nil then
	CardMotif = dofile("./src/client/CardMotif.luau")
else
	CardMotif = require("./CardMotif")
end

UiView.RULES_VERSION = "provisional-1"

-- Layout contract per screen. coversCenter=false screens keep the 3D
-- stage visible: chrome is pinned top/bottom, the middle stays open.
function UiView.layoutSpec(id)
	if id == "encounter" then
		return {
			coversCenter = false,
			topBarScale = 0.14,
			bottomBarScale = 0.16,
			note = "transparent center; controls in a contained bottom bar",
		}
	end
	return {
		coversCenter = false,
		topBarScale = 0.12,
		bottomBarScale = 0.12,
		note = "compact world-backed navigation and contained scrolling rail",
	}
end

-- Keep the reading rail broad enough for touch on portrait devices while
-- leaving most of the landscape stage visible on desktop.
function UiView.overlayWidth(viewportWidth)
	if type(viewportWidth) == "number" and viewportWidth >= 900 then
		return { scale = 0.4, offset = -24, maxPx = 460 }
	end
	return { scale = 1, offset = -24, maxPx = 460 }
end

-- Paint one native component: hex tokens → real Color3 via the runtime.
-- Role "focused" paints the visible focus ring (theme focus token).
function UiView.paint(app, inst, role)
	local M = app.M
	if M.Theme == nil or inst == nil then
		return
	end
	local R = app.R
	local t = M.Theme.currentTokens()
	local a = M.Theme.currentArchiveTokens()
	local accent = M.Theme.accent()
	local class = inst.ClassName or ""
	local function col(hex)
		return R.Color3.fromHex(hex)
	end
	if role == "focused" then
		if class == "TextButton" then
			inst.BackgroundColor3 = col(t.focus)
			inst.TextColor3 = col(t.background)
		elseif class == "TextLabel" then
			inst.BackgroundTransparency = 1
			inst.TextColor3 = col(t.focus)
		elseif class == "Frame" or class == "ScrollingFrame" then
			inst.BackgroundColor3 = col(t.panel)
		end
	elseif class == "Frame" or class == "ScrollingFrame" then
		local color = a.surface
		if role == "canvas" then color = a.canvas end
		if role == "raised" then color = a.raised end
		if role == "accent-line" then color = a.accent end
		if role == "card-shell" then color = "#111113" end
		if role == "card-portrait" then color = "#252528" end
		if role == "card-halo" then color = "#414146" end
		inst.BackgroundColor3 = col(color)
	elseif class == "TextButton" then
		if role == "action" or role == "tab-active" then
			local fill = (role == "action" and accent) or a.accent
			inst.BackgroundColor3 = col(fill)
			local onFill = a.onAccent
			if role == "action" and accent ~= nil then
				local dark = M.Theme.contrastRatio("#111113", accent) or 0
				local light = M.Theme.contrastRatio("#FFFFFF", accent) or 0
				onFill = dark >= light and "#111113" or "#FFFFFF"
			end
			inst.TextColor3 = col(onFill)
		elseif role == "locked" then
			inst.BackgroundColor3 = col(a.canvas)
			inst.TextColor3 = col(a.muted)
		else
			inst.BackgroundColor3 = col(a.raised)
			inst.TextColor3 = col(a.text)
		end
	elseif class == "TextLabel" then
		if role == "hud" or role == "reveal" or role == "rarity" then
			inst.BackgroundTransparency = 0.08
			inst.BackgroundColor3 = col(role == "rarity"
				and "#17233A" or a.surface)
		else
			inst.BackgroundTransparency = 1
		end
		local color = a.text
		if role == "muted" or role == "feedback" then color = a.muted end
		if role == "eyebrow" then color = a.accent end
		if role == "alert" then color = a.alert end
		if role == "pending" then color = a.aqua end
		if role == "rarity" then
			color = M.Theme.rarityColor(app.lastRoll and app.lastRoll.rarity)
		end
		if role == "card-name" then color = "#F5F5F5" end
		if role == "card-copy" or role == "card-pending" then color = "#B5B5BC" end
		if role == "card-sigil" then color = "#F5F5F5" end
		inst.TextColor3 = col(color)
	end
	app.paintRoles = app.paintRoles or setmetatable({}, { __mode = "k" })
	app.paintRoles[inst] = role or "default"
end

local function decorate(app, inst, radius, border)
	-- Strict Linux fakes do not implement these cosmetic engine classes. The
	-- real Studio receives them; the layout and behavior remain testable.
	if app.M.Theme == nil then return end
	pcall(function()
		local corner = app.R.Instance.new("UICorner")
		corner.CornerRadius = app.R.UDim.new(0, radius)
		corner.Parent = inst
		if border then
			local stroke = app.R.Instance.new("UIStroke")
			stroke.Color = app.R.Color3.fromHex(
				app.M.Theme.currentArchiveTokens().border)
			stroke.Thickness = 1
			stroke.Parent = inst
			app.strokes = app.strokes or setmetatable({}, { __mode = "k" })
			app.strokes[stroke] = true
		end
	end)
end

UiView.decorate = decorate

local function typeStyle(app, inst, kind)
	pcall(function()
		inst.TextXAlignment = app.R.Enum.TextXAlignment.Left
		inst.TextYAlignment = app.R.Enum.TextYAlignment.Center
		inst.Font = (kind == "display") and app.R.Enum.Font.GothamBold
			or app.R.Enum.Font.GothamMedium
	end)
end

local function label(app, parent, name, value, size, role)
	local l = app.R.Instance.new("TextLabel")
	l.Name = name
	l.Text = value
	l.TextSize = size
	l.TextWrapped = true
	l.Parent = parent
	typeStyle(app, l, size >= 22 and "display" or "body")
	UiView.paint(app, l, role)
	return l
end

-- One native card face shared by summon, collection and deck. Without an
-- uploaded image, show one monochrome emblem and a clear ART PENDING label.
-- Name, rarity and stats remain readable without the portrait.
local function faceLabel(app, parent, name, value, size, position, dimensions, role)
	local l = label(app, parent, name, value, size, role)
	l.Position = position
	l.Size = dimensions
	return l
end

function UiView.buildCardVisual(app, parent, name, compact)
	local R = app.R
	local shell = R.Instance.new("Frame")
	shell.Name = name
	shell.Parent = parent
	UiView.paint(app, shell, "card-shell")
	local rim = R.Instance.new("Frame")
	rim.Name = "RarityRim"
	rim.Size = R.UDim2.new(1, 0, 0, compact and 5 or 7)
	rim.Parent = shell
	local art = R.Instance.new("Frame")
	art.Name = "Portrait"
	art.Position = R.UDim2.new(0.06, 0, 0.16, 0)
	art.Size = R.UDim2.new(0.88, 0, 0.55, 0)
	art.Parent = shell
	UiView.paint(app, art, "card-portrait")
	pcall(function() art.ClipsDescendants = true end)
	local mark = faceLabel(app, art, "Sigil", "◇", compact and 29 or 64,
		R.UDim2.fromScale(0.1, 0.12), R.UDim2.fromScale(0.8, 0.62), "card-sigil")
	pcall(function() mark.TextXAlignment = R.Enum.TextXAlignment.Center end)
	local image = R.Instance.new("ImageLabel")
	image.Name = "UploadedPortrait"
	image.Size = R.UDim2.fromScale(1, 1)
	image.BackgroundTransparency = 1
	image.ClipsDescendants = true
	image.ScaleType = R.Enum.ScaleType.Crop
	image.Parent = art
	local pending = faceLabel(app, art, "ArtState", "ART PENDING",
		compact and 8 or 10, R.UDim2.fromScale(0.04, 0.85),
		R.UDim2.fromScale(0.92, 0.12), "card-pending")
	pcall(function() pending.TextXAlignment = R.Enum.TextXAlignment.Center end)
	local rarity = faceLabel(app, shell, "Rarity", "UNREVEALED",
		compact and 10 or 12, R.UDim2.fromScale(0.06, 0.045),
		R.UDim2.fromScale(0.88, 0.1))
	local alias = faceLabel(app, shell, "Alias", "AWAITING DRAW",
		compact and 11 or 19, R.UDim2.fromScale(0.06, 0.72),
		R.UDim2.fromScale(0.88, compact and 0.25 or 0.14), "card-name")
	local stats = faceLabel(app, shell, "Stats", "REVEAL TO ADD TO COLLECTION",
		compact and 10 or 12, R.UDim2.fromScale(0.06, 0.86),
		R.UDim2.fromScale(0.88, 0.1), "card-copy")
	if compact then
		stats.Visible = false
		alias.TextWrapped = false
		pcall(function() alias.TextTruncate = R.Enum.TextTruncate.AtEnd end)
	end
	for _, l in ipairs({ rarity, alias, stats }) do
		pcall(function() l.TextXAlignment = R.Enum.TextXAlignment.Center end)
	end
	if app.M.Theme ~= nil then
		decorate(app, shell, compact and 8 or 14, false)
		decorate(app, art, 7, false)
		pcall(function()
			local stroke = R.Instance.new("UIStroke")
			stroke.Name = "CardRarityStroke"
			stroke.Color = R.Color3.fromHex("#D8D8DC")
			stroke.Thickness = compact and 2 or 3
			stroke.Parent = shell
		end)
	end
	local face = { shell = shell, rim = rim, art = art,
		mark = mark, image = image,
		pending = pending, rarity = rarity, alias = alias, stats = stats,
		compact = compact }
	app.cardFaces = app.cardFaces or setmetatable({}, { __mode = "k" })
	app.cardFaces[shell] = face
	return face
end

function UiView.setCardVisual(app, face, id, identity)
	if face == nil then return end
	identity = identity or {}
	face.id = id
	face.identity = identity
	local rarity = tostring(identity.rarity or "Unrevealed")
	face.rarity.Text = string.upper(rarity)
	face.alias.Text = id and tostring(identity.alias or id) or "AWAITING DRAW"
	local motif = CardMotif.forId(id)
	face.mark.Text = motif.glyph
	if id == nil then
		face.stats.Text = "REVEAL TO ADD TO COLLECTION"
	else
		face.stats.Text = "ATK " .. tostring(identity.atk or "—")
			.. "   HP " .. tostring(identity.hp or "—")
			.. "   DEF " .. tostring(identity.def or "—")
	end
	local artId = app.M.CardView ~= nil
		and app.M.CardView.resolveArt(id, app.R.ArtIds) or nil
	face.image.Image = artId or ""
	pcall(function() face.image.Visible = artId ~= nil end)
	face.pending.Visible = artId == nil
	face.mark.Visible = artId == nil
	if app.M.Theme ~= nil then
		local color = "#D8D8DC"
		face.art.BackgroundColor3 = app.R.Color3.fromHex(motif.base)
		face.mark.TextColor3 = app.R.Color3.fromHex(motif.accent)
		face.rim.BackgroundColor3 = app.R.Color3.fromHex(color)
		face.rarity.TextColor3 = app.R.Color3.fromHex(color)
		pcall(function()
			local stroke = face.shell:FindFirstChild("CardRarityStroke")
			if stroke then stroke.Color = app.R.Color3.fromHex(color) end
		end)
	end
end

-- A brief scale settle makes a newly confirmed card feel dealt. All data and
-- actions are available immediately; reduced-motion users get no tween.
function UiView.pulseCard(app, face)
	if face == nil or app.store == nil or app.store.prefs == nil
		or app.store.prefs.reducedMotion then return false end
	if app.R.game == nil or TweenInfo == nil then return false end
	local ok = pcall(function()
		local scale = face.shell:FindFirstChild("DealScale")
		if scale == nil then
			scale = app.R.Instance.new("UIScale")
			scale.Name = "DealScale"
			scale.Parent = face.shell
		end
		scale.Scale = 0.92
		local tween = app.R.game:GetService("TweenService"):Create(scale,
			TweenInfo.new(0.24, app.R.Enum.EasingStyle.Quad,
				app.R.Enum.EasingDirection.Out), { Scale = 1 })
		tween:Play()
	end)
	return ok
end

function UiView.buildRewardPanel(app, s)
	local R = app.R
	local panel = R.Instance.new("Frame")
	panel.Name = "RewardPanel"
	panel.Size = R.UDim2.new(1, 0, 0, 226)
	panel.LayoutOrder = 0
	panel.Parent = s.scroll
	UiView.paint(app, panel, "raised")
	decorate(app, panel, 14, true)
	local card = UiView.buildCardVisual(app, panel, "DecisiveCard", true)
	card.shell.Position = R.UDim2.new(0, 14, 0, 18)
	card.shell.Size = R.UDim2.new(0, 112, 0, 160)
	UiView.setCardVisual(app, card, nil)
	local outcome = faceLabel(app, panel, "Outcome", "DUEL RESULT",
		25, R.UDim2.new(0, 138, 0, 18), R.UDim2.new(1, -152, 0, 42))
	local detail = faceLabel(app, panel, "ResultDetail",
		"Finish a duel to see its result.", 13,
		R.UDim2.new(0, 138, 0, 62), R.UDim2.new(1, -152, 0, 64))
	local xp = faceLabel(app, panel, "XPReward", "XP  /  Claim to reveal",
		14, R.UDim2.new(0, 138, 0, 128), R.UDim2.new(1, -152, 0, 38))
	local coins = faceLabel(app, panel, "CoinReward", "RUN COINS  /  Claim to reveal",
		14, R.UDim2.new(0, 138, 0, 170), R.UDim2.new(1, -152, 0, 38))
	local accent = R.Instance.new("Frame")
	accent.Name = "OutcomeRail"
	accent.Size = R.UDim2.new(1, -28, 0, 4)
	accent.Position = R.UDim2.new(0, 14, 1, -12)
	accent.Parent = panel
	UiView.paint(app, accent, "accent-line")
	s.rewardPanel = { panel = panel, card = card, accent = accent, outcome = outcome,
		detail = detail, xp = xp, coins = coins }
end

function UiView.renderRewardPanel(app, state, winner, result)
	local s = app.screens and app.screens.rewards
	local p = s and s.rewardPanel
	if p == nil then return end
	local cardId = state == "empty" and nil or app.lastBattleCardId
	local identity = cardId and app.Actions
		and app.Actions.cardIdentity(app, cardId) or nil
	UiView.setCardVisual(app, p.card, cardId, identity)
	if app.M.Theme ~= nil then
		local light = app.M.Theme.current() == "Light"
		local tint = state == "empty" and (light and "#4A586F" or "#8290A9")
			or winner == "A" and (light and "#845200" or "#F3C36A")
			or (light and "#9C3738" or "#F19893")
		p.accent.BackgroundColor3 = app.R.Color3.fromHex(tint)
		p.outcome.TextColor3 = app.R.Color3.fromHex(tint)
	end
	if state == "settled" then
		p.outcome.Text = winner == "A" and "VICTORY" or "DEFEAT"
		p.detail.Text = "The duel is settled. Claim the server result."
		p.xp.Text = "XP  /  Claim to reveal"
		p.coins.Text = "RUN COINS  /  Claim to reveal"
	elseif state == "claimed" and result ~= nil then
		p.outcome.Text = winner == "A" and "VICTORY"
			or winner == "B" and "DEFEAT" or "REWARD CLAIMED"
		p.detail.Text = result.legacyGranted and "Reward claimed. Story Legacy added."
			or "Reward claimed. Your next route is ready."
		p.xp.Text = result.xp ~= nil and ("+" .. tostring(result.xp) .. " XP")
			or "XP  /  Not reported"
		p.coins.Text = result.currency ~= nil
			and ("+" .. tostring(result.currency) .. " RUN COINS")
			or "RUN COINS  /  Not reported"
	else
		p.outcome.Text = "DUEL RESULT"
		p.detail.Text = "Finish a duel to see its result."
		p.xp.Text = "XP  /  Claim to reveal"
		p.coins.Text = "RUN COINS  /  Claim to reveal"
	end
end

-- Single ENABLED panel: ScreenGui uses Enabled, never Visible.
function UiView.show(app, id)
	for sid, s in pairs(app.screens) do
		s.gui.Enabled = (sid == id)
	end
	local encounter = app.screens.encounter
	if encounter ~= nil and encounter.title ~= nil then
		local presenting = id == "encounter" and app.battle ~= nil
		encounter.title.Visible = not presenting
		encounter.data.Visible = not presenting
	end
	if app.hud ~= nil and app.hud.gui ~= nil then
		app.hud.gui.Enabled = (id == "encounter" and app.battle ~= nil)
	end
	app.current = id
end

function UiView.addButton(app, s, id, label, fn, role, opts)
	opts = opts or {}
	local R = app.R
	local b = R.Instance.new("TextButton")
	b.Name = id
	b.Text = label
	b.TextSize = (role == "action") and 18 or 15
	b.TextWrapped = true
	b.Size = opts.size or R.UDim2.new(1, 0, 0,
		s.isEncounter and 44 or ((role == "action") and 58 or 48))
	if opts.position ~= nil then b.Position = opts.position end
	s.nextOrder = (s.nextOrder or 10) + 1
	b.LayoutOrder = s.nextOrder
	typeStyle(app, b, role == "action" and "display" or "body")
	decorate(app, b, 10, role ~= "action")
	pcall(function()
		b.AutoButtonColor = true
	end)
	-- Selectable for D-pad/tab/confirm navigation (real Roblox property).
	pcall(function()
		b.Selectable = true
	end)
	b.Parent = opts.parent or s.scroll
	UiView.paint(app, b, role)
	s.buttonRoles = s.buttonRoles or {}
	s.buttonRoles[id] = role
	b.Activated:Connect(function(...)
		UiView.setFocus(app, s, id)
		fn(...)
	end)
	s.buttons[id] = b
	return b
end

function UiView.clearExtra(app, s)
	for _, inst in ipairs(s.extra) do
		if inst.ClassName == "Frame" then
			for shell, _ in pairs(app.cardFaces or {}) do
				local cursor = shell
				for _ = 1, 12 do
					if cursor == inst then
						app.cardFaces[shell] = nil
						break
					end
					local ok, parent = pcall(function() return cursor.Parent end)
					if not ok or parent == nil then break end
					cursor = parent
				end
			end
		end
		if app.focus ~= nil and app.focus.screen == s
			and app.focus.controlId == inst.Name then
			app.focus = nil
		end
		s.buttons[inst.Name] = nil
		if s.buttonRoles ~= nil then s.buttonRoles[inst.Name] = nil end
		inst:Destroy()
	end
	s.extra = {}
	s.nextOrder = s.baseOrder or 20
end

-- One scroll construction path for every screen. A missing enum or UI class
-- is returned to the caller with its cause; no property failure is ignored.
function UiView.buildScroll(app, parent)
	local R = app.R
	local automaticSize = R.Enum and R.Enum.AutomaticSize
	if automaticSize == nil or automaticSize.Y == nil then
		return nil, "Enum.AutomaticSize.Y unavailable"
	end
	local ok, scroll = pcall(function()
		local body = R.Instance.new("ScrollingFrame")
		body.Name = "Body"
		body.Size = R.UDim2.fromScale(1, 1)
		body.CanvasSize = R.UDim2.fromScale(0, 0)
		body.AutomaticCanvasSize = automaticSize.Y
		body.ScrollBarThickness = 4
		local layout = R.Instance.new("UIListLayout")
		layout.Padding = R.UDim.new(0, 12)
		pcall(function()
			layout.SortOrder = R.Enum.SortOrder.LayoutOrder
		end)
		layout.Parent = body
		local pad = R.Instance.new("UIPadding")
		pad.PaddingTop = R.UDim.new(0, 18)
		pad.PaddingLeft = R.UDim.new(0, 18)
		pad.PaddingRight = R.UDim.new(0, 18)
		pad.PaddingBottom = R.UDim.new(0, 24)
		pad.Parent = body
		body.Parent = parent
		UiView.paint(app, body, "scroll")
		return body
	end)
	if not ok then
		return nil, "scroll layout construction failed: " .. tostring(scroll)
	end
	return scroll, nil
end

-- Visible focus for D-pad/tab/confirm: exactly one focused control per
-- screen, painted with the theme focus token, never obscured.
function UiView.setFocus(app, s, id)
	if s == nil or s.buttons[id] == nil then
		return false
	end
	local prev = app.focus
	if prev ~= nil and prev.screen == s
		and prev.controlId ~= nil
		and s.buttons[prev.controlId] ~= nil
		and prev.controlId ~= id then
		UiView.paint(app, s.buttons[prev.controlId],
			s.buttonRoles and s.buttonRoles[prev.controlId] or nil)
	end
	app.focus = { screen = s, controlId = id }
	UiView.paint(app, s.buttons[id], "focused")
	return true
end

function UiView.focusNext(app, screenId)
	local s = app.screens[screenId]
	if s == nil then
		return false
	end
	local ids = {}
	for id, _ in pairs(s.buttons) do
		ids[#ids + 1] = id
	end
	table.sort(ids)
	if #ids == 0 then
		return false
	end
	local cur = (app.focus ~= nil and app.focus.screen == s)
		and app.focus.controlId or nil
	local nextId = ids[1]
	for i = 1, #ids do
		if ids[i] == cur then
			nextId = ids[(i % #ids) + 1]
		end
	end
	return UiView.setFocus(app, s, nextId)
end

-- Encounter build: transparent center over the 3D stage. A slim top bar
-- (title + data, Scale 0.07 + 44px minimum so it grows with the viewport
-- but never drops below the 44px touch floor, with an 8px safe-area inset)
-- and a contained bottom control bar (bottom 16%, transparent center above)
-- hold every control; nothing covers the middle.
function UiView.buildEncounter(app, desc)
	local R = app.R
	local layoutSpec = UiView.layoutSpec(desc.id)
	local gui = R.Instance.new("ScreenGui")
	gui.Name = "Screen_" .. desc.id
	gui.Enabled = false
	gui.ResetOnSpawn = false
	pcall(function() gui.IgnoreGuiInset = false end)
	local s = { gui = gui, buttons = {}, data = nil, desc = desc,
		scroll = nil, extra = {}, isEncounter = true }
	local top = label(app, gui, "Title", desc.title, 24, "hud")
	top.Size = R.UDim2.new(1, -32, 0, 44)
	top.Position = R.UDim2.new(0, 16, 0, 60)
	decorate(app, top, 8, false)
	local data = label(app, gui, "DataLabel",
		desc.subtitle or "Choose a route and let the cards fight.", 15, "hud")
	data.Size = R.UDim2.new(1, -32, 0, 44)
	data.Position = R.UDim2.new(0, 16, 0, 108)
	decorate(app, data, 8, false)
	s.data = data
	s.title = top
	local bar = R.Instance.new("Frame")
	bar.Name = "ControlBar"
	bar.AnchorPoint = R.Vector2.new(0.5, 1)
	bar.Size = R.UDim2.new(1, -32, layoutSpec.bottomBarScale, 0)
	-- Reserve starts at 95% viewport height - 144px. Keep the bar 16px
	-- above it at every viewport height, including tall portrait screens.
	bar.Position = R.UDim2.new(0.5, 0, 0.95, -160)
	bar.Parent = gui
	UiView.paint(app, bar, "surface")
	bar.BackgroundTransparency = 0.08
	decorate(app, bar, 12, true)
	local scroll = R.Instance.new("ScrollingFrame")
	scroll.Name = "BattleControls"
	scroll.Size = R.UDim2.fromScale(1, 1)
	scroll.Position = R.UDim2.new(0, 0, 0, 0)
	scroll.CanvasSize = R.UDim2.new(0,
		#desc.controls * 112 + 32, 1, 0)
	scroll.ScrollBarThickness = 0
	scroll.BackgroundTransparency = 1
	scroll.ScrollingDirection = R.Enum.ScrollingDirection.X
	local layout = R.Instance.new("UIListLayout")
	layout.FillDirection = R.Enum.FillDirection.Horizontal
	layout.Padding = R.UDim.new(0, 8)
	pcall(function() layout.SortOrder = R.Enum.SortOrder.LayoutOrder end)
	layout.Parent = scroll
	local padding = R.Instance.new("UIPadding")
	padding.PaddingTop = R.UDim.new(0, 4)
	padding.PaddingBottom = R.UDim.new(0, 4)
	padding.PaddingLeft = R.UDim.new(0, 12)
	padding.PaddingRight = R.UDim.new(0, 12)
	padding.Parent = scroll
	scroll.Parent = bar
	s.scroll = scroll
	for _, c in ipairs(desc.controls) do
		UiView.addButton(app, s, c.id, c.label, function()
			app.Actions.onActivated(app, desc.id, c.id, c.action)
		end, c.id == desc.primary and "action" or nil, {
			size = R.UDim2.new(0,
				c.id == desc.primary and 128 or 104, 0, 48),
		})
	end
	local canvasWidth = 24
	for _, c in ipairs(desc.controls) do
		canvasWidth = canvasWidth + (c.id == desc.primary and 128 or 104) + 8
	end
	scroll.CanvasSize = R.UDim2.new(0, canvasWidth, 1, 0)
	s.baseOrder = s.nextOrder
	return s
end

local NAV = {
	{ id = "tutorial", label = "START" },
	{ id = "roll", label = "SUMMON" },
	{ id = "inventory", label = "CARDS" },
	{ id = "deck", label = "TEAM" },
	{ id = "worlds", label = "WORLDS" },
	{ id = "store", label = "SHOP" },
	{ id = "settings", label = "MORE" },
}

function UiView.buildScreen(app, desc)
	if desc.id == "encounter" then
		return UiView.buildEncounter(app, desc)
	end
	local R = app.R
	local gui = R.Instance.new("ScreenGui")
	gui.Name = "Screen_" .. desc.id
	gui.Enabled = false
	gui.ResetOnSpawn = false
	pcall(function() gui.IgnoreGuiInset = false end)
	local canvas = R.Instance.new("Frame")
	canvas.Name = "ArchiveCanvas"
	canvas.Size = R.UDim2.fromScale(1, 1)
	canvas.BackgroundTransparency = 1
	canvas.Parent = gui
	local frame = R.Instance.new("Frame")
	frame.Name = "WorldOverlay"
	pcall(function() frame.AnchorPoint = R.Vector2.new(0, 0) end)
	frame.Position = R.UDim2.new(0, 12, 0, 12)
	local viewportWidth = 0
	pcall(function()
		viewportWidth = app.workspace.CurrentCamera.ViewportSize.X
	end)
	local railWidth = UiView.overlayWidth(viewportWidth)
	frame.Size = R.UDim2.new(railWidth.scale, railWidth.offset, 1, -24)
	frame.Parent = canvas
	UiView.paint(app, frame, "surface")
	frame.BackgroundTransparency = 0.12
	decorate(app, frame, 14, true)
	pcall(function()
		local limit = R.Instance.new("UISizeConstraint")
		limit.MaxSize = R.Vector2.new(railWidth.maxPx, 2000)
		limit.Parent = frame
	end)
	local rail = R.Instance.new("Frame")
	rail.Name = "AccentRail"
	rail.Size = R.UDim2.new(1, -24, 0, 4)
	rail.Position = R.UDim2.new(0, 12, 0, 0)
	rail.Parent = frame
	UiView.paint(app, rail, "accent-line")
	local eyebrow = label(app, frame, "Eyebrow",
		"SKYBRIDGE  ·  CARD BATTLES", 12, "eyebrow")
	eyebrow.Size = R.UDim2.new(1, -32, 0, 18)
	eyebrow.Position = R.UDim2.new(0, 18, 0, 12)
	local title = label(app, frame, "Title", desc.title, 28, "title")
	title.Size = R.UDim2.new(1, -32, 0, 38)
	title.Position = R.UDim2.new(0, 18, 0, 30)
	local subtitle = label(app, frame, "Subtitle",
		desc.subtitle or "Your collection. Your next move.", 14, "muted")
	subtitle.Size = R.UDim2.new(1, -32, 0, 30)
	subtitle.Position = R.UDim2.new(0, 18, 0, 69)
	local nav = R.Instance.new("ScrollingFrame")
	nav.Name = "SectionTabs"
	nav.Size = R.UDim2.new(1, -24, 0, 48)
	nav.Position = R.UDim2.new(0, 12, 0, 104)
	nav.CanvasSize = R.UDim2.new(0, #NAV * 86, 0, 0)
	nav.ScrollBarThickness = 0
	nav.BackgroundTransparency = 1
	nav.Parent = frame
	pcall(function() nav.ScrollingDirection = R.Enum.ScrollingDirection.X end)
	local scroll, err = UiView.buildScroll(app, frame)
	if scroll == nil then
		error("screen scroll unavailable: " .. tostring(err), 2)
	end
	scroll.Size = R.UDim2.new(1, -24, 1, -164)
	scroll.Position = R.UDim2.new(0, 12, 0, 156)
	decorate(app, scroll, 10, false)
	local data = label(app, scroll, "DataLabel",
		desc.loading or "Loading your saved run…", 16, "body")
	data.Size = R.UDim2.new(1, 0, 0, desc.dataHeight or 92)
	data.LayoutOrder = 1
	pcall(function()
		data.AutomaticSize = R.Enum.AutomaticSize.Y
		data.TextYAlignment = R.Enum.TextYAlignment.Top
	end)
	local feedback = label(app, scroll, "Feedback",
		"Waiting for your saved progress…", 14, "feedback")
	feedback.Size = R.UDim2.new(1, 0, 0, 38)
	feedback.LayoutOrder = 2
	local s = { gui = gui, buttons = {}, data = data, desc = desc,
		scroll = scroll, extra = {}, feedback = feedback, navButtons = {} }
	for i, item in ipairs(NAV) do
		local b = R.Instance.new("TextButton")
		b.Name = "Tab_" .. item.id
		b.Text = item.label
		b.TextSize = 13
		b.Size = R.UDim2.new(0, 80, 0, 44)
		b.Position = R.UDim2.new(0, (i - 1) * 86, 0, 2)
		b.Parent = nav
		typeStyle(app, b, "display")
		decorate(app, b, 8, false)
		pcall(function() b.Selectable = true end)
		UiView.paint(app, b, item.id == desc.id and "tab-active" or "tab")
		b.Activated:Connect(function()
			app.Actions.onActivated(app, desc.id, b.Name, "nav-" .. item.id)
		end)
		s.navButtons[item.id] = b
	end
	if desc.id == "roll" then
		local stage = R.Instance.new("Frame")
		stage.Name = "RevealStage"
		stage.Size = R.UDim2.new(1, 0, 0, 354)
		stage.LayoutOrder = 1
		stage.Parent = scroll
		UiView.paint(app, stage, "raised")
		decorate(app, stage, 12, true)
		local face = UiView.buildCardVisual(app, stage, "RevealCard", false)
		face.shell.AnchorPoint = R.Vector2.new(0.5, 0)
		face.shell.Position = R.UDim2.new(0.5, 0, 0, 12)
		face.shell.Size = R.UDim2.new(0, 210, 0, 284)
		UiView.setCardVisual(app, face, nil)
		local reveal = label(app, stage, "RollReveal",
			"NEXT REVEAL  /  Your free card is waiting.", 15, "reveal")
		reveal.Size = R.UDim2.new(1, -20, 0, 42)
		reveal.Position = R.UDim2.new(0, 10, 0, 302)
		decorate(app, reveal, 8, false)
		s.reveal = reveal
		s.rollFace = face
		data.LayoutOrder = 2
		data.Size = R.UDim2.new(1, 0, 0, 58)
		feedback.LayoutOrder = 4
		local odds = label(app, scroll, "OddsDetails",
			"Exact odds load with your saved profile.", 13, "muted")
		odds.Size = R.UDim2.new(1, 0, 0, 134)
		odds.LayoutOrder = 11
		odds.Visible = false
		s.odds = odds
	elseif desc.id == "inventory" then
		local stage = R.Instance.new("Frame")
		stage.Name = "FeaturedCardStage"
		stage.Size = R.UDim2.new(1, 0, 0, 294)
		stage.LayoutOrder = 0
		stage.Parent = scroll
		UiView.paint(app, stage, "raised")
		decorate(app, stage, 12, true)
		local face = UiView.buildCardVisual(app, stage, "FeaturedCard", false)
		face.shell.AnchorPoint = R.Vector2.new(0.5, 0)
		face.shell.Position = R.UDim2.new(0.5, 0, 0, 12)
		face.shell.Size = R.UDim2.new(0, 192, 0, 266)
		UiView.setCardVisual(app, face, nil)
		s.featuredFace = face
		feedback.LayoutOrder = 2
	elseif desc.id == "deck" then
		feedback.LayoutOrder = 3
	elseif desc.id == "rewards" then
		UiView.buildRewardPanel(app, s)
		data.LayoutOrder = 4
		feedback.LayoutOrder = 5
	end
	for _, c in ipairs(desc.controls) do
		local b = UiView.addButton(app, s, c.id, c.label, function()
			app.Actions.onActivated(app, desc.id, c.id, c.action)
		end, c.id == desc.primary and "action" or nil)
		if desc.id == "roll" then
			if c.id == "roll-free" then b.LayoutOrder = 3 end
			if c.id == "roll-odds" then b.LayoutOrder = 10 end
			if c.id == "autoroll-toggle" then b.LayoutOrder = 12 end
			if c.id == "roll-to-deck" then b.LayoutOrder = 13 end
			if c.id == "to-inventory" then b.LayoutOrder = 14 end
			if c.id == "to-store" then b.LayoutOrder = 15 end
		elseif desc.id == "rewards" then
			if c.id == "reward-claim" then b.LayoutOrder = 2 end
			if c.id == "reward-next" then b.LayoutOrder = 3 end
			if c.id == "to-upgrade" then b.LayoutOrder = 6 end
		elseif desc.id == "inventory" then
			if c.id == "inspect-card" then b.LayoutOrder = 1000 end
			if c.id == "refresh-profile" then b.LayoutOrder = 1001 end
			if c.id == "to-deck" then b.LayoutOrder = 1002 end
		elseif desc.id == "deck" then
			if c.id == "deck-save" then b.LayoutOrder = 2 end
			if c.id == "to-worlds" then b.LayoutOrder = 4 end
		end
	end
	s.baseOrder = s.nextOrder
	if desc.id == "settings" then
		-- One reachable nav hub: every screen one tap away.
		for _, id in ipairs(app.M.Screens.ids()) do
			if id ~= "settings" then
				UiView.addButton(app, s, "hub-" .. id, "Go: " .. id, function()
					app.Actions.onActivated(app, "settings",
						"hub-" .. id, "nav-" .. id)
				end, nil)
			end
		end
	end
	return s
end

-- Battle HUD: top status + bottom reserve strip, both Scale-anchored with
-- safe-area insets; transparent labels so the stage shows through. Bottom
-- stack never overlaps: Reserve occupies -100..-56, StatusLine -28..0, with
-- a 28px gap; TopHP is pinned to the top safe-area inset and grows with the
-- viewport (Scale 0.07 + 44px minimum). Order on screen: HP/shield per side,
-- then status, then turn on top; Active A vs B then ordered reserves A / B
-- at the bottom.
function UiView.buildHUD(app, parent)
	local R = app.R
	local gui = R.Instance.new("ScreenGui")
	gui.Name = "BattleHUD"
	gui.Enabled = false
	gui.ResetOnSpawn = false
	pcall(function() gui.IgnoreGuiInset = false end)
	local refs = {}
	local function label(name, text, anchorY, yOff)
		local l = R.Instance.new("TextLabel")
		l.Name = name
		l.Text = text
		l.TextSize = 15
		l.TextWrapped = true
		l.AnchorPoint = R.Vector2.new(0, anchorY)
		l.Size = R.UDim2.new(1, -32, 0.05, 44)
		l.Position = R.UDim2.new(0, 16, anchorY, yOff)
		l.Parent = gui
		typeStyle(app, l, "display")
		UiView.paint(app, l, "hud")
		decorate(app, l, 8, false)
		refs[name] = l
		return l
	end
	label("TopHP", "YOUR TEAM  /  A:—   RIVAL  /  B:—", 0, 8)
	label("Reserve", "ACTIVE CARDS  /  Waiting for the battle…", 1, -100)
	app.statusLine = R.Instance.new("TextLabel")
	app.statusLine.Name = "StatusLine"
	app.statusLine.Text = ""
	app.statusLine.TextSize = 14
	app.statusLine.AnchorPoint = R.Vector2.new(0, 1)
	app.statusLine.Size = R.UDim2.new(1, -32, 0, 28)
	app.statusLine.Position = R.UDim2.new(0, 16, 1, -28)
	app.statusLine.Parent = gui
	UiView.paint(app, app.statusLine, "hud")
	decorate(app, app.statusLine, 8, false)
	gui.Parent = parent
	app.hud = { gui = gui, refs = refs }
	-- Live-scene identity for the Studio check suite (P6StudioChecks
	-- hud-present): published ONLY after the TopHP + Reserve nodes really
	-- exist under the HUD. pcall-guarded for minimal test fakes.
	pcall(function()
		if refs.TopHP ~= nil and refs.Reserve ~= nil
			and app.statusLine ~= nil then
			parent:SetAttribute("UACGHud", true)
		end
	end)
	return app.hud
end

-- Repaint native descendants when the saved theme changes. Weak keys avoid
-- retaining destroyed card rows across profile refreshes. Focus survives.
function UiView.repaintAll(app)
	for inst, role in pairs(app.paintRoles or {}) do
		local exists, parent = pcall(function()
			return inst.Parent
		end)
		local hasFakeFlag, destroyed = pcall(function()
			return inst.Destroyed
		end)
		if exists and parent ~= nil
			and (not hasFakeFlag or destroyed ~= true) then
			UiView.paint(app, inst, role)
		else
			app.paintRoles[inst] = nil
		end
	end
	for stroke, _ in pairs(app.strokes or {}) do
		pcall(function()
			if stroke.Parent ~= nil then
				stroke.Color = app.R.Color3.fromHex(
					app.M.Theme.currentArchiveTokens().border)
			end
		end)
	end
	for shell, face in pairs(app.cardFaces or {}) do
		local ok, parent = pcall(function() return shell.Parent end)
		if ok and parent ~= nil then
			UiView.setCardVisual(app, face, face.id, face.identity)
		else
			app.cardFaces[shell] = nil
		end
	end
	if app.focus ~= nil and app.focus.screen ~= nil
		and app.focus.controlId ~= nil then
		local b = app.focus.screen.buttons[app.focus.controlId]
		if b ~= nil then
			UiView.paint(app, b, "focused")
		end
	end
end

return UiView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[-- World.luau — Skybridge world palette + primitive prop list.
-- Pure Luau/plain-Lua subset (descriptors testable without Studio).
-- Identity follows the selected monochrome battle study: a bright skybridge,
-- floating stone islands, distant keeps, waterfalls and blossom accents.
-- Cards remain flat anchored planes; the setting carries the color.
-- World palette is INDEPENDENT of UI theme: world scripts never write UI
-- colors (ThemeController owns UI roles). Props are Roblox primitive Parts
-- only — no character geometry, no rigs, no meshes-as-fighters.

local World = {}

World.RULES_VERSION = "provisional-1"
World.NAME = "Skybridge"

World.PALETTE = {
	stone = "#69747D", stoneLight = "#9DA9A9", stoneDark = "#364B60",
	sky = "#6E9EC8", cloud = "#DDE8F0", waterfall = "#83DDF0",
	blossom = "#F18AB0", leaf = "#557968", light = "#FFE4B2",
}

World.LANDMARK = {
	id = "keep-base",
	kind = "keep",
	note = "Distant stone keep above a floating bridge; no character models.",
}

local function skybridgeProps()
	return {
		-- Broad foreground bridge with raised edge courses and a central path.
		{ id = "bridge-deck", kind = "Block", color = World.PALETTE.stone, size = { x = 29, y = 1, z = 15 }, pos = { x = 0, y = 0, z = 0 }, solid = true },
		{ id = "player-start", kind = "Block", color = World.PALETTE.stoneLight, size = { x = 6, y = 0.2, z = 6 }, pos = { x = 0, y = 0.62, z = 3 }, solid = true, transparent = true, spawn = true },
		{ id = "bridge-front-course", kind = "Block", color = World.PALETTE.stoneDark, size = { x = 29, y = 2.4, z = 1.2 }, pos = { x = 0, y = -1.55, z = 7.1 } },
		{ id = "bridge-left-course", kind = "Block", color = World.PALETTE.stoneLight, size = { x = 1.1, y = 0.5, z = 13 }, pos = { x = -14, y = 0.72, z = 0 } },
		{ id = "bridge-right-course", kind = "Block", color = World.PALETTE.stoneLight, size = { x = 1.1, y = 0.5, z = 13 }, pos = { x = 14, y = 0.72, z = 0 } },
		{ id = "bridge-left-inlay", kind = "Block", color = World.PALETTE.waterfall, size = { x = 0.13, y = 0.08, z = 12 }, pos = { x = -13.3, y = 1.02, z = 0 } },
		{ id = "bridge-right-inlay", kind = "Block", color = World.PALETTE.waterfall, size = { x = 0.13, y = 0.08, z = 12 }, pos = { x = 13.3, y = 1.02, z = 0 } },
		{ id = "bridge-arch-left", kind = "Block", color = World.PALETTE.stoneDark, size = { x = 1.1, y = 5, z = 1.2 }, pos = { x = -4.8, y = -3.9, z = 7 } },
		{ id = "bridge-arch-right", kind = "Block", color = World.PALETTE.stoneDark, size = { x = 1.1, y = 5, z = 1.2 }, pos = { x = 4.8, y = -3.9, z = 7 } },
		{ id = "bridge-arch-cap", kind = "Block", color = World.PALETTE.stoneDark, size = { x = 10.5, y = 1, z = 1.2 }, pos = { x = 0, y = -6.3, z = 7 } },
		-- Floating island silhouettes and distant castle towers frame the duel.
		{ id = "island-left", kind = "Block", color = World.PALETTE.stoneDark, size = { x = 11, y = 2, z = 8 }, pos = { x = -15, y = 6, z = -14 } },
		{ id = "island-right", kind = "Block", color = World.PALETTE.stoneDark, size = { x = 10, y = 2, z = 7 }, pos = { x = 16, y = 8, z = -19 } },
		{ id = "island-left-under", kind = "Block", color = World.PALETTE.stone, size = { x = 7, y = 2, z = 5 }, pos = { x = -15, y = 4, z = -14 } },
		{ id = "island-right-under", kind = "Block", color = World.PALETTE.stone, size = { x = 6, y = 2, z = 4 }, pos = { x = 16, y = 6, z = -19 } },
		-- A low platform and open gate read as a distant keep without a giant
		-- opaque wall across the player's first view of the sky.
		{ id = "keep-base", kind = "Block", color = World.PALETTE.stoneLight, size = { x = 10, y = 1, z = 5 }, pos = { x = 1, y = 4, z = -27 } },
		{ id = "keep-gate-left", kind = "Block", color = World.PALETTE.stoneLight, size = { x = 1.2, y = 8, z = 1.2 }, pos = { x = -1.7, y = 8.4, z = -24.4 } },
		{ id = "keep-gate-right", kind = "Block", color = World.PALETTE.stoneLight, size = { x = 1.2, y = 8, z = 1.2 }, pos = { x = 3.7, y = 8.4, z = -24.4 } },
		{ id = "keep-gate-cap", kind = "Block", color = World.PALETTE.stoneLight, size = { x = 6.6, y = 1, z = 1.2 }, pos = { x = 1, y = 12.9, z = -24.4 } },
		{ id = "keep-tower-left", kind = "Block", color = World.PALETTE.stone, size = { x = 2.2, y = 17, z = 2.2 }, pos = { x = -3.2, y = 14, z = -27 } },
		{ id = "keep-tower-right", kind = "Block", color = World.PALETTE.stone, size = { x = 2.2, y = 20, z = 2.2 }, pos = { x = 5.2, y = 15.5, z = -27 } },
		{ id = "keep-spire", kind = "Block", color = World.PALETTE.stoneLight, size = { x = 1.5, y = 13, z = 1.5 }, pos = { x = 1, y = 18.5, z = -27 } },
		{ id = "keep-window-left", kind = "Block", color = World.PALETTE.light, size = { x = 0.45, y = 1.8, z = 0.08 }, pos = { x = -3.2, y = 15, z = -25.84 } },
		{ id = "keep-window-right", kind = "Block", color = World.PALETTE.light, size = { x = 0.45, y = 1.8, z = 0.08 }, pos = { x = 5.2, y = 16.5, z = -25.84 } },
		{ id = "left-far-spire", kind = "Block", color = World.PALETTE.stone, size = { x = 1.5, y = 11, z = 1.5 }, pos = { x = -14, y = 11.5, z = -20 } },
		{ id = "right-far-spire", kind = "Block", color = World.PALETTE.stone, size = { x = 1.5, y = 13, z = 1.5 }, pos = { x = 15, y = 13, z = -25 } },
		{ id = "falls-left", kind = "Block", color = World.PALETTE.waterfall, size = { x = 1.4, y = 10, z = 0.25 }, pos = { x = -18, y = 1, z = -14 } },
		{ id = "falls-right", kind = "Block", color = World.PALETTE.waterfall, size = { x = 1.2, y = 12, z = 0.25 }, pos = { x = 19, y = 1, z = -20 } },
		-- Blossoms and cloud layers add color without crowding the card center.
		{ id = "blossom-canopy-left", kind = "Block", shape = "Ball", color = World.PALETTE.blossom, size = { x = 0.35, y = 0.35, z = 0.12 }, pos = { x = -12, y = 6, z = -5 } },
		{ id = "blossom-canopy-right", kind = "Block", shape = "Ball", color = World.PALETTE.blossom, size = { x = 0.35, y = 0.35, z = 0.12 }, pos = { x = 12, y = 8, z = -10 } },
		{ id = "blossom-cluster-left", kind = "Block", shape = "Ball", color = World.PALETTE.blossom, size = { x = 3, y = 2.2, z = 2.6 }, pos = { x = -17, y = 8.1, z = -14 } },
		{ id = "blossom-cluster-right", kind = "Block", shape = "Ball", color = World.PALETTE.blossom, size = { x = 2.8, y = 2, z = 2.6 }, pos = { x = 17.5, y = 10.1, z = -19 } },
		{ id = "cloud-left", kind = "Block", shape = "Ball", color = World.PALETTE.cloud, size = { x = 14, y = 1.5, z = 3 }, pos = { x = -20, y = -1, z = -22 } },
		{ id = "cloud-right", kind = "Block", shape = "Ball", color = World.PALETTE.cloud, size = { x = 15, y = 1.5, z = 3 }, pos = { x = 20, y = 1, z = -29 } },
		{ id = "warm-key-left", kind = "PointLight", color = World.PALETTE.light, pos = { x = -8, y = 12, z = 3 } },
		{ id = "warm-key-right", kind = "PointLight", color = World.PALETTE.waterfall, pos = { x = 8, y = 11, z = -5 } },
	}
end

World.SCENES = {
	["WORLD-01"] = {
		name = "Skybridge",
		folderName = "Skybridge",
		palette = World.PALETTE,
		props = skybridgeProps(),
	},
	["WORLD-02"] = {
		name = "Ashen Approach",
		folderName = "AshenApproach",
		palette = {
			platformSlate = "#34323B",
			platformCoal = "#201F24",
			worldEmber = "#D89567",
			worldMist = "#93B5BE",
			landmarkClay = "#D7A47D",
			ash = "#C9C4BD",
		},
		props = {
			{ id = "approach-platform", kind = "Block", color = "#34323B", size = { x = 26, y = 1, z = 14 }, pos = { x = 0, y = 0, z = 0 } },
			{ id = "approach-shelf", kind = "Block", color = "#201F24", size = { x = 18, y = 1, z = 9 }, pos = { x = 0, y = -0.5, z = -8 } },
			{ id = "approach-step-left", kind = "Block", color = "#34323B", size = { x = 8, y = 0.5, z = 2.5 }, pos = { x = -5, y = 0.75, z = -2 } },
			{ id = "approach-step-right", kind = "Block", color = "#34323B", size = { x = 8, y = 0.5, z = 2.5 }, pos = { x = 5, y = 1.25, z = -5 } },
			{ id = "ash-pillar-left", kind = "Block", color = "#201F24", size = { x = 1.5, y = 8, z = 1.5 }, pos = { x = -10, y = 4, z = -6 } },
			{ id = "ash-pillar-right", kind = "Block", color = "#201F24", size = { x = 1.5, y = 8, z = 1.5 }, pos = { x = 10, y = 4, z = -6 } },
			{ id = "ash-gate-left", kind = "Block", color = "#D7A47D", size = { x = 0.7, y = 6, z = 0.8 }, pos = { x = -2.5, y = 3, z = -10 } },
			{ id = "ash-gate-right", kind = "Block", color = "#D7A47D", size = { x = 0.7, y = 6, z = 0.8 }, pos = { x = 2.5, y = 3, z = -10 } },
			{ id = "ash-gate-beam", kind = "Block", color = "#D7A47D", size = { x = 5.7, y = 0.7, z = 0.8 }, pos = { x = 0, y = 6, z = -10 } },
			{ id = "ember-light", kind = "PointLight", color = "#D89567", pos = { x = -5, y = 6, z = 2 } },
			{ id = "mist-light", kind = "PointLight", color = "#93B5BE", pos = { x = 5, y = 6, z = 2 } },
			{ id = "ash-drift-1", kind = "paper", color = "#C9C4BD", size = { x = 0.5, y = 0.25, z = 0.05 }, pos = { x = -3, y = 4.5, z = -2 }, drift = true },
		},
	},
	["WORLD-03"] = {
		name = "Hollow Summit",
		folderName = "HollowSummit",
		palette = {
			platformBlueGray = "#293946",
			platformSlate = "#1E2932",
			worldCyan = "#8FC9D2",
			worldEvergreen = "#84AE9D",
			landmarkIce = "#D3E4E6",
			haze = "#AABFC6",
		},
		props = {
			{ id = "summit-ridge", kind = "Block", color = "#293946", size = { x = 28, y = 1, z = 13 }, pos = { x = 0, y = 0, z = 0 } },
			{ id = "summit-upper-ledge", kind = "Block", color = "#1E2932", size = { x = 17, y = 1, z = 8 }, pos = { x = 0, y = 0.6, z = -8 } },
			{ id = "summit-step-left", kind = "Block", color = "#293946", size = { x = 7, y = 0.5, z = 2 }, pos = { x = -5, y = 0.75, z = -3 } },
			{ id = "summit-step-right", kind = "Block", color = "#293946", size = { x = 7, y = 0.5, z = 2 }, pos = { x = 5, y = 1.25, z = -6 } },
			{ id = "hollow-spire-left", kind = "Block", color = "#1E2932", size = { x = 1.3, y = 10, z = 1.3 }, pos = { x = -10, y = 5, z = -6 } },
			{ id = "hollow-spire-right", kind = "Block", color = "#1E2932", size = { x = 1.3, y = 10, z = 1.3 }, pos = { x = 10, y = 5, z = -6 } },
			{ id = "summit-arch-left", kind = "Block", color = "#D3E4E6", size = { x = 0.6, y = 6, z = 0.7 }, pos = { x = -2.8, y = 3, z = -10 } },
			{ id = "summit-arch-right", kind = "Block", color = "#D3E4E6", size = { x = 0.6, y = 6, z = 0.7 }, pos = { x = 2.8, y = 3, z = -10 } },
			{ id = "summit-arch-cap", kind = "Block", color = "#D3E4E6", size = { x = 6.2, y = 0.6, z = 0.7 }, pos = { x = 0, y = 6, z = -10 } },
			{ id = "cyan-light", kind = "PointLight", color = "#8FC9D2", pos = { x = -5, y = 7, z = 2 } },
			{ id = "evergreen-light", kind = "PointLight", color = "#84AE9D", pos = { x = 5, y = 7, z = 2 } },
			{ id = "summit-haze", kind = "paper", color = "#AABFC6", size = { x = 0.45, y = 0.3, z = 0.04 }, pos = { x = 2, y = 5, z = -3 }, drift = true },
		},
	},
}

function World.sceneSpec(worldId)
	return World.SCENES[worldId or "WORLD-01"]
end

function World.propList(worldId)
	local scene = World.sceneSpec(worldId)
	if scene == nil then
		return nil, "unknown world"
	end
	return scene.props, nil
end

-- World palette must not leak into UI tokens (independent-theme check).
function World.usesOnlyWorldPalette(propColor, worldId)
	local scene = World.sceneSpec(worldId)
	if worldId ~= nil and scene == nil then
		return false
	end
	for _, candidate in pairs(World.SCENES) do
		if scene == nil or scene == candidate then
			for _, color in pairs(candidate.palette) do
				if color == propColor then
					return true
				end
			end
		end
	end
	return false
end

-- Direct bare references (never rawget(_G)): in Roblox, `script`/`game`
-- resolve per-script environment; in plain Lua/Lune they are nil.
local function isRoblox()
	return script ~= nil and game ~= nil
end

-- Studio construction: primitive Parts + lights only (R = runtime table,
-- defaults to real engine globals in Studio; tests inject fakes).
function World.build(parent, opts, R)
	if R == nil then
		if not isRoblox() then
			return nil, "studio-only"
		end
		R = {
			Instance = Instance, Enum = Enum, Vector3 = Vector3,
			UDim2 = UDim2, Color3 = Color3,
		}
	end
	opts = opts or {}
	local scene = World.sceneSpec(opts.worldId)
	if scene == nil then
		return nil, "unknown world"
	end
	local reduced = opts.reducedMotion == true
	local folder = R.Instance.new("Folder")
	folder.Name = scene.folderName
	for _, p in ipairs(scene.props) do
		if p.kind == "PointLight" then
			local anchor = R.Instance.new("Part")
			anchor.Name = p.id
			anchor.Size = R.Vector3.new(0.5, 0.5, 0.5)
			anchor.Anchored = true
			anchor.CanCollide = false
			anchor.Transparency = 1
			anchor.Position = R.Vector3.new(p.pos.x, p.pos.y, p.pos.z)
			local light = R.Instance.new("PointLight")
			light.Color = R.Color3.fromHex(p.color)
			light.Parent = anchor
			anchor.Parent = folder
		else
			local okPart, part = pcall(R.Instance.new,
				p.spawn and "SpawnLocation" or "Part")
			if not okPart then part = R.Instance.new("Part") end
			part.Name = p.id
			part.Shape = R.Enum.PartType.Block
			if p.shape ~= nil then
				pcall(function() part.Shape = R.Enum.PartType[p.shape] end)
			end
			part.Size = R.Vector3.new(p.size.x, p.size.y, p.size.z)
			part.Position = R.Vector3.new(p.pos.x, p.pos.y, p.pos.z)
			part.Anchored = true
			part.CanCollide = p.solid == true
			part.CanTouch = p.solid == true
			part.CanQuery = p.solid == true
			part.Material = R.Enum.Material.SmoothPlastic
			if p.transparent then part.Transparency = 1 end
			if p.spawn then
				pcall(function()
					part.Neutral = true
					part.Duration = 0
				end)
			end
			pcall(function()
				part.Color = R.Color3.fromHex(p.color)
			end)
			part.Parent = folder
			if p.drift and not reduced then
				-- Restrained drift marker (BattleScene animates it).
				part:SetAttribute("Drift", true)
			end
		end
	end
	folder.Parent = parent
	return folder, nil
end

return World
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>