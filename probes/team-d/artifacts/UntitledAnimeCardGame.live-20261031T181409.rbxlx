		canonical = "Explosion Quirk Rival — Howitzer Striker", alias = "Howitzer Striker",
		rarity = "Epic", mythic = false, legacy = false,
		role = "attacker", starter = false,
		hp = 78, atk = 15, def = 4, speed = 11,
		entry = "none", artwork = "PLACEHOLDER-no-asset-id",
	},
	{
		id = "MHA-FROSTBURN-01", franchise = "My Hero Academia",
		canonical = "Half-Hot Half-Cold Prodigy — Twin Element", alias = "Twin-Element Prodigy",
		rarity = "Legendary", mythic = false, legacy = false,
		role = "attacker", starter = false, boss = true,
		hp = 88, atk = 15, def = 6, speed = 12,
		entry = "none", artwork = "PLACEHOLDER-no-asset-id",
	},
	{
		id = "BC-WIND-01", franchise = "Black Clover",
		canonical = "Four-Leaf Wind Mage — Gale Captain", alias = "Gale Mage",
		rarity = "Uncommon", mythic = false, legacy = false,
		role = "support", starter = false,
		hp = 58, atk = 9, def = 5, speed = 13,
		entry = "none", artwork = "PLACEHOLDER-no-asset-id",
	},
	{
		id = "BC-SEA-01", franchise = "Black Clover",
		canonical = "Royal Sea Mage — Water Barrier", alias = "Sea Barrier",
		rarity = "Rare", mythic = false, legacy = false,
		role = "counter", starter = false,
		hp = 64, atk = 10, def = 7, speed = 10,
		entry = "shield2", artwork = "PLACEHOLDER-no-asset-id",
	},
}

Cards.WORLD_01 = {
	id = "WORLD-01",
	name = "Provisional Slice World",
	encounters = { "BL-ICHIGO-01", "VS-THORFINN-01", "BC-ASTA-01" },
	boss = "NR-KAKASHI-01",
}

-- P3 expansion (2026-09-22): same shape as WORLD_01 (3 encounters + 1
-- boss). Encounter picks are existing non-starter editions, distinct
-- across worlds; bosses are the two boss=true rows above. Artwork stays
-- placeholder on every row; role-title naming unchanged.
Cards.WORLD_02 = {
	id = "WORLD-02",
	name = "Ashen Approach",
	encounters = { "VG-MUSASHI-01", "MHA-DEKU-01", "BC-SEA-01" },
	boss = "DB-PRINCE-01",
}

Cards.WORLD_03 = {
	id = "WORLD-03",
	name = "Hollow Summit",
	encounters = { "BK-GUTS-01", "VG-RIVAL-01", "MHA-BLAST-01" },
	boss = "MHA-FROSTBURN-01",
}

-- Ordered world list: Bootstrap.contentTables loops this (never a
-- hardcoded WORLD_01). WORLD-01 stays first so its historical encounter
-- keys (enc-1..3, boss-1) are preserved byte-identically.
Cards.WORLDS = { Cards.WORLD_01, Cards.WORLD_02, Cards.WORLD_03 }

function Cards.getById(id)
	for i = 1, #Cards.EDITIONS do
		if Cards.EDITIONS[i].id == id then
			return Cards.EDITIONS[i]
		end
	end
	return nil
end

-- Starter/counter identities usable with no luck (Common/Uncommon + starter).
function Cards.starters()
	local out = {}
	for i = 1, #Cards.EDITIONS do
		if Cards.EDITIONS[i].starter then
			out[#out + 1] = Cards.EDITIONS[i]
		end
	end
	return out
end

-- Convert an edition to a resolver fighter block (immutable fresh table).
function Cards.toFighter(edition)
	return {
		cardId = edition.id,
		hp = edition.hp,
		maxHp = edition.hp,
		atk = edition.atk,
		def = edition.def,
		speed = edition.speed,
		shield = 0,
		status = { name = "none", ticks = 0, power = 0 },
		entry = edition.entry,
	}
end

return Cards
]]></string>
