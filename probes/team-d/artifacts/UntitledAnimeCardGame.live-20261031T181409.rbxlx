      <Item class="Script" referent="39">
        <Properties>
          <string name="Name">StudioDemoDrill</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- StudioDemoDrill.server.luau — genuine server-side Studio drills (session7-B).
-- This is a Script (run by Roblox on the server shortly after place start),
-- NOT a ModuleScript: never required by Lune/plain-Lua tests, never executes
-- off-engine. It runs two REAL data-path drills against isolated in-memory
-- harnesses (never the live player store) and publishes each P6StudioChecks
-- workspace marker ONLY after the behaviour genuinely verified:
--
--   UACGResetCycle  preview bound a token -> confirm committed exactly one
--                   new run -> duplicate confirm reconciled (no second run)
--   UACGSaveFailure failed load returned Unavailable and NO fresh default
--                   was written over the (possibly existing) data
--
-- A failed drill publishes NOTHING for its marker (honest partial credit).

local MARK = "UACGDemoDrill"

local function short(s, n)
	s = tostring(s or "")
	if #s > n then
		return string.sub(s, 1, n) .. "..."
	end
	return s
end

local function drillResetCycle()
	local Bootstrap = require(script.Parent:WaitForChild("Bootstrap"))
	local MemoryAdapter = require(script.Parent:WaitForChild("MemoryAdapter"))
	local Cards = game:GetService("ReplicatedStorage")
		:WaitForChild("Shared"):WaitForChild("Content")
		:WaitForChild("Cards")
	local CardsMod = require(Cards)
	local Resolver = require(game:GetService("ReplicatedStorage")
		:WaitForChild("Shared"):WaitForChild("Combat")
		:WaitForChild("Resolver"))

	local adapter = MemoryAdapter.new()
	local h = Bootstrap.build({
		adapter = adapter,
		clock = os.time,
		drawInt = function(upper)
			return math.random(1, upper)
		end,
		drawSeed = function()
			return Bootstrap.randomSeed(math.random)
		end,
		resolver = Resolver,
		Cards = CardsMod,
		serverId = "uacg-studio-drill",
	})

	local userId = 999001
	local created, cerr = h.store.create(h.store, userId, nil)
	if not created then
		return false, "drill setup create failed: " .. short(cerr, 120)
	end
	-- Drill setup (documented seed, not the behaviour under test): the
	-- rebirth contract requires the committed boss milestone, so the
	-- isolated drill profile commits it before previewing.
	local seeded, _, seedErr = adapter.update(adapter,
		h.store.keyFor and h.store.keyFor(userId)
			or ("profile:" .. tostring(userId)),
		function(current)
			if current == nil then
				return nil, "missing drill profile"
			end
			current.run.bossClaimed = true
			return current, nil
		end)
	if not seeded then
		return false, "drill setup milestone failed: " .. short(seedErr, 120)
	end
	local epoch = seeded.session and seeded.session.epoch or 1
	local runBefore = seeded.run.runId

	-- 1. Preview binds a token.
	local prev = h.rebirth.preview(h.rebirth, userId, "drill-prev-1", nil,
		{ epoch = epoch, seq = 1 })
	if prev.status ~= "Committed" or type(prev.result) ~= "table"
		or type(prev.result.token) ~= "string" then
		return false, "preview did not bind a token: "
			.. short(prev.reason or prev.status, 120)
	end
	local token = prev.result.token

	-- 2. Confirm commits exactly one new run.
	local conf = h.rebirth.confirm(h.rebirth, userId, "drill-conf-1", token,
		{ epoch = epoch, seq = 2 })
	if conf.status ~= "Committed" then
		return false, "confirm did not commit: "
			.. short(conf.reason or conf.status, 120)
	end
	local after, aerr = h.store.read(h.store, userId)
	if not after then
		return false, "post-confirm read failed: " .. short(aerr, 120)
	end
	if after.run.runId ~= runBefore + 1 then
		return false, "confirm did not open exactly one new run"
	end
	if after.run.lastRebirth == nil
		or after.run.lastRebirth.token ~= token then
		return false, "confirm did not record the committed token"
	end

	-- 3. Duplicate confirm reconciles (stale/duplicate rejected as a new
	-- commit; runId must NOT advance again).
	local dup = h.rebirth.confirm(h.rebirth, userId, "drill-conf-2", token,
		{ epoch = epoch, seq = 3 })
	if dup.status ~= "AlreadyCommitted" then
		return false, "dup confirm not reconciled: "
			.. short(dup.reason or dup.status, 120)
	end
	local final, ferr = h.store.read(h.store, userId)
	if not final then
		return false, "post-dup read failed: " .. short(ferr, 120)
	end
	if final.run.runId ~= runBefore + 1 then
		return false, "dup confirm opened a second run"
	end
	return true, nil
end

local function drillSaveFailure()
	local MemoryAdapter = require(script.Parent:WaitForChild("MemoryAdapter"))
	local Store = require(script.Parent:WaitForChild("Store"))

	local adapter = MemoryAdapter.new()
	adapter.faults.failLoad = true
	local store = Store.new({ adapter = adapter,
		serverId = "uacg-studio-drill", clock = os.time })

	-- Failed load must surface as unknown (never as "new player").
	local data, derr, exists = Store.loadExisting(store, 999002)
	if derr == nil then
		return false, "failed load did not surface an error"
	end
	if exists then
		return false, "failed load reported existence"
	end
	if data ~= nil then
		return false, "failed load returned data"
	end
	-- Create over the failed load must REFUSE to default.
	local created, cerr = Store.create(store, 999002, nil)
	if created ~= nil then
		return false, "create defaulted over a failed load"
	end
	if cerr == nil or not string.find(cerr, "refusing default", 1, true) then
		return false, "create refusal reason unexpected: "
			.. short(cerr, 120)
	end
	-- Nothing was written: the key is still absent-or-failing, never a
	-- fresh default document.
	if adapter.tables["profile:999002"] ~= nil then
		return false, "failed-load path wrote a document"
	end
	return true, nil
end

local function publish(key)
	local ok = pcall(function()
		workspace:SetAttribute(key, true)
	end)
	return ok
end

local function runDrills()
	-- NOTE: pcall multi-return unpacking done explicitly per drill.
	print("[" .. MARK .. "] reset-cycle drill starting")
	local pok, pokRes, pokErr = pcall(drillResetCycle)
	if pok and pokRes == true then
		publish("UACGResetCycle")
		print("[" .. MARK .. "] reset-cycle demonstrated "
			.. "(preview->confirm->new-run, dup reconciled)")
	else
		print("[" .. MARK .. "] reset-cycle NOT demonstrated: "
			.. short(pokErr or pokRes, 200))
	end
	print("[" .. MARK .. "] save-failure drill starting")
	local sok, sokRes, sokErr = pcall(drillSaveFailure)
	if sok and sokRes == true then
		publish("UACGSaveFailure")
		print("[" .. MARK .. "] save-failure path demonstrated "
			.. "(failed load never defaults)")
	else
		print("[" .. MARK .. "] save-failure NOT demonstrated: "
			.. short(sokErr or sokRes, 200))
	end
end

-- Delay slightly so Bootstrap/Remotes finish starting first; drills use an
-- isolated harness and never touch live player state.
task.delay(3, function()
	local ok, err = pcall(runDrills)
	if not ok then
		print("[" .. MARK .. "] drill runner crashed: " .. short(err, 200))
	end
end)
]]></string>
