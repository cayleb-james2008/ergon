        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Pools</string>
            <string name="Source"><![CDATA[-- Pools.luau — provisional rarity roll-pool distribution (P2).
-- Pure Luau / plain-Lua subset. Covers all six rarities with weights that
-- total exactly 10000, ALIGNED with P3 Config.ROLL_WEIGHTS_10000
-- (6000/2500/1000/450/45/5; lead-authorized spec evolution 2026-09-20 —
-- P2's earlier 520/260/130/60/25/5-of-1000 scale is superseded).
-- PROVISIONAL mapping for slice engineering only; P3 owns pity/enforcement.
-- Mythic is a rarity; Legacy is a separate retention flag (see Cards.luau),
-- never a pool.

local Pools = {}

Pools.CONTENT_VERSION = "content-provisional-1"
Pools.WEIGHT_TOTAL = 10000

-- Weight in ten-thousandths; sum is exactly 10000.
Pools.POOLS = {
	{ rarity = "Common", weight = 6000 },
	{ rarity = "Uncommon", weight = 2500 },
	{ rarity = "Rare", weight = 1000 },
	{ rarity = "Epic", weight = 450 },
	{ rarity = "Legendary", weight = 45 },
	{ rarity = "Mythic", weight = 5 },
}

function Pools.totalWeight()
	local total = 0
	for i = 1, #Pools.POOLS do
		total = total + Pools.POOLS[i].weight
	end
	return total
end

-- Deterministic pool pick from a uniform integer roll in [1,10000].
function Pools.pickByRoll(roll)
	assert(type(roll) == "number" and roll == math.floor(roll), "roll must be an integer")
	assert(roll >= 1 and roll <= 10000, "roll out of range")
	local acc = 0
	for i = 1, #Pools.POOLS do
		acc = acc + Pools.POOLS[i].weight
		if roll <= acc then
			return Pools.POOLS[i].rarity
		end
	end
	return "Mythic"
end

return Pools
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="13">
        <Properties>
          <string name="Name">Progression</string>
        </Properties>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">AwayProgress</string>
            <string name="Source"><![CDATA[-- AwayProgress.luau — deterministic, capped free run-XP calculation.

local AwayProgress = {}

local Config
if game ~= nil then
	Config = require(script.Parent:WaitForChild("Config"))
elseif dofile ~= nil then
	local here = debug.getinfo(1, "S").source
	local dir = string.match(here, "@(.*/)") or "./src/shared/progression/"
	Config = dofile(dir .. "Config.luau")
else
	Config = require("./Config")
end

-- Pure calculation. The caller supplies server-recorded timestamps, the
-- configured run-XP-per-hour rate table, and the configured catch-up cap.
function AwayProgress.calculate(lastSeenAt, now, rates, catchUpCapSeconds)
	if not Config.isSafeInteger(lastSeenAt, 0)
		or not Config.isSafeInteger(now, 0) then
		return nil, "timestamps must be safe nonnegative integers"
	end
	if type(rates) ~= "table"
		or not Config.isSafeInteger(rates.runXpPerHour, 0) then
		return nil, "rates.runXpPerHour must be a safe nonnegative integer"
	end
	if not Config.isSafeInteger(catchUpCapSeconds, 0) then
		return nil, "catch-up cap must be a safe nonnegative integer"
	end

	local clockSkew = now < lastSeenAt
	local elapsedSeconds = clockSkew and 0 or now - lastSeenAt
	local cappedSeconds = math.min(elapsedSeconds, catchUpCapSeconds)
	local rawXp = cappedSeconds / 3600 * rates.runXpPerHour
	if rawXp > Config.MAX_SAFE_INTEGER then
		return nil, "calculated run XP exceeds safe integer range"
	end
	return {
		elapsedSeconds = elapsedSeconds,
		cappedSeconds = cappedSeconds,
		catchUpCapSeconds = catchUpCapSeconds,
		capApplied = elapsedSeconds > catchUpCapSeconds,
		clockSkew = clockSkew,
		runXp = math.floor(rawXp),
	}, nil
end

return AwayProgress
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Battles</string>
            <string name="Source"><![CDATA[-- Battles.luau — pure battle snapshot + reward rules (P3).
-- BattleStart builds legal IMMUTABLE snapshots from confirmed state and runs
-- the pure P2 Resolver; the issued attemptId + sealed reward entitlement are
-- stored server-side. Reward cadence comes from the server clock (issuedAt /
-- claim rules in BattleService), never from animation length or skip state.

local function loadSibling(name)
	if game ~= nil then
		return require(script.Parent:WaitForChild(name))
	elseif dofile ~= nil then
		local here = debug.getinfo(1, "S").source
		local dir = string.match(here, "@(.*/)") or "./src/shared/progression/"
		return dofile(dir .. name .. ".luau")
	else
		return require("./" .. name)
	end
end

local Config = loadSibling("Config")
local Progression = loadSibling("Progression")

local Battles = {}

-- Build immutable fighter snapshots from confirmed run state.
-- editionsById: id -> {hp,atk,def,speed,entry}; skillMult: {atk,hp} multipliers.
function Battles.buildSnapshot(deckIds, editionsById, cardLevels, chapter,
	skillMult)
	if type(deckIds) ~= "table" or #deckIds < 1 then
		return nil, "empty deck"
	end
	skillMult = skillMult or { atk = 1, hp = 1 }
	local fighters = {}
	for i = 1, #deckIds do
		local ed = editionsById[deckIds[i]]
		if not ed then
			return nil, "unknown edition: " .. tostring(deckIds[i])
		end
		local lvl = cardLevels[deckIds[i]] or 1
		local eff, err = Progression.effectiveLevel(lvl, chapter)
		if not eff then
			return nil, err
		end
		-- Deterministic trained bonus per effective level above 1
		-- (Config.CARD_TRAINED_BP_PER_LEVEL, R1 provisional +6%/level),
		-- floored to integers (proposed, visible in preview).
		local bp = Config.CARD_TRAINED_BP_PER_LEVEL / 10000
		local hp = math.floor(ed.hp * skillMult.hp * (1 + bp * (eff - 1)))
		local atk = math.floor(ed.atk * skillMult.atk * (1 + bp * (eff - 1)))
		if hp < 1 then
			hp = 1
		end
		if atk < 1 then
			atk = 1
		end
		fighters[#fighters + 1] = {
			cardId = deckIds[i],
			hp = hp,
			maxHp = hp,
			atk = atk,
			def = ed.def,
			speed = ed.speed,
			shield = 0,
			status = { name = "none", ticks = 0, power = 0 },
			entry = ed.entry or "none",
		}
	end
	return fighters, nil
end

-- Build the fixed enemy team snapshot for an encounter id. enemyIds is the
-- ordered opposing deck (world encounter or boss deck), same shape as above.
function Battles.buildEnemySnapshot(enemyIds, editionsById)
	if type(enemyIds) ~= "table" or #enemyIds < 1 then
		return nil, "empty enemy deck"
	end
	local fighters = {}
	for i = 1, #enemyIds do
		local ed = editionsById[enemyIds[i]]
		if not ed then
			return nil, "unknown enemy edition: " .. tostring(enemyIds[i])
		end
		fighters[#fighters + 1] = {
			cardId = enemyIds[i],
			hp = ed.hp,
			maxHp = ed.hp,
			atk = ed.atk,
			def = ed.def,
			speed = ed.speed,
			shield = 0,
			status = { name = "none", ticks = 0, power = 0 },
			entry = ed.entry or "none",
		}
	end
	return fighters, nil
end

-- Pure reward entitlement from a sealed resolver result. Server-issued only:
-- the client never supplies victory, XP, or currency.
-- result: {snapshot={winner,...}}; firstClear: encounter never cleared before.
function Battles.rewardFor(winner, isBoss, firstClear)
	if winner ~= "A" and winner ~= "B" and winner ~= "tie" then
		return nil, "bad winner"
	end
	if winner ~= "A" then
		return { xp = 0, currency = 0, firstClearRank = nil }, nil
	end
	local xp, currency = Config.REWARD_WIN_XP, Config.REWARD_WIN_CURRENCY
	if isBoss then
		xp, currency = Config.REWARD_BOSS_XP, Config.REWARD_BOSS_CURRENCY
	end
	return { xp = xp, currency = currency, firstClearRank = firstClear or nil }, nil
end

-- Attempt identity: monotonic per-run sequence, durable forever.
function Battles.nextAttemptId(runId, seq)
	return runId .. ":" .. seq
end

return Battles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Config</string>
            <string name="Source"><![CDATA[-- Config.luau — P3 provisional progression tuning (NOT production config).
-- Package source: game-design-draft.json + PROGRESSION-DESIGN.md + roster.md.
-- Roll weights match the package proposal exactly: 6000/2500/1000/450/45/5
-- over 10000 (60/25/10/4.5/0.45/0.05%). Pools.luau carries the same
-- distribution (6000/2500/1000/450/45/5 over 10000); P3 enforcement below is
-- authoritative for the server.
-- Every number here is a proposed starting bound (SPEC Assumptions), not an
-- approved production value. R1 provisional training bounds (2026-09-20):
-- CARD_TRAINED_BP_PER_LEVEL=600, cardXpNext=25*level, CARD_XP_WIN=25,
-- CARD_XP_LOSS=5. Reason: with the frozen Cards roster + Resolver, starters
-- at level 1 lose the boss 100/100 and even cap-30 cards at +2%/level never
-- win (0/100), so no earned-training path existed; at +6%/level starters
-- still lose 100/100 at level 1 and win 100/100 at true level 10 (boss
-- chapter cap 15), reachable in ~45 farmed wins. Boss stats untouched; no
-- top-rarity dependency (starters only).

local Config = {}

Config.SCHEMA_VERSION = 1
Config.PROGRESSION_VERSION = "prog-1"
Config.RULES_VERSION = "provisional-1" -- must match P2 Validate.RULES_VERSION
Config.CONTENT_VERSION = "content-provisional-1" -- must match P2 content

-- Free-roll cadence (proposed, 6s) and hard pity (proposed, 1800).
Config.ROLL_COOLDOWN_S = 6
Config.PITY_FAILS = 1800

-- U4a provisional earned-only Store offer: one card, paid only from the
-- server-issued run currency. Odds and pity reuse the standard roll table.
Config.EARNED_PACK_ID = "earned-card-pack-v1"
Config.EARNED_PACK_COST = 100
-- Provisional story reward; the decision and rationale are in docs/decisions.md.
Config.LEGACY_STORY_ROUTE_ID = "boss-3"
Config.LEGACY_STORY_REWARD_ID = "DB-GOKU-01"

-- Rarity weights in ten-thousandths; total is exactly 10000.
Config.ROLL_WEIGHTS_10000 = {
	{ rarity = "Common", weight = 6000 },
	{ rarity = "Uncommon", weight = 2500 },
	{ rarity = "Rare", weight = 1000 },
	{ rarity = "Epic", weight = 450 },
	{ rarity = "Legendary", weight = 45 },
	{ rarity = "Mythic", weight = 5 },
}
Config.ROLL_WEIGHT_TOTAL = 10000

-- Ordered deck: explicit ordered owned IDs, unique, configured cap.
-- DECK_MAX=4 is provisional (package attacker_slots_provisional=4).
Config.DECK_MIN = 1
Config.DECK_MAX = 4

-- Profile bounds (every field bounded; duplicate counts and cache sizes too).
Config.MAX_DUP_COUNT = 99 -- copies per owned identity, this run
Config.MAX_COLLECTION_IDS = 64 -- distinct owned identities, this run
Config.MAX_CATALOGUE_IDS = 128 -- distinct discovered identities, account
Config.MAX_PENDING_ROLLS = 10 -- unconfirmed auto-roll batch bound
Config.MAX_RECENT_OPS = 50 -- bounded request cache (NOT durable proof)
Config.MAX_DECK_IDS = 4 -- mirrors DECK_MAX
Config.MAX_CURRENCY = 9999999
Config.MAX_XP = 99999999
Config.MAX_CARD_LEVEL = 30
Config.MAX_RUN_LEVEL = 99
Config.MAX_ACCOUNT_LEVEL = 50
Config.MAX_STRING_LEN = 64 -- request string bound
Config.MAX_TABLE_DEPTH = 4 -- request nesting bound
Config.MAX_TABLE_WIDTH = 32 -- request array/map width bound
-- Lua/Roblox numbers are IEEE-754 doubles: integer request identities must
-- stay within the exact-integer range so a malicious high-water cannot stall
-- future client sequences at 2^53.
Config.MAX_SAFE_INTEGER = 9007199254740991

function Config.isSafeInteger(value, minimum)
	return type(value) == "number" and value == value
		and value ~= math.huge and value ~= -math.huge
		and value == math.floor(value)
		and value >= (minimum or 0)
		and value <= Config.MAX_SAFE_INTEGER
end

-- Level curves (proposed): xp to advance from `level` to `level+1`.
-- R1 provisional (2026-09-20): card curve 25*level so true level 10 costs
-- 1125 XP per card (~45 farmed wins at CARD_XP_WIN=25); run curve unchanged.
function Config.cardXpNext(level)
	return 25 * level
end

function Config.runXpNext(level)
	return 100 * level
end

-- Trained bonus per effective card level above 1, in basis points
-- (R1 provisional 600 = +6%/level, floored to integers, visible in preview;
-- see header note for the measured reason).
Config.CARD_TRAINED_BP_PER_LEVEL = 600

-- Chapter attunement ceiling by chapter index 1..5 (proposed).
Config.CHAPTER_CAPS = { 6, 10, 15, 21, 30 }

-- Permanent mastery: 8 ranks x 3 points = 24 max; aggregate ceilings in
-- basis points (6% ATK, 6% HP, 20% card XP). Repeats/discards mint nothing.
Config.MASTERY_MAX_POINTS = 24
Config.MASTERY_RANK_COUNT = 8
Config.MASTERY_POINTS_PER_RANK = 3
Config.MASTERY_ATK_BP_MAX = 600
Config.MASTERY_HP_BP_MAX = 600
Config.MASTERY_XP_BP_MAX = 2000

-- Finite skill tree (11 nodes, 3 branches; points only from first-clear
-- ranks). effect is basis points toward the aggregate ceilings above.
-- (Earlier comment said 12; the table holds 11 — R1 correction 2026-09-20.)
Config.SKILL_NODES = {
	{ id = "prep-atk-1", branch = "preparation", maxRanks = 2, atkBp = 150, hpBp = 0, xpBp = 0 },
	{ id = "prep-atk-2", branch = "preparation", maxRanks = 2, atkBp = 150, hpBp = 0, xpBp = 0 },
	{ id = "prep-hp-1", branch = "preparation", maxRanks = 2, atkBp = 0, hpBp = 150, xpBp = 0 },
	{ id = "prep-hp-2", branch = "preparation", maxRanks = 2, atkBp = 0, hpBp = 150, xpBp = 0 },
	{ id = "train-xp-1", branch = "training", maxRanks = 3, atkBp = 0, hpBp = 0, xpBp = 250 },
	{ id = "train-xp-2", branch = "training", maxRanks = 3, atkBp = 0, hpBp = 0, xpBp = 250 },
	{ id = "prep-atk-3", branch = "preparation", maxRanks = 2, atkBp = 150, hpBp = 0, xpBp = 0 },
	{ id = "prep-hp-3", branch = "preparation", maxRanks = 2, atkBp = 0, hpBp = 150, xpBp = 0 },
	{ id = "train-bench-1", branch = "training", maxRanks = 2, atkBp = 0, hpBp = 0, xpBp = 250 },
	{ id = "restore-bench-1", branch = "restoration", maxRanks = 2, atkBp = 0, hpBp = 0, xpBp = 250 },
	{ id = "restore-flex-1", branch = "restoration", maxRanks = 2, atkBp = 150, hpBp = 150, xpBp = 0 },
}

-- Rank ladder (8 finite ranks x 3 pts; repeat = 0). rank-N unlocks only
-- in runNumber >= N with that run's committed boss milestone: at most ONE
-- rank per eligible run, so a single boss can never mint all 24 points.
Config.RANKS = {
	{ id = "rank-1", points = 3, minRun = 1 },
	{ id = "rank-2", points = 3, minRun = 2 },
	{ id = "rank-3", points = 3, minRun = 3 },
	{ id = "rank-4", points = 3, minRun = 4 },
	{ id = "rank-5", points = 3, minRun = 5 },
	{ id = "rank-6", points = 3, minRun = 6 },
	{ id = "rank-7", points = 3, minRun = 7 },
	{ id = "rank-8", points = 3, minRun = 8 },
}

-- Battle rewards (proposed, server-issued only — never client-supplied).
Config.REWARD_WIN_XP = 20
Config.REWARD_WIN_CURRENCY = 10
Config.REWARD_BOSS_XP = 100
Config.REWARD_BOSS_CURRENCY = 50
-- Card participation XP per deck card (R1 provisional; losing still trains).
Config.CARD_XP_WIN = 25
Config.CARD_XP_LOSS = 5

-- Tutorial: fixed deterministic starter grant (no luck involved).
Config.STARTER_IDS = { "NR-NARUTO-01", "VS-THORFINN-01", "BC-ASTA-01" }
Config.TUTORIAL_LABEL = "deterministic"

-- Audio volumes are finite 0..100 integers (no audio generated here).
Config.VOLUME_MIN = 0
Config.VOLUME_MAX = 100
Config.DEFAULT_VOLUMES = { musicVolume = 80, sfxVolume = 80, uiVolume = 100,
	ambienceVolume = 60 }
-- Settings allow-lists (persisted per account, survive rebirth).
-- speed accepts the two named cadences and the three numeric presentation
-- multipliers 1/2/4 (client cycles 1->2->4; server stores the given form).
-- One canonical table owns the allowed set; SPEEDS is derived, never
-- hand-synced.
Config.THEMES = { dark = true, light = true }
-- Canonical ordered speed list (single source; SPEEDS derived, the read
-- model copies this order — never hand-duplicated elsewhere).
Config.SPEED_ORDER = { "normal", "fast", 1, 2, 4 }
-- Canonical presentation multiplier per stored speed value.
Config.SPEED_MULT = { normal = 1, fast = 2, [1] = 1, [2] = 2, [4] = 4 }
Config.SPEEDS = {}
for i = 1, #Config.SPEED_ORDER do
	Config.SPEEDS[Config.SPEED_ORDER[i]] = true
end

-- Canonical speed multiplier for a stored speed value (nil+err if unknown).
function Config.speedMult(speed)
	local m = Config.SPEED_MULT[speed]
	if m == nil then
		return nil, "unknown speed"
	end
	return m, nil
end

-- Starter deck / enemy-team snapshot bounds for STORED pending documents.
-- MAX_FIGHTER_STAT caps any single stored fighter stat (hp/maxHp/atk/def/
-- speed/shield): the frozen roster peaks at ~1e2 base per stat, trained
-- (+6%/level to cap 30) and skill (+6%) multipliers stay under 3x, so 1e5
-- is >300x headroom above anything BattleService can seal — a stored
-- 999999-class value is forged data, never a legitimate snapshot.
-- MAX_BATTLE_TURNS mirrors the read-only P2 Resolver.MAX_TURNS (R1 lane
-- never edits src/shared/combat/**); a sealed longer battle is forged.
Config.MAX_FIGHTER_STAT = 100000
Config.MAX_BATTLE_TURNS = 50

-- Provisional free away progression: 60 Run XP per hour, with at most
-- eight hours of catch-up per claim. This grants only ordinary run XP; it
-- never awards currency, cards, rolls, paid items, or exclusive benefits.
Config.AWAY_REWARD_RATES = { runXpPerHour = 60 }
Config.AWAY_CATCH_UP_CAP_S = 8 * 60 * 60

-- Per-command rate limits: min interval seconds + burst bucket size.
Config.RATE_LIMITS = {
	RollOnce = { interval = 6, burst = 2 },
	BuyEarnedPack = { interval = 1, burst = 2 },
	SetAutoRoll = { interval = 1, burst = 5 },
	SetDeck = { interval = 1, burst = 5 },
	SetSkills = { interval = 1, burst = 5 },
	ClaimRank = { interval = 2, burst = 3 },
	ClaimAway = { interval = 2, burst = 3 },
	SaveSettings = { interval = 1, burst = 5 },
	BattleStart = { interval = 2, burst = 3 },
	BattleClaim = { interval = 1, burst = 5 },
	BattleStatus = { interval = 0, burst = 20 },
	TutorialGrant = { interval = 2, burst = 3 },
	RebirthPreview = { interval = 2, burst = 3 },
	RebirthConfirm = { interval = 2, burst = 3 },
	RebirthCancel = { interval = 1, burst = 5 },
	GetProfile = { interval = 0, burst = 20 },
}

-- Session fencing lease (proposed; tested with injected clocks/skew).
Config.SESSION_LEASE_S = 300

-- DataStore namespaces: explicit DEV only; production blocked until the
-- release config lands (see server/DataStoreAdapter.luau).
Config.DATASTORE_SCOPE_DEV = "UACG_DEV_v1"

return Config
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Profile</string>
            <string name="Source"><![CDATA[-- Profile.luau — bounded player profile schema (P3). Pure Luau/plain-Lua subset.
-- One profile = one durable transaction boundary. All fields bounded (see
-- Config). No JSON encoding is used anywhere: Roblox remotes carry Lua tables
-- directly. Durable proof is monotonic sequences (runId/attemptSeq/opSeq,
-- pruneMark), never the bounded recent-results cache.

local function loadSibling(name)
	if game ~= nil then
		return require(script.Parent:WaitForChild(name))
	elseif dofile ~= nil then
		local here = debug.getinfo(1, "S").source
		local dir = string.match(here, "@(.*/)") or "./src/shared/progression/"
		return dofile(dir .. name .. ".luau")
	else
		return require("./" .. name)
	end
end

local Config = loadSibling("Config")
local Progression = loadSibling("Progression")

local Profile = {}

-- Fresh profile for a user with no durable data. Starter cards are granted
-- separately by the deterministic tutorial grant (never inside this default).
function Profile.new(userId, now)
	local account = {
		catalogue = {}, -- id -> true (discovered, permanent)
		mythicEntitlements = {}, -- id -> true (permanent)
		legacyEntitlements = {}, -- id -> true (permanent)
		keepsakeId = nil, -- one replaceable account slot
		skillPoints = 0, -- earned from first-clear ranks (<=24)
		skillAlloc = {}, -- nodeId -> ranks
		claimedRanks = {}, -- rankId -> true (repeat = no reward)
		storePurchaseRecovery = nil, -- last server-owned Store identity/outcome
		settings = {
			theme = "dark",
			accent = "#A78BFA",
			reducedMotion = false,
			flashes = true,
			speed = "normal",
			musicVolume = 80,
			sfxVolume = 80,
			uiVolume = 100,
			ambienceVolume = 60,
		},
		entitlements = {}, -- protected paid/compensated grants
		tutorialDone = false,
		accountLevel = 1,
		accountXp = 0,
	}
	local run = {
		runId = 1,
		runNumber = 1,
		level = 1,
		xp = 0,
		currency = 0,
		pityFails = 0, -- standard-roll non-mythic streak (survives rebirth)
		cooldownReadyAt = 0,
		collection = {}, -- id -> count owned THIS run (bounded)
		deck = {}, -- ordered owned ids, unique, <= DECK_MAX
		cardLevels = {}, -- id -> run level (reset each rebirth)
		cardXp = {}, -- id -> leftover xp toward next card level (0 valid)
		encounters = {}, -- encounterId -> true cleared this run
		bossClaimed = false, -- committed boss milestone this run
		pendingBattle = nil, -- {attemptId,runId,encounterId,isBoss,snapshot,seed,issuedAt}
		pendingReward = nil, -- {attemptId,runId,xp,currency,firstClearRank}
		completedAttempts = {}, -- attemptId -> true (consumed once, monotonic proof)
		attemptSeq = 0, -- monotonic per run; attemptId = runId..":"..seq
		opSeq = 0, -- monotonic per profile (legacy lane)
		reqHighWater = 0, -- durable v2 command-seq high-water (bounded proof)
		pruneMark = 0, -- opSeq high-water: ops <= pruneMark are durably done
		recentOps = {}, -- bounded opId -> result summary (cache only)
		recentOrder = {}, -- insertion order for bounded eviction
		autoRoll = false,
		preview = nil, -- open rebirth preview freezes the economy
		lastRebirth = nil, -- {token, fromRun, toRun} (duplicate-confirm proof)
	}
	return {
		schemaVersion = Config.SCHEMA_VERSION,
		progressionVersion = Config.PROGRESSION_VERSION,
		rulesVersion = Config.RULES_VERSION,
		contentVersion = Config.CONTENT_VERSION,
		revision = 1, -- increments on every durable commit
		userId = userId,
		session = { epoch = 0, owner = nil, leaseUntil = 0 },
		account = account,
		run = run,
		updatedAt = now or 0,
	}
end

-- Bounded finite typed plain-data map for protected ACCOUNT records
-- (paid/cosmetic entitlements such as `paid_hat = true`): these are NOT
-- card ids and are never checked against the content roster. Keys are
-- bounded strings; values are booleans, finite numbers, or bounded
-- strings only. Nested tables, cycles-by-value, NaN/Infinity, functions
-- and oversize maps fail closed (rejected, never silently reset).
local function checkPlainData(t, maxKeys, label)
	if type(t) ~= "table" then
		return false, label .. " must be a table"
	end
	local n = 0
	for k, v in pairs(t) do
		n = n + 1
		if n > maxKeys then
			return false, label .. " exceeds " .. maxKeys .. " keys"
		end
		if type(k) ~= "string" or #k == 0
			or #k > Config.MAX_STRING_LEN then
			return false, label .. " key must be a bounded nonempty string"
		end
		local vt = type(v)
		if vt == "boolean" then
			-- plain flag, ok
		elseif vt == "number" then
			if v ~= v or v == math.huge or v == -math.huge then
				return false, label .. "[" .. k .. "] must be finite"
			end
		elseif vt == "string" then
			if #v > Config.MAX_STRING_LEN then
				return false, label .. "[" .. k .. "] string too long"
			end
		else
			return false, label .. "[" .. k .. "] must be plain data"
		end
	end
	return true, nil
end

local function isInt(v)
	return type(v) == "number" and v == math.floor(v)
		and v == v and v ~= math.huge and v ~= -math.huge
end

-- Finite nonnegative timestamp (clocks may be fractional; never NaN/Inf).
local function isStamp(v)
	return type(v) == "number" and v == v
		and v ~= math.huge and v ~= -math.huge and v >= 0
end

local function checkIdMap(map, maxKeys, maxCount, label)
	if type(map) ~= "table" then
		return false, label .. " must be a table"
	end
	local n = 0
	for k, v in pairs(map) do
		n = n + 1
		if n > maxKeys then
			return false, label .. " exceeds " .. maxKeys .. " ids"
		end
		if type(k) ~= "string" or #k == 0 or #k > Config.MAX_STRING_LEN then
			return false, label .. " key must be a bounded nonempty string"
		end
		if maxCount then
			if not isInt(v) or v < 1 or v > maxCount then
				return false, label .. "[" .. k .. "] count out of bounds"
			end
		elseif v ~= true then
			return false, label .. "[" .. k .. "] must be true"
		end
	end
	return true, nil
end

-- Stored fighter snapshot shape: one entry of pendingBattle.snapshotA/B as
-- sealed by BattleService from Battles.buildSnapshot (cardId/hp/maxHp/atk/
-- def/speed/shield/status/entry). Known content id (when the roster set is
-- provided), finite integer stats within Config.MAX_FIGHTER_STAT, live
-- consistency (hp>=1, maxHp>=hp), bounded status/entry fields and key
-- count. Naive single-field inflation (hp without maxHp) fails on the
-- maxHp>=hp consistency; 999999-class values fail the stat ceiling.
local function checkFighter(f, label, knownIds)
	if type(f) ~= "table" then
		return false, label .. " must be a table"
	end
	local n = 0
	for _ in pairs(f) do
		n = n + 1
		if n > 32 then
			return false, label .. " exceeds 32 fields"
		end
	end
	if type(f.cardId) ~= "string" or #f.cardId == 0
		or #f.cardId > Config.MAX_STRING_LEN then
		return false, label .. ".cardId out of bounds"
	end
	if knownIds ~= nil and not knownIds[f.cardId] then
		return false, label .. ".cardId unknown content id: " .. f.cardId
	end
	for _, k in ipairs({ "hp", "maxHp", "atk" }) do
		if not isInt(f[k]) or f[k] < 1
			or f[k] > Config.MAX_FIGHTER_STAT then
			return false, label .. "." .. k .. " out of bounds"
		end
	end
	for _, k in ipairs({ "def", "speed", "shield" }) do
		if not isInt(f[k]) or f[k] < 0
			or f[k] > Config.MAX_FIGHTER_STAT then
			return false, label .. "." .. k .. " out of bounds"
		end
	end
	if f.maxHp < f.hp then
		return false, label .. ".maxHp below hp"
	end
	if type(f.status) ~= "table" then
		return false, label .. ".status must be a table"
	end
	if type(f.status.name) ~= "string" or #f.status.name == 0
		or #f.status.name > Config.MAX_STRING_LEN then
		return false, label .. ".status.name out of bounds"
	end
	for _, k in ipairs({ "ticks", "power" }) do
		if not isInt(f.status[k]) or f.status[k] < 0
			or f.status[k] > Config.MAX_XP then
			return false, label .. ".status." .. k .. " out of bounds"
		end
	end
	if type(f.entry) ~= "string" or #f.entry > Config.MAX_STRING_LEN then
		return false, label .. ".entry out of bounds"
	end
	return true, nil
end

-- Sealed final-state shape: pendingReward.finalA/B carry the resolver
-- publicState ({active, hp, reserve}) sealed at BattleStart. A fainted side
-- reports hp 0 with active nil-able; reserve ids are known roster ids.
local function checkFinalState(fs, label, knownIds)
	if type(fs) ~= "table" then
		return false, label .. " must be a table"
	end
	if fs.active ~= nil and (type(fs.active) ~= "string"
		or #fs.active == 0 or #fs.active > Config.MAX_STRING_LEN) then
		return false, label .. ".active out of bounds"
	end
	if fs.active ~= nil and knownIds ~= nil
		and not knownIds[fs.active] then
		return false, label .. ".active unknown content id: " .. fs.active
	end
	if not isInt(fs.hp) or fs.hp < 0
		or fs.hp > Config.MAX_FIGHTER_STAT then
		return false, label .. ".hp out of bounds"
	end
	if type(fs.reserve) ~= "table" or #fs.reserve > Config.DECK_MAX then
		return false, label .. ".reserve exceeds cap"
	end
	for i = 1, #fs.reserve do
		local id = fs.reserve[i]
		if type(id) ~= "string" or #id == 0
			or #id > Config.MAX_STRING_LEN then
			return false, label .. ".reserve id out of bounds"
		end
		if knownIds ~= nil and not knownIds[id] then
			return false, label .. ".reserve unknown content id: " .. id
		end
	end
	return true, nil
end

-- Dense bounded fighter array: one side of a stored initial snapshot.
-- Holes, string keys and oversize teams fail (the service seals dense
-- 1..DECK_MAX arrays, always).
local function checkSnapshotArray(arr, label, knownIds)
	if type(arr) ~= "table" then
		return false, label .. " must be a table"
	end
	local n, total = #arr, 0
	for _ in pairs(arr) do
		total = total + 1
	end
	if n < 1 or n > Config.DECK_MAX or total ~= n then
		return false, label .. " size out of bounds"
	end
	for i = 1, n do
		local ok, err = checkFighter(arr[i], label .. "[" .. i .. "]",
			knownIds)
		if not ok then
			return false, err
		end
	end
	return true, nil
end

-- ok, err — every field bounded; rejects NaN/Infinity/wrong shapes.
-- Unifies the service validators with the stored shape: skill allocation is
-- checked through Progression.checkSkills (known nodes, per-node ranks,
-- spent-within-earned, aggregate ceilings — a stored 900bp attack book that
-- the service would reject is rejected here too); settings through
-- Progression.checkSettings; claimed ranks against the known ladder;
-- cardLevels 1..MAX_CARD_LEVEL; cardXp 0..MAX_XP (zero XP is valid — a card
-- exactly on a level boundary stores 0, and services omit-or-zero it);
-- deck unique AND owned in this run's collection.
-- knownIds (optional set id->true, injected by the server wiring from the
-- content roster): when provided, every content identity reference
-- (catalogue, collection, deck, cardLevels, cardXp, keepsake, entitlements,
-- pending snapshots and finals) must be a known id; when nil only
-- shape/bounds are checked (documented).
-- Pending documents are FULLY shape-checked (not scalar-only): BattleService
-- always seals isBoss + snapshotA/B (initial fighters) + winner/turns/
-- eventHash + finalA/B (resolver publicState), and status re-resolves the
-- stored snapshots on reconnect — so a forged persisted snapshot must fail
-- closed here at load, before it can ever reach the resolver.
function Profile.validate(p, knownIds)
	if type(p) ~= "table" then
		return false, "profile must be a table"
	end
	if p.schemaVersion ~= Config.SCHEMA_VERSION then
		return false, "unsupported schemaVersion"
	end
	if p.progressionVersion ~= Config.PROGRESSION_VERSION then
		return false, "unsupported progressionVersion"
	end
	if p.rulesVersion ~= Config.RULES_VERSION then
		return false, "unsupported rulesVersion"
	end
	if p.contentVersion ~= Config.CONTENT_VERSION then
		return false, "unsupported contentVersion"
	end
	if not isInt(p.revision) or p.revision < 1 then
		return false, "revision out of bounds"
	end
	if type(p.userId) ~= "number" and type(p.userId) ~= "string" then
		return false, "userId must be a number or string"
	end
	if not isStamp(p.updatedAt) then
		return false, "updatedAt must be a finite nonnegative number"
	end
	if type(p.session) ~= "table" or not isInt(p.session.epoch)
		or p.session.epoch < 0 then
		return false, "session.epoch out of bounds"
	end
	if p.session.owner ~= nil and type(p.session.owner) ~= "string" then
		return false, "session.owner must be a string or nil"
	end
	if not isStamp(p.session.leaseUntil) then
		return false, "session.leaseUntil must be finite"
	end
	local function knownCheck(id, label)
		if knownIds ~= nil and not knownIds[id] then
			return false, label .. " unknown content id: " .. id
		end
		return true, nil
	end
	local a = p.account
	if type(a) ~= "table" then
		return false, "account must be a table"
	end
	local ok, err = checkIdMap(a.catalogue, Config.MAX_CATALOGUE_IDS, nil, "catalogue")
	if not ok then
		return false, err
	end
	ok, err = checkIdMap(a.mythicEntitlements, Config.MAX_CATALOGUE_IDS, nil, "mythicEntitlements")
	if not ok then
		return false, err
	end
	ok, err = checkIdMap(a.legacyEntitlements, Config.MAX_CATALOGUE_IDS, nil, "legacyEntitlements")
	if not ok then
		return false, err
	end
	if knownIds ~= nil then
		for id in pairs(a.catalogue) do
			ok, err = knownCheck(id, "catalogue")
			if not ok then
				return false, err
			end
		end
		for id in pairs(a.mythicEntitlements) do
			ok, err = knownCheck(id, "mythicEntitlements")
			if not ok then
				return false, err
			end
		end
		for id in pairs(a.legacyEntitlements) do
			ok, err = knownCheck(id, "legacyEntitlements")
			if not ok then
				return false, err
			end
		end
	end
	if a.keepsakeId ~= nil and (type(a.keepsakeId) ~= "string"
		or #a.keepsakeId == 0 or #a.keepsakeId > Config.MAX_STRING_LEN) then
		return false, "keepsakeId must be a bounded string or nil"
	end
	if a.keepsakeId ~= nil and knownIds ~= nil
		and not knownIds[a.keepsakeId] then
		return false, "keepsakeId unknown content id: " .. a.keepsakeId
	end
	if not isInt(a.skillPoints) or a.skillPoints < 0
		or a.skillPoints > Config.MASTERY_MAX_POINTS then
		return false, "skillPoints out of bounds"
	end
	-- Same authority as the service: known nodes, per-node ranks,
	-- spent within earned points, aggregate +6%/+6%/+20% ceilings.
	ok, err = Progression.checkSkills(a.skillAlloc or {}, a.skillPoints)
	if not ok then
		return false, "skillAlloc invalid: " .. err
	end
	-- Claimed ranks must be known ladder ids (repeat = no reward is service
	-- logic; storage only admits known ids).
	if type(a.claimedRanks) ~= "table" then
		return false, "claimedRanks must be a table"
	end
	local rankKnown = {}
	for i = 1, #Config.RANKS do
		rankKnown[Config.RANKS[i].id] = true
	end
	local nRanks = 0
	for id, v in pairs(a.claimedRanks) do
		nRanks = nRanks + 1
		if nRanks > Config.MASTERY_RANK_COUNT then
			return false, "claimedRanks exceeds "
				.. Config.MASTERY_RANK_COUNT .. " ids"
		end
		if not rankKnown[id] then
			return false, "claimedRanks unknown rank: " .. tostring(id)
		end
		if v ~= true then
			return false, "claimedRanks[" .. id .. "] must be true"
		end
	end
	-- Settings persist per account: stored settings must satisfy the same
	-- authority the SaveSettings service enforces.
	ok, err = Progression.checkSettings(a.settings)
	if not ok then
		return false, "settings invalid: " .. err
	end
	if type(a.entitlements) ~= "table" then
		return false, "entitlements must be a table"
	end
	ok, err = checkPlainData(a.entitlements, Config.MAX_CATALOGUE_IDS,
		"entitlements")
	if not ok then
		return false, err
	end
	local storeRecovery = a.storePurchaseRecovery
	if storeRecovery ~= nil then
		if type(storeRecovery) ~= "table"
			or type(storeRecovery.requestId) ~= "string"
			or #storeRecovery.requestId == 0
			or #storeRecovery.requestId > Config.MAX_STRING_LEN
			or not Config.isSafeInteger(storeRecovery.epoch, 0)
			or not Config.isSafeInteger(storeRecovery.seq, 1)
			or not Config.isSafeInteger(storeRecovery.runId, 1) then
			return false, "storePurchaseRecovery identity out of bounds"
		end
		if storeRecovery.status == "pending" then
			if storeRecovery.result ~= nil then
				return false, "pending Store recovery cannot contain an outcome"
			end
		elseif storeRecovery.status == "committed" then
			local receipt = storeRecovery.result
			if type(receipt) ~= "table"
				or type(receipt.editionId) ~= "string"
				or #receipt.editionId == 0
				or #receipt.editionId > Config.MAX_STRING_LEN
				or not isInt(receipt.pityFails)
				or receipt.pityFails < 0
				or receipt.pityFails > Config.PITY_FAILS
				or receipt.offerId ~= Config.EARNED_PACK_ID
				or receipt.cost ~= Config.EARNED_PACK_COST
				or not isInt(receipt.balance)
				or receipt.balance < 0
				or receipt.balance > Config.MAX_CURRENCY
				or receipt.pityAt ~= Config.PITY_FAILS then
				return false, "committed Store recovery outcome out of bounds"
			end
			local knownRarity = false
			for i = 1, #Config.ROLL_WEIGHTS_10000 do
				if receipt.rarity == Config.ROLL_WEIGHTS_10000[i].rarity then
					knownRarity = true
					break
				end
			end
			if not knownRarity then
				return false, "committed Store recovery rarity out of bounds"
			end
			ok, err = knownCheck(receipt.editionId, "storePurchaseRecovery")
			if not ok then
				return false, err
			end
		else
			return false, "storePurchaseRecovery status out of bounds"
		end
	end
	if type(a.tutorialDone) ~= "boolean" then
		return false, "tutorialDone must be a boolean"
	end
	if not isInt(a.accountLevel) or a.accountLevel < 1
		or a.accountLevel > Config.MAX_ACCOUNT_LEVEL then
		return false, "accountLevel out of bounds"
	end
	if not isInt(a.accountXp) or a.accountXp < 0
		or a.accountXp > Config.MAX_XP then
		return false, "accountXp out of bounds"
	end
	local r = p.run
	if type(r) ~= "table" then
		return false, "run must be a table"
	end
	for _, k in ipairs({ "runId", "runNumber", "level", "xp", "currency",
		"pityFails", "attemptSeq", "opSeq", "pruneMark", "reqHighWater" }) do
		if not isInt(r[k]) or r[k] < 0 then
			return false, "run." .. k .. " out of bounds"
		end
	end
	if not Config.isSafeInteger(r.reqHighWater, 0) then
		return false, "run.reqHighWater exceeds client-safe integer range"
	end
	if storeRecovery ~= nil and storeRecovery.status == "pending"
		and storeRecovery.runId ~= r.runId then
		return false, "pending Store recovery run binding mismatch"
	end
	if r.runId < 1 or r.pityFails > Config.PITY_FAILS then
		return false, "run.runId/pityFails out of bounds"
	end
	if r.currency > Config.MAX_CURRENCY or r.xp > Config.MAX_XP then
		return false, "run currency/xp out of bounds"
	end
	if r.level < 1 or r.level > Config.MAX_RUN_LEVEL then
		return false, "run.level out of bounds"
	end
	if not isStamp(r.cooldownReadyAt) then
		return false, "run.cooldownReadyAt must be finite"
	end
	ok, err = checkIdMap(r.collection, Config.MAX_COLLECTION_IDS,
		Config.MAX_DUP_COUNT, "collection")
	if not ok then
		return false, err
	end
	-- cardLevels: true run levels 1..MAX_CARD_LEVEL per owned identity.
	if type(r.cardLevels) ~= "table" then
		return false, "cardLevels must be a table"
	end
	do
		local n = 0
		for id, lv in pairs(r.cardLevels) do
			n = n + 1
			if n > Config.MAX_COLLECTION_IDS then
				return false, "cardLevels exceeds "
					.. Config.MAX_COLLECTION_IDS .. " ids"
			end
			if type(id) ~= "string" or #id == 0
				or #id > Config.MAX_STRING_LEN then
				return false, "cardLevels key must be a bounded nonempty string"
			end
			if not isInt(lv) or lv < 1 or lv > Config.MAX_CARD_LEVEL then
				return false, "cardLevels[" .. id .. "] out of bounds"
			end
		end
	end
	-- cardXp: leftover xp toward the next card level; ZERO is valid (a card
	-- exactly on a boundary stores 0; services store nil-or-0 alike).
	if type(r.cardXp) ~= "table" then
		return false, "cardXp must be a table"
	end
	do
		local n = 0
		for id, xp in pairs(r.cardXp) do
			n = n + 1
			if n > Config.MAX_COLLECTION_IDS then
				return false, "cardXp exceeds "
					.. Config.MAX_COLLECTION_IDS .. " ids"
			end
			if type(id) ~= "string" or #id == 0
				or #id > Config.MAX_STRING_LEN then
				return false, "cardXp key must be a bounded nonempty string"
			end
			if not isInt(xp) or xp < 0 or xp > Config.MAX_XP then
				return false, "cardXp[" .. id .. "] out of bounds"
			end
		end
	end
	if knownIds ~= nil then
		for id in pairs(r.collection) do
			ok, err = knownCheck(id, "collection")
			if not ok then
				return false, err
			end
		end
		for id in pairs(r.cardLevels) do
			ok, err = knownCheck(id, "cardLevels")
			if not ok then
				return false, err
			end
		end
		for id in pairs(r.cardXp) do
			ok, err = knownCheck(id, "cardXp")
			if not ok then
				return false, err
			end
		end
	end
	if type(r.deck) ~= "table" or #r.deck > Config.DECK_MAX then
		return false, "deck exceeds cap"
	end
	do
		local seen = {}
		for i = 1, #r.deck do
			local id = r.deck[i]
			if type(id) ~= "string" or #id == 0
				or #id > Config.MAX_STRING_LEN then
				return false, "deck id must be a bounded nonempty string"
			end
			if seen[id] then
				return false, "deck ids must be unique"
			end
			seen[id] = true
			-- Owned deck: every stored deck id is owned (>=1 confirmed copy
			-- this run). Pending ids never enter the collection, so a stored
			-- deck referencing them is invalid data, never a fresh default.
			if type(r.collection[id]) ~= "number"
				or r.collection[id] < 1 then
				return false, "deck id not owned this run: " .. id
			end
			if knownIds ~= nil and not knownIds[id] then
				return false, "deck unknown content id: " .. id
			end
		end
	end
	if type(r.encounters) ~= "table" then
		return false, "encounters must be a table"
	end
	for id, v in pairs(r.encounters) do
		if type(id) ~= "string" or #id == 0
			or #id > Config.MAX_STRING_LEN then
			return false, "encounters key must be a bounded nonempty string"
		end
		if v ~= true then
			return false, "encounters[" .. id .. "] must be true"
		end
	end
	if type(r.bossClaimed) ~= "boolean" then
		return false, "bossClaimed must be a boolean"
	end
	ok, err = checkPlainData(r.completedAttempts, 100000,
		"completedAttempts")
	if not ok then
		return false, err
	end
	if type(r.autoRoll) ~= "boolean" then
		return false, "autoRoll must be a boolean"
	end
	-- Pending battle/reward: full stored shape (scalars PLUS the sealed
	-- snapshots and finals BattleService always writes). Non-finite
	-- amounts, unknown content ids, inflated stats or forged shapes fail
	-- closed here — status re-resolves these exact bytes on reconnect.
	if r.pendingBattle ~= nil then
		local pb = r.pendingBattle
		if type(pb) ~= "table" then
			return false, "pendingBattle must be a table or nil"
		end
		if type(pb.attemptId) ~= "string" or #pb.attemptId == 0
			or #pb.attemptId > Config.MAX_STRING_LEN then
			return false, "pendingBattle.attemptId out of bounds"
		end
		if not isInt(pb.runId) or pb.runId < 1 then
			return false, "pendingBattle.runId out of bounds"
		end
		if type(pb.encounterId) ~= "string" or #pb.encounterId == 0
			or #pb.encounterId > Config.MAX_STRING_LEN then
			return false, "pendingBattle.encounterId out of bounds"
		end
		if type(pb.isBoss) ~= "boolean" then
			return false, "pendingBattle.isBoss must be a boolean"
		end
		if not isInt(pb.seed) or pb.seed < 0 or pb.seed > 4294967295 then
			return false, "pendingBattle.seed out of bounds"
		end
		if not isStamp(pb.issuedAt) then
			return false, "pendingBattle.issuedAt must be finite"
		end
		-- Stored initial snapshots are REQUIRED and dense: the service
		-- seals both sides at start, always.
		ok, err = checkSnapshotArray(pb.snapshotA,
			"pendingBattle.snapshotA", knownIds)
		if not ok then
			return false, err
		end
		ok, err = checkSnapshotArray(pb.snapshotB,
			"pendingBattle.snapshotB", knownIds)
		if not ok then
			return false, err
		end
	end
	if r.pendingReward ~= nil then
		local pr = r.pendingReward
		if type(pr) ~= "table" then
			return false, "pendingReward must be a table or nil"
		end
		if type(pr.attemptId) ~= "string" or #pr.attemptId == 0
			or #pr.attemptId > Config.MAX_STRING_LEN then
			return false, "pendingReward.attemptId out of bounds"
		end
		if not isInt(pr.runId) or pr.runId < 1 then
			return false, "pendingReward.runId out of bounds"
		end
		if not isInt(pr.xp) or pr.xp < 0 or pr.xp > Config.MAX_XP then
			return false, "pendingReward.xp out of bounds"
		end
		if not isInt(pr.currency) or pr.currency < 0
			or pr.currency > Config.MAX_CURRENCY then
			return false, "pendingReward.currency out of bounds"
		end
		-- Sealed outcome bindings: the service seals winner/turns/
		-- eventHash/finals at start; all are required stored fields.
		if pr.winner ~= "A" and pr.winner ~= "B"
			and pr.winner ~= "tie" then
			return false, "pendingReward.winner out of bounds"
		end
		if not isInt(pr.turns) or pr.turns < 0
			or pr.turns > Config.MAX_BATTLE_TURNS then
			return false, "pendingReward.turns out of bounds"
		end
		if type(pr.eventHash) ~= "string" or #pr.eventHash == 0
			or #pr.eventHash > Config.MAX_STRING_LEN then
			return false, "pendingReward.eventHash out of bounds"
		end
		ok, err = checkFinalState(pr.finalA, "pendingReward.finalA",
			knownIds)
		if not ok then
			return false, err
		end
		ok, err = checkFinalState(pr.finalB, "pendingReward.finalB",
			knownIds)
		if not ok then
			return false, err
		end
	end
	if r.preview ~= nil then
		local pv = r.preview
		if type(pv) ~= "table" then
			return false, "preview must be a table or nil"
		end
		if type(pv.token) ~= "string" or #pv.token == 0
			or #pv.token > Config.MAX_STRING_LEN then
			return false, "preview.token out of bounds"
		end
		if not isInt(pv.revision) or pv.revision < 1 then
			return false, "preview.revision out of bounds"
		end
		if not isInt(pv.runId) or pv.runId < 1 then
			return false, "preview.runId out of bounds"
		end
	end
	if r.lastRebirth ~= nil then
		local lr = r.lastRebirth
		if type(lr) ~= "table" then
			return false, "lastRebirth must be a table or nil"
		end
		if type(lr.token) ~= "string" or #lr.token == 0
			or #lr.token > Config.MAX_STRING_LEN then
			return false, "lastRebirth.token out of bounds"
		end
	end
	-- Cross-field bindings (commit semantics on stored state): a pending
	-- pair belongs to THIS run and to each other; an open preview belongs
	-- to this run at an already-reached revision stage (account saves may
	-- commit while a preview is open, so the stage is <=, never equality);
	-- the rebirth record lands exactly on this run. Unpaired or
	-- cross-run leftovers fail closed.
	if r.pendingBattle ~= nil or r.pendingReward ~= nil then
		local pb, pr = r.pendingBattle, r.pendingReward
		if pb == nil or pr == nil then
			return false, "pending battle/reward must pair"
		end
		if pb.runId ~= r.runId or pr.runId ~= r.runId then
			return false, "pending run binding mismatch"
		end
		if pb.attemptId ~= pr.attemptId then
			return false, "pending attempt binding mismatch"
		end
		if pr.firstClear ~= nil and (type(pr.firstClear) ~= "string"
			or #pr.firstClear == 0
			or #pr.firstClear > Config.MAX_STRING_LEN) then
			return false, "pendingReward.firstClear out of bounds"
		end
	end
	if r.preview ~= nil then
		if r.preview.runId ~= r.runId then
			return false, "preview run binding mismatch"
		end
		if r.preview.revision > p.revision then
			return false, "preview revision from the future"
		end
		if r.preview.keepsakeId ~= nil
			and (type(r.preview.keepsakeId) ~= "string"
				or #r.preview.keepsakeId == 0
				or #r.preview.keepsakeId > Config.MAX_STRING_LEN) then
			return false, "preview.keepsakeId out of bounds"
		end
	end
	if r.lastRebirth ~= nil then
		if r.lastRebirth.toRun ~= r.runId then
			return false, "lastRebirth run binding mismatch"
		end
		if not isInt(r.lastRebirth.fromRun)
			or r.lastRebirth.fromRun ~= r.runId - 1 then
			return false, "lastRebirth fromRun binding mismatch"
		end
	end
	return true, nil
end

-- Deep copy of plain profile data (no shared references escape a commit).
function Profile.deepCopy(value, depth)
	depth = depth or 0
	if depth > 16 then
		error("profile nesting too deep", 2)
	end
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in pairs(value) do
		out[Profile.deepCopy(k, depth + 1)] = Profile.deepCopy(v, depth + 1)
	end
	return out
end

return Profile
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Progression</string>
            <string name="Source"><![CDATA[-- Progression.luau — pure deck / XP / skills / settings rules (P3).
-- Pure Luau/plain-Lua subset. Repetitions and discard volume can never mint
-- power: skill points come only from first-clear ranks, capped at 24, with
-- aggregate ceilings of +6% ATK / +6% HP / +20% card XP.

local function loadSibling(name)
	if game ~= nil then
		return require(script.Parent:WaitForChild(name))
	elseif dofile ~= nil then
		local here = debug.getinfo(1, "S").source
		local dir = string.match(here, "@(.*/)") or "./src/shared/progression/"
		return dofile(dir .. name .. ".luau")
	else
		return require("./" .. name)
	end
end

local Config = loadSibling("Config")

local Progression = {}

-- ok, err — ordered deck of owned, confirmed ids: unique, within cap, every
-- id owned (>=1 copy in the CONFIRMED collection). Pending/uncommitted ids
-- are never in that collection, so they can never validate here.
function Progression.checkDeck(deckIds, ownedCollection)
	if type(deckIds) ~= "table" then
		return false, "deck must be an array"
	end
	if #deckIds < Config.DECK_MIN or #deckIds > Config.DECK_MAX then
		return false, "deck size must be " .. Config.DECK_MIN .. ".." .. Config.DECK_MAX
	end
	local seen = {}
	for i = 1, #deckIds do
		local id = deckIds[i]
		if type(id) ~= "string" or #id == 0 or #id > Config.MAX_STRING_LEN then
			return false, "deck[" .. i .. "] must be a bounded nonempty string"
		end
		if seen[id] then
			return false, "deck ids must be unique"
		end
		seen[id] = true
		if type(ownedCollection) ~= "table"
			or type(ownedCollection[id]) ~= "number"
			or ownedCollection[id] < 1 then
			return false, "deck id not owned this run: " .. id
		end
	end
	return true, nil
end

-- Pure XP application. Returns newLevel, newXp, levelsGained.
function Progression.applyCardXp(level, xp, gain, xpNextFn)
	if gain < 0 or gain ~= math.floor(gain) then
		return nil, "xp gain must be a nonnegative integer"
	end
	local gained = 0
	xp = xp + gain
	while level < Config.MAX_CARD_LEVEL and xp >= xpNextFn(level) do
		xp = xp - xpNextFn(level)
		level = level + 1
		gained = gained + 1
	end
	if level >= Config.MAX_CARD_LEVEL then
		xp = 0
	end
	return level, xp, gained
end

function Progression.applyRunXp(level, xp, gain)
	if gain < 0 or gain ~= math.floor(gain) then
		return nil, "xp gain must be a nonnegative integer"
	end
	local gained = 0
	xp = xp + gain
	while level < Config.MAX_RUN_LEVEL and xp >= Config.runXpNext(level) do
		xp = xp - Config.runXpNext(level)
		level = level + 1
		gained = gained + 1
	end
	return level, xp, gained
end

-- Visible effective level under the chapter attunement ceiling.
function Progression.effectiveLevel(cardLevel, chapter)
	local caps = Config.CHAPTER_CAPS
	if type(chapter) ~= "number" or chapter ~= math.floor(chapter)
		or chapter < 1 or chapter > #caps then
		return nil, "chapter out of range 1.." .. #caps
	end
	if cardLevel < 1 then
		return nil, "cardLevel out of bounds"
	end
	if cardLevel < caps[chapter] then
		return cardLevel, nil
	end
	return caps[chapter], nil
end

local function nodeById(id)
	for i = 1, #Config.SKILL_NODES do
		if Config.SKILL_NODES[i].id == id then
			return Config.SKILL_NODES[i]
		end
	end
	return nil
end

-- ok, spent, totals | false, err — finite allocation: every node known,
-- ranks within node max, total spent within earned points (<=24), aggregate
-- effects within the +6%/+6%/+20% ceilings.
function Progression.checkSkills(alloc, earnedPoints)
	if type(alloc) ~= "table" then
		return false, "alloc must be a table"
	end
	if type(earnedPoints) ~= "number" or earnedPoints ~= math.floor(earnedPoints)
		or earnedPoints < 0 or earnedPoints > Config.MASTERY_MAX_POINTS then
		return false, "earnedPoints out of bounds"
	end
	local spent, atkBp, hpBp, xpBp = 0, 0, 0, 0
	for nodeId, ranks in pairs(alloc) do
		local node = nodeById(nodeId)
		if not node then
			return false, "unknown skill node: " .. tostring(nodeId)
		end
		if type(ranks) ~= "number" or ranks ~= math.floor(ranks)
			or ranks < 0 or ranks > node.maxRanks then
			return false, "ranks out of bounds for " .. nodeId
		end
		spent = spent + ranks
		atkBp = atkBp + ranks * node.atkBp
		hpBp = hpBp + ranks * node.hpBp
		xpBp = xpBp + ranks * node.xpBp
	end
	if spent > earnedPoints then
		return false, "spent points exceed earned points"
	end
	if atkBp > Config.MASTERY_ATK_BP_MAX then
		return false, "attack bonus exceeds +6% ceiling"
	end
	if hpBp > Config.MASTERY_HP_BP_MAX then
		return false, "health bonus exceeds +6% ceiling"
	end
	if xpBp > Config.MASTERY_XP_BP_MAX then
		return false, "card XP bonus exceeds +20% ceiling"
	end
	return true, nil, { spent = spent, atkBp = atkBp, hpBp = hpBp, xpBp = xpBp }
end

-- ok, points | false, err — first-clear rank claim: already-claimed ranks
-- (even the same one) grant zero further points.
function Progression.claimRank(rankId, claimedRanks)
	local points = 0
	for i = 1, #Config.RANKS do
		if Config.RANKS[i].id == rankId then
			points = Config.RANKS[i].points
		end
	end
	if points == 0 then
		return false, "unknown rank: " .. tostring(rankId)
	end
	if claimedRanks[rankId] then
		return false, "rank already claimed: no repeat reward"
	end
	return true, nil, points
end

-- ok, sanitized | false, err — settings persist per account across rebirth.
function Progression.checkSettings(s)
	if type(s) ~= "table" then
		return false, "settings must be a table"
	end
	if not Config.THEMES[s.theme] then
		return false, "unknown theme"
	end
	-- Speeds share the one canonical allow-list (named or numeric 1/2/4);
	-- the stored form echoes back unchanged for client mapping.
	if Config.speedMult(s.speed) == nil then
		return false, "unknown speed"
	end
	if type(s.accent) ~= "string" or not string.match(s.accent, "^#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]$") then
		return false, "accent must be #RRGGBB"
	end
	if type(s.reducedMotion) ~= "boolean" then
		return false, "reducedMotion must be a boolean"
	end
	if type(s.flashes) ~= "boolean" then
		return false, "flashes must be a boolean"
	end
	-- Audio volumes: finite 0..100 ints; legacy/cached settings missing keys
	-- migrate safely to defaults instead of rejecting the whole save.
	local vols = {}
	for _, key in ipairs({ "musicVolume", "sfxVolume", "uiVolume",
		"ambienceVolume" }) do
		local v = s[key]
		if v == nil then
			v = Config.DEFAULT_VOLUMES[key]
		end
		if type(v) ~= "number" or v ~= math.floor(v)
			or v < Config.VOLUME_MIN or v > Config.VOLUME_MAX then
			return false, key .. " must be an integer 0..100"
		end
		vols[key] = v
	end
	return true, nil, {
		theme = s.theme,
		accent = s.accent,
		reducedMotion = s.reducedMotion,
		flashes = s.flashes,
		speed = s.speed,
		musicVolume = vols.musicVolume,
		sfxVolume = vols.sfxVolume,
		uiVolume = vols.uiVolume,
		ambienceVolume = vols.ambienceVolume,
	}
end

return Progression
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Rebirth</string>
            <string name="Source"><![CDATA[-- Rebirth.luau — pure atomic-rebirth preview + apply (P3).
-- Double-confirm yields exactly one new run: old-valid or complete-new, never
-- partial deletion. Mythic + Legacy + one replaceable keepsake + catalogue +
-- pity + settings + protected entitlements survive; everything else resets
-- per the visible preview. Previous ordinary keepsake does NOT remain unless
-- reselected or independently protected as Mythic/Legacy.

local function loadSibling(name)
	if game ~= nil then
		return require(script.Parent:WaitForChild(name))
	elseif dofile ~= nil then
		local here = debug.getinfo(1, "S").source
		local dir = string.match(here, "@(.*/)") or "./src/shared/progression/"
		return dofile(dir .. name .. ".luau")
	else
		return require("./" .. name)
	end
end

local Config = loadSibling("Config")

local Rebirth = {}

Rebirth.NEEDS_BOSS = true -- committed boss milestone required

-- Next unclaimed rank in ladder order, issuable only with the committed
-- boss milestone. Repeats grant nothing (claimedRanks is permanent).
function Rebirth.pendingRankReward(profile)
	if not profile.run.bossClaimed then
		return nil
	end
	for i = 1, #Config.RANKS do
		local rank = Config.RANKS[i]
		if not profile.account.claimedRanks[rank.id] then
			if (profile.run.runNumber or 0) >= (rank.minRun or i) then
				return rank.id
			end
			return nil
		end
	end
	return nil
end
-- Eligibility rechecked at BOTH preview and confirm time.
function Rebirth.checkEligible(profile)
	local run = profile.run
	if run.pendingBattle ~= nil then
		return false, "rebirth blocked: battle pending"
	end
	if run.pendingReward ~= nil then
		return false, "rebirth blocked: reward unclaimed"
	end
	if Rebirth.NEEDS_BOSS and not run.bossClaimed then
		return false, "rebirth blocked: boss milestone not committed"
	end
	return true, nil
end

-- Pure preview at an exact revision/run/version. Lists exact lost / kept /
-- granted identities and currency deltas. editionsById: id -> edition row
-- ({rarity, mythic, legacy}); starters: array of starter ids.
function Rebirth.preview(profile, keepsakeId, editionsById, starters)
	local ok, err = Rebirth.checkEligible(profile)
	if not ok then
		return nil, err
	end
	local run = profile.run
	local account = profile.account
	if keepsakeId ~= nil then
		if type(keepsakeId) ~= "string" then
			return nil, "keepsake must be a string or nil"
		end
		local ed = editionsById[keepsakeId]
		if not ed then
			return nil, "unknown keepsake identity"
		end
		if ed.mythic or ed.legacy then
			return nil, "Mythic/Legacy persist already; keepsake is for ordinary identities"
		end
		if type(run.collection[keepsakeId]) ~= "number" then
			return nil, "keepsake not owned this run"
		end
	end
	local kept, granted, lost = {}, {}, {}
	local grantedSet = {}
	local function grantOnce(id, why)
		if not grantedSet[id] then
			grantedSet[id] = true
			granted[#granted + 1] = { id = id, why = why }
		end
	end
	-- Mythic + Legacy entitlements: one baseline level-1 copy each.
	for id in pairs(account.mythicEntitlements) do
		kept[#kept + 1] = { id = id, why = "mythic", copies = 1 }
		grantOnce(id, "mythic")
	end
	for id in pairs(account.legacyEntitlements) do
		kept[#kept + 1] = { id = id, why = "legacy", copies = 1 }
		grantOnce(id, "legacy")
	end
	-- One replaceable keepsake.
	if keepsakeId ~= nil then
		kept[#kept + 1] = { id = keepsakeId, why = "keepsake", copies = 1 }
		grantOnce(keepsakeId, "keepsake")
	end
	-- Starters regranted (union: no duplicate-salvage double-count).
	for i = 1, #starters do
		grantOnce(starters[i], "starter")
	end
	-- Everything else owned this run is lost and resets. Rarity is NEVER a
	-- salvage lock (roster.md: Common-Epic removed with discovery retained,
	-- Legendary removed unless it is the one keepsake, Mythic/Legacy
	-- auto-retained): lockedReset is therefore always empty, kept for
	-- response-shape compatibility. Every lost entry carries its run copy
	-- count so the client can render exact losses.
	for id, count in pairs(run.collection) do
		if not grantedSet[id] then
			lost[#lost + 1] = { id = id, copies = count, locked = false }
		end
	end
	local pendingRank = Rebirth.pendingRankReward(profile)
	local claimedCount = 0
	for _ in pairs(account.claimedRanks) do
		claimedCount = claimedCount + 1
	end
	return {
		revision = profile.revision,
		runId = run.runId,
		runNumber = run.runNumber,
		progressionVersion = Config.PROGRESSION_VERSION,
		keepsakeId = keepsakeId,
		-- The keepsake slot is replaceable: this names the previous slot
		-- value (nil when empty) that the confirm will overwrite.
		replacesKeepsakeId = account.keepsakeId,
		kept = kept,
		granted = granted,
		lost = lost,
		-- Rarity is never a salvage lock (see above): always empty, kept
		-- for response-shape compatibility.
		lockedReset = {},
		-- Explicit reset list: everything below returns to its new-run
		-- value on confirm (deck empties, encounters/boss clear,
		-- run level/XP/currency restart).
		resets = { "level", "xp", "currency", "deck", "cardLevels",
			"cardXp", "encounters", "bossClaimed", "cooldownReadyAt",
			"autoRoll" },
		currencies = { lost = run.currency, kept = 0 },
		currencyLost = run.currency,
		pityFailsKept = run.pityFails,
		pendingRankReward = pendingRank,
		-- Rank read model: the pending first-clear rung plus the durable
		-- ladder position (points and claimed count survive rebirth).
		rank = { pending = pendingRank,
			skillPoints = account.skillPoints,
			claimedCount = claimedCount },
		nextRunId = run.runId + 1,
	}, nil
end

-- Pure atomic apply. Requires the EXACT preview identity (revision, run,
-- version, keepsake) plus the service-issued token match done by the service.
-- Returns a complete new profile or nil+err; never a partial deletion.
function Rebirth.apply(profile, previewObj, editionsById, starters, now)
	if type(previewObj) ~= "table" then
		return nil, "preview must be a table"
	end
	local ok, err = Rebirth.checkEligible(profile)
	if not ok then
		return nil, err
	end
	if previewObj.revision ~= profile.revision then
		return nil, "stale preview: revision changed"
	end
	if previewObj.runId ~= profile.run.runId then
		return nil, "stale preview: run changed"
	end
	if previewObj.progressionVersion ~= Config.PROGRESSION_VERSION then
		return nil, "stale preview: version changed"
	end
	-- Re-derive deterministically and cross-check the keepsake binding.
	local fresh, ferr = Rebirth.preview(profile, previewObj.keepsakeId,
		editionsById, starters)
	if not fresh then
		return nil, ferr
	end
	if #fresh.granted ~= #previewObj.granted then
		return nil, "stale preview: roster changed"
	end
	if fresh.pendingRankReward ~= previewObj.pendingRankReward then
		return nil, "stale preview: rank state changed"
	end
	-- Issue the pending first-clear rank reward exactly once here (repeats
	-- are impossible: claimedRanks is permanent and rechecked above).
	local nextClaimed, nextPoints = {}, profile.account.skillPoints
	for k, v in pairs(profile.account.claimedRanks) do
		nextClaimed[k] = v
	end
	if fresh.pendingRankReward ~= nil then
		for i = 1, #Config.RANKS do
			if Config.RANKS[i].id == fresh.pendingRankReward then
				nextClaimed[fresh.pendingRankReward] = true
				nextPoints = nextPoints + Config.RANKS[i].points
			end
		end
		if nextPoints > Config.MASTERY_MAX_POINTS then
			return nil, "skill point cap exceeded"
		end
	end
	-- Duplicate-confirm after a completed rebirth with the same token is
	-- handled by the service (lastRebirth); a confirm against the NEW run is
	-- always rejected here by the runId check above.
	local nextCollection, nextLevels = {}, {}
	for i = 1, #fresh.granted do
		local id = fresh.granted[i].id
		nextCollection[id] = (nextCollection[id] or 0) + 1
		nextLevels[id] = 1
	end
	-- Union guarantee: starter that is also keepsake/entitlement stays one copy.
	local newProfile = {
		schemaVersion = profile.schemaVersion,
		progressionVersion = profile.progressionVersion,
		rulesVersion = profile.rulesVersion,
		contentVersion = profile.contentVersion,
		revision = profile.revision + 1,
		userId = profile.userId,
		session = profile.session,
		account = {
			catalogue = profile.account.catalogue,
			mythicEntitlements = profile.account.mythicEntitlements,
			legacyEntitlements = profile.account.legacyEntitlements,
			storePurchaseRecovery = profile.account.storePurchaseRecovery,
			keepsakeId = previewObj.keepsakeId, -- replaced, not accumulated
			skillPoints = nextPoints,
			skillAlloc = profile.account.skillAlloc,
			claimedRanks = nextClaimed,
			settings = profile.account.settings,
			entitlements = profile.account.entitlements,
			tutorialDone = profile.account.tutorialDone,
			accountLevel = profile.account.accountLevel,
			accountXp = profile.account.accountXp,
		},
		run = {
			runId = profile.run.runId + 1,
			runNumber = profile.run.runNumber + 1,
			level = 1,
			xp = 0,
			currency = 0,
			pityFails = profile.run.pityFails, -- never a hidden reset
			cooldownReadyAt = 0,
			collection = nextCollection,
			deck = {},
			cardLevels = nextLevels,
			cardXp = {},
			encounters = {},
			bossClaimed = false,
			pendingBattle = nil,
			pendingReward = nil,
			completedAttempts = {}, -- new run, new attempt namespace
			attemptSeq = 0,
			opSeq = profile.run.opSeq,
			pruneMark = profile.run.pruneMark,
			reqHighWater = profile.run.reqHighWater or 0,
			recentOps = profile.run.recentOps,
			recentOrder = profile.run.recentOrder,
			autoRoll = false,
			preview = nil,
			lastRebirth = profile.run.lastRebirth,
		},
		updatedAt = now or 0,
	}
	return newProfile, nil
end

return Rebirth
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Rolls</string>
            <string name="Source"><![CDATA[-- Rolls.luau — pure roll/pity/edition logic (P3). Pure Luau/plain-Lua subset.
-- RNG draws happen OUTSIDE any persistence retry callback: callers pre-draw
-- `roll10000` (uniform int 1..10000) and `pickInt`, then pass them in, so a
-- retried commit can never reroll an outcome. No collection seed is ever sent
-- to the client; only the committed result crosses the remote.

local function loadSibling(name)
	if game ~= nil then
		return require(script.Parent:WaitForChild(name))
	elseif dofile ~= nil then
		local here = debug.getinfo(1, "S").source
		local dir = string.match(here, "@(.*/)") or "./src/shared/progression/"
		return dofile(dir .. name .. ".luau")
	else
		return require("./" .. name)
	end
end

local Config = loadSibling("Config")

local Rolls = {}

-- Pure rarity pick. pityFails = consecutive standard non-mythic rolls.
-- The (PITY_FAILS)th eligible roll since the last Mythic is forced Mythic:
-- when pityFails >= PITY_FAILS-1 the next roll is Mythic regardless.
function Rolls.rarityFor(pityFails, roll10000)
	if type(pityFails) ~= "number" or pityFails ~= math.floor(pityFails)
		or pityFails < 0 or pityFails > Config.PITY_FAILS then
		return nil, "pityFails out of bounds"
	end
	if type(roll10000) ~= "number" or roll10000 ~= math.floor(roll10000)
		or roll10000 < 1 or roll10000 > Config.ROLL_WEIGHT_TOTAL then
		return nil, "roll out of range 1.." .. Config.ROLL_WEIGHT_TOTAL
	end
	if pityFails >= Config.PITY_FAILS - 1 then
		return "Mythic", nil
	end
	local acc = 0
	for i = 1, #Config.ROLL_WEIGHTS_10000 do
		acc = acc + Config.ROLL_WEIGHTS_10000[i].weight
		if roll10000 <= acc then
			return Config.ROLL_WEIGHTS_10000[i].rarity, nil
		end
	end
	return "Mythic", nil
end

-- Pure edition pick within a rarity. `editions` is an injected array of
-- {id, rarity}; Mythic prefers an unowned identity (missing-identity
-- protection), otherwise a deterministic duplicate. Before the first
-- four-card deck is possible, prefer an unowned identity within the rolled
-- rarity; this leaves the published rarity weights unchanged. pickInt is a
-- pre-drawn uniform int >= 1. Returns edition id.
function Rolls.pickEditionId(editions, rarity, ownedSet, pickInt, preferMissing)
	if type(editions) ~= "table" or type(rarity) ~= "string" then
		return nil, "bad editions/rarity"
	end
	if type(pickInt) ~= "number" or pickInt ~= math.floor(pickInt)
		or pickInt < 1 or pickInt ~= pickInt
		or pickInt == math.huge or pickInt == -math.huge then
		return nil, "pickInt must be a finite integer >= 1"
	end
	ownedSet = ownedSet or {}
	local pool = {}
	for i = 1, #editions do
		if editions[i].rarity == rarity then
			pool[#pool + 1] = editions[i].id
		end
	end
	if #pool == 0 then
		return nil, "no editions at rarity " .. rarity
	end
	if rarity == "Mythic" or preferMissing then
		local missing = {}
		for i = 1, #pool do
			if not ownedSet[pool[i]] then
				missing[#missing + 1] = pool[i]
			end
		end
		if #missing > 0 then
			return missing[((pickInt - 1) % #missing) + 1], nil
		end
		-- Pool complete: deterministic duplicate resource, never a new
		-- entitlement, never pity acceleration.
		return pool[((pickInt - 1) % #pool) + 1], nil
	end
	return pool[((pickInt - 1) % #pool) + 1], nil
end

-- Pure roll application to a run fragment. Returns a NEW collection table,
-- new pityFails, and the granted id. Pending (uncommitted) grants are never
-- written here — only the durable commit path calls this.
function Rolls.applyGrant(collection, pityFails, editionId, rarity, catalogue)
	local nextCollection = {}
	for k, v in pairs(collection) do
		nextCollection[k] = v
	end
	nextCollection[editionId] = (nextCollection[editionId] or 0) + 1
	if nextCollection[editionId] > Config.MAX_DUP_COUNT then
		return nil, "duplicate count exceeds bound"
	end
	local nextCatalogue = {}
	for k, v in pairs(catalogue) do
		nextCatalogue[k] = v
	end
	nextCatalogue[editionId] = true
	local nextFails = pityFails
	if rarity == "Mythic" then
		nextFails = 0
	else
		nextFails = pityFails + 1
	end
	if nextFails > Config.PITY_FAILS then
		return nil, "pity counter exceeds bound"
	end
	return nextCollection, nextFails, nextCatalogue
end

return Rolls
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="21">
        <Properties>
          <string name="Name">Studio</string>
        </Properties>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">P6StudioChecks</string>
            <string name="Source"><![CDATA[-- P6StudioChecks.luau — PORTED COPY of tests/studio/test_studio_checks.luau
-- for the live place (session7-A). Provenance: the test-tree original is the
-- authority; this copy exists so the check suite EXISTS in the built place at
-- runtime. If the two ever differ, the test-tree original wins and this copy
-- must be re-ported (compare byte-for-byte below the header).
--
-- Runtime location (via default.project.json):
--   ReplicatedStorage > Shared > Studio > P6StudioChecks (ModuleScript)
-- Require it in Studio with:
--   require(game:GetService("ReplicatedStorage")
--       :WaitForChild("Shared"):WaitForChild("Studio")
--       :WaitForChild("P6StudioChecks")).run()
--
-- Under a real Studio session (game ~= nil) run() executes exact assertions
-- against the LIVE scene: CardView-bound card parts, face-camera, contact
-- motion beat, HUD legibility markers, mode recovery, and the rebirth reset
-- cycle. On Linux/Lune (no Studio runtime) it returns a structured NOT_RUN
-- with the exact blocker and exits 0 — an overall NOT_RUN that is never a
-- PASS and never engine evidence. Never invents session/account IDs.
--
-- The automatic path is src/server/StudioSelfReport.server.luau, which calls
-- run() shortly after place start and reports the result off-machine
-- (localhost HTTP POST, falling back to a JEV_STUDIO_RESULT console line).

local Checks = {}

local NOT_RUN = "NOT_RUN: no supported Studio session on this host " ..
	"(Linux; Sober is player-only; remote UNVERIFIED per " ..
	"docs/research/environment.md; P1 inventory owns the dated record)"

function Checks.runtime()
	if game ~= nil then
		return "studio"
	end
	if dofile == nil then
		return "lune"
	end
	return "lua"
end

-- Exact assertions executed ONLY with a live game runtime.
function Checks.run()
	local rt = Checks.runtime()
	local meta = { runtime = rt, atUtc = (DateTime and DateTime.now()
		and DateTime.now():ToIsoDate()) or "n/a-linux" }
	if rt ~= "studio" then
		print("RECEIPT tests/studio/test_studio_checks " .. NOT_RUN)
		print("META runtime=" .. meta.runtime .. " (metadata only)")
		meta.overall = "NOT_RUN (never PASS off-engine; Linux domain "
			.. "runs are not Studio evidence)"
		return "NOT_RUN", meta
	end

	local results = {}
	local function check(name, fn)
		local ok, err = pcall(fn)
		results[#results + 1] = { name = name,
			verdict = ok and "PASS" or "FAIL", detail = tostring(err or "ok") }
	end

	check("remote-present", function()
		local rs = game:GetService("ReplicatedStorage")
		local rf = rs:FindFirstChild("UACG_Economy")
		assert(rf ~= nil and rf:IsA("RemoteFunction"),
			"UACG_Economy RemoteFunction missing")
	end)
	check("supporter-store-wired", function()
		local rs = game:GetService("ReplicatedStorage")
		local rf = rs:FindFirstChild("UACG_SupporterPass")
		assert(rf ~= nil and rf:IsA("RemoteFunction"),
			"UACG_SupporterPass RemoteFunction missing")
		local player = game:GetService("Players").LocalPlayer
		local gui = player and player:FindFirstChild("PlayerGui")
		local screen = gui and gui:FindFirstChild("Screen_store")
		assert(screen ~= nil and screen:IsA("ScreenGui"),
			"Store ScreenGui missing after spawn")
		assert(screen.ResetOnSpawn == false,
			"Store ScreenGui would reset on spawn")
		local button = screen and screen:FindFirstChild("supporter-prompt", true)
		assert(button ~= nil and button:IsA("TextButton"),
			"Supporter Crest purchase control missing")
	end)
	check("shared-tree-mapped", function()
		local rs = game:GetService("ReplicatedStorage")
		assert(rs:FindFirstChild("Shared") ~= nil,
			"ReplicatedStorage.Shared missing (check default.project.json)")
	end)
	check("cards-anchored-noncolliding", function()
		local found = 0
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("BasePart") and d:GetAttribute("UACGCard") == true then
				found = found + 1
				assert(d.Anchored == true, d:GetFullName() .. " not Anchored")
				assert(d.CanCollide == false,
					d:GetFullName() .. " collides")
			end
		end
		assert(found >= 2, "fewer than 2 UACG card parts in scene")
	end)
	check("cardview-bound", function()
		-- The live card parts must be CardView products: image face present
		-- and the scene marker published by the CardView binding path.
		assert(workspace:GetAttribute("UACGCardView") == true,
			"no UACGCardView marker published by CardView binding")
		local faced = 0
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("BasePart") and d:GetAttribute("UACGCard") == true then
				for _, ch in ipairs(d:GetChildren()) do
					if ch:IsA("Decal") or ch:IsA("SurfaceGui") then
						faced = faced + 1
						break
					end
				end
			end
		end
		assert(faced >= 2, "fewer than 2 card parts carry an image face")
	end)
	check("camera-faces-cards", function()
		-- CurrentCamera must look at the live card midpoint (read live from
		-- the card parts, never hardcoded); fails closed without the marker
		-- the scene publishes after facing the camera.
		assert(workspace:GetAttribute("UACGCameraFace") == true,
			"no UACGCameraFace marker: camera never faced the live cards")
		local cam = workspace.CurrentCamera
		assert(cam ~= nil, "no CurrentCamera in this Studio run")
	end)
	check("hud-present", function()
		-- HUD legibility anchor: PlayerGui carries the UACG HUD marker with
		-- HP/deck/turn nodes present (both themes render from the same HUD).
		local pg = game:GetService("Players").LocalPlayer
			and game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
		assert(pg ~= nil, "no PlayerGui for LocalPlayer")
		assert(pg:GetAttribute("UACGHud") == true,
			"no UACGHud marker published by the HUD path")
	end)
	check("contact-beat", function()
		-- Exact contact assertion: at the hit beat the attacker edge meets
		-- the defender edge (edge-to-edge cue), then returns to its anchor.
		-- Scene-specific positions are read live, never hardcoded here:
		-- the check fails closed if the beat markers are absent.
		local beat = workspace:GetAttribute("UACGContactBeat")
		assert(beat ~= nil, "no UACGContactBeat marker published by scene")
		assert(beat == true, "contact beat never fired this duel")
	end)
	check("modes-recover", function()
		assert(workspace:GetAttribute("UACGModeRecovery") == true,
			"pause/fast/skip/reconnect recovery not demonstrated this run")
	end)
	check("reset-cycle", function()
		-- Full rebirth reset demonstrated in-scene: preview bound a token,
		-- confirm committed exactly one new run, stale preview rejected.
		assert(workspace:GetAttribute("UACGResetCycle") == true,
			"no UACGResetCycle marker: preview->confirm->new-run "
			.. "cycle not demonstrated this run")
	end)
	check("save-failure-path", function()
		assert(workspace:GetAttribute("UACGSaveFailure") ~= nil,
			"save-failure drill (failed load never defaults) not recorded")
	end)
	-- Where the audio engine ACTUALLY publishes: AudioEngine.bindAll
	-- parents the UACGAudio folder under the workspace it is handed
	-- (Boot.client + StudioDemo pass the live workspace), so the folder
	-- is a client-built workspace child. Client-built sounds never
	-- replicate up, which is why server-vantage runs honestly cannot see
	-- them. Search every home the client vantage can genuinely see.
	local AUDIO_FOLDER_NAME = "UACGAudio"
	local function findAudioFolder()
		local folder = nil
		pcall(function()
			folder = workspace:FindFirstChild(AUDIO_FOLDER_NAME)
		end)
		if folder ~= nil then
			return folder
		end
		pcall(function()
			folder = game:GetService("SoundService")
				:FindFirstChild(AUDIO_FOLDER_NAME)
		end)
		if folder ~= nil then
			return folder
		end
		pcall(function()
			local lp = game:GetService("Players").LocalPlayer
			local gui = (lp ~= nil
				and lp:FindFirstChild("PlayerGui")) or nil
			if gui ~= nil then
				folder = gui:FindFirstChild(AUDIO_FOLDER_NAME)
			end
		end)
		return folder
	end
	-- Corroboration from the demo's published engine facts (counts read
	-- live at bind time). Quoted inside failure detail so a missing
	-- folder still tells the full story — but it never PASSES a check
	-- alone. Only live Sounds with real engine flags do.
	local function audioAttrSummary()
		local parts = {}
		pcall(function()
			parts[#parts + 1] = "attrSounds="
				.. tostring(workspace:GetAttribute("UACGAudioSounds"))
			parts[#parts + 1] = "attrLoaded="
				.. tostring(workspace:GetAttribute("UACGAudioLoaded"))
			parts[#parts + 1] = "attrPlaying="
				.. tostring(workspace:GetAttribute("UACGAudioPlaying"))
		end)
		return table.concat(parts, " ")
	end
	check("audio-bound", function()
		-- All 8 catalog cues bound to live Sounds (client vantage only:
		-- client-built sounds never replicate up, so the server reporter
		-- structurally cannot see them — honest vantage limit, not a game
		-- defect; the client line is authoritative). Resolution mirrors
		-- where AudioEngine.bindAll ACTUALLY parents the folder
		-- (workspace, via Boot.client + StudioDemo) with the other
		-- client-visible homes as fallback — never one hardcoded path.
		local folder = findAudioFolder()
		assert(folder ~= nil,
			"no UACGAudio folder in workspace/SoundService/PlayerGui ["
			.. audioAttrSummary() .. "] (client vantage only)")
		local n = 0
		for _, ch in ipairs(folder:GetChildren()) do
			if ch:IsA("Sound") then
				n = n + 1
			end
		end
		assert(n >= 8, "fewer than 8 bound Sounds (got " .. tostring(n) .. ")")
	end)
	check("audio-loaded", function()
		-- Real media proof: >=1 bound Sound reports IsLoaded with
		-- TimeLength > 0 (a stub reports 0). Detail names every sound's
		-- exact engine facts. Local-attempt rbxasset ids are expected to
		-- stay unloaded (Sound needs an uploaded rbxassetid:// id) — that
		-- honest FAIL carries the exact blocker.
		local folder = findAudioFolder()
		assert(folder ~= nil, "no UACGAudio folder for load probe ["
			.. audioAttrSummary() .. "]")
		local parts = {}
		local loaded = 0
		for _, ch in ipairs(folder:GetChildren()) do
			if ch:IsA("Sound") then
				local il, tl, sid = false, 0, ""
				pcall(function()
					il = ch.IsLoaded == true
				end)
				pcall(function()
					tl = tonumber(ch.TimeLength) or 0
				end)
				pcall(function()
					sid = tostring(ch.SoundId)
				end)
				if il and tl > 0 then
					loaded = loaded + 1
				end
				parts[#parts + 1] = ch.Name .. ":loaded=" .. tostring(il)
					.. ":len=" .. tostring(tl) .. ":id=" .. sid
			end
		end
		assert(loaded >= 1, "0 sounds loaded with TimeLength>0 ["
			.. table.concat(parts, " | ") .. "]")
	end)
	check("audio-playing", function()
		-- Audibility proof: >=1 bound Sound reports IsPlaying after the
		-- demo called Play() on menu_music + contact_normal. Never claimed
		-- without the engine flag.
		local folder = findAudioFolder()
		assert(folder ~= nil, "no UACGAudio folder for play probe ["
			.. audioAttrSummary() .. "]")
		local parts = {}
		local playing = 0
		for _, ch in ipairs(folder:GetChildren()) do
			if ch:IsA("Sound") then
				local ip, il = false, false
				pcall(function()
					ip = ch.IsPlaying == true
				end)
				pcall(function()
					il = ch.IsLoaded == true
				end)
				if ip then
					playing = playing + 1
				end
				parts[#parts + 1] = ch.Name .. ":playing=" .. tostring(ip)
					.. ":loaded=" .. tostring(il)
			end
		end
		assert(playing >= 1, "0 sounds IsPlaying after Play() ["
			.. table.concat(parts, " | ") .. "]")
	end)

	local fails = 0
	for _, r in ipairs(results) do
		print("STUDIO-CHECK " .. r.name .. " " .. r.verdict
			.. " :: " .. r.detail)
		if r.verdict ~= "PASS" then
			fails = fails + 1
		end
	end
	meta.checks = #results
	meta.fails = fails
	meta.overall = "NOT_RUN requires Studio; this return is Studio-only"
	if fails > 0 then
		return "FAIL", meta
	end
	return "PASS", meta
end

-- Auto-execute on require outside Studio (NOT_RUN receipt); inside Studio
-- the caller invokes Checks.run() explicitly after loading the place.
if game == nil then
	Checks.run()
end

return Checks
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="23">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="24">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">AwayProgressService</string>
          <string name="Source"><![CDATA[-- AwayProgressService.luau — server-owned capped away-XP claims (P1).

local R
if game ~= nil then
	R = require(script.Parent:WaitForChild("RobloxRequire"))
elseif dofile ~= nil then
	R = dofile("./src/server/RobloxRequire.luau")
else
	R = require("./RobloxRequire")
end

local Config = R.shared("Progression", "Config")
local Progression = R.shared("Progression", "Progression")
local AwayProgress = R.shared("Progression", "AwayProgress")
local StoreMod = R.sibling("Store")

local AwayProgressService = {}

local function withRevision(ident)
	ident.op.expectedRevision = ident.revision
	return ident.op
end

function AwayProgressService.new(deps)
	local self = {
		store = deps.store,
		clock = deps.clock or os.time,
		lastSeenAt = {},
		sessionStartedAt = {},
	}
	setmetatable(self, { __index = AwayProgressService })
	return self
end

-- Bootstrap supplies updatedAt from the server-validated stored profile
-- BEFORE Store.acquire refreshes it. It is durable across reconnects without
-- adding a second timestamp field to the existing profile schema.
function AwayProgressService.beginSession(svc, userId, lastSeenAt)
	local sessionStartedAt = svc.clock()
	if not Config.isSafeInteger(lastSeenAt, 0)
		or not Config.isSafeInteger(sessionStartedAt, 0) then
		return false, "server last-seen state is missing or invalid"
	end
	svc.lastSeenAt[userId] = lastSeenAt
	svc.sessionStartedAt[userId] = sessionStartedAt
	return true, nil
end

function AwayProgressService.endSession(svc, userId)
	svc.lastSeenAt[userId] = nil
	svc.sessionStartedAt[userId] = nil
end

function AwayProgressService.claim(svc, userId, requestId, idem)
	if type(requestId) ~= "string" or #requestId == 0
		or #requestId > Config.MAX_STRING_LEN then
		return { status = "Rejected", reason = "bad requestId" }
	end
	if idem == nil then
		return { status = "Rejected",
			reason = "v2 identity required: epoch+seq" }
	end
	local lastSeenAt = svc.lastSeenAt[userId]
	local sessionStartedAt = svc.sessionStartedAt[userId]
	if not Config.isSafeInteger(lastSeenAt, 0)
		or not Config.isSafeInteger(sessionStartedAt, 0) then
		return { status = "Rejected",
			reason = "server last-seen state is missing or invalid" }
	end

	local ident, err = StoreMod.identity(svc.store, userId, requestId,
		svc.clock(), idem, "ClaimAway")
	if not ident then
		return { status = "Unavailable", reason = err }
	end
	local awardThroughAt = math.min(ident.now, sessionStartedAt)
	local function apply(current)
		if StoreMod.frozen(current) then
			return nil, nil, "economy frozen: rebirth preview open"
		end
		if ident.epoch ~= (current.session and current.session.epoch or 0)
			or ident.runId ~= current.run.runId then
			return nil, nil, "state moved under request: refetch"
		end
		local award, awardErr = AwayProgress.calculate(lastSeenAt,
			awardThroughAt,
			Config.AWAY_REWARD_RATES, Config.AWAY_CATCH_UP_CAP_S)
		if not award then
			return nil, nil, awardErr
		end
		if award.clockSkew then
			return nil, nil, "server clock rollback: no away reward"
		end
		if award.runXp < 1 then
			return nil, nil, "no away reward earned yet"
		end

		local level, xp, levelsGained = Progression.applyRunXp(
			current.run.level, current.run.xp, award.runXp)
		if level == nil then
			return nil, nil, xp
		end
		current.run.level = level
		current.run.xp = math.min(xp, Config.MAX_XP)
		return current, {
			runXp = award.runXp,
			level = level,
			levelsGained = levelsGained,
			elapsedSeconds = award.elapsedSeconds,
			awardedSeconds = award.cappedSeconds,
			catchUpCapSeconds = award.catchUpCapSeconds,
			capApplied = award.capApplied,
			progressThroughAt = awardThroughAt,
		}, nil
	end

	local out = svc.store.runOp(svc.store, userId, withRevision(ident), apply)
	local progressThroughAt = out.result and out.result.progressThroughAt
	if Config.isSafeInteger(progressThroughAt, lastSeenAt) then
		svc.lastSeenAt[userId] = progressThroughAt
	elseif out.status == "Pending" then
		-- An ambiguous acknowledgement may follow a durable write. The sequence
		-- high-water proves whether this away interval was already consumed.
		local saved = svc.store.read(svc.store, userId)
		if saved ~= nil
			and (saved.run.reqHighWater or 0) >= ident.op.seq then
			svc.lastSeenAt[userId] = awardThroughAt
		end
	end
	return out
end

return AwayProgressService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">BattleService</string>
          <string name="Source"><![CDATA[-- BattleService.luau — server-owned battle admission + sealed rewards (P3).
-- BattleStart validates the confirmed deck, builds IMMUTABLE snapshots, runs
-- the pure P2 Resolver OUTSIDE the retry callback (pre-drawn seed is a frozen
-- input), and stores the issued attempt + sealed reward entitlement. Reward
-- cadence is server-issued at start and claimed exactly once; animation
-- speed, skip, pause, or forged playback change nothing. Reconnect
-- reconciles by re-resolving deterministically from the stored snapshot.

local R
if game ~= nil then
	R = require(script.Parent:WaitForChild("RobloxRequire"))
elseif dofile ~= nil then
	R = dofile("./src/server/RobloxRequire.luau")
else
	R = require("./RobloxRequire")
end

local Config = R.shared("Progression", "Config")
local Battles = R.shared("Progression", "Battles")
local Progression = R.shared("Progression", "Progression")

local StoreMod = R.sibling("Store")

local BattleService = {}

-- deps: { store, clock, drawSeed (fn()->int 0..2^32-1, server RNG),
--         resolver (P2 Resolver), editionsById (id->stats row),
--         cardsById (id->{mythic,legacy} retention flags),
--         encounters (id->{enemyIds,isBoss,chapter}), skillMultFn }.
function BattleService.new(deps)
	local self = {
		store = deps.store,
		clock = deps.clock or os.time,
		drawSeed = deps.drawSeed,
		resolver = deps.resolver,
		editionsById = deps.editionsById or {},
		cardsById = deps.cardsById or {},
		encounters = deps.encounters or {},
		skillMultFn = deps.skillMultFn or function()
			return { atk = 1, hp = 1 }
		end,
	}
	setmetatable(self, { __index = BattleService })
	return self
end

local function opIdentity(svc, userId, requestId, idem)
	return StoreMod.identity(svc.store, userId, requestId, svc.clock(), idem)
end

-- Attach the compare-and-commit revision to an admitted op.
local function withRevision(ident)
	ident.op.expectedRevision = ident.revision
	return ident.op
end

-- Shared server admission. Only the public RemoteFunction lane enforces route
-- prerequisites here; direct start() is a trusted server service call used
-- by domain tests/internal code, never exposed to clients.
local function startBattle(svc, userId, requestId, encounterId, idem,
	enforceRoutePrerequisites)
	if type(requestId) ~= "string" or #requestId == 0
		or #requestId > Config.MAX_STRING_LEN then
		return { status = "Rejected", reason = "bad requestId" }
	end
	local encounter = svc.encounters[encounterId]
	if not encounter then
		return { status = "Rejected", reason = "unknown encounter" }
	end
	local ident, err = opIdentity(svc, userId, requestId, idem)
	if idem == nil then
		-- Production service API admits versioned identity only: the
		-- unversioned lane is trusted-internal/test readback, never a
		-- public mutation route (B-09). No legacy fresh grants here.
		return { status = "Rejected",
			reason = "v2 identity required: epoch+seq" }
	end
	if not ident then
		return { status = "Unavailable", reason = err }
	end
	-- Read-model validation + pure resolution happen BEFORE the commit, on
	-- committed state. The tx rechecks revision/attemptSeq (compare-and-commit).
	local data = svc.store.read(svc.store, userId)
	if not data then
		return { status = "Unavailable", reason = "no profile" }
	end
	-- Retained receipts and durable v2 sequences reconcile in the tx: early
	-- rejects must never shadow AlreadyCommitted for a known op.
	local known = data.run.recentOps
		and data.run.recentOps[ident.op.opId] ~= nil
	local v2known = ident.op.epoch ~= nil and ident.op.seq ~= nil
		and ident.op.seq <= (data.run.reqHighWater or 0)
	local prerequisite = encounter.requiresClear
	local cleared = data.run.encounters
	if enforceRoutePrerequisites and prerequisite ~= nil
		and not known and not v2known
		and (type(cleared) ~= "table" or cleared[prerequisite] ~= true) then
		return { status = "Rejected",
			reason = "route locked: clear " .. prerequisite }
	end
	if StoreMod.frozen(data) and not known and not v2known then
		return { status = "Rejected", reason = "economy frozen: preview open" }
	end
	if (data.run.pendingBattle ~= nil or data.run.pendingReward ~= nil)
		and not known and not v2known then
		return { status = "Rejected", reason = "battle already pending" }
	end
	-- Server RNG is spent only after cheap admission passed (never inside
	-- the retry callback, never before validation).
	local seed = svc.drawSeed()
	local ok, derr = Progression.checkDeck(data.run.deck, data.run.collection)
	if not ok then
		return { status = "Rejected", reason = "deck illegal: " .. derr }
	end
	local mult = svc.skillMultFn(data)
	local fighters, ferr = Battles.buildSnapshot(data.run.deck,
		svc.editionsById, data.run.cardLevels, encounter.chapter or 1, mult)
	if not fighters then
		return { status = "Rejected", reason = ferr }
	end
	local enemies, eerr = Battles.buildEnemySnapshot(encounter.enemyIds,
		svc.editionsById)
	if not enemies then
		return { status = "Rejected", reason = eerr }
	end
	local result, rerr = svc.resolver.resolveBattle(fighters, enemies,
		{ seed = seed, rulesVersion = Config.RULES_VERSION })
	if not result then
		return { status = "Rejected", reason = "resolver: " .. tostring(rerr) }
	end
	local attemptId = Battles.nextAttemptId(ident.runId, ident.attemptSeq)
	local firstClear = nil
	if result.snapshot.winner == "A"
		and not data.run.encounters[encounterId] then
		firstClear = encounterId
	end
	local reward, rwerr = Battles.rewardFor(result.snapshot.winner,
		encounter.isBoss, firstClear)
	if not reward then
		return { status = "Rejected", reason = rwerr }
	end
	local store = svc.store
	local function apply(current)
		if current.revision ~= ident.revision then
			return nil, nil, "revision conflict: refetch and retry"
		end
		if (current.run.attemptSeq or 0) + 1 ~= ident.attemptSeq then
			return nil, nil, "attempt conflict: refetch and retry"
		end
		if StoreMod.frozen(current) then
			return nil, nil, "economy frozen: rebirth preview open"
		end
		if current.run.pendingBattle ~= nil
			or current.run.pendingReward ~= nil then
			return nil, nil, "battle already pending"
		end
		current.run.attemptSeq = ident.attemptSeq
		current.run.pendingBattle = {
			attemptId = attemptId,
			runId = ident.runId,
			encounterId = encounterId,
			isBoss = encounter.isBoss == true,
			snapshotA = fighters,
			snapshotB = enemies,
			seed = seed,
			issuedAt = ident.now,
		}
		current.run.pendingReward = {
			attemptId = attemptId,
			runId = ident.runId,
			xp = reward.xp,
			currency = reward.currency,
			firstClear = firstClear,
			winner = result.snapshot.winner,
			turns = result.snapshot.turns,
			eventHash = result.snapshot.eventHash,
			-- Sealed final snapshots (post-battle card states) alongside
			-- the initial snapshots in pendingBattle: the client renders
			-- initial->events->final with no trust in forged timelines.
			finalA = result.snapshot.finalA,
			finalB = result.snapshot.finalB,
		}
		return current, {
			attemptId = attemptId,
			events = result.events,
			winner = result.snapshot.winner,
			turns = result.snapshot.turns,
			eventHash = result.snapshot.eventHash,
			initialA = fighters,
			initialB = enemies,
			finalA = result.snapshot.finalA,
			finalB = result.snapshot.finalB,
		}, nil
	end
	return store.runOp(store, userId,
		withRevision(ident), apply)
end

-- Trusted server entry retained for direct service callers/domain tests.
function BattleService.start(svc, userId, requestId, encounterId, idem)
	return startBattle(svc, userId, requestId, encounterId, idem, false)
end

-- Untrusted clients enter only through Remotes.dispatch and this guarded path.
function BattleService.startFromRemote(svc, userId, requestId, encounterId,
	idem)
	return startBattle(svc, userId, requestId, encounterId, idem, true)
end

-- Claim the sealed reward exactly once. Replay (same requestId, or same
-- attemptId after consume) returns AlreadyCommitted via completedAttempts —
-- monotonic durable proof, never recent-request pruning.
function BattleService.claim(svc, userId, requestId, attemptId, idem)
	if type(requestId) ~= "string" or #requestId == 0
		or #requestId > Config.MAX_STRING_LEN then
		return { status = "Rejected", reason = "bad requestId" }
	end
	local ident, err = opIdentity(svc, userId, requestId, idem)
	if idem == nil then
		-- Production service API admits versioned identity only: the
		-- unversioned lane is trusted-internal/test readback, never a
		-- public mutation route (B-09). No legacy fresh grants here.
		return { status = "Rejected",
			reason = "v2 identity required: epoch+seq" }
	end
	if not ident then
		return { status = "Unavailable", reason = err }
	end
	local store = svc.store
	local function apply(current)
		local pending = current.run.pendingReward
		if pending == nil then
			if current.run.completedAttempts[attemptId] then
				return nil, { repeated = true, attemptId = attemptId },
					"AlreadyCommitted:dup-claim"
			end
			return nil, nil, "no pending reward"
		end
		if pending.attemptId ~= attemptId then
			return nil, nil, "attempt mismatch"
		end
		if current.run.currency + pending.currency > Config.MAX_CURRENCY then
			return nil, nil, "currency bound reached"
		end
		local lvl, xp = Progression.applyRunXp(current.run.level,
			current.run.xp, pending.xp)
		current.run.level, current.run.xp = lvl, xp
		current.run.currency = current.run.currency + pending.currency
		-- Card participation XP for every deck card in the sealed snapshot
		-- (winners train more; losers still train). Levels feed the visible
		-- effective-level ceiling via Battles.buildSnapshot.
		local cardGain = pending.winner == "A" and Config.CARD_XP_WIN
			or Config.CARD_XP_LOSS
		local snap = current.run.pendingBattle
		if snap and snap.snapshotA then
			for i = 1, #snap.snapshotA do
				local cid = snap.snapshotA[i].cardId
				local cl0 = current.run.cardLevels[cid] or 1
				local cx0 = current.run.cardXp[cid] or 0
				local nl, nx = Progression.applyCardXp(cl0, cx0,
					cardGain, Config.cardXpNext)
				current.run.cardLevels[cid] = nl
				if nx > 0 then
					current.run.cardXp[cid] = nx
				else
					current.run.cardXp[cid] = nil
				end
			end
		end
		current.run.encounters[pending.firstClear or ""] = nil
		if pending.firstClear then
			current.run.encounters[pending.firstClear] = true
		end
		-- Commit the boss milestone only here (durable), never from the client.
		local bossNow = false
		if pending.winner == "A" then
			local enc = svc.encounters[current.run.pendingBattle.encounterId]
			if enc and enc.isBoss and pending.runId == current.run.runId then
				current.run.bossClaimed = true
				bossNow = true
			end
		end
		local legacyGranted = nil
		if pending.winner == "A"
			and current.run.pendingBattle.isBoss == true
			and pending.firstClear == Config.LEGACY_STORY_ROUTE_ID
			and current.account.legacyEntitlements[
				Config.LEGACY_STORY_REWARD_ID] ~= true then
			current.account.legacyEntitlements[
				Config.LEGACY_STORY_REWARD_ID] = true
			legacyGranted = Config.LEGACY_STORY_REWARD_ID
		end
		current.run.completedAttempts[pending.attemptId] = true
		current.run.pendingBattle = nil
		current.run.pendingReward = nil
		local doneLevels, doneXp = {}, {}
		for id, lv in pairs(current.run.cardLevels) do
			doneLevels[id] = lv
		end
		for id, xp in pairs(current.run.cardXp) do
			doneXp[id] = xp
		end
		return current, { attemptId = pending.attemptId,
			xp = pending.xp, currency = pending.currency,
			level = current.run.level, bossClaimed = bossNow,
			firstClear = pending.firstClear,
			legacyGranted = legacyGranted,
			cardLevels = doneLevels, cardXp = doneXp }, nil
	end
	local out = store.runOp(store, userId,
		withRevision(ident), apply)
	-- A duplicate claim that arrives as a NEW requestId after consume must
	-- still reconcile to AlreadyCommitted (monotonic proof, not cache).
	if out.status == "Rejected" and out.reason == "no pending reward" then
		local data = svc.store.read(svc.store, userId)
		if data and data.run.completedAttempts[attemptId] then
			return { status = "AlreadyCommitted",
				result = { repeated = true, attemptId = attemptId } }
		end
	end
	if out.status == "Rejected"
		and string.find(out.reason or "", "AlreadyCommitted", 1, true) then
		return { status = "AlreadyCommitted", result = out.result }
	end
	return out
end

-- Reconnect reconcile: regenerate the authoritative timeline deterministically
-- from the stored pending snapshot (never trust client-supplied events).
function BattleService.status(svc, userId)
	local data = svc.store.read(svc.store, userId)
	if not data then
		return { status = "Unavailable", reason = "no profile" }
	end
	local pending = data.run.pendingBattle
	if pending == nil then
		return { status = "Committed",
			result = { pending = false } }
	end
	local result, rerr = svc.resolver.resolveBattle(pending.snapshotA,
		pending.snapshotB,
		{ seed = pending.seed, rulesVersion = Config.RULES_VERSION })
	if not result then
		return { status = "Unavailable",
			reason = "re-resolve failed: " .. tostring(rerr) }
	end
	return { status = "Committed", result = {
		pending = true,
		attemptId = pending.attemptId,
		encounterId = pending.encounterId,
		events = result.events,
		winner = result.snapshot.winner,
		reward = data.run.pendingReward,
		initialA = pending.snapshotA,
		initialB = pending.snapshotB,
		finalA = data.run.pendingReward.finalA,
		finalB = data.run.pendingReward.finalB,
	} }
end

return BattleService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Bootstrap</string>
          <string name="Source"><![CDATA[-- Bootstrap.luau — server entrypoint wiring (P3).
-- Roblox path: builds the DEV-scoped DataStore adapter, the fenced Store,
-- all services, and the single RemoteFunction; routes PlayerAdded /
-- PlayerRemoving / BindToClose; runs the server-scheduled auto-roll loop.
-- No manual fight controls exist anywhere: every mutation travels the narrow
-- remote contract. Test path (Lune): buildTestHarness returns the same wired
-- services over the TEST-ONLY memory adapter with injected clock/RNG.

local R
if game ~= nil then
	R = require(script.Parent:WaitForChild("RobloxRequire"))
elseif dofile ~= nil then
	R = dofile("./src/server/RobloxRequire.luau")
else
	R = require("./RobloxRequire")
end

local Config = R.shared("Progression", "Config")
local Store = R.sibling("Store")
local MemoryAdapter = R.sibling("MemoryAdapter")
local DataStoreAdapter = R.sibling("DataStoreAdapter")
local RollService = R.sibling("RollService")
local BattleService = R.sibling("BattleService")
local RebirthService = R.sibling("RebirthService")
local SkillService = R.sibling("SkillService")
local AwayProgressService = R.sibling("AwayProgressService")
local Remotes = R.sibling("Remotes")
local RateLimit = R.sibling("RateLimit")

local Bootstrap = {}

-- Roblox's math.random rejects a single interval spanning the full u32
-- range. Join two supported 16-bit draws for a battle seed instead.
function Bootstrap.randomSeed(drawRange)
	local high = drawRange(0, 65535)
	local low = drawRange(0, 65535)
	return high * 65536 + low
end

-- Build content-derived tables from P2 modules (injected for tests).
-- Loops ALL worlds in Cards.WORLDS (falls back to WORLD_01-only when an
-- injected stub predates WORLDS). WORLD-01 keeps its exact historical
-- keys (enc-1..3, boss-1); later worlds use wN- prefixes (w2-enc-1..3,
-- boss-2, w3-enc-1..3, boss-3). Chapters restart per world (1,2,3):
-- Progression.effectiveLevel rejects chapter > #CHAPTER_CAPS (5), so a
-- global 1..9 continuation would mint encounters BattleStart must reject
-- as "chapter out of range" — unplayable content is refused by design.
-- Each world's boss is chapter 3; requiresClear chains this same route order
-- across bosses and world boundaries for server-side BattleStart admission.
function Bootstrap.contentTables(Cards)
	local editions, editionsById = {}, {}
	for i = 1, #Cards.EDITIONS do
		local ed = Cards.EDITIONS[i]
		editions[#editions + 1] = { id = ed.id, rarity = ed.rarity }
		editionsById[ed.id] = {
			hp = ed.hp, atk = ed.atk, def = ed.def, speed = ed.speed,
			entry = ed.entry,
		}
	end
	local worlds = Cards.WORLDS or { Cards.WORLD_01 }
	local encounters = {}
	local previousRouteId = nil
	for w = 1, #worlds do
		local world = worlds[w]
		local prefix = ""
		local bossKey = "boss-1"
		if w > 1 then
			prefix = "w" .. w .. "-"
			bossKey = "boss-" .. w
		end
		for i = 1, #world.encounters do
			local id = world.encounters[i]
			local routeId = prefix .. "enc-" .. i
			encounters[routeId] = { enemyIds = { id }, isBoss = false,
				chapter = i, requiresClear = previousRouteId }
			previousRouteId = routeId
		end
		encounters[bossKey] = { enemyIds = { world.boss },
			isBoss = true, chapter = 3, requiresClear = previousRouteId }
	end
	return editions, editionsById, encounters
end

-- Full harness over injected deps (used by Roblox AND Lune tests).
-- deps: { adapter, clock, drawInt, drawSeed, resolver, Cards, serverId }.
function Bootstrap.build(deps)
	local editions, editionsById, encounters =
		Bootstrap.contentTables(deps.Cards)
	local knownIds = {}
	if deps.Cards then
		for i = 1, #deps.Cards.EDITIONS do
			knownIds[deps.Cards.EDITIONS[i].id] = true
		end
	end
	local store = Store.new({ adapter = deps.adapter,
		serverId = deps.serverId or "srv-1", clock = deps.clock,
		knownIds = knownIds })
	local roll = RollService.new({ store = store, clock = deps.clock,
		drawInt = deps.drawInt, editions = editions })
	local battle = BattleService.new({ store = store, clock = deps.clock,
		drawSeed = deps.drawSeed, resolver = deps.resolver,
		editionsById = editionsById, encounters = encounters })
	local rebirth = RebirthService.new({ store = store, clock = deps.clock,
		editionsById = deps.Cards and Bootstrap.retentionFlags(deps.Cards)
			or editionsById,
		starters = Config.STARTER_IDS })
	local skills = SkillService.new({ store = store, clock = deps.clock })
	local away = AwayProgressService.new({ store = store, clock = deps.clock })
	local router = Remotes.new({ store = store, clock = deps.clock,
		roll = roll, battle = battle, rebirth = rebirth, skills = skills,
		away = away,
		rate = RateLimit.new() })
	return {
		store = store, roll = roll, battle = battle, rebirth = rebirth,
		skills = skills, away = away, router = router, encounters = encounters,
		editions = editions, editionsById = editionsById,
	}
end

-- Retention flags (mythic/legacy) indexed by id for rebirth enforcement.
function Bootstrap.retentionFlags(Cards)
	local out = {}
	for i = 1, #Cards.EDITIONS do
		local ed = Cards.EDITIONS[i]
		out[ed.id] = { rarity = ed.rarity, mythic = ed.mythic == true,
			legacy = ed.legacy == true }
	end
	return out
end

-- Player lifecycle: load-or-create (safe: failed load never defaults over
-- data), acquire fencing, deterministic tutorial on first join only.
function Bootstrap.playerAdded(h, userId)
	local data, derr, exists = h.store.loadExisting(h.store, userId)
	local lastSeenAt = data and data.updatedAt or nil
	if derr ~= nil then
		return { status = "Unavailable", reason = derr }
	end
	if not exists then
		local created, cerr = h.store.create(h.store, userId, nil)
		if not created then
			return { status = "Unavailable", reason = cerr }
		end
		data = created
	else
		local acquired, aerr = h.store.acquire(h.store, userId)
		if not acquired then
			return { status = "Stale", reason = aerr }
		end
		data = acquired
	end
	if h.away ~= nil then
		local awayStarted, awayErr = h.away.beginSession(h.away, userId,
			lastSeenAt or data.updatedAt)
		if not awayStarted then
			return { status = "Unavailable", reason = awayErr }
		end
	end
	if not data.account.tutorialDone then
		-- Trusted internal path with proper server-generated v2 identity
		-- (current epoch + next durable sequence): never the public
		-- legacy lane. The grant commits exactly once (tutorialDone gate
		-- + revision compare inside the service op).
		local ep = (data.session and data.session.epoch) or 0
		local seq = (data.run.reqHighWater or 0) + 1
		return h.roll.tutorialGrant(h.roll, userId,
			"join-" .. tostring(data.run.runId), { epoch = ep, seq = seq })
	end
	return { status = "Committed",
		result = Remotes.profileLite(data, h.store.clock()) }
end

-- Best-effort fencing release on leave (all economics already durable
-- per-op; release frees the lease so a reconnecting session recovers fast,
-- while epoch fencing still blocks any stale writer).
function Bootstrap.playerRemoving(h, userId)
	local released, rerr = h.store.release(h.store, userId)
	if h.away ~= nil then
		h.away.endSession(h.away, userId)
	end
	if not released then
		return { status = "Committed", result = { noted = true,
			release = tostring(rerr) } }
	end
	return { status = "Committed", result = { noted = true,
		released = true } }
end

-- Roblox server start. No-ops outside a Roblox runtime.
function Bootstrap.serve(h)
	if game == nil then
		return false, "no Roblox runtime"
	end
	local studio = game:GetService("RunService"):IsStudio()
	local analytics = not studio and game:GetService("AnalyticsService") or nil
	local players = game:GetService("Players")
	local sessionProgress = {}
	local function log(player, name)
		if analytics ~= nil then
			pcall(function() analytics:LogCustomEvent(player, name) end)
		end
	end
	local remote = Instance.new("RemoteFunction")
	remote.Name = Remotes.REMOTE_NAME
	remote.Parent = game:GetService("ReplicatedStorage")
	remote.OnServerInvoke = function(player, req)
		local result = Remotes.dispatch(h.router, player.UserId, req)
		if studio and type(req) == "table" and type(req.command) == "string"
			and ({ GetProfile = true, TutorialGrant = true, RollOnce = true,
				SetDeck = true, BattleStart = true, BattleStatus = true,
				BattleClaim = true, RebirthConfirm = true })[req.command] then
			local stamp = game:GetService("ReplicatedStorage")
				:FindFirstChild("UACGManifestHash")
			print("UACG_STUDIO_TX manifest="
				.. (stamp and tostring(stamp.Value) or "absent")
				.. " command=" .. req.command
				.. " status=" .. tostring(result.status))
		end
		if result.status == "Committed" and type(req) == "table" then
			local name = ({ RollOnce = "RollCommitted",
				SetDeck = "DeckSaved", BattleStart = "BattleStarted",
				BattleClaim = "BattleClaimed", RebirthConfirm = "RebirthCommitted",
				BuyEarnedPack = "EarnedPackOpened" })[req.command]
			if name ~= nil then log(player, name) end
			local progress = sessionProgress[player.UserId]
			if progress ~= nil then
				if req.command == "RollOnce" then progress.roll = true end
				if req.command == "BattleClaim" then progress.battle = true end
			end
		end
		return result
	end
	local function track(player)
		sessionProgress[player.UserId] = { roll = false, battle = false }
		task.delay(600, function()
			local progress = sessionProgress[player.UserId]
			if player.Parent == players and progress ~= nil
				and progress.roll and progress.battle then
				log(player, "Session10MinWithBattle")
			end
		end)
	end
	local function join(player)
		track(player)
		Bootstrap.playerAdded(h, player.UserId)
	end
	players.PlayerAdded:Connect(join)
	players.PlayerRemoving:Connect(function(player)
		sessionProgress[player.UserId] = nil
		Bootstrap.playerRemoving(h, player.UserId)
	end)
	for _, player in ipairs(players:GetPlayers()) do
		-- Init may have loaded the profile before serve installed the remote.
		track(player)
	end
	-- Server-scheduled auto-roll: one tick per player per cooldown window,
	-- backpressured (tickAuto skips unless exactly due). Not a client loop.
	task.spawn(function()
		local tick = 0
		while true do
			task.wait(Config.ROLL_COOLDOWN_S)
			tick = tick + 1
			for _, player in ipairs(players:GetPlayers()) do
				h.roll.tickAuto(h.roll, player.UserId,
					"auto-" .. tick .. "-" .. player.UserId)
			end
		end
	end)
	return true, nil
end

-- Studio DEV fallback adapter: LOUD, clearly-marked, NON-DURABLE.
-- Exists so the game is playable in an UNPUBLISHED Studio place, where
-- Roblox blocks DataStore access ("You must publish this place to the web
-- to access DataStore"). It wraps the test-only MemoryAdapter and marks
-- itself so receipts/status can never confuse it with durable storage.
-- Production NEVER uses this path: Bootstrap.production() only selects it
-- when the DataStore service is unavailable, and it is never selected when
-- a real DataStore call can be made.
function Bootstrap.devFallbackAdapter()
	local mem = MemoryAdapter.new()
	-- Rebrand the test adapter for the Studio-dev lane: durable=false is
	-- explicit; the underlying behavior is identical (in-memory only).
	mem.__testOnly = false
	mem.__studioDev = true
	mem.__notDurable = true
	return mem
end

-- Studio DEV harness: DataStore when reachable, loud non-durable fallback
-- when it is not (unpublished place). Returns harness + adapterLane string
-- so the caller can warn precisely; it never claims durability it lacks.
function Bootstrap.studioDev()
	local Cards = R.shared("Content", "Cards")
	local Resolver = R.shared("Combat", "Resolver")
	local dss = game and game:GetService("DataStoreService") or nil
	local adapter, lane
	if dss ~= nil then
		-- Probe: DataStore is unusable in an unpublished place; pcall the
		-- same call the adapter would make so the decision is evidence-based.
		local okProbe = pcall(function()
			local probeStore = dss:GetDataStore("uacg-dev-probe")
			probeStore:GetAsync("probe:" .. tostring(os.time()))
		end)
		if okProbe then
			adapter = DataStoreAdapter.new({ allowProduction = false })
			lane = "datastore-dev"
		else
			adapter = Bootstrap.devFallbackAdapter()
			lane = "studio-dev-memory"
			warn("[UACG] DataStore unavailable (unpublished place): using "
				.. "NON-DURABLE studio-dev memory adapter. Progress will "
				.. "NOT persist. Publish the place or use a published test "
				.. "slot for durable saves.")
		end
	else
		adapter = Bootstrap.devFallbackAdapter()
		lane = "studio-dev-memory"
		warn("[UACG] No DataStoreService in this runtime: using "
			.. "NON-DURABLE studio-dev memory adapter.")
	end
	return Bootstrap.build({
		adapter = adapter,
		clock = os.time,
		drawInt = function(upper)
			return math.random(1, upper)
		end,
		drawSeed = function()
			return Bootstrap.randomSeed(math.random)
		end,
		resolver = Resolver,
		Cards = Cards,
		serverId = game and tostring(game.JobId) or "srv-prod",
	}), lane
end

-- Production refuses to boot unless the compiled target matches the live
-- Roblox universe AND place. This prevents a copied place from writing to
-- this game's durable namespace by accident.
function Bootstrap.checkReleaseTarget(config, universeId, placeId)
	if type(config) ~= "table" or type(config.universeId) ~= "number"
		or type(config.placeId) ~= "number"
		or config.universeId <= 0 or config.placeId <= 0
		or config.universeId % 1 ~= 0 or config.placeId % 1 ~= 0
		or type(config.productionScope) ~= "string"
		or not string.match(config.productionScope, "^UACG_PROD_[%w_]+$") then
		return false, "release target is not configured"
	end
	if config.universeId ~= universeId or config.placeId ~= placeId then
		return false, "live universe/place does not match release target"
	end
	return true, nil
end

function Bootstrap.production(config)
	local ok, reason = Bootstrap.checkReleaseTarget(config,
		game and game.GameId or 0, game and game.PlaceId or 0)
	if not ok then
		error(reason, 2)
	end
	local dsa = DataStoreAdapter.new({ allowProduction = true,
		productionScope = config.productionScope })
	local Cards = R.shared("Content", "Cards")
	local Resolver = R.shared("Combat", "Resolver")
	return Bootstrap.build({
		adapter = dsa,
		clock = os.time,
		drawInt = function(upper)
			return math.random(1, upper)
		end,
		drawSeed = function()
			return Bootstrap.randomSeed(math.random)
		end,
		resolver = Resolver,
		Cards = Cards,
		serverId = game and tostring(game.JobId) or "srv-prod",
	})
end

return Bootstrap
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">DataStoreAdapter</string>
          <string name="Source"><![CDATA[-- DataStoreAdapter.luau — real Roblox DataStore persistence (P3, server only).
-- Uses a SEPARATE explicit DEV namespace (Config.DATASTORE_SCOPE_DEV).
-- Production is BLOCKED until a release config explicitly allows it: there
-- is no silent fallback, no implicit default-over-data, and no in-memory
-- masquerade. A failed load returns nil+err and the service must surface
-- Unavailable — it must NEVER create a fresh writable default over possible
-- existing data. This file requires a Roblox server runtime (DataStoreService)
-- and is never executed by Lune tests (MemoryAdapter covers those paths).

local DataStoreAdapter = {}

local R
if game ~= nil then
	R = require(script.Parent:WaitForChild("RobloxRequire"))
elseif dofile ~= nil then
	R = dofile("./src/server/RobloxRequire.luau")
else
	R = require("./RobloxRequire")
end

function DataStoreAdapter.new(opts)
	opts = opts or {}
	-- Bootstrap checks the exact live universe and place before it can reach
	-- this branch. Never accept an empty or DEV scope as production storage.
	local scope = R.shared("Progression", "Config").DATASTORE_SCOPE_DEV
	if opts.allowProduction then
		scope = opts.productionScope -- must come from the release config
		if type(scope) ~= "string" or #scope == 0
			or scope == R.shared("Progression", "Config").DATASTORE_SCOPE_DEV then
			error("production scope must come from the release config", 2)
		end
	end
	local dss = opts.datastoreService
	if not dss then
		if game == nil then
			error("DataStoreAdapter needs a Roblox server runtime", 2)
		end
		dss = game:GetService("DataStoreService")
	end
	local store = dss:GetDataStore(scope)
	local self = { __testOnly = false, store = store, scope = scope }
	setmetatable(self, { __index = DataStoreAdapter })
	return self
end

function DataStoreAdapter.keyFor(userId)
	return "profile:" .. tostring(userId)
end

function DataStoreAdapter.load(adapter, key)
	local ok, result = pcall(function()
		return adapter.store:GetAsync(key)
	end)
	if not ok then
		return nil, "datastore load failed: " .. tostring(result)
	end
	return result, nil -- nil result with nil err = key absent (new player)
end

-- fn(current) must be PURE: no yield, no RNG advancement, no external calls
-- (Roblox forbids yielding inside UpdateAsync; impurity also breaks retries).
-- The callback given to Roblox returns ONLY the new document or nil: the
-- second domain value (abort reason) NEVER crosses into UpdateAsync, because
-- Roblox would hand that second return to the write path. The abort reason
-- is captured in an upvalue and reported separately.
function DataStoreAdapter.update(adapter, key, fn)
	local ranCallback = false
	local abortReason = nil
	local function cb(current)
		ranCallback = true
		local doc, why = fn(current)
		if doc == nil then
			abortReason = why
			return nil
		end
		return doc
	end
	local ok, result = pcall(function()
		return adapter.store:UpdateAsync(key, cb)
	end)
	if not ok then
		if ranCallback then
			-- The callback ran: the write may have landed. Unknown.
			return nil, false, "datastore update failed after callback (commit unknown): "
				.. tostring(result)
		end
		return nil, false, "datastore update failed before callback: "
			.. tostring(result)
	end
	if result == nil then
		return nil, false, "aborted:" .. tostring(abortReason)
	end
	return result, true, nil
end

return DataStoreAdapter
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="29">
        <Properties>
          <string name="Name">Init</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Init.server.luau — Roblox server entrypoint (P3). This is a Script (run by
-- Roblox), NOT a ModuleScript: Bootstrap stays a testable module, and THIS
-- file starts the live game. Never required by Lune/plain-Lua tests.
--
-- Studio-dev lane: in an UNPUBLISHED Studio place, Roblox blocks DataStore
-- ("You must publish this place to the web to access DataStore"). The server
-- must still boot for live testing: Bootstrap.studioDev() probes DataStore
-- and degrades LOUDLY to a non-durable memory adapter when unavailable. The
-- production lane (Bootstrap.production, DataStore-backed) is kept for a
-- published place; this file never silently claims durability.

local Bootstrap = require(script.Parent:WaitForChild("Bootstrap"))
local ReleaseConfig = require(script.Parent:WaitForChild("ReleaseConfig"))
local SupporterPass = require(script.Parent:WaitForChild("SupporterPass"))

local function fatal(where, err)
	warn("[UACG] init failed at " .. where .. ": " .. tostring(err))
end

local isStudio = game:GetService("RunService"):IsStudio()
local ok, h, lane
if isStudio then
	ok, h, lane = pcall(Bootstrap.studioDev)
else
	ok, h = pcall(Bootstrap.production, ReleaseConfig)
	lane = "production"
end
if not ok or h == nil then
	fatal(lane or "server build", tostring(h))
	return
end

warn("[UACG] server lane: " .. tostring(lane))

-- Initialize players already present before this Script ran (quick rejoins).
local players = game:GetService("Players")
for _, player in ipairs(players:GetPlayers()) do
	local pok, perr = pcall(Bootstrap.playerAdded, h, player.UserId)
	if not pok then
		fatal("playerAdded existing " .. tostring(player.UserId), perr)
	end
end

local sok, serr = pcall(Bootstrap.serve, h)
if not sok or serr ~= true then
	fatal("serve", serr)
	return
end
local pok, perr = pcall(SupporterPass.serve, ReleaseConfig)
if not pok then
	fatal("supporter pass", perr)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">MemoryAdapter</string>
          <string name="Source"><![CDATA[-- MemoryAdapter.luau — TEST-ONLY in-memory persistence adapter (P3).
-- This is NOT durable Roblox proof: everything here vanishes with the
-- process. It exists so Lune/Linux tests can execute the REAL Store +
-- service logic with injected faults (before/after commit, ack loss,
-- callback retry, concurrent writers). Production uses DataStoreAdapter.
-- Adapter contract (both adapters): load(key) -> data|nil, err; and
-- update(key, fn) -> committedData, wasCommitted, err, where fn(current)
-- is a PURE transform (no yield, no RNG, no IO) returning the new document
-- or nil+abortReason to abort without writing.

local MemoryAdapter = {}

function MemoryAdapter.new()
	local self = {
		__testOnly = true,
		__notDurable = true,
		tables = {},
		faults = {
			failLoad = false,
			failBeforeCommit = false,
			failAfterCommit = false,
			retryCallback = false, -- call fn twice, require identical output
		},
	}
	setmetatable(self, { __index = MemoryAdapter })
	return self
end

local function deepCopy(value, depth)
	depth = depth or 0
	if depth > 32 then
		error("nesting too deep", 2)
	end
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in pairs(value) do
		out[deepCopy(k, depth + 1)] = deepCopy(v, depth + 1)
	end
	return out
end

local function deepEqual(a, b, depth)
	depth = depth or 0
	if depth > 32 then
		return false
	end
	if type(a) ~= type(b) then
		return false
	end
	if type(a) ~= "table" then
		return a == b
	end
	for k, v in pairs(a) do
		if not deepEqual(v, b[k], depth + 1) then
			return false
		end
	end
	for k in pairs(b) do
		if a[k] == nil then
			return false
		end
	end
	return true
end

function MemoryAdapter.load(adapter, key)
	if adapter.faults.failLoad then
		return nil, "injected load failure"
	end
	local stored = adapter.tables[key]
	if stored == nil then
		return nil, nil
	end
	return deepCopy(stored), nil
end

function MemoryAdapter.update(adapter, key, fn)
	if adapter.faults.failBeforeCommit then
		return nil, false, "injected failure before commit"
	end
	local current = nil
	if adapter.tables[key] ~= nil then
		current = deepCopy(adapter.tables[key])
	end
	local first, firstErr = fn(current)
	if first == nil then
		return nil, false, firstErr or "aborted"
	end
	if adapter.faults.retryCallback then
		-- DataStore UpdateAsync may run the callback multiple times: a pure
		-- callback must produce byte-identical output or it is a bug.
		local second, secondErr = fn(current)
		if second == nil or not deepEqual(first, second) then
			error("impure UpdateAsync callback: retry produced different output ("
				.. tostring(secondErr) .. ")", 2)
		end
	end
	adapter.tables[key] = deepCopy(first)
	if adapter.faults.failAfterCommit then
		-- Committed durably, but the caller sees a timeout: status unknown.
		return nil, false, "ambiguous: committed, acknowledgment lost"
	end
	return deepCopy(first), true, nil
end

MemoryAdapter.deepEqual = deepEqual
MemoryAdapter.deepCopy = deepCopy

return MemoryAdapter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">RateLimit</string>
          <string name="Source"><![CDATA[-- RateLimit.luau — per-player per-command token buckets (P3, server-side).
-- Pure Luau/plain-Lua subset; clock injected for tests. High-rate forged
-- clients are rejected before touching durable state.

local R
if game ~= nil then
	R = require(script.Parent:WaitForChild("RobloxRequire"))
elseif dofile ~= nil then
	R = dofile("./src/server/RobloxRequire.luau")
else
	R = require("./RobloxRequire")
end

local RateLimit = {}

function RateLimit.new()
	return { buckets = {} }
end

-- ok | false, retryAfterS — token bucket per player+command.
function RateLimit.check(state, userKey, command, now)
	local cfg = R.shared("Progression", "Config")
	local rule = cfg.RATE_LIMITS[command]
	if not rule then
		return false, "unknown command"
	end
	local key = tostring(userKey) .. ":" .. command
	local b = state.buckets[key]
	if not b then
		b = { tokens = rule.burst, updated = now }
		state.buckets[key] = b
	end
	local elapsed = now - b.updated
	if elapsed < 0 then
		elapsed = 0
	end
	if rule.interval > 0 then
		b.tokens = b.tokens + elapsed / rule.interval
		if b.tokens > rule.burst then
			b.tokens = rule.burst
		end
	else
		b.tokens = rule.burst
	end
	b.updated = now
	if b.tokens < 1 then
		return false, rule.interval
	end
	b.tokens = b.tokens - 1
	return true, nil
end

return RateLimit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">RebirthService</string>
          <string name="Source"><![CDATA[-- RebirthService.luau — atomic rebirth with exact preview (P3).
-- Preview is bound to revision/run/version + a server-issued token. While a
-- preview is open the economy freezes (rolls/battles/deck/skills reject;
-- auto-roll skips); cancel resumes. Confirm is atomic via Rebirth.apply and
-- duplicate confirms reconcile to AlreadyCommitted through lastRebirth.

local R
if game ~= nil then
	R = require(script.Parent:WaitForChild("RobloxRequire"))
elseif dofile ~= nil then
	R = dofile("./src/server/RobloxRequire.luau")
else
	R = require("./RobloxRequire")
end

local Config = R.shared("Progression", "Config")
local Rebirth = R.shared("Progression", "Rebirth")

local StoreMod = R.sibling("Store")

local RebirthService = {}

-- deps: { store, clock, editionsById, starters, cardsById }.
function RebirthService.new(deps)
	local self = {
		store = deps.store,
		clock = deps.clock or os.time,
		editionsById = deps.editionsById or {},
		starters = deps.starters or Config.STARTER_IDS,
	}
	setmetatable(self, { __index = RebirthService })
	return self
end

local function opIdentity(svc, userId, requestId, idem)
	return StoreMod.identity(svc.store, userId, requestId, svc.clock(), idem)
end

-- Attach the compare-and-commit revision to an admitted op.
local function withRevision(ident)
	ident.op.expectedRevision = ident.revision
	return ident.op
end

-- Open a preview: flushes nothing (all prior ops already durable), then
-- freezes new economic ops until confirm or cancel.
function RebirthService.preview(svc, userId, requestId, keepsakeId, idem)
	if type(requestId) ~= "string" or #requestId == 0
		or #requestId > Config.MAX_STRING_LEN then
		return { status = "Rejected", reason = "bad requestId" }
	end
	if keepsakeId ~= nil and (type(keepsakeId) ~= "string"
		or #keepsakeId > Config.MAX_STRING_LEN) then
		return { status = "Rejected", reason = "bad keepsakeId" }
	end
	local ident, err = opIdentity(svc, userId, requestId, idem)
	if idem == nil then
		-- Production service API admits versioned identity only: the
		-- unversioned lane is trusted-internal/test readback, never a
		-- public mutation route (B-09). No legacy fresh grants here.
		return { status = "Rejected",
			reason = "v2 identity required: epoch+seq" }
	end
	if not ident then
		return { status = "Unavailable", reason = err }
	end
	local store = svc.store
	local function apply(current)
		if current.run.preview ~= nil then
			return nil, nil, "preview already open"
		end
		local body, berr = Rebirth.preview(current, keepsakeId,
			svc.editionsById, svc.starters)
		if not body then
			return nil, nil, berr
		end
		local token = current.run.runId .. ":" .. current.revision .. ":"
			.. ((current.run.opSeq or 0) + 1)
		-- The preview binds to the POST-commit revision: this very commit
		-- bumps revision by one, so bind revision+1 (else the opener commit
		-- itself would read as "state moved").
		current.run.preview = {
			token = token,
			revision = current.revision + 1,
			runId = current.run.runId,
			keepsakeId = keepsakeId,
			frozenAt = ident.now,
		}
		body.revision = current.revision + 1
		body.token = token
		return current, body, nil
	end
	return store.runOp(store, userId,
		withRevision(ident), apply)
end

-- Confirm atomically with the exact server-issued token.
function RebirthService.confirm(svc, userId, requestId, token, idem)
	if type(requestId) ~= "string" or #requestId == 0
		or #requestId > Config.MAX_STRING_LEN then
		return { status = "Rejected", reason = "bad requestId" }
	end
	if type(token) ~= "string" or #token == 0
		or #token > Config.MAX_STRING_LEN then
		return { status = "Rejected", reason = "bad token" }
	end
	local ident, err = opIdentity(svc, userId, requestId, idem)
	if idem == nil then
		-- Production service API admits versioned identity only: the
		-- unversioned lane is trusted-internal/test readback, never a
		-- public mutation route (B-09). No legacy fresh grants here.
		return { status = "Rejected",
			reason = "v2 identity required: epoch+seq" }
	end
	if not ident then
		return { status = "Unavailable", reason = err }
	end
	local store = svc.store
	local function apply(current)
		local open = current.run.preview
		if open == nil then
			local last = current.run.lastRebirth
			if last and last.token == token then
				return nil, { repeated = true, fromRun = last.fromRun,
					toRun = last.toRun, granted = last.granted },
					"AlreadyCommitted:dup-confirm"
			end
			return nil, nil, "no preview open"
		end
		if open.token ~= token then
			return nil, nil, "token mismatch"
		end
		local body, berr = Rebirth.preview(current, open.keepsakeId,
			svc.editionsById, svc.starters)
		if not body then
			return nil, nil, berr
		end
		if body.revision ~= open.revision or body.runId ~= open.runId then
			return nil, nil, "stale preview: state moved"
		end
		body.token = token
		local applied, aerr = Rebirth.apply(current, body,
			svc.editionsById, svc.starters, ident.now)
		if not applied then
			return nil, nil, aerr
		end
		applied.run.lastRebirth = { token = token,
			fromRun = open.runId, toRun = open.runId + 1,
			granted = body.granted }
		return applied, { fromRun = open.runId, toRun = open.runId + 1,
			granted = body.granted, kept = body.kept, lost = body.lost,
			currencyLost = body.currencyLost }, nil
	end
	local out = store.runOp(store, userId,
		withRevision(ident), apply)
	if out.status == "Rejected"
		and string.find(out.reason or "", "AlreadyCommitted", 1, true) then
		return { status = "AlreadyCommitted", result = out.result }
	end
	return out
end

-- Cancel: clears the freeze; auto-roll resumes on the next server tick.
function RebirthService.cancel(svc, userId, requestId, idem)
	if type(requestId) ~= "string" or #requestId == 0
		or #requestId > Config.MAX_STRING_LEN then
		return { status = "Rejected", reason = "bad requestId" }
	end
	local ident, err = opIdentity(svc, userId, requestId, idem)
	if idem == nil then
		-- Production service API admits versioned identity only: the
		-- unversioned lane is trusted-internal/test readback, never a
		-- public mutation route (B-09). No legacy fresh grants here.
		return { status = "Rejected",
			reason = "v2 identity required: epoch+seq" }
	end
	if not ident then
		return { status = "Unavailable", reason = err }
	end
	local store = svc.store
	local function apply(current)
		if current.run.preview == nil then
			return nil, nil, "no preview open"
		end
		current.run.preview = nil
		return current, { cancelled = true }, nil
	end
	return store.runOp(store, userId,
		withRevision(ident), apply)
end

return RebirthService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">ReleaseConfig</string>
          <string name="Source"><![CDATA[-- Exact live target. Zero IDs keep the published-server path closed until
-- the owner selects the experience and its pass is created there.
-- This module is server-only; no credential belongs in a place file.
return {
	universeId = 0,
	placeId = 0,
	productionScope = "UACG_PROD_v1",
	supporterPassId = 0,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Remotes.luau — narrow remote contract (P3, server-side dispatch).
-- ONE RemoteFunction ("UACG_Economy") carrying Lua tables directly — no JSON
-- encoding of the profile across remotes. Every request is
-- { requestId, command, params }; every response is
-- { status, result?, reason?, serverNow }. The client never supplies grant
-- amounts, rarities, victories, retention lists, or full profiles.
-- Validation rejects bad structure, overlong strings, deep/wide tables,
-- non-table params, NaN/Infinity, unknown/forged IDs, and high rates BEFORE
-- any durable work.

local R
if game ~= nil then
	R = require(script.Parent:WaitForChild("RobloxRequire"))
elseif dofile ~= nil then
	R = dofile("./src/server/RobloxRequire.luau")
else
	R = require("./RobloxRequire")
end

local Config = R.shared("Progression", "Config")
local Progression = R.shared("Progression", "Progression")
local AwayProgress = R.shared("Progression", "AwayProgress")
local RateLimit = R.sibling("RateLimit")

local Remotes = {}

Remotes.REMOTE_NAME = "UACG_Economy"

Remotes.COMMANDS = {
	RollOnce = true,
	BuyEarnedPack = true,
	SetAutoRoll = true,
	SetDeck = true,
	SetSkills = true,
	ClaimRank = true,
	ClaimAway = true,
	SaveSettings = true,
	TutorialGrant = true,
	BattleStart = true,
	BattleClaim = true,
	BattleStatus = true,
	RebirthPreview = true,
	RebirthConfirm = true,
	RebirthCancel = true,
	GetProfile = true,
}

local function isFinite(v)
	return type(v) == "number" and v == v
		and v ~= math.huge and v ~= -math.huge
end

-- Structural validation: depth, width, string length, NaN/Infinity.
local function checkValue(v, depth)
	if depth > Config.MAX_TABLE_DEPTH then
		return false, "params too deep"
	end
	local t = type(v)
	if t == "number" then
		if not isFinite(v) then
			return false, "non-finite number rejected"
		end
		return true, nil
	elseif t == "string" then
		if #v > Config.MAX_STRING_LEN then
			return false, "string too long"
		end
		return true, nil
	elseif t == "boolean" or t == "nil" then
		return true, nil
	elseif t == "table" then
		local n = 0
		for k, item in pairs(v) do
			n = n + 1
			if n > Config.MAX_TABLE_WIDTH then
				return false, "params too wide"
			end
			if type(k) == "string" and #k > Config.MAX_STRING_LEN then
				return false, "key too long"
			end
			local ok, err = checkValue(item, depth + 1)
			if not ok then
				return false, err
			end
		end
		return true, nil
	end
	return false, "bad param type: " .. t
end

function Remotes.validateRequest(req)
	if type(req) ~= "table" then
		return false, "request must be a table"
	end
	if type(req.requestId) ~= "string" or #req.requestId == 0
		or #req.requestId > Config.MAX_STRING_LEN then
		return false, "bad requestId"
	end
	if type(req.command) ~= "string" or not Remotes.COMMANDS[req.command] then
		return false, "unknown command"
	end
	local params = req.params
	if params == nil then
		params = {}
	end
	if type(params) ~= "table" then
		return false, "params must be a table"
	end
	local ok, err = checkValue(params, 0)
	if not ok then
		return false, err
	end
	-- Versioned command identity (v2, REQUIRED on every public mutation):
	-- the server-issued session epoch (see GetProfile.epoch) plus a
	-- client-monotonic sequence. Both or neither; absent identity is
	-- rejected for mutations below (dispatch gate). The requestId-only
	-- lane survives ONLY as the trusted internal/test lane (direct
	-- service calls); it is never a public route and carries weaker
	-- replay proof after cache eviction (documented in persistence.md).
	-- Canonical binding: a requestId ending in "-e<epoch>-<seq>" (the
	-- client durableId shape "<prefix>-e<epoch>-<seq>") MUST repeat the
	-- top-level epoch/seq exactly, else the request is tampered.
	local idem = nil
	if req.epoch ~= nil or req.seq ~= nil then
		if not Config.isSafeInteger(req.epoch, 0) then
			return false, "bad epoch"
		end
		if not Config.isSafeInteger(req.seq, 1) then
			return false, "bad seq"
		end
		idem = { epoch = req.epoch, seq = req.seq }
	end
	return true, nil, params, idem
end

-- Read-only commands stay identity-light (no grants, no writes).
Remotes.READ_ONLY = { GetProfile = true, BattleStatus = true }

-- Single canonical public-identity parser. Mutations require the v2
-- epoch+seq; an embedded "-e<epoch>-<seq>" requestId suffix must match the
-- top-level pair exactly (tampered prefix/ids rejected, never coerced).
function Remotes.checkIdentity(req, idem)
	if idem == nil then
		return false, "v2 identity required: epoch+seq"
	end
	local rid = req.requestId or ""
	local e, s = string.match(rid, "%-e(%d+)%-(%d+)$")
	if e ~= nil then
		if tonumber(e) ~= idem.epoch or tonumber(s) ~= idem.seq then
			return false, "request id/identity mismatch"
		end
	end
	return true, nil
end

-- Redacted read model for the client: confirmed state only, no collection
-- seeds, no durable-proof internals (recentOps/order, completedAttempts).
function Remotes.profileLite(profile, serverNow, pendingAwayRunXp)
	local run = profile.run
	local savedPurchase = profile.account.storePurchaseRecovery
	local storeRecovery = nil
	if savedPurchase ~= nil then
		storeRecovery = {
			requestId = savedPurchase.requestId,
			epoch = savedPurchase.epoch,
			seq = savedPurchase.seq,
			runId = savedPurchase.runId,
			status = savedPurchase.status,
		}
	end
	local collection = {}
	for id, count in pairs(run.collection) do
		collection[id] = count
	end
	local deck = {}
	for i = 1, #run.deck do
		deck[i] = run.deck[i]
	end
	local cardLevels = {}
	for id, lv in pairs(run.cardLevels) do
		cardLevels[id] = lv
	end
	local cardXp = {}
	for id, xp in pairs(run.cardXp or {}) do
		cardXp[id] = xp
	end
	local catalogue = {}
	for id in pairs(profile.account.catalogue) do
		catalogue[#catalogue + 1] = id
	end
	-- Retained identities (survive rebirth): Mythic + Legacy entitlements
	-- plus the one replaceable keepsake slot. Owned-this-run = collection;
	-- discovered-ever = catalogue. R2 renders owned/retained/catalogue
	-- distinctly from these three fields.
	local retainedMythic, retainedLegacy = {}, {}
	for id in pairs(profile.account.mythicEntitlements) do
		retainedMythic[#retainedMythic + 1] = id
	end
	for id in pairs(profile.account.legacyEntitlements) do
		retainedLegacy[#retainedLegacy + 1] = id
	end
	-- Canonical config echoes (source-derived, additive): exact odds table,
	-- default volumes, speed mapping, skill nodes (11) + rank ladder,
	-- chapter caps. R2 must render from these, never hardcode.
	local odds = {}
	for i = 1, #Config.ROLL_WEIGHTS_10000 do
		odds[i] = { rarity = Config.ROLL_WEIGHTS_10000[i].rarity,
			weight = Config.ROLL_WEIGHTS_10000[i].weight }
	end
	local skillNodeIds = {}
	for i = 1, #Config.SKILL_NODES do
		skillNodeIds[i] = Config.SKILL_NODES[i].id
	end
	local rankRows = {}
	for i = 1, #Config.RANKS do
		rankRows[i] = { id = Config.RANKS[i].id,
			points = Config.RANKS[i].points, minRun = Config.RANKS[i].minRun }
	end
	local chapterCaps = {}
	for i = 1, #Config.CHAPTER_CAPS do
		chapterCaps[i] = Config.CHAPTER_CAPS[i]
	end
	-- Allowed speeds copy the canonical ordered Config list (never a
	-- hand-duplicated mirror).
	local speedAllowed = {}
	for i = 1, #Config.SPEED_ORDER do
		speedAllowed[i] = Config.SPEED_ORDER[i]
	end
	local speedMult = {}
	for k, v in pairs(Config.SPEED_MULT) do
		speedMult[k] = v
	end
	return {
		epoch = (profile.session and profile.session.epoch) or 0,
		reqHighWater = run.reqHighWater or 0,
		runId = run.runId,
		runNumber = run.runNumber,
		revision = profile.revision,
		level = run.level,
		xp = run.xp,
		currency = run.currency,
		pityFails = run.pityFails,
		pityAt = Config.PITY_FAILS,
		cooldownReadyAt = run.cooldownReadyAt,
		cooldownSeconds = Config.ROLL_COOLDOWN_S,
		collection = collection,
		cardLevels = cardLevels,
		cardXp = cardXp,
		maxCardLevel = Config.MAX_CARD_LEVEL,
		chapterCaps = chapterCaps,
		catalogue = catalogue,
		retained = { mythic = retainedMythic, legacy = retainedLegacy,
			keepsakeId = profile.account.keepsakeId },
		deck = deck,
		deckMax = Config.DECK_MAX,
		autoRoll = run.autoRoll,
		encounters = run.encounters,
		bossClaimed = run.bossClaimed,
		pendingBattle = run.pendingBattle ~= nil,
		pendingReward = run.pendingReward ~= nil,
		pendingAwayRunXp = Config.isSafeInteger(pendingAwayRunXp, 0)
			and pendingAwayRunXp or 0,
		previewOpen = run.preview ~= nil,
		tutorialDone = profile.account.tutorialDone,
		keepsakeId = profile.account.keepsakeId,
		skillPoints = profile.account.skillPoints,
		skillAlloc = profile.account.skillAlloc,
		skillNodes = skillNodeIds,
		claimedRanks = profile.account.claimedRanks,
		ranks = rankRows,
		settings = profile.account.settings,
		defaultVolumes = Config.DEFAULT_VOLUMES,
		speeds = { allowed = speedAllowed, mult = speedMult },
		odds = odds,
		weightTotal = Config.ROLL_WEIGHT_TOTAL,
		storeOffer = {
			id = Config.EARNED_PACK_ID,
			name = "Field Pack",
			count = 1,
			cost = Config.EARNED_PACK_COST,
			currency = "Run Coins",
			currencySource = "server-issued battle rewards only",
			robuxAvailable = false,
			odds = odds,
			weightTotal = Config.ROLL_WEIGHT_TOTAL,
			pityFails = run.pityFails,
			pityAt = Config.PITY_FAILS,
		},
		storeRecovery = storeRecovery,
		versions = { schema = profile.schemaVersion,
			progression = profile.progressionVersion,
			rules = profile.rulesVersion, content = profile.contentVersion },
		serverNow = serverNow,
	}
end

-- deps: { store, clock, roll, battle, rebirth, skills, away, rate }.
function Remotes.new(deps)
	return {
		store = deps.store,
		clock = deps.clock or os.time,
		roll = deps.roll,
		battle = deps.battle,
		rebirth = deps.rebirth,
		skills = deps.skills, -- { setSkills(userId, requestId, alloc) }
		away = deps.away,
		rate = deps.rate or RateLimit.new(),
	}
end

-- Dispatch one validated request for a userId. Never throws: all service
-- outcomes (including Rejected/Unavailable/Pending/Stale) are data.
function Remotes.dispatch(router, userId, req)
	local now = router.clock()
	local ok, verr, params, idem = Remotes.validateRequest(req)
	if not ok then
		return { status = "Rejected", reason = verr, serverNow = now }
	end
	local allowed, retry = RateLimit.check(router.rate, userId,
		req.command, now)
	if not allowed then
		return { status = "Rejected", reason = "rate limited",
			retryAfterS = retry, serverNow = now }
	end
	local command = req.command
	-- Public economic gate (B-09): every mutation requires v2 identity.
	-- Rejected here means no durable work, no RNG, no economic delta.
	-- Read-only commands (GetProfile/BattleStatus) stay identity-light.
	if not Remotes.READ_ONLY[command] then
		local okId, idReason = Remotes.checkIdentity(req, idem)
		if not okId then
			return { status = "Rejected", reason = idReason,
				serverNow = now }
		end
	end
	local out
	if command == "RollOnce" then
		out = router.roll.rollOnce(router.roll, userId, req.requestId, idem)
	elseif command == "BuyEarnedPack" then
		if next(params) ~= nil then
			out = { status = "Rejected",
				reason = "earned pack accepts no client-supplied offer, cost, odds, or grant" }
		else
			out = router.roll.buyEarnedPack(router.roll, userId,
				req.requestId, idem)
		end
	elseif command == "SetAutoRoll" then
		if type(params.enabled) ~= "boolean" then
			out = { status = "Rejected", reason = "enabled must be boolean" }
		else
			out = router.roll.setAuto(router.roll, userId, req.requestId,
				params.enabled, idem)
		end
	elseif command == "SetDeck" then
		out = router.roll.setDeck(router.roll, userId, req.requestId,
			params.deck, idem)
	elseif command == "SetSkills" then
		out = router.skills.setSkills(router.skills, userId, req.requestId,
			params.alloc, idem)
	elseif command == "ClaimRank" then
		out = router.skills.claimRank(router.skills, userId, req.requestId, idem)
	elseif command == "ClaimAway" then
		if next(params) ~= nil then
			out = { status = "Rejected",
				reason = "away claim accepts no client-supplied timestamps or amounts" }
		elseif router.away == nil then
			out = { status = "Unavailable", reason = "away service unavailable" }
		else
			out = router.away.claim(router.away, userId, req.requestId, idem)
		end
	elseif command == "SaveSettings" then
		out = router.skills.saveSettings(router.skills, userId, req.requestId,
			params.settings, idem)
	elseif command == "TutorialGrant" then
		out = router.roll.tutorialGrant(router.roll, userId, req.requestId, idem)
	elseif command == "BattleStart" then
		local publicStart = router.battle.startFromRemote
		if type(publicStart) ~= "function" then
			out = { status = "Unavailable",
				reason = "server route authorization unavailable" }
		else
			out = publicStart(router.battle, userId, req.requestId,
				params.encounterId, idem)
		end
	elseif command == "BattleClaim" then
		out = router.battle.claim(router.battle, userId, req.requestId,
			params.attemptId, idem)
	elseif command == "BattleStatus" then
		out = router.battle.status(router.battle, userId)
	elseif command == "RebirthPreview" then
		out = router.rebirth.preview(router.rebirth, userId, req.requestId,
			params.keepsakeId, idem)
	elseif command == "RebirthConfirm" then
		out = router.rebirth.confirm(router.rebirth, userId, req.requestId,
			params.token, idem)
	elseif command == "RebirthCancel" then
		out = router.rebirth.cancel(router.rebirth, userId, req.requestId, idem)
	elseif command == "GetProfile" then
		local data, derr = router.store.read(router.store, userId)
		if not data then
			out = { status = "Unavailable", reason = derr or "no profile" }
		else
			local pendingAwayRunXp = 0
			local away = router.away
			if away ~= nil and type(away.lastSeenAt) == "table"
				and type(away.sessionStartedAt) == "table" then
				local lastSeenAt = away.lastSeenAt[userId]
				local sessionStartedAt = away.sessionStartedAt[userId]
				if Config.isSafeInteger(lastSeenAt, 0)
					and Config.isSafeInteger(sessionStartedAt, 0)
					and Config.isSafeInteger(now, 0) then
					local award = AwayProgress.calculate(lastSeenAt,
						math.min(now, sessionStartedAt),
						Config.AWAY_REWARD_RATES,
						Config.AWAY_CATCH_UP_CAP_S)
					if award ~= nil and not award.clockSkew then
						pendingAwayRunXp = award.runXp
					end
				end
			end
			out = { status = "Committed",
				result = Remotes.profileLite(data, now, pendingAwayRunXp) }
		end
	end
	out = out or { status = "Rejected", reason = "unhandled command" }
	out.serverNow = now
	return out
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">RobloxRequire</string>
          <string name="Source"><![CDATA[-- RobloxRequire.luau — tri-runtime module resolution for server files (P3).
-- Roblox (ModuleScripts under ServerScriptService.Server + shared folders
-- under ReplicatedStorage.Shared): script.Parent for siblings,
-- ReplicatedStorage.Shared.<Area> for shared. Lune: relative require
-- (relative to THIS file in src/server/). Plain Lua: game-root dofile.
-- Every server file loads this shim first, then everything else through it,
-- so exactly one place owns the native import route.

local RobloxRequire = {}

function RobloxRequire.sibling(name)
	if game ~= nil then
		return require(script.Parent:WaitForChild(name))
	elseif dofile ~= nil then
		return dofile("./src/server/" .. name .. ".luau")
	else
		return require("./" .. name)
	end
end

-- area: "Progression" | "Content" | "Combat" (exact Roblox folder names).
function RobloxRequire.shared(area, name)
	if game ~= nil then
		return require(game:GetService("ReplicatedStorage")
			:WaitForChild("Shared"):WaitForChild(area):WaitForChild(name))
	elseif dofile ~= nil then
		return dofile("./src/shared/" .. string.lower(area)
			.. "/" .. name .. ".luau")
	else
		return require("../shared/" .. string.lower(area) .. "/" .. name)
	end
end

return RobloxRequire
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">RollService</string>
          <string name="Source"><![CDATA[-- RollService.luau — server-owned free rolls (P3).
-- RNG is drawn OUTSIDE the persistence retry callback (frozen operation
-- inputs); the UpdateAsync transform is pure and retriable. Rolls commit
-- synchronously, then reveal: nothing is shown before durable commit, so a
-- displayed rare can never silently become nothing. Unissued auto-roll ticks
-- are server-scheduled with backpressure (never a client loop).

local R
if game ~= nil then
	R = require(script.Parent:WaitForChild("RobloxRequire"))
elseif dofile ~= nil then
	R = dofile("./src/server/RobloxRequire.luau")
else
	R = require("./RobloxRequire")
end

local Config = R.shared("Progression", "Config")
local Rolls = R.shared("Progression", "Rolls")
local Progression = R.shared("Progression", "Progression")

local StoreMod = R.sibling("Store")

local RollService = {}

-- deps: { store, clock, drawInt (fn(upper)->int 1..upper, server RNG),
--         editions (array of {id,rarity}), ownedDetails unused (counts only) }.
function RollService.new(deps)
	local self = {
		store = deps.store,
		clock = deps.clock or os.time,
		drawInt = deps.drawInt,
		editions = deps.editions or {},
	}
	setmetatable(self, { __index = RollService })
	return self
end

local function opIdentity(svc, userId, requestId, idem, command)
	return StoreMod.identity(svc.store, userId, requestId, svc.clock(), idem,
		command)
end

-- Attach the compare-and-commit revision to an admitted op.
local function withRevision(ident)
	ident.op.expectedRevision = ident.revision
	return ident.op
end

-- One canonical server-side award path for free rolls and earned packs.
-- Caller draws both random inputs before the storage transaction; this helper
-- applies the same odds, collection bounds, pity, catalogue and Mythic
-- entitlement rules regardless of how the player earned the roll.
local function applyCardRoll(svc, profile, rarityDraw, editionDraw)
	local rarity, rarityErr = Rolls.rarityFor(profile.run.pityFails,
		rarityDraw)
	if not rarity then
		return nil, rarityErr
	end
	local ownedSet = {}
	local distinct = 0
	for id in pairs(profile.run.collection) do
		ownedSet[id] = true
		distinct = distinct + 1
	end
	local editionId, editionErr = Rolls.pickEditionId(svc.editions, rarity,
		ownedSet, editionDraw, distinct < Config.DECK_MAX)
	if not editionId then
		return nil, editionErr
	end
	if profile.run.collection[editionId] ~= nil
		and profile.run.collection[editionId] >= Config.MAX_DUP_COUNT then
		return nil, "duplicate bound reached"
	end
	if profile.run.collection[editionId] == nil
		and distinct >= Config.MAX_COLLECTION_IDS then
		return nil, "collection bound reached"
	end
	local nextCollection, nextFails, nextCatalogue = Rolls.applyGrant(
		profile.run.collection, profile.run.pityFails, editionId, rarity,
		profile.account.catalogue)
	if not nextCollection then
		return nil, nextFails
	end
	profile.run.collection = nextCollection
	profile.run.pityFails = nextFails
	profile.account.catalogue = nextCatalogue
	if rarity == "Mythic" then
		profile.account.mythicEntitlements[editionId] = true
	end
	return { editionId = editionId, rarity = rarity,
		pityFails = nextFails }, nil
end

-- Single eligible roll. Returns Store status envelope.
function RollService.rollOnce(svc, userId, requestId, idem)
	if type(requestId) ~= "string" or #requestId == 0
		or #requestId > Config.MAX_STRING_LEN then
		return { status = "Rejected", reason = "bad requestId" }
	end
	local ident, err = opIdentity(svc, userId, requestId, idem)
	if idem == nil then
		-- Production service API admits versioned identity only: the
		-- unversioned lane is trusted-internal/test readback, never a
		-- public mutation route (B-09). No legacy fresh grants here.
		return { status = "Rejected",
			reason = "v2 identity required: epoch+seq" }
	end
	if not ident then
		return { status = "Unavailable", reason = err }
	end
	-- Cheap admission validation BEFORE spending server RNG: frozen table
	-- and active cooldown reject without consuming randomness. The tx
	-- rechecks authoritatively (revision compare + committed state).
	do
		local peek = svc.store.read(svc.store, userId)
		-- A retained receipt short-circuits: the tx reconciles the duplicate
		-- (cheap checks must never shadow AlreadyCommitted).
		local known = peek and peek.run.recentOps
			and peek.run.recentOps[ident.op.opId] ~= nil
		-- A v2 sequence at/below the durable high-water is proven done even
		-- after receipt eviction: let the tx reconcile, not the peek.
		local v2known = peek and ident.op.epoch ~= nil and ident.op.seq
			~= nil and ident.op.seq <= (peek.run.reqHighWater or 0)
		-- A legacy opSeq at/below the prune high-water is proven done: let
		-- the tx reconcile, not the peek.
		local legacyKnown = peek and ident.op.epoch == nil
			and ident.op.opSeq <= (peek.run.pruneMark or 0)
		if peek and not known and not v2known and not legacyKnown then
			if StoreMod.frozen(peek) then
				return { status = "Rejected",
					reason = "economy frozen: rebirth preview open" }
			end
			if ident.now < (peek.run.cooldownReadyAt or 0) then
				return { status = "Rejected", reason = "cooldown active" }
			end
		end
	end
	-- Frozen inputs drawn AFTER admission, BEFORE any commit attempt
	-- (never inside the retry callback).
	local roll10000 = svc.drawInt(Config.ROLL_WEIGHT_TOTAL)
	local pickInt = svc.drawInt(1000000)
	local store = svc.store
	local function apply(current)
		if StoreMod.frozen(current) then
			return nil, nil, "economy frozen: rebirth preview open"
		end
		if ident.epoch ~= (current.session and current.session.epoch or 0)
			or ident.runId ~= current.run.runId then
			return nil, nil, "state moved under request: refetch"
		end
		if ident.now < (current.run.cooldownReadyAt or 0) then
			return nil, nil, "cooldown active"
		end
		local grant, grantErr = applyCardRoll(svc, current, roll10000, pickInt)
		if not grant then
			return nil, nil, grantErr
		end
		current.run.cooldownReadyAt = ident.now + Config.ROLL_COOLDOWN_S
		grant.cooldownReadyAt = current.run.cooldownReadyAt
		return current, grant, nil
	end
	return store.runOp(store, userId,
		withRevision(ident), apply)
end

local function earnedPackBlockReason(profile)
	if profile.run.pendingBattle ~= nil or profile.run.pendingReward ~= nil then
		return "store unavailable while a battle or reward is pending"
	end
	if profile.run.currency < Config.EARNED_PACK_COST then
		return "insufficient earned currency: need "
			.. tostring(Config.EARNED_PACK_COST) .. " Run Coins"
	end
	return nil
end

-- Spend only server-earned run currency on one server-selected card. The
-- exact cost, rarity table, and shared pity come from Config; callers cannot
-- choose an offer, amount, rarity, card, or outcome. RNG is frozen before the
-- transaction so an ambiguous retry with the same v2 identity cannot reroll.
function RollService.buyEarnedPack(svc, userId, requestId, idem)
	if type(requestId) ~= "string" or #requestId == 0
		or #requestId > Config.MAX_STRING_LEN then
		return { status = "Rejected", reason = "bad requestId" }
	end
	local ident, err = opIdentity(svc, userId, requestId, idem,
		"BuyEarnedPack")
	if idem == nil then
		return { status = "Rejected",
			reason = "v2 identity required: epoch+seq" }
	end
	if not ident then
		return { status = "Unavailable", reason = err }
	end
	local store = svc.store
	local peek = store.read(store, userId)
	if not peek then
		return { status = "Unavailable", reason = "no profile" }
	end
	local known = peek.run.recentOps
		and peek.run.recentOps[ident.op.opId] ~= nil
	local v2known = ident.op.seq <= (peek.run.reqHighWater or 0)
	local recovery = StoreMod.matchingStorePurchase(peek, ident.op)
	if known or (v2known
		and not (recovery ~= nil and recovery.status == "pending")) then
		-- Store reconciles the existing receipt/high-water without invoking an
		-- apply callback. A retry never spends RNG or a second pack cost.
		return store.runOp(store, userId, withRevision(ident), function()
			return nil, nil, "duplicate purchase reconciliation"
		end)
	end
	local reservation = store.prepareStorePurchase(store, userId,
		withRevision(ident), function(current)
		if StoreMod.frozen(current) then
			return false, "economy frozen: rebirth preview open"
		end
		local blocked = earnedPackBlockReason(current)
		if blocked then
			return false, blocked
		end
		return true, nil
	end)
	if reservation.status ~= "Committed" then
		return reservation
	end
	ident.revision = reservation.revision
	local rarityDraw = svc.drawInt(Config.ROLL_WEIGHT_TOTAL)
	local editionDraw = svc.drawInt(1000000)
	local function apply(current)
		if StoreMod.frozen(current) then
			return nil, nil, "economy frozen: rebirth preview open"
		end
		if ident.epoch ~= (current.session and current.session.epoch or 0)
			or ident.runId ~= current.run.runId then
			return nil, nil, "state moved under request: refetch"
		end
		local blocked = earnedPackBlockReason(current)
		if blocked then
			return nil, nil, blocked
		end
		local grant, grantErr = applyCardRoll(svc, current,
			rarityDraw, editionDraw)
		if not grant then
			return nil, nil, grantErr
		end
		current.run.currency = current.run.currency - Config.EARNED_PACK_COST
		grant.offerId = Config.EARNED_PACK_ID
		grant.cost = Config.EARNED_PACK_COST
		grant.balance = current.run.currency
		grant.pityAt = Config.PITY_FAILS
		return current, grant, nil
	end
	return store.runOp(store, userId, withRevision(ident), apply)
end

-- Server-scheduled auto-roll tick: at most one due roll per call, only when
-- the table is quiet (no preview, no pending battle, cooldown due).
-- Backpressure: returns { status="Skipped", reason } instead of queueing.
function RollService.tickAuto(svc, userId, requestId)
	local data = svc.store.read(svc.store, userId)
	if not data then
		return { status = "Unavailable", reason = "no profile" }
	end
	if not data.run.autoRoll then
		return { status = "Skipped", reason = "auto-roll off" }
	end
	if data.run.preview ~= nil then
		return { status = "Skipped", reason = "preview open: frozen" }
	end
	if data.run.pendingBattle ~= nil then
		return { status = "Skipped", reason = "battle pending" }
	end
	if svc.clock() < (data.run.cooldownReadyAt or 0) then
		return { status = "Skipped", reason = "cooldown" }
	end
	-- Server-minted monotonic identity: current session epoch + next durable
	-- sequence. Safe under the per-user serialization gate + fencing.
	local epoch = (data.session and data.session.epoch) or 0
	local seq = (data.run.reqHighWater or 0) + 1
	return RollService.rollOnce(svc, userId,
		"auto-" .. epoch .. "-" .. seq, { epoch = epoch, seq = seq })
end

function RollService.setAuto(svc, userId, requestId, enabled, idem)
	if type(requestId) ~= "string" or #requestId == 0
		or #requestId > Config.MAX_STRING_LEN then
		return { status = "Rejected", reason = "bad requestId" }
	end
	if type(enabled) ~= "boolean" then
		return { status = "Rejected", reason = "enabled must be boolean" }
	end
	local ident, err = opIdentity(svc, userId, requestId, idem)
	if idem == nil then
		-- Production service API admits versioned identity only: the
		-- unversioned lane is trusted-internal/test readback, never a
		-- public mutation route (B-09). No legacy fresh grants here.
		return { status = "Rejected",
			reason = "v2 identity required: epoch+seq" }
	end
	if not ident then
		return { status = "Unavailable", reason = err }
	end
	local store = svc.store
	local function apply(current)
		if StoreMod.frozen(current) then
			return nil, nil, "economy frozen: rebirth preview open"
		end
		current.run.autoRoll = enabled
		return current, { autoRoll = enabled }, nil
	end
	return store.runOp(store, userId,
		withRevision(ident), apply)
end

-- Deterministic tutorial grant: fixed starters, once per profile, labeled.
function RollService.tutorialGrant(svc, userId, requestId, idem)
	if type(requestId) ~= "string" or #requestId == 0
		or #requestId > Config.MAX_STRING_LEN then
		return { status = "Rejected", reason = "bad requestId" }
	end
	local ident, err = opIdentity(svc, userId, requestId, idem)
	if idem == nil then
		-- Production service API admits versioned identity only: the
		-- unversioned lane is trusted-internal/test readback, never a
		-- public mutation route (B-09). No legacy fresh grants here.
		return { status = "Rejected",
			reason = "v2 identity required: epoch+seq" }
	end
	if not ident then
		return { status = "Unavailable", reason = err }
	end
	local store = svc.store
	local function apply(current)
		if StoreMod.frozen(current) then
			return nil, nil, "economy frozen: rebirth preview open"
		end
		if current.account.tutorialDone then
			return nil, nil, "tutorial already granted"
		end
		for i = 1, #Config.STARTER_IDS do
			local id = Config.STARTER_IDS[i]
			current.run.collection[id] = (current.run.collection[id] or 0) + 1
			current.account.catalogue[id] = true
			current.run.cardLevels[id] = 1
		end
		current.account.tutorialDone = true
		return current, { granted = Config.STARTER_IDS,
			label = Config.TUTORIAL_LABEL }, nil
	end
	return store.runOp(store, userId,
		withRevision(ident), apply)
end

function RollService.setDeck(svc, userId, requestId, deckIds, idem)
	if type(requestId) ~= "string" or #requestId == 0
		or #requestId > Config.MAX_STRING_LEN then
		return { status = "Rejected", reason = "bad requestId" }
	end
	local ident, err = opIdentity(svc, userId, requestId, idem)
	if idem == nil then
		-- Production service API admits versioned identity only: the
		-- unversioned lane is trusted-internal/test readback, never a
		-- public mutation route (B-09). No legacy fresh grants here.
		return { status = "Rejected",
			reason = "v2 identity required: epoch+seq" }
	end
	if not ident then
		return { status = "Unavailable", reason = err }
	end
	local store = svc.store
	local function apply(current)
		if StoreMod.frozen(current) then
			return nil, nil, "economy frozen: rebirth preview open"
		end
		if current.run.pendingBattle ~= nil then
			return nil, nil, "deck locked during pending battle"
		end
		local ok, derr = Progression.checkDeck(deckIds, current.run.collection)
		if not ok then
			return nil, nil, derr
		end
		local copy = {}
		for i = 1, #deckIds do
			copy[i] = deckIds[i]
		end
		current.run.deck = copy
		return current, { deck = copy }, nil
	end
	return store.runOp(store, userId,
		withRevision(ident), apply)
end

return RollService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">SkillService</string>
          <string name="Source"><![CDATA[-- SkillService.luau — finite skills, ranks, settings (P3, server).
-- Skill points come ONLY from first-clear rank claims (max 24). Repeating a
-- claimed rank, discarding cards, or resetting runs grants zero points.
-- Settings (theme/accent/reduced-motion/flashes/speed) persist per account.

local R
if game ~= nil then
	R = require(script.Parent:WaitForChild("RobloxRequire"))
elseif dofile ~= nil then
	R = dofile("./src/server/RobloxRequire.luau")
else
	R = require("./RobloxRequire")
end

local Config = R.shared("Progression", "Config")
local Progression = R.shared("Progression", "Progression")

local StoreMod = R.sibling("Store")

local SkillService = {}

function SkillService.new(deps)
	local self = { store = deps.store, clock = deps.clock or os.time }
	setmetatable(self, { __index = SkillService })
	return self
end

local function opIdentity(svc, userId, requestId, idem)
	return StoreMod.identity(svc.store, userId, requestId, svc.clock(), idem)
end

-- Attach the compare-and-commit revision to an admitted op.
local function withRevision(ident)
	ident.op.expectedRevision = ident.revision
	return ident.op
end

-- Next claimable rank: ordered ladder, rank-N unlocks only in runNumber
-- >= N with that run's committed boss milestone — at most one rank per
-- eligible run, so one boss can never mint all 24 points.
function SkillService.nextRank(claimedRanks, runNumber, bossClaimed)
	if not bossClaimed then
		return nil
	end
	for i = 1, #Config.RANKS do
		local rank = Config.RANKS[i]
		if not claimedRanks[rank.id] then
			if (runNumber or 0) >= (rank.minRun or i) then
				return rank
			end
			return nil
		end
	end
	return nil
end

-- Claim the next rank: requires the committed boss milestone this run.
function SkillService.claimRank(svc, userId, requestId, idem)
	if type(requestId) ~= "string" or #requestId == 0
		or #requestId > Config.MAX_STRING_LEN then
		return { status = "Rejected", reason = "bad requestId" }
	end
	local ident, err = opIdentity(svc, userId, requestId, idem)
	if idem == nil then
		-- Production service API admits versioned identity only: the
		-- unversioned lane is trusted-internal/test readback, never a
		-- public mutation route (B-09). No legacy fresh grants here.
		return { status = "Rejected",
			reason = "v2 identity required: epoch+seq" }
	end
	if not ident then
		return { status = "Unavailable", reason = err }
	end
	local store = svc.store
	local function apply(current)
		if StoreMod.frozen(current) then
			return nil, nil, "economy frozen: rebirth preview open"
		end
		local next = SkillService.nextRank(current.account.claimedRanks,
			current.run.runNumber, current.run.bossClaimed)
		if not next then
			return nil, nil, "no rank eligible (need boss milestone, next rung, unclaimed)"
		end
		current.account.claimedRanks[next.id] = true
		current.account.skillPoints = current.account.skillPoints + next.points
		if current.account.skillPoints > Config.MASTERY_MAX_POINTS then
			return nil, nil, "skill point cap exceeded"
		end
		return current, { rankId = next.id, points = next.points,
			total = current.account.skillPoints }, nil
	end
	return store.runOp(store, userId,
		withRevision(ident), apply)
end

-- Allocate earned points across the finite tree (free respec: full replace).
function SkillService.setSkills(svc, userId, requestId, alloc, idem)
	if type(requestId) ~= "string" or #requestId == 0
		or #requestId > Config.MAX_STRING_LEN then
		return { status = "Rejected", reason = "bad requestId" }
	end
	local ident, err = opIdentity(svc, userId, requestId, idem)
	if idem == nil then
		-- Production service API admits versioned identity only: the
		-- unversioned lane is trusted-internal/test readback, never a
		-- public mutation route (B-09). No legacy fresh grants here.
		return { status = "Rejected",
			reason = "v2 identity required: epoch+seq" }
	end
	if not ident then
		return { status = "Unavailable", reason = err }
	end
	local store = svc.store
	local function apply(current)
		if StoreMod.frozen(current) then
			return nil, nil, "economy frozen: rebirth preview open"
		end
		local ok, cerr = Progression.checkSkills(alloc or {},
			current.account.skillPoints)
		if not ok then
			return nil, nil, cerr
		end
		local copy = {}
		for k, v in pairs(alloc or {}) do
			copy[k] = v
		end
		current.account.skillAlloc = copy
		return current, { alloc = copy }, nil
	end
	return store.runOp(store, userId,
		withRevision(ident), apply)
end

function SkillService.saveSettings(svc, userId, requestId, settings, idem)
	if type(requestId) ~= "string" or #requestId == 0
		or #requestId > Config.MAX_STRING_LEN then
		return { status = "Rejected", reason = "bad requestId" }
	end
	local ident, err = opIdentity(svc, userId, requestId, idem)
	if idem == nil then
		-- Production service API admits versioned identity only: the
		-- unversioned lane is trusted-internal/test readback, never a
		-- public mutation route (B-09). No legacy fresh grants here.
		return { status = "Rejected",
			reason = "v2 identity required: epoch+seq" }
	end
	if not ident then
		return { status = "Unavailable", reason = err }
	end
	local store = svc.store
	local function apply(current)
		local ok, cerr, clean = Progression.checkSettings(settings or {})
		if not ok then
			return nil, nil, cerr
		end
		current.account.settings = clean
		return current, { settings = clean }, nil
	end
	return store.runOp(store, userId,
		withRevision(ident), apply)
end

return SkillService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">Store</string>
          <string name="Source"><![CDATA[-- Store.luau — ProfileStore: fencing + serialized durable ops (P3, server).
-- One server-side queue per player (services call runOp; concurrent calls for
-- the same user are serialized by the service layer holding one Store per
-- server process). Session fencing is DURABLE: a lease + monotonic epoch
-- stored in the document. Every commit verifies owner/epoch + revision; a
-- stale server aborts instead of overwriting the new owner. After an
-- ambiguous commit the SAME opId reconciles (Committed/AlreadyCommitted)
-- instead of issuing a new grant. No outcome is acknowledged until durable
-- commit. A failed load NEVER yields a writable default.

local R
if game ~= nil then
	R = require(script.Parent:WaitForChild("RobloxRequire"))
elseif dofile ~= nil then
	R = dofile("./src/server/RobloxRequire.luau")
else
	R = require("./RobloxRequire")
end

local Config = R.shared("Progression", "Config")
local Profile = R.shared("Progression", "Profile")

local Store = {}

-- deps: { adapter, serverId, clock, knownIds } — clock() returns unix
-- seconds; knownIds (optional id->true set from the content roster) lets
-- stored-profile validation reject forged content identities fail-closed.
function Store.new(deps)
	local self = {
		adapter = deps.adapter,
		serverId = deps.serverId or ("srv-" .. tostring({}):sub(8)),
		clock = deps.clock or os.time,
		knownIds = deps.knownIds,
		sessions = {}, -- userId -> { epoch } live owners this process holds
	}
	setmetatable(self, { __index = Store })
	return self
end

function Store.keyFor(userId)
	return "profile:" .. tostring(userId)
end

-- Load WITHOUT creating: returns data|nil, err, exists.
-- err ~= nil means "unknown" — the caller must NOT treat nil as new player.
function Store.loadExisting(store, userId)
	local data, err = store.adapter.load(store.adapter, Store.keyFor(userId))
	if err ~= nil then
		return nil, err, false
	end
	if data == nil then
		return nil, nil, false
	end
	-- Fail closed: a stored document that no longer validates (bad shapes,
	-- non-finite numbers, unknown skill/content ids, unowned deck) is
	-- reported as an error and NEVER silently replaced with a fresh default.
	local ok, verr = Profile.validate(data, store.knownIds)
	if not ok then
		return nil, "stored profile invalid: " .. verr, false
	end
	return data, nil, true
end

-- Acquire (or re-acquire) session fencing for this server via UpdateAsync.
-- Pure callback: precomputes nothing random; only epoch/owner/lease fields.
function Store.acquire(store, userId)
	local now = store.clock()
	local epochSeen = nil
	local function fence(current)
		if current == nil then
			return nil, "no profile: create first"
		end
		local sess = current.session or { epoch = 0, owner = nil, leaseUntil = 0 }
		if sess.owner ~= nil and sess.owner ~= store.serverId
			and (sess.leaseUntil or 0) > now then
			return nil, "session owned by another live server"
		end
		epochSeen = (sess.epoch or 0) + 1
		local next = Profile.deepCopy(current)
		next.session = { epoch = epochSeen, owner = store.serverId,
			leaseUntil = now + Config.SESSION_LEASE_S }
		next.revision = current.revision + 1
		next.updatedAt = now
		return next, nil
	end
	local committed, wasCommitted, err = store.adapter.update(
		store.adapter, Store.keyFor(userId), fence)
	if not wasCommitted then
		return nil, err or "acquire failed"
	end
	store.sessions[userId] = { epoch = committed.session.epoch }
	return committed, nil
end

function Store.owns(store, userId, doc)
	local live = store.sessions[userId]
	if not live then
		return false
	end
	return doc.session ~= nil and doc.session.epoch == live.epoch
		and doc.session.owner == store.serverId
end

-- Admission map (TRUSTED INTERNAL/TEST LANE ONLY — the public remote
-- route always carries v2 epoch+seq and never reaches this fallback).
-- The SAME requestId in the SAME session (epoch+run) always maps to the
-- SAME opSeq. Retries after cache prune therefore still trip the
-- pruneMark high-water (AlreadyCommitted) instead of double-granting.
-- Bounded (200 entries); eviction only loses prune-precision for ancient ops
-- whose clients are long gone (documented in docs/persistence.md).
function Store.admit(store, userId, requestId, committedOpSeq, epoch, runId)
	local sess = store.sessions[userId]
	if not sess then
		sess = {}
		store.sessions[userId] = sess
	end
	sess.admitted = sess.admitted or {}
	sess.admitOrder = sess.admitOrder or {}
	sess.nextSeq = sess.nextSeq or (committedOpSeq or 0) + 1
	if (committedOpSeq or 0) + 1 > sess.nextSeq then
		sess.nextSeq = (committedOpSeq or 0) + 1
	end
	local scope = epoch .. ":" .. runId .. ":" .. requestId
	local hit = sess.admitted[scope]
	if hit then
		return hit.opId, hit.opSeq
	end
	local opSeq = sess.nextSeq
	sess.nextSeq = sess.nextSeq + 1
	local opId = scope
	sess.admitted[scope] = { opId = opId, opSeq = opSeq }
	sess.admitOrder[#sess.admitOrder + 1] = scope
	while #sess.admitOrder > 200 do
		local evicted = table.remove(sess.admitOrder, 1)
		sess.admitted[evicted] = nil
	end
	return opId, opSeq
end

-- Create a new profile ONLY when the key is confirmed absent. A load error
-- returns Unavailable and never a fresh default.
function Store.create(store, userId, starterFn)
	local now = store.clock()
	local existing, err, exists = Store.loadExisting(store, userId)
	if err ~= nil then
		return nil, "Unavailable: load failed, refusing default-over-data"
	end
	if exists then
		return nil, "already exists"
	end
	local profile = Profile.new(userId, now)
	if starterFn then
		profile = starterFn(profile) or profile
	end
	profile.session = { epoch = 1, owner = store.serverId,
		leaseUntil = now + Config.SESSION_LEASE_S }
	local ok, verr = Profile.validate(profile, store.knownIds)
	if not ok then
		return nil, "fresh profile invalid: " .. verr
	end
	local function seed(current)
		if current ~= nil then
			return nil, "raced creation: key appeared"
		end
		return Profile.deepCopy(profile), nil
	end
	local committed, wasCommitted, uerr = store.adapter.update(
		store.adapter, Store.keyFor(userId), seed)
	if not wasCommitted then
		return nil, uerr or "create failed"
	end
	store.sessions[userId] = { epoch = committed.session.epoch }
	return committed, nil
end

-- Central economic freeze: while a rebirth preview is open, no economic
-- mutation may commit (rolls, battles, deck, skills, ranks). Cancel/confirm
-- and read-only reconciliations are the only paths through.
function Store.frozen(current)
	return current.run ~= nil and current.run.preview ~= nil
end

-- Real per-user serialization gate: only one economic op per player computes
-- against committed state at a time. A contending caller gets bounded
-- backpressure ("busy: retry") and retries with the SAME identity, which is
-- idempotent-safe. Cross-server races are caught by the revision compare.
function Store.serialized(store, userId, fn)
	store.locks = store.locks or {}
	if store.locks[userId] then
		return { status = "Rejected", reason = "busy: retry same identity" }
	end
	store.locks[userId] = true
	local res = fn()
	store.locks[userId] = nil
	return res
end

-- A Store request keeps its original identity across a client restart. The
-- durable account record is the only recovery authority; a client may replay
-- it, but cannot invent or replace its id, epoch, sequence, or run binding.
function Store.matchingStorePurchase(profile, op)
	local saved = profile.account.storePurchaseRecovery
	if saved == nil or op.kind ~= "BuyEarnedPack" then
		return nil
	end
	if saved.requestId == op.requestId and saved.epoch == op.epoch
		and saved.seq == op.seq and saved.runId == op.runId
		and op.opId == saved.epoch .. ":" .. saved.runId .. ":"
			.. saved.seq .. ":" .. saved.requestId then
		return saved
	end
	return nil
end

-- Reserve the exact Store identity durably before drawing or charging. If the
-- acknowledgement is lost, GetProfile exposes this marker and the returning
-- client retries the same identity. No other mutation may pass the pending
-- marker until that one purchase is resolved.
function Store.prepareStorePurchase(store, userId, op, canPrepare)
	if type(op) ~= "table" or op.kind ~= "BuyEarnedPack"
		or type(op.requestId) ~= "string"
		or not Config.isSafeInteger(op.epoch, 0)
		or not Config.isSafeInteger(op.seq, 1)
		or not Config.isSafeInteger(op.runId, 1) then
		return { status = "Rejected", reason = "bad Store purchase identity" }
	end
	return Store.serialized(store, userId, function()
		local now = store.clock()
		local outcome = nil
		local function tx(current)
			if current == nil then
				outcome = { status = "Unavailable", reason = "no profile" }
				return nil, "no profile"
			end
			if not Store.owns(store, userId, current) then
				outcome = { status = "Stale",
					reason = "session not owned by this server" }
				return nil, "Stale: session not owned by this server"
			end
			local saved = current.account.storePurchaseRecovery
			if Store.matchingStorePurchase(current, op) then
				outcome = { status = saved.status == "committed"
					and "AlreadyCommitted" or "Committed",
					result = Profile.deepCopy(saved.result),
					revision = current.revision }
				return nil, "Store identity already prepared"
			end
			if saved ~= nil and saved.status == "pending" then
				outcome = { status = "Rejected",
					reason = "pending Store purchase recovery required" }
				return nil, "pending Store recovery"
			end
			if op.epoch ~= (current.session and current.session.epoch or 0)
				or op.runId ~= current.run.runId then
				outcome = { status = "Stale",
					reason = "session moved before Store reservation" }
				return nil, "Stale: Store reservation session moved"
			end
			if op.seq <= (current.run.reqHighWater or 0) then
				outcome = { status = "AlreadyCommitted", result = nil,
					revision = current.revision }
				return nil, "AlreadyCommitted: sequence high-water"
			end
			if op.expectedRevision ~= nil
				and current.revision ~= op.expectedRevision then
				outcome = { status = "Rejected",
					reason = "revision conflict: refetch" }
				return nil, "Rejected: revision conflict"
			end
			local ok, reason = canPrepare(current)
			if not ok then
				outcome = { status = "Rejected", reason = reason or "rejected" }
				return nil, "Rejected: " .. (reason or "rejected")
			end
			local next = Profile.deepCopy(current)
			next.account.storePurchaseRecovery = {
				requestId = op.requestId,
				epoch = op.epoch,
				seq = op.seq,
				runId = op.runId,
				status = "pending",
			}
			next.run.reqHighWater = op.seq
			next.revision = current.revision + 1
			next.updatedAt = now
			local valid, err = Profile.validate(next, store.knownIds)
			if not valid then
				outcome = { status = "Rejected",
					reason = "reservation invalid: " .. err }
				return nil, "Rejected: reservation invalid"
			end
			outcome = { status = "Committed", wrote = true,
				recovery = Profile.deepCopy(next.account.storePurchaseRecovery),
				revision = next.revision }
			return next, nil
		end
		local committed, wasCommitted, err = store.adapter.update(
			store.adapter, Store.keyFor(userId), tx)
		if not wasCommitted then
			if outcome ~= nil and outcome.wrote then
				if err and (string.find(err, "ambiguous", 1, true)
					or string.find(err, "after callback", 1, true)) then
					return { status = "Pending", reason = err,
						hint = "retry the SAME Store identity" }
				end
				return { status = "Unavailable", reason = err or "reservation unproven" }
			end
			return outcome or { status = "Unavailable",
				reason = err or "reservation failed" }
		end
		if outcome ~= nil then
			outcome.wrote = nil
			return outcome
		end
		return { status = "Committed", recovery = Profile.deepCopy(committed.account.storePurchaseRecovery),
			revision = committed.revision }
	end)
end

-- Lease renewal: live owner extends; expired lease with no takeover is
-- re-acquired by the legitimate holder (idle recovery); a live foreign
-- owner rejects. Old servers can never write (owner check in tx).
function Store.renew(store, userId)
	local now = store.clock()
	local function tx(current)
		if current == nil then
			return nil, "no profile"
		end
		local sess = current.session or {}
		if sess.owner == store.serverId then
			local next = Profile.deepCopy(current)
			next.session.leaseUntil = now + Config.SESSION_LEASE_S
			next.revision = current.revision + 1
			next.updatedAt = now
			return next, nil
		end
		if (sess.leaseUntil or 0) <= now then
			local next = Profile.deepCopy(current)
			next.session = { epoch = (sess.epoch or 0) + 1,
				owner = store.serverId,
				leaseUntil = now + Config.SESSION_LEASE_S }
			next.revision = current.revision + 1
			next.updatedAt = now
			return next, nil
		end
		return nil, "lease held by a live server"
	end
	local committed, wasCommitted, err = store.adapter.update(
		store.adapter, Store.keyFor(userId), tx)
	if not wasCommitted then
		return nil, err or "renew failed"
	end
	store.sessions[userId] = store.sessions[userId] or {}
	store.sessions[userId].epoch = committed.session.epoch
	return committed, nil
end

-- Release ownership on disconnect (best-effort; fencing still guards races).
function Store.release(store, userId)
	local now = store.clock()
	local function tx(current)
		if current == nil then
			return nil, "no profile"
		end
		if current.session == nil or current.session.owner ~= store.serverId then
			return nil, "not owner"
		end
		local next = Profile.deepCopy(current)
		next.session.owner = nil
		next.session.leaseUntil = 0
		next.revision = current.revision + 1
		next.updatedAt = now
		return next, nil
	end
	local committed, wasCommitted, err = store.adapter.update(
		store.adapter, Store.keyFor(userId), tx)
	if not wasCommitted then
		return nil, err or "release failed"
	end
	store.sessions[userId] = nil
	return committed, nil
end

-- The single serialized economic gate. op = { opId, opSeq, kind }.
-- apply(profile) -> newProfile|nil, result|nil, abortReason — must be PURE.
-- Returns status + payload; only Committed/AlreadyCommitted carry durable
-- outcomes. Ambiguous adapter errors surface as Pending (reconcile same op).
-- DOCUMENTED INTERNAL: raw runOp fixtures (durability atomic-op tests) may
-- use it directly; production service calls always arrive with versioned
-- identity (services reject unversioned mutations before reaching here).
function Store.runOp(store, userId, op, apply)
	if type(op) ~= "table" or type(op.opId) ~= "string"
		or type(op.opSeq) ~= "number" then
		return { status = "Rejected", reason = "bad op identity" }
	end
	if (op.epoch ~= nil or op.seq ~= nil)
		and (not Config.isSafeInteger(op.epoch, 0)
			or not Config.isSafeInteger(op.seq, 1)) then
		return { status = "Rejected", reason = "bad v2 op identity" }
	end
	return Store.serialized(store, userId, function()
		return Store.runOpInner(store, userId, op, apply)
	end)
end

function Store.runOpInner(store, userId, op, apply)
	local now = store.clock()
	local outcome = nil
	local function tx(current)
		if current == nil then
			return nil, "no profile"
		end
		if not Store.owns(store, userId, current) then
			return nil, "Stale: session not owned by this server"
		end
		-- Lease liveness: every proven commit renews the lease inline, so an
		-- idle-but-legitimate owner recovers by touching state; a server that
		-- lost ownership (owner mismatch above) can never write.
		-- Same-operation reconciliation: an op already proven durable (high
		-- pruneMark OR retained receipt) never re-applies.
		local storeRecovery = Store.matchingStorePurchase(current, op)
		if storeRecovery ~= nil and storeRecovery.status == "committed" then
			outcome = { status = "AlreadyCommitted",
				result = Profile.deepCopy(storeRecovery.result) }
			return nil, "AlreadyCommitted: durable Store recovery"
		end
		if type(current.run.recentOps) == "table"
			and current.run.recentOps[op.opId] ~= nil then
			outcome = { status = "AlreadyCommitted",
				result = Profile.deepCopy(current.run.recentOps[op.opId]) }
			return nil, "AlreadyCommitted"
		end
		local pendingStoreRecovery = current.account.storePurchaseRecovery
		local matchingPendingStore = storeRecovery ~= nil
			and storeRecovery.status == "pending"
		if pendingStoreRecovery ~= nil
			and pendingStoreRecovery.status == "pending"
			and not matchingPendingStore then
			outcome = { status = "Rejected",
				reason = "pending Store purchase recovery required" }
			return nil, "Rejected: pending Store recovery"
		end
		if op.epoch == nil and op.opSeq <= (current.run.pruneMark or 0) then
			outcome = { status = "AlreadyCommitted", result = nil,
				note = "pruned durable proof" }
			return nil, "AlreadyCommitted"
		end
		-- Versioned command identity (durable, bounded: two ints): ops from
		-- an older session epoch are rejected (resync + reconcile via
		-- BattleStatus, never blind retry); seq at/below the durable
		-- high-water reconciles as already-committed even after the bounded
		-- receipt cache evicted it. No unbounded UUID history is stored.
		if op.epoch ~= nil then
			local curEpoch = (current.session and current.session.epoch) or 0
			if op.epoch < curEpoch and not matchingPendingStore then
				outcome = { status = "Rejected",
					reason = "stale epoch: resync and reconcile" }
				return nil, "Rejected:stale-epoch"
			end
			if op.epoch > curEpoch then
				outcome = { status = "Rejected", reason = "unknown epoch" }
				return nil, "Rejected:unknown-epoch"
			end
			if op.seq <= (current.run.reqHighWater or 0)
				and not matchingPendingStore then
				outcome = { status = "AlreadyCommitted", result = nil,
					note = "durable sequence high-water" }
				return nil, "AlreadyCommitted"
			end
		end
		-- Revision compare on EVERY economic op: concurrent writers that
		-- slipped the gate must refetch, never overwrite newer state.
		if op.expectedRevision ~= nil
			and current.revision ~= op.expectedRevision then
			outcome = { status = "Rejected",
				reason = "revision conflict: refetch" }
			return nil, "Rejected:revision-conflict"
		end
		local next, result, applyErr = apply(Profile.deepCopy(current))
		if next == nil then
			outcome = { status = "Rejected", reason = applyErr or "rejected" }
			return nil, "Rejected:" .. (applyErr or "rejected")
		end
		-- Stage the commit counters BEFORE validation so the gate checks
		-- the exact bytes that will be stored (a preview binds the
		-- post-commit revision; validating pre-increment bytes would
		-- falsely read it as "from the future").
		next.revision = current.revision + 1
		next.updatedAt = now
		if matchingPendingStore then
			next.account.storePurchaseRecovery.status = "committed"
			next.account.storePurchaseRecovery.result = Profile.deepCopy(result)
		end
		local ok, verr = Profile.validate(next, store.knownIds)
		if not ok then
			outcome = { status = "Rejected", reason = "post-state invalid: " .. verr }
			return nil, "Rejected:post-state"
		end
		local seq = op.opSeq
		if type(seq) ~= "number" or seq ~= math.floor(seq)
			or seq < (current.run.opSeq or 0) + 1 then
			seq = (current.run.opSeq or 0) + 1
		end
		next.run.opSeq = seq
		-- Bounded recent-ops cache with monotonic prune high-water. When the
		-- cache is full, the OLDEST op becomes pruneMark (it stays proven).
		next.run.recentOps = next.run.recentOps or {}
		next.run.recentOrder = next.run.recentOrder or {}
		if op.epoch ~= nil then
			next.run.reqHighWater = math.max(
				next.run.reqHighWater or 0, op.seq)
		end
		next.run.recentOps[op.opId] = Profile.deepCopy(result)
		next.run.recentOrder[#next.run.recentOrder + 1] = { id = op.opId,
			seq = seq, v2 = op.epoch ~= nil }
		while #next.run.recentOrder > Config.MAX_RECENT_OPS do
			local evicted = table.remove(next.run.recentOrder, 1)
			next.run.recentOps[evicted.id] = nil
			if not evicted.v2 and evicted.seq
				and evicted.seq > (next.run.pruneMark or 0) then
				next.run.pruneMark = evicted.seq
			end
		end
		outcome = { status = "Committed", wrote = true,
			result = Profile.deepCopy(result) }
		return next, nil
	end
	local committed, wasCommitted, err = store.adapter.update(
		store.adapter, Store.keyFor(userId), tx)
	if not wasCommitted then
		-- SEVERE-case gate: a locally computed Committed is NEVER returned
		-- unless the adapter proved the write. If the callback produced a
		-- new document (wrote=true) the commit is unknown -> Pending when
		-- the transport ran the callback, Unavailable when it failed first.
		-- Aborts (no write attempted) keep their read-only verdicts.
		if outcome ~= nil and outcome.wrote then
			if err and (string.find(err, "ambiguous", 1, true)
				or string.find(err, "after callback", 1, true)) then
				return { status = "Pending", reason = err,
					hint = "reconcile with the SAME opId" }
			end
			return { status = "Unavailable",
				reason = err or "commit unproven" }
		end
		if outcome ~= nil then
			return outcome
		end
		if err and string.find(err, "Stale", 1, true) then
			return { status = "Stale", reason = err }
		end
		return { status = "Unavailable", reason = err or "commit failed" }
	end
	if outcome ~= nil then
		outcome.wrote = nil
		return outcome
	end
	return { status = "Committed", result = nil }
end

-- Shared op identity: read committed state, then admit the requestId in the
-- current session namespace (same idempotent opId/opSeq on retry), plus the
-- frozen read-model fields services compare-and-commit against.
-- Returns ident or nil+err (no profile / load failure).
function Store.identity(store, userId, requestId, now, idem, command)
	if type(requestId) ~= "string" or #requestId == 0
		or #requestId > Config.MAX_STRING_LEN then
		return nil, "bad requestId"
	end
	local data, err = Store.read(store, userId)
	if not data then
		return nil, err or "no profile"
	end
	local epoch = data.session and data.session.epoch or 0
	if type(idem) == "table" and idem.epoch ~= nil and idem.seq ~= nil then
		if not Config.isSafeInteger(idem.epoch, 0)
			or not Config.isSafeInteger(idem.seq, 1) then
			return nil, "bad v2 identity"
		end
		local opRunId = data.run.runId
		local saved = data.account.storePurchaseRecovery
		if command == "BuyEarnedPack" and saved ~= nil
			and saved.requestId == requestId
			and saved.epoch == idem.epoch and saved.seq == idem.seq then
			opRunId = saved.runId
		end
		return {
			op = { opId = idem.epoch .. ":" .. opRunId .. ":"
					.. idem.seq .. ":" .. requestId,
				opSeq = idem.seq, epoch = idem.epoch, seq = idem.seq,
				requestId = requestId, runId = opRunId, kind = command },
			now = now,
			epoch = epoch,
			runId = data.run.runId,
			revision = data.revision,
			attemptSeq = (data.run.attemptSeq or 0) + 1,
		}, nil
	end
	local opId, opSeq = Store.admit(store, userId, requestId,
		data.run.opSeq or 0, epoch, data.run.runId)
	return {
		op = { opId = opId, opSeq = opSeq },
		now = now,
		epoch = epoch,
		runId = data.run.runId,
		revision = data.revision,
		attemptSeq = (data.run.attemptSeq or 0) + 1,
	}, nil
end
-- Record a durable read-model snapshot for reconnect (no grants inside).
function Store.read(store, userId)
	local data, err = Store.loadExisting(store, userId)
	if err ~= nil then
		return nil, err
	end
	return data, nil
end

return Store
]]></string>
        </Properties>
