            <string name="Name">Events</string>
            <string name="Source"><![CDATA[-- Events.luau — canonical battle event schema + snapshot encoding (P2).
-- Pure Luau / plain-Lua subset. P4 consumes these events; the full field
-- contract is recorded in run pieces/P2/API.md. Field order in the canonical
-- encoding is FIXED — never reorder, only append new kinds/fields.

local Events = {}

Events.RULES_VERSION = "provisional-1"

-- Event kinds (stable strings):
-- battle_start | turn_start | strike | damage | shield_absorb | shield_expire
-- status_applied | status_tick | status_expired | ko | replacement
-- entry_effect | battle_end | timeout
Events.KINDS = {
	"battle_start", "turn_start", "strike", "damage", "shield_absorb",
	"shield_expire", "status_applied", "status_tick", "status_expired",
	"ko", "replacement", "entry_effect", "battle_end", "timeout",
}

-- Canonical per-kind field order for byte-identical serialization.
Events.FIELD_ORDER = {
	"id", "seq", "kind", "side", "card", "target", "amount",
	"hp", "shield", "status", "turn", "winner", "reason", "detail",
}

-- Stable event id: "e" + zero-padded 4-digit sequence.
function Events.eventId(seq)
	return "e" .. string.format("%04d", seq)
end

-- Build an event table with a stable id. Extra fields default to "".
function Events.make(seq, kind, fields)
	local event = {
		id = Events.eventId(seq),
		seq = seq,
		kind = kind,
		side = "",
		card = "",
		target = "",
		amount = "",
		hp = "",
		shield = "",
		status = "",
		turn = "",
		winner = "",
		reason = "",
		detail = "",
	}
	if fields ~= nil then
		for key, value in pairs(fields) do
			event[key] = value
		end
	end
	return event
end

-- Deterministic serialization: fixed field order, "|" separated, one line
-- per event. Numbers render via tostring (integers only by construction).
function Events.encodeCanonical(events)
	local lines = {}
	for i = 1, #events do
		local event = events[i]
		local parts = {}
		for j = 1, #Events.FIELD_ORDER do
			parts[j] = tostring(event[Events.FIELD_ORDER[j]])
		end
		lines[i] = table.concat(parts, "|")
	end
	return table.concat(lines, "\n")
end

-- djb2-style hex digest of the canonical encoding (mod 2^32).
function Events.hashCanonical(canonical)
	local hash = 5381
	for i = 1, #canonical do
		hash = (hash * 33 + string.byte(canonical, i)) % 4294967296
	end
	return string.format("%08x", hash)
end

-- Minimal public snapshot for P3/P4: winner, turns, reason, event digest,
-- and final active/reserve state per side. Immutable plain data.
function Events.makeSnapshot(opts)
	return {
		rulesVersion = opts.rulesVersion,
		seed = opts.seed,
		winner = opts.winner,
		turns = opts.turns,
		reason = opts.reason,
		eventCount = opts.eventCount,
		eventHash = opts.eventHash,
		finalA = opts.finalA,
		finalB = opts.finalB,
	}
end

return Events
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Prng</string>
            <string name="Source"><![CDATA[-- Prng.luau — versioned seeded PRNG for Untitled Anime Card Game (P2).
-- Pure Luau written in the plain-Lua subset (no type annotations, no bitwise
-- operators) so the identical file executes on Lune/Luau AND plain Lua 5.x.
-- Rules are PROVISIONAL (REF-01/B-02 BLOCKED, 0/10 observed battles).
-- A new table is returned; callers hold isolated streams. Combat and cosmetic
-- callers must use SEPARATE streams so cosmetic draws never alter combat.

local Prng = {}

Prng.MODULUS = 4294967296 -- 2^32, exact in IEEE doubles
Prng.MULTIPLIER = 1664525
Prng.INCREMENT = 1013904223
Prng.VERSION = 1 -- stream algorithm version; bump = new canonical stream

-- Small deterministic string hash (djb2 variant, mod 2^32) for seed mixing.
function Prng.hashString(text)
	assert(type(text) == "string", "Prng.hashString expects a string")
	local hash = 5381
	for i = 1, #text do
		hash = (hash * 33 + string.byte(text, i)) % Prng.MODULUS
	end
	return hash
end

-- Create a stream. seedInteger must be a finite integer; tag mixes a domain
-- label (e.g. "combat" vs "cosmetic") so streams never collide.
function Prng.newStream(seedInteger, tag)
	assert(type(seedInteger) == "number", "Prng.newStream expects a numeric seed")
	assert(seedInteger == math.floor(seedInteger), "seed must be an integer")
	assert(seedInteger >= 0 and seedInteger < Prng.MODULUS, "seed out of range")
	assert(seedInteger ~= seedInteger or seedInteger == seedInteger, "seed must be finite")
	assert(not (seedInteger == math.huge or seedInteger == -math.huge), "seed must be finite")
	tag = tag or "combat"
	assert(type(tag) == "string", "tag must be a string")
	local mixed = (seedInteger + Prng.hashString("uacg-v1:" .. tag)) % Prng.MODULUS
	return { state = mixed, draws = 0, tag = tag, version = Prng.VERSION }
end

-- Advance one step; returns integer in [0, 2^32).
function Prng.nextU32(stream)
	assert(stream ~= nil and type(stream.state) == "number", "invalid stream")
	stream.state = (Prng.MULTIPLIER * stream.state + Prng.INCREMENT) % Prng.MODULUS
	stream.draws = stream.draws + 1
	return stream.state
end

-- Integer in [1, upper] inclusive. upper must be a positive finite integer.
function Prng.nextInt(stream, upper)
	assert(type(upper) == "number" and upper == math.floor(upper), "upper must be an integer")
	assert(upper >= 1 and upper <= Prng.MODULUS, "upper out of range")
	assert(not (upper == math.huge or upper ~= upper), "upper must be finite")
	local roll = Prng.nextU32(stream)
	return math.floor(roll / Prng.MODULUS * upper) + 1
end

-- Integer in [low, high] inclusive.
function Prng.nextRange(stream, low, high)
	assert(type(low) == "number" and type(high) == "number", "range bounds must be numbers")
	assert(low == math.floor(low) and high == math.floor(high), "range bounds must be integers")
	assert(low <= high, "empty range")
	return low + Prng.nextInt(stream, high - low + 1) - 1
end

return Prng
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Resolver</string>
            <string name="Source"><![CDATA[-- Resolver.luau — deterministic ordered card duel (P2). Pure Luau/plain-Lua subset.
-- PROVISIONAL rule set "provisional-1" (REF-01/B-02 BLOCKED, 0/10 observed
-- battles). One active card per side, ordered replacement, bounded turns,
-- stable ordered event ids, fixed integer math, seeded versioned PRNG,
-- immutable caller inputs, simultaneous-death ties, deterministic tiebreaks.
-- No physics, no tweens, no client input: server-owned only.

local Resolver = {}

Resolver.RULES_VERSION = "provisional-1"
Resolver.MAX_TURNS = 50
Resolver.MAX_EVENTS = 1000

-- Sibling import with three explicit runtime branches:
-- plain Lua (dofile by path), Roblox (require of script.Parent ModuleScript),
-- Lune (relative require). Branch selection is injectable for tests via
-- Resolver._makeSiblingLoader so the Roblox path is covered by a fixture.
local function makeSiblingLoader(env)
	return function(name)
		if env.hasDofile then
			return dofile(env.dir .. name .. ".luau")
		elseif env.scriptObj ~= nil then
			return env.requireFn(env.scriptObj.Parent[name])
		else
			return require("./" .. name)
		end
	end
end
Resolver._makeSiblingLoader = makeSiblingLoader

local siblingDir = "./src/shared/combat/"
if dofile ~= nil then
	local here = debug.getinfo(1, "S").source
	siblingDir = string.match(here, "@(.*/)") or siblingDir
end
local loadSibling = makeSiblingLoader({
	hasDofile = dofile ~= nil,
	scriptObj = (script ~= nil) and script or nil,
	requireFn = require,
	dir = siblingDir,
})

local Prng = loadSibling("Prng")
local Validate = loadSibling("Validate")
local Statuses = loadSibling("Statuses")
local Events = loadSibling("Events")

-- Deep copy of plain data (tables/arrays/scalars only).
function Resolver.deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for key, item in pairs(value) do
		out[Resolver.deepCopy(key)] = Resolver.deepCopy(item)
	end
	return out
end

-- Normalise a fighter inside resolver-owned state (defaults, no aliasing).
local function normalise(fighter)
	local out = Resolver.deepCopy(fighter)
	out.shield = out.shield or 0
	out.status = out.status or { name = "none", ticks = 0, power = 0 }
	out.entry = out.entry or "none"
	out._shieldNew = false -- entry-granted this round: skips one expiry
	return out
end

-- Integer damage: max(1, atk - def + variance), variance in {-1,0,+1} from
-- the COMBAT stream. Fixed floor rounding; no floats escape.
local function strikeDamage(attacker, defender, stream)
	local variance = Prng.nextRange(stream, -1, 1)
	local raw = attacker.atk - defender.def + variance
	if raw < 1 then
		raw = 1
	end
	return raw
end

-- Public: resolveBattle(deckA, deckB, opts) -> result or nil+err.
-- opts: { seed = integer, rulesVersion = "provisional-1", maxTurns? }
-- result: { snapshot, events, canonical, stateA, stateB }
function Resolver.resolveBattle(deckA, deckB, opts)
	opts = opts or {}
	local ok, err = Validate.checkTeam(deckA)
	if not ok then
		return nil, "deckA invalid: " .. err
	end
	ok, err = Validate.checkTeam(deckB)
	if not ok then
		return nil, "deckB invalid: " .. err
	end
	ok, err = Validate.checkSeed(opts.seed)
	if not ok then
		return nil, err
	end
	ok, err = Validate.checkRulesVersion(opts.rulesVersion)
	if not ok then
		return nil, err
	end
	local maxTurns = opts.maxTurns or Resolver.MAX_TURNS
	if not Validate.isFiniteInteger(maxTurns) or maxTurns < 1
		or maxTurns > Validate.MAX_TURNS then
		return nil, "maxTurns out of range 1..50"
	end

	-- Resolver-owned copies: caller tables are never mutated.
	local teamA = {}
	for i = 1, #deckA do
		teamA[i] = normalise(deckA[i])
	end
	local teamB = {}
	for i = 1, #deckB do
		teamB[i] = normalise(deckB[i])
	end

	-- Combat stream mixes seed + rules version + fixed combat tag.
	local seedMixed = (opts.seed + Prng.hashString("uacg-v1:" .. Resolver.RULES_VERSION)) % 4294967296
	local stream = Prng.newStream(seedMixed, "combat")

	local events = {}
	local seq = 0
	local function emit(kind, fields)
		seq = seq + 1
		if seq > Resolver.MAX_EVENTS then
			return nil
		end
		events[seq] = Events.make(seq, kind, fields)
		return events[seq]
	end

	local indexA = 1
	local indexB = 1
	emit("battle_start", {
		side = "-", detail = "rules=" .. Resolver.RULES_VERSION .. " seed=" .. tostring(opts.seed),
	})

	local winner = nil
	local reason = ""
	local turn = 0

	while turn < maxTurns do
		turn = turn + 1
		local activeA = teamA[indexA]
		local activeB = teamB[indexB]
		if activeA == nil or activeB == nil then
			break
		end
		emit("turn_start", { side = "-", turn = turn })

		-- Start-of-turn status ticks (burn can KO before any strike).
		for _, slot in ipairs({
			{ side = "A", fighter = activeA },
			{ side = "B", fighter = activeB },
		}) do
			local tick = Statuses.tickStartOfTurn(slot.fighter)
			if tick.dot > 0 then
				emit("status_tick", {
					side = slot.side, card = slot.fighter.cardId,
					amount = tick.dot, hp = slot.fighter.hp,
					status = "burn", turn = turn,
				})
			end
			if tick.expired then
				emit("status_expired", {
					side = slot.side, card = slot.fighter.cardId,
					status = "burn", turn = turn,
				})
			end
		end

		-- KO check after ticks; simultaneous tick death is a tie path.
		local deadA = activeA.hp <= 0
		local deadB = activeB.hp <= 0
		if deadA or deadB then
			if deadA then
				emit("ko", { side = "A", card = activeA.cardId, turn = turn })
			end
			if deadB then
				emit("ko", { side = "B", card = activeB.cardId, turn = turn })
			end
			if deadA then
				indexA = indexA + 1
				local next = teamA[indexA]
				if next ~= nil then
					emit("replacement", { side = "A", card = next.cardId, turn = turn })
					local fx = Statuses.applyEntry(next, teamB[indexB])
					if fx ~= nil then
						emit("entry_effect", {
							side = "A", card = next.cardId,
							status = fx, turn = turn,
						})
					end
				end
			end
			if deadB then
				indexB = indexB + 1
				local next = teamB[indexB]
				if next ~= nil then
					emit("replacement", { side = "B", card = next.cardId, turn = turn })
					local fx = Statuses.applyEntry(next, teamA[indexA])
					if fx ~= nil then
						emit("entry_effect", {
							side = "B", card = next.cardId,
							status = fx, turn = turn,
						})
					end
				end
			end
			if teamA[indexA] == nil and teamB[indexB] == nil then
				winner, reason = "tie", "simultaneous"
				break
			elseif teamA[indexA] == nil then
				winner, reason = "B", "ko"
				break
			elseif teamB[indexB] == nil then
				winner, reason = "A", "ko"
				break
			end
		else
			-- Strike order: higher speed first; speed tie -> side A first
			-- (deterministic, documented).
			local order = { "A", "B" }
			if activeB.speed > activeA.speed then
				order = { "B", "A" }
			end
			local teams = { A = teamA, B = teamB }
			local indexes = { A = indexA, B = indexB }
			for _, side in ipairs(order) do
				local foe = "A"
				if side == "A" then
					foe = "B"
				end
				local attacker = teams[side][indexes[side]]
				local defender = teams[foe][indexes[foe]]
				if attacker ~= nil and defender ~= nil
					and attacker.hp > 0 and defender.hp > 0 then
					if Statuses.isStunned(attacker) then
						Statuses.consumeStun(attacker)
						emit("status_tick", {
							side = side, card = attacker.cardId,
							status = "stun-skip", turn = turn,
						})
					else
						emit("strike", {
							side = side, card = attacker.cardId,
							target = defender.cardId, turn = turn,
						})
						local dmg = strikeDamage(attacker, defender, stream)
						local absorbed = Statuses.absorb(defender, dmg)
						if absorbed > 0 then
							emit("shield_absorb", {
								side = foe, card = defender.cardId,
								amount = absorbed, shield = defender.shield,
								turn = turn,
							})
						end
						local dealt = dmg - absorbed
						defender.hp = defender.hp - dealt
						emit("damage", {
							side = foe, card = defender.cardId,
							target = attacker.cardId, amount = dealt,
							hp = defender.hp, turn = turn,
						})
					end
				end
			end

			-- End of round: KO resolution in stable side order (A then B).
			deadA = teams.A[indexes.A] ~= nil and teams.A[indexes.A].hp <= 0
			deadB = teams.B[indexes.B] ~= nil and teams.B[indexes.B].hp <= 0
			if deadA then
				emit("ko", { side = "A", card = teams.A[indexes.A].cardId, turn = turn })
			end
			if deadB then
				emit("ko", { side = "B", card = teams.B[indexes.B].cardId, turn = turn })
			end
			if deadA then
				indexA = indexes.A + 1
				if teamA[indexA] ~= nil then
					emit("replacement", { side = "A", card = teamA[indexA].cardId, turn = turn })
					local fx = Statuses.applyEntry(teamA[indexA], teamB[indexB])
					if fx ~= nil then
						emit("entry_effect", {
							side = "A", card = teamA[indexA].cardId,
							status = fx, turn = turn,
						})
					end
				end
			end
			if deadB then
				indexB = indexes.B + 1
				if teamB[indexB] ~= nil then
					emit("replacement", { side = "B", card = teamB[indexB].cardId, turn = turn })
					local fx = Statuses.applyEntry(teamB[indexB], teamA[indexA])
					if fx ~= nil then
						emit("entry_effect", {
							side = "B", card = teamB[indexB].cardId,
							status = fx, turn = turn,
						})
					end
				end
			end
			if teamA[indexA] == nil and teamB[indexB] == nil then
				winner, reason = "tie", "simultaneous"
				break
			elseif teamA[indexA] == nil then
				winner, reason = "B", "ko"
				break
			elseif teamB[indexB] == nil then
				winner, reason = "A", "ko"
				break
			end

			-- One-turn shields expire at round end, except shields granted
			-- by an entry effect this same round (they guard next round).
			for _, slot in ipairs({
				{ side = "A", fighter = teamA[indexA] },
				{ side = "B", fighter = teamB[indexB] },
			}) do
				if slot.fighter ~= nil then
					if slot.fighter._shieldNew then
						slot.fighter._shieldNew = false
					elseif Statuses.expireShield(slot.fighter) then
						emit("shield_expire", {
							side = slot.side, card = slot.fighter.cardId, turn = turn,
						})
					end
				end
			end
		end
		if seq >= Resolver.MAX_EVENTS then
			winner, reason = "tie", "event-bound"
			break
		end
	end

	-- Turn-limit tiebreak: more total remaining HP wins; equal is a tie.
	if winner == nil then
		local hpA = 0
		for i = indexA, #teamA do
			if teamA[i].hp > 0 then
				hpA = hpA + teamA[i].hp
			end
		end
		local hpB = 0
		for i = indexB, #teamB do
			if teamB[i].hp > 0 then
				hpB = hpB + teamB[i].hp
			end
		end
		if hpA > hpB then
			winner, reason = "A", "timeout-hp"
		elseif hpB > hpA then
			winner, reason = "B", "timeout-hp"
		else
			winner, reason = "tie", "timeout-equal"
		end
		emit("timeout", { side = "-", winner = winner, reason = reason })
	end

	emit("battle_end", { side = "-", winner = winner, reason = reason, turn = turn })

	local function publicState(team, index)
		local act = team[index]
		local reserve = {}
		for i = index + 1, #team do
			reserve[#reserve + 1] = team[i].cardId
		end
		return {
			active = act and act.cardId or nil,
			hp = act and act.hp or 0,
			reserve = reserve,
		}
	end

	local canonical = Events.encodeCanonical(events)
	local snapshot = Events.makeSnapshot({
		rulesVersion = Resolver.RULES_VERSION,
		seed = opts.seed,
		winner = winner,
		turns = turn,
		reason = reason,
		eventCount = #events,
		eventHash = Events.hashCanonical(canonical),
		finalA = publicState(teamA, indexA),
		finalB = publicState(teamB, indexB),
	})
	return {
		snapshot = snapshot,
		events = events,
		canonical = canonical,
		stateA = teamA,
		stateB = teamB,
	}, nil
end

return Resolver
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Statuses</string>
            <string name="Source"><![CDATA[-- Statuses.luau — status / shield / entry-effect helpers (P2).
-- Pure Luau / plain-Lua subset. All functions mutate only the passed fighter
-- table (owned by the resolver) and return small event-fragment tables.
-- PROVISIONAL tuning (REF-01/B-02 BLOCKED): burn 2/turn for 3 ticks,
-- entry shield 2, entry stun 1 tick. One-turn shield expiry per transcript
-- example (historical, NOT a frozen reference rule).

local Statuses = {}

Statuses.BURN_POWER = 2
Statuses.BURN_TICKS = 3
Statuses.ENTRY_SHIELD = 2
Statuses.STUN_TICKS = 1

function Statuses.newStatus(name, ticks, power)
	return { name = name or "none", ticks = ticks or 0, power = power or 0 }
end

function Statuses.isStunned(fighter)
	return fighter.status ~= nil
		and fighter.status.name == "stun"
		and fighter.status.ticks > 0
end

-- Start-of-turn tick for the holder. Returns fragment { dot, expired }.
function Statuses.tickStartOfTurn(fighter)
	local out = { dot = 0, expired = false }
	local status = fighter.status
	if status == nil or status.name == "none" or status.ticks <= 0 then
		return out
	end
	if status.name == "burn" then
		out.dot = status.power
		fighter.hp = fighter.hp - status.power
		status.ticks = status.ticks - 1
		if status.ticks <= 0 then
			fighter.status = Statuses.newStatus("none", 0, 0)
			out.expired = true
		end
	elseif status.name == "stun" then
		-- Stun consumes one tick when it eats a strike (see consumeStun),
		-- but a safety decay here prevents permanent lock on timeout paths.
		status.ticks = status.ticks - 1
		if status.ticks <= 0 then
			fighter.status = Statuses.newStatus("none", 0, 0)
			out.expired = true
		end
	end
	return out
end

function Statuses.consumeStun(fighter)
	fighter.status = Statuses.newStatus("none", 0, 0)
end

function Statuses.applyBurn(fighter)
	fighter.status = Statuses.newStatus("burn", Statuses.BURN_TICKS, Statuses.BURN_POWER)
end

-- Shield absorbs incoming damage; returns absorbed amount.
function Statuses.absorb(fighter, damage)
	local shield = fighter.shield or 0
	if shield <= 0 or damage <= 0 then
		return 0
	end
	local absorbed = math.min(shield, damage)
	fighter.shield = shield - absorbed
	return absorbed
end

-- One-turn shields expire at end of the holder's round. Returns true if a
-- shield value was cleared.
function Statuses.expireShield(fighter)
	if (fighter.shield or 0) > 0 then
		fighter.shield = 0
		return true
	end
	return false
end

-- Entry effect when a replacement becomes active. Returns effect name or nil.
-- enemy may be nil when the other side is exhausted (simultaneous depletion):
-- entry stun then has no target and is skipped; the terminal event stands.
function Statuses.applyEntry(entering, enemy)
	local entry = entering.entry
	if entry == nil or entry == "none" then
		return nil
	end
	if entry == "shield2" then
		entering.shield = (entering.shield or 0) + Statuses.ENTRY_SHIELD
		entering._shieldNew = true -- survives this round-end expiry
		return "shield2"
	elseif entry == "stun" then
		if enemy == nil then
			return nil
		end
		enemy.status = Statuses.newStatus("stun", Statuses.STUN_TICKS, 0)
		return "stun"
	end
	return nil
end

return Statuses
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Validate</string>
            <string name="Source"><![CDATA[-- Validate.luau — input validation for combat (P2). Pure Luau / plain-Lua subset.
-- Rejects non-finite numbers, wrong shapes, unknown rules versions, bad decks.
-- PROVISIONAL rules version (REF-01/B-02 BLOCKED).

local Validate = {}

Validate.RULES_VERSION = "provisional-1"
Validate.MAX_TEAM = 6
Validate.MIN_TEAM = 1
Validate.MAX_TURNS = 50
Validate.MAX_EVENTS = 1000
Validate.MAX_STAT = 999
Validate.MAX_HP = 9999

function Validate.isFiniteNumber(value)
	return type(value) == "number"
		and value == value
		and value ~= math.huge
		and value ~= -math.huge
end

function Validate.isFiniteInteger(value)
	return Validate.isFiniteNumber(value) and value == math.floor(value)
end

-- ok, err — rules version must match exactly or the battle is rejected.
function Validate.checkRulesVersion(version)
	if type(version) ~= "string" then
		return false, "rulesVersion must be a string"
	end
	if version ~= Validate.RULES_VERSION then
		return false, "unsupported rulesVersion: " .. version
	end
	return true, nil
end

-- ok, err — one fighter stat block.
function Validate.checkFighter(fighter)
	if type(fighter) ~= "table" then
		return false, "fighter must be a table"
	end
	if type(fighter.cardId) ~= "string" or fighter.cardId == "" then
		return false, "fighter.cardId must be a nonempty string"
	end
	for _, key in ipairs({ "hp", "maxHp", "atk", "def", "speed" }) do
		local value = fighter[key]
		if not Validate.isFiniteInteger(value) then
			return false, "fighter." .. key .. " must be a finite integer"
		end
	end
	if fighter.hp < 1 or fighter.hp > Validate.MAX_HP then
		return false, "fighter.hp out of range"
	end
	if fighter.maxHp < 1 or fighter.maxHp > Validate.MAX_HP then
		return false, "fighter.maxHp out of range"
	end
	if fighter.hp > fighter.maxHp then
		return false, "fighter.hp exceeds maxHp"
	end
	for _, key in ipairs({ "atk", "def", "speed" }) do
		if fighter[key] < 0 or fighter[key] > Validate.MAX_STAT then
			return false, "fighter." .. key .. " out of range"
		end
	end
	if fighter.shield ~= nil then
		if not Validate.isFiniteInteger(fighter.shield) or fighter.shield < 0 then
			return false, "fighter.shield must be a nonnegative finite integer"
		end
	end
	if fighter.status ~= nil then
		if type(fighter.status) ~= "table" then
			return false, "fighter.status must be a table"
		end
		local name = fighter.status.name
		if name ~= nil and name ~= "none" and name ~= "burn" and name ~= "stun" then
			return false, "unknown status: " .. tostring(name)
		end
		if fighter.status.ticks ~= nil then
			if not Validate.isFiniteInteger(fighter.status.ticks) or fighter.status.ticks < 0 then
				return false, "status.ticks must be a nonnegative finite integer"
			end
		end
		if fighter.status.power ~= nil then
			if not Validate.isFiniteInteger(fighter.status.power) or fighter.status.power < 0 then
				return false, "status.power must be a nonnegative finite integer"
			end
		end
	end
	if fighter.entry ~= nil and fighter.entry ~= "none"
		and fighter.entry ~= "shield2" and fighter.entry ~= "stun" then
		return false, "unknown entry effect: " .. tostring(fighter.entry)
	end
	return true, nil
end

-- ok, err — ordered team (deck): 1..MAX_TEAM validated fighters in order.
function Validate.checkTeam(team)
	if type(team) ~= "table" then
		return false, "team must be a table"
	end
	local count = #team
	if count < Validate.MIN_TEAM or count > Validate.MAX_TEAM then
		return false, "team size out of range 1..6"
	end
	for i = 1, count do
		local ok, err = Validate.checkFighter(team[i])
		if not ok then
			return false, "team[" .. i .. "]: " .. err
		end
	end
	return true, nil
end

-- ok, err — battle seed.
function Validate.checkSeed(seed)
	if not Validate.isFiniteInteger(seed) then
		return false, "seed must be a finite integer"
	end
	if seed < 0 or seed >= 4294967296 then
		return false, "seed out of range"
	end
	return true, nil
end

return Validate
]]></string>
          </Properties>
        </Item>
      </Item>
