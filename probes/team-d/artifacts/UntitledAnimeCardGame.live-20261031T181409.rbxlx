        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Cards</string>
            <string name="Source"><![CDATA[-- Cards.luau — provisional placeholder card editions (P2). Pure Luau/plain-Lua subset.
-- 24 editions covering all 8 fixed franchises (3 per franchise). Artwork is an
-- explicit PLACEHOLDER: no asset IDs are invented (art gate B-05/B-06 BLOCKED).
-- Canonical exact-form names are gameplay identity; `alias` is the SEPARATE
-- display short name (roster retention contract). Player-visible names are
-- descriptive ROLE TITLES, never real character names (operator directive
-- 2026-09-21); `franchise` stays accurate as metadata. Stats bounded
-- (atk 3..20, hp 20..120, def 0..10, speed 1..20). Mythic rarity and the
-- Legacy retention flag are DISTINCT fields (single Mythic BL-BYAKUYA-01,
-- single Legacy DB-GOKU-01). Three+ low-rarity starter/counter identities
-- exist for a no-luck start. Three worlds (WORLD-01/02/03), each with 3
-- encounters + one boss-flagged edition (NR-KAKASHI-01, DB-PRINCE-01,
-- MHA-FROSTBURN-01). WORLD-02/03 reuse existing non-starter editions only:
-- no rows added, no ids/rarities/stats renamed; the sole row change is
-- boss=true on the two new boss editions (audited 2026-09-22: no test or
-- pin required exactly-one-boss). Boss picks fit the role: DB-PRINCE-01 is
-- an Epic attacker (hp84/atk16), MHA-FROSTBURN-01 a Legendary attacker
-- (hp88/atk15). Mythic BL-BYAKUYA-01 deliberately stays a non-boss chase
-- card (single-Mythic pin untouched); Legacy DB-GOKU-01 untouched.
-- Existing 10 ids/rarities/stats/flags frozen (P3/P4/P6 + journey balance pin
-- them); the 14 added rows are starter=false, mythic=false, legacy=false.

local Cards = {}

Cards.CONTENT_VERSION = "content-provisional-1"
Cards.RULES_VERSION = "provisional-1"

-- rarity: one of Common Uncommon Rare Epic Legendary Mythic.
-- mythic: true only for Mythic rarity. legacy: independent retention flag.
-- role: attacker | counter | support. starter: no-luck-start eligible.
-- artwork: placeholder marker only — never an asset id.
