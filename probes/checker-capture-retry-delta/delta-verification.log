--- claim 1: bounded retry implementation ---
class Atlas(CollectorFixture):
    timeout, max_report, chunks = 600, 2 * 1024 * 1024, True
    first_view_timeout = ATLAS_FIRST_VIEW_TIMEOUT  # Plan 4: bounded bind of view-001 (named-seed hang detector)
    capture_attempts_max = 3  # launch March: one capture + at most 2 bounded retries when bytes duplicate an earlier view
    capture_retry_wait = 0.3  # seconds between the duplicate and the retry (lets the Play frame repaint)

    def __init__(self, name, seed=None):
                self.read_world_trace(ctx, out)
            ack = body["report"]
            # Bounded fresh-capture retry: a capture that duplicates an earlier view's bytes is re-taken (at most
            # capture_attempts_max total) after a short wait, with the camera re-probed each time. The duplicate rule
            # stays the final fail-closed outcome, and every attempt is kept as evidence so the retry path is auditable.
            attempts = []
            for attempt in range(1, self.capture_attempts_max + 1):
                before = probe(ctx)
                raw, mime = ctx.studio.capture()
                after = probe(ctx)
                sha = digest(raw)
                duplicate = any(c["sha256"] == sha for c in self.captures)
                delta = max(max(abs(a - b) for a, b in zip(p["camera"]["frame"], ack["frame"])) for p in (before, after))
                attempts.append({"attempt": attempt, "sha256": sha, "duplicate": duplicate, "cameraDelta": delta})
                if not duplicate:
                    break
                if delta > frames.CAMERA_TOLERANCE:
                    self.capture_attempts.append({"phase": phase, "attempts": attempts})
                    raise FixtureFailed(f"{phase}: camera moved during the capture retry ({delta:.4g} > "
                                        f"{frames.CAMERA_TOLERANCE}); no capture accepted")
                if attempt == self.capture_attempts_max:
                    self.capture_attempts.append({"phase": phase, "attempts": attempts})
                    raise FixtureFailed(f"{phase}: screen_capture returned the same bytes as an earlier view on all "
                                        f"{attempt} attempts (stale capture; attempts recorded)")
                ctx.sleep(self.capture_retry_wait)
            self.capture_attempts.append({"phase": phase, "attempts": attempts})
            if any(a["duplicate"] for a in attempts):
                write(out / "capture-attempts.json", self.capture_attempts)
            for which, p in (("before", before), ("after", after)):
                delta = max(abs(a - b) for a, b in zip(p["camera"]["frame"], ack["frame"]))
                if delta > frames.CAMERA_TOLERANCE:
                    raise FixtureFailed(f"{phase} camera {which} capture differs from the ack by {delta:.4g} > {frames.CAMERA_TOLERANCE}")
            name = f"{index:03d}-{view['id']}"
            image_name = name + frames.image_ext(mime)
            write(out / "views" / image_name, raw)
            try:
                row = frames.sidecar(index, before, after, raw, image_name, self.visual_flags, mime, ctx.place_technology)
            except ValueError as exc:
                raise FixtureFailed(f"{phase}: {exc}") from exc
            # The view's native acknowledgement (seed, twoSettledFrames, qualifiedCoverage, anchors, ...) under the probe's fields.
            row.update(ok=body.get("ok") is True, report=frames.merged(ack, row["report"]), ack=phase)
            if len(attempts) > 1:
                row["captureAttempts"] = attempts
            write(out / "views" / (name + ".json"), row)
            self.captures.append({"id": view["id"], "phase": phase, "path": f"views/{image_name}", "mimeType": mime, "sha256": digest(raw)})

