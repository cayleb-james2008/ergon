 def test_server_and_client_agree_on_the_widened_view_bound(self):
  """Nox run-7 layer-6 fix: the server allowlist bound mirrors the client (32), and a >32 plan is rejected by the
  pinned contract. Scout is 27 views; the old 24 cap was the stale side."""
  server=(A.ROOT/'tests/atlas/Server.luau').read_text()
  client=(A.ROOT/'tests/atlas/Client.luau').read_text()
  self.assertIn('#manifest.views<=32,"candidate/allowlist mismatch"',server)
  self.assertIn('#plan.views<=32,"native allowlist invalid"',client)
  self.assertNotIn('views<=24',server)  # the stale layer-6 cap is gone
  self.assertNotIn('views<=24',client)
  self.assertEqual(len(self.data['views']),27)
  bound=lambda views:0<len(views)<=32
  self.assertTrue(bound(self.data['views']))
  self.assertFalse(bound(self.data['views']+[{}]*6))  # 33 views is rejected

--- claim 3: full planned-list assertion ---
 def test_full_planned_list_contains_no_whole_highway_overhead_and_exactly_the_zone_views(self):
  """Checker R3: the scout pin alone would stay green if an unused whole-highway view lingered in the full list; pin
  the full planned list itself (no highway-overhead anywhere, exactly the four zone overheads, distinct zone paths)."""
  views,_=atlas.planned_views(self.graph)
  self.assertNotIn('highway-overhead',{v['id'] for v in views})
  zone=[v for v in views if v.get('zonePath')]
  self.assertEqual([v['id'] for v in zone],['highway-zone-%d-overhead'%i for i in (1,2,3,4)])
  self.assertEqual(len({v['zonePath'] for v in zone}),4)
  self.assertTrue(all(v['zonePath'].startswith('Highway/Roads/Road_') for v in zone))
  self.assertTrue(all(v['kind']=='overhead' and v['zone']=='highway' for v in zone))
  overhead={v['id'] for v in views if v['kind']=='overhead'}
  self.assertEqual(overhead,{'city-overhead','world-overhead'}|{v['id'] for v in zone})

